(module harness-tui-approval-fixture)

(import "coil.alloc" :use *)
(import "coil.match" :use *)
(import "harness-tui-approval" :use *)
(import "harness-tui-approval-input" :use *)
(import "harness-tui-output" :use *)
(import "harness-tui-terminal" :use *)

;; PTY-only fixture for the approval lifecycle. It stays outside configured test
;; roots and adds no command or provider behavior to the production harness.
(defn main [(argc i32) (argv (ptr (ptr i8)))] (-> i64)
  (let [allocator (malloc-allocator)
        overrides (terminal-overrides-from-env allocator)
        profile (terminal-detect-profile allocator overrides)
        choice (approval-input-interactive allocator profile)]
    (tui-output-reset allocator profile)
    (match choice
      (ApprovalAllowOnce []
                         (do
                           (tui-output-write-line allocator 1 "ALLOW")
                           0))
      (ApprovalReject [reason]
                      (do
                        (tui-output-write-line allocator 1 "REJECT")
                        0)))))
