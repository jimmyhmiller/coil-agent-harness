(module harness-tui-stream-fixture)

(import "coil.alloc" :use *)
(import "harness-tui-frame" :use *)
(import "harness-tui-output" :use *)
(import "harness-tui-render-inline" :use *)
(import "harness-tui-terminal" :use *)

;; Repeatedly redraw a one-row response. The final stable commit is the only
;; operation in this fixture that may advance scrollback.
(defn main [(argc i32) (argv (ptr (ptr i8)))] (-> i64)
  (let [allocator (malloc-allocator)
        overrides (terminal-overrides-from-env allocator)
        profile (terminal-detect-profile allocator overrides)
        (mut renderer) (inline-renderer-new)
        (mut empty) (frame-new allocator)
        (mut at) 0]
    (loop (if (>= (load at) 100)
              (break)
              (let [(mut live) (frame-new allocator)]
                (frame-push-line! (mut live) "streaming answer" 16 (RolePrimary))
                (tui-output-inline-update! (mut renderer)
                                           allocator
                                           profile
                                           (mut empty)
                                           (mut live))
                (store! at (+ (load at) 1)))))
    (let [(mut committed) (frame-new allocator)]
      (frame-push-line! (mut committed) "final answer" 12 (RoleSuccess))
      (tui-output-inline-update! (mut renderer)
                                 allocator
                                 profile
                                 (mut committed)
                                 (mut empty)))
    0))
