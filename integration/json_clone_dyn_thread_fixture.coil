(module harness-json-clone-dyn-thread-fixture)

(import "coil.alloc" :as alloc :use *)
(import "coil.arraylist" :use *)
(import "coil.primitive" :as primitive)
(import "coil.thread" :use *)
(import "harness-allocation-domain" :use *)
(import "harness-bash-tool" :use *)
(import "harness-event" :use *)
(import "harness-filesystem-tools" :use *)
(import "harness-json" :use *)
(import "provider-common" :use *)
(import "harness-tool" :use *)

(defstruct CloneThreadJob
  [(owner (dyn Allocator))
   (registry (ptr ToolRegistry))
   (emitter (ptr EventEmitter))])

(defn build-copy-request [(allocator (dyn Allocator))
                          (registry (ptr ToolRegistry))] (-> Json)
  (let [(mut params) (json-object allocator)
        (mut tools) (json-array allocator)
        definitions (field registry definitions)
        (mut i) 0
        n (al-len [ToolDefinition] (load definitions))]
    (loop (if (>= (load i) n)
              (break)
              (let [definition (al-get [ToolDefinition] (load definitions) (load i))
                    spec (field definition spec)
                    (mut tool) (json-object allocator)]
                (json-put-string! (mut tool) "type" "function")
                (json-put-string! (mut tool) "name" (load (field spec name)))
                (json-put-string! (mut tool) "description" (load (field spec description)))
                (json-object-put! (mut tool)
                                  "inputSchema"
                                  (json-clone allocator
                                              (load (field spec input-schema))))
                (json-array-push! (mut tools) (load tool))
                (store! i (+ (load i) 1)))))
    (json-object-put! (mut params) "dynamicTools" (load tools))
    (load params)))

(defn clone-thread-worker [(opaque (ptr i8))] (-> (ptr i8))
  (let [job (cast (ptr CloneThreadJob) opaque)
        owner (load (field job owner))
        domain (allocation-domain-open owner)
        allocator (allocation-domain-allocator domain)
        request (build-copy-request allocator (load (field job registry)))
        encoded (json-stringify allocator request)]
    (emit-event (load (field job emitter))
                1
                (CodexNotification)
                "run"
                "operation"
                ""
                "fixture"
                "fixture"
                (JsonNull))
    (allocation-domain-close! owner domain)
    (cast (ptr i8) 0)))

(defn main [(argc i32) (argv (ptr (ptr i8)))] (-> i64)
  (let [owner (malloc-allocator)
        registry (box! owner ToolRegistry (tool-registry-new owner))
        sink (box! owner NoopEventSink (zeroed NoopEventSink))
        sequence (box! owner i64 1)
        emitter (box! owner EventEmitter (event-emitter-new owner sink sequence))
        job (box! owner CloneThreadJob (zeroed CloneThreadJob))
        thread (primitive/alloc-stack Thread)]
    (register-filesystem-tools! registry owner ".")
    (register-bash-tool! registry owner ".")
    (store! (field job owner) owner)
    (store! (field job registry) registry)
    (store! (field job emitter) emitter)
    (if (!= (cast i64
                  (thread-spawn thread
                                (fnptr-of clone-thread-worker)
                                (cast (ptr i8) job)))
            0)
        2
        (do
          (thread-join thread)
          0))))
