(module harness-http-test)

(import "coil.alloc" :as alloc :use *)
(import "coil.arraylist" :use *)
(import "coil.primitive" :as primitive)
(import "coil.slice" :use *)
(import "coil.str" :use *)
(import "harness-http" :use *)

(defstruct FakeStreamingHttpTransport
  [(return-code i64)
   (calls i64)
   (payload (slice u8))
   (status i64)])

(impl StreamingHttpTransport FakeStreamingHttpTransport
  (send-streaming-http [(self (ptr FakeStreamingHttpTransport))
                        (allocator (dyn Allocator))
                        (request (ptr HttpRequest))
                        (response (mut HttpResponse))]
                       (-> i64)
                       (do
                         (set! (.calls self) (+ (.calls self) 1))
                         (let [payload (.payload self)
                               sink (field request chunks)]
                           (when (> (slice-len [u8] payload) 0)
                             (primitive/call-ptr (load (field sink consume))
                                                 (slice-data [u8] payload)
                                                 (cast usize (slice-len [u8] payload))
                                                 (load (field sink context)))
                             0))
                         (set! (.transport-code response) 0)
                         (set! (.status-code response) (.status self))
                         (set! (.body response) (.payload self))
                         (set! (.error response) "fake transport error")
                         (.return-code self))))

(defn accept-http-chunk [(data (ptr u8)) (length usize) (context (ptr i8))] (-> usize)
  (let [observed (cast (ptr i64) context)]
    (set! observed (cast i64 length))
    length))

(defn reject-http-chunk [(data (ptr u8)) (length usize) (context (ptr i8))] (-> usize)
  (cast usize 0))

(deftest curl-stream-callback-delivers-bounds-capture-and-propagates-stop
         (let [allocator (malloc-allocator)
               observed (box! allocator i64 0)
               capture (primitive/alloc-stack StreamingCapture)
               input "stream bytes"]
           (store! (field (field capture sink) context) (cast (ptr i8) observed))
           (store! (field (field capture sink) consume) (fnptr-of accept-http-chunk))
           (store! (field capture body) (al-new [u8] allocator))
           (store! (field capture max-captured-bytes) 6)
           ;; A sink that accepts the whole chunk keeps the transfer going, and the
           ;; retained copy stops at max-captured-bytes.
           (assert-eq (capture-streaming-chunk (slice-data [u8] input)
                                               (slice-len [u8] input)
                                               (cast (ptr i8) capture))
                      BODY-CONTINUE)
           (assert-eq (load observed) (slice-len [u8] input))
           (assert (= (al-slice [u8] (load (field capture body))) "stream"))
           ;; A sink that accepts less than the chunk is asking to stop.
           (store! (field (field capture sink) consume) (fnptr-of reject-http-chunk))
           (assert-eq (capture-streaming-chunk (slice-data [u8] input)
                                               (slice-len [u8] input)
                                               (cast (ptr i8) capture))
                      BODY-STOP)
           (al-free! [u8] (mut (field capture body)))))

(deftest injectable-streaming-transport-delivers-chunks-and-normalizes-failure
         (let [allocator (malloc-allocator)
               headers
                 (box! allocator
                      (ArrayList (slice u8))
                      (al-new [(slice u8)] allocator))
               observed (box! allocator i64 0)
               request (primitive/alloc-stack HttpRequest)
               transport
                 (box! allocator
                      FakeStreamingHttpTransport
                      (zeroed FakeStreamingHttpTransport))]
           (store! (field request url) "https://example.invalid/stream")
           (store! (field request headers) headers)
           (store! (field request body) "{}")
           (store! (field request timeout-ms) 25)
           (store! (field (field request chunks) context) (cast (ptr i8) observed))
           (store! (field (field request chunks) consume) (fnptr-of accept-http-chunk))
           (store! (field transport payload) "two chunks")
           (store! (field transport status) 202)
           (let [response (streaming-http-send transport allocator request)]
             (assert-eq (load (field transport calls)) 1)
             (assert-eq (load observed) 10)
             (assert-eq (load (field response transport-code)) 0)
             (assert-eq (load (field response status-code)) 202)
             (assert (= (load (field response body)) "two chunks")))
           (store! (field transport return-code) -7)
           (let [failed (streaming-http-send transport allocator request)]
             (assert-eq (load (field failed transport-code)) -1)
             (assert (= (load (field failed error)) "fake transport error")))))
