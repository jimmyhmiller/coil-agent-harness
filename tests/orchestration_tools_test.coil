(module harness-orchestration-tools-test)

(import "coil.alloc" :as alloc :use *)
(import "coil.fs" :as fs)
(import "coil.match" :use *)
(import "coil.str" :use *)
(import "harness-event" :use *)
(import "harness-event-journal" :use *)
(import "harness-json" :use *)
(import "harness-orchestration-tools" :use *)
(import "harness-run-service" :use *)
(import "harness-system" :use *)
(import "harness-tool" :use *)
(import "provider-common" :use *)

(defstruct OrchestrationController [(starts i64)])

(impl RunController OrchestrationController
  (prepare-durable-provider [(self (ptr OrchestrationController)) (provider-name (slice u8))] (-> i64) 0)
  (start-durable-run [(self (ptr OrchestrationController)) (command (ptr Json))]
                     (-> i64)
                     (do
                       (set! (.starts self) (+ (.starts self) 1))
                       0))
  (request-cancel-durable-run [(self (ptr OrchestrationController)) (command (ptr Json))]
                              (-> i64)
                              0)
  (cancel-durable-run [(self (ptr OrchestrationController)) (command (ptr Json))]
                      (-> RunCancellationResult)
                      (RunCancellationAccepted))
  (describe-tools [(self (ptr OrchestrationController))
                   (allocator (ptr Allocator))
                   (out (ptr Json))]
                  (-> i64)
                  -1)
  (authorize-tool-call [(self (ptr OrchestrationController))
                        (command (ptr Json))
                        (allocator (ptr Allocator))
                        (out (ptr Json))]
                       (-> i64)
                       -1)
  (invoke-tool [(self (ptr OrchestrationController))
                (command (ptr Json))
                (allocator (ptr Allocator))
                (out (ptr Json))]
               (-> i64)
               -1))

(defn orchestration-call [(allocator (ptr Allocator))
                          (id (slice u8))
                          (name (slice u8))
                          (run-id (slice u8))
                          (prompt (slice u8))] (-> ToolCall)
  (let [call (alloc/stack ToolCall)
        (mut arguments) (json-object allocator)]
    (json-put-string! (mut arguments) "run_id" run-id)
    (when (not (= name "spawn_subagents"))
      (json-put-string! (mut arguments) "provider" "fake")
      (json-put-string! (mut arguments) "model" "fake-model")
      0)
    (json-put-string! (mut arguments) "prompt" prompt)
    (set! (.id call) id)
    (set! (.name call) name)
    (set! (.arguments call) (load arguments))
    (set! (.raw-arguments call) "")
    (load call)))

(defn orchestration-succeeded? [(result ToolResult)] (-> bool)
  (match (.status result) (ToolSucceeded [] true) (_ false)))

(defn batch-agent [(allocator (ptr Allocator))
                   (run-id (slice u8))
                   (provider (slice u8))
                   (model (slice u8))
                   (prompt (slice u8))] (-> Json)
  (let [(mut agent) (json-object allocator)]
    (json-put-string! (mut agent) "run_id" run-id)
    (json-put-string! (mut agent) "provider" provider)
    (json-put-string! (mut agent) "model" model)
    (json-put-string! (mut agent) "prompt" prompt)
    (load agent)))

(deftest asynchronous-tools-have-composable-strict-schemas
         (let [allocator (malloc-allocator)
               schema (spawn-subagents-schema allocator)
               properties (json-get schema "properties")
               required (json-get schema "required")
               agent (json-get (json-get properties "agents") "items")]
           (assert-eq (json-array-length required) 1)
           (assert-eq (json-array-length (json-get agent "required")) 4)
           (assert (match (json-bool-value (json-get agent "additionalProperties"))
                     (Some [allowed] (not allowed))
                     (None [] false)))
           (let [start (start-async-schema allocator)
                 notify (notify-async-schema allocator)]
             (assert (json-object-has? (json-get start "properties") "tool_name"))
             (assert (json-object-has? (json-get start "properties") "arguments"))
             (assert (= (command-string (json-get (json-get start "properties")
                                                  "arguments")
                                        "type")
                        "string"))
             (assert (json-object-has? (json-get notify "properties") "handles"))
             (assert (not (json-object-has? (json-get notify "properties") "mode")))
             (assert-eq (json-array-length (json-get notify "required")) 2))))

(deftest subagent-and-workflow-tools-use-durable-run-service
         (let [allocator (malloc-allocator)
               path "/tmp/coil-agent-harness-orchestration-tools.jsonl"
               journal (alloc/stack EventJournal)
               sequence (box allocator i64 1)
               emitter (alloc/stack EventEmitter)
               controller (alloc/stack OrchestrationController)
               service (alloc/stack RunService)
               context (alloc/stack ToolExecutionContext)]
           (fs/write-file allocator path "")
           (match (event-journal-open allocator path true)
             (JournalOpenFailed [message] (assert false))
             (JournalOpened [opened] (store! journal opened)))
           (store! emitter (event-emitter-new allocator journal sequence))
           (store! (field controller starts) 0)
           (store! (field service allocator) allocator)
           (store! (field service journal-path) path)
           (store! (field service journal) journal)
           (store! (field service emitter) emitter)
           (store! (field service controller) controller)
           (store! (field context run-id) "parent-run")
           (store! (field context cancellation) (cast (ptr CancellationToken) 0))
           (store! (field context run-deadline-monotonic-ms) 0)
           (store! (field context tool-deadline-monotonic-ms) 0)
           (let [(mut parent) (json-object allocator)]
             (json-object-put! (mut parent) "version" (json-integer allocator 1))
             (json-put-string! (mut parent) "command_id" "parent-create")
             (json-put-string! (mut parent) "run_id" "parent-run")
             (json-put-string! (mut parent) "provider" "fake")
             (json-put-string! (mut parent) "model" "fake-model")
             (json-put-string! (mut parent) "prompt" "coordinate")
             (let [response (service-submit-run service (mut parent) "test")]
               (assert-eq (load (field response status)) 202)))
           (let [spawn-tool (alloc/stack SpawnSubagentsTool)
                 spawn-call (alloc/stack ToolCall)
                 (mut arguments) (json-object allocator)
                 (mut agents) (json-array allocator)]
             (store! (field spawn-tool service) service)
             (let [duplicate-call (alloc/stack ToolCall)
                   (mut duplicate-arguments) (json-object allocator)
                   (mut duplicates) (json-array allocator)]
               (json-array-push! (mut duplicates)
                                 (batch-agent allocator "same-run" "fake" "fake-model" "one"))
               (json-array-push! (mut duplicates)
                                 (batch-agent allocator "same-run" "fake" "fake-model" "two"))
               (json-object-put! (mut duplicate-arguments) "agents" (load duplicates))
               (store! (field duplicate-call id) "duplicate-batch")
               (store! (field duplicate-call name) "spawn_subagents")
               (store! (field duplicate-call arguments) (load duplicate-arguments))
               (let [rejected (execute-spawn-subagents spawn-tool duplicate-call context allocator)]
                 (assert (not (orchestration-succeeded? rejected)))
                 ;; The entire invalid batch is rejected before either child starts.
                 (assert-eq (load (field controller starts)) 1)))
             (json-array-push! (mut agents)
                               (batch-agent allocator "child-run" "fake" "fake-model" "research"))
             (json-array-push! (mut agents)
                               (batch-agent allocator
                                            "override-child-run"
                                            "fake-override"
                                            "override-model"
                                            "use an override"))
             (json-object-put! (mut arguments) "agents" (load agents))
             (store! (field spawn-call id) "spawn-batch-call")
             (store! (field spawn-call name) "spawn_subagents")
             (store! (field spawn-call arguments) (load arguments))
             (store! (field spawn-call raw-arguments) "")
             (let [result (execute-spawn-subagents spawn-tool spawn-call context allocator)]
               (assert (orchestration-succeeded? result))
               (assert-eq (json-array-length (json-get (load (field result output)) "handles")) 2)))
           (let [async-tool (alloc/stack StartAsyncTool)
                 (mut async-call)
                   (orchestration-call allocator
                                       "async-bash-call"
                                       "start_async_tool"
                                       "async-bash-run"
                                       "")]
             (store! (field async-tool service) service)
             (let [(mut arguments) (load (field async-call arguments))
                   (mut inner) (json-object allocator)]
               (json-put-string! (mut arguments) "run_id" "async-bash-run")
               (json-put-string! (mut arguments) "tool_name" "bash")
               (json-put-string! (mut inner) "command" "echo ready")
               (json-put-string! (mut arguments)
                                 "arguments"
                                 (json-stringify allocator (load inner)))
               (store! (field async-call arguments) (load arguments)))
             (let [result (execute-start-async async-tool (mut async-call) context allocator)]
               (assert (orchestration-succeeded? result))
               (assert (= (command-string (load (field result output)) "status") "queued"))))
           (let [workflow-tool (alloc/stack CreateWorkflowNodeTool)
                 root-call (alloc/stack ToolCall)
                 child-call (alloc/stack ToolCall)]
             (store! (field workflow-tool service) service)
             (store! root-call
                     (orchestration-call allocator
                                         "root-call"
                                         "create_workflow_node"
                                         "root-node-run"
                                         "root"))
             (let [(mut arguments) (load (field root-call arguments))
                   (mut dependencies) (json-array allocator)]
               (json-put-string! (mut arguments) "workflow_id" "workflow-tools")
               (json-put-string! (mut arguments) "node_id" "root")
               (json-object-put! (mut arguments) "depends_on" (load dependencies))
               (store! (field root-call arguments) (load arguments)))
             (assert (orchestration-succeeded? (execute-create-workflow-node workflow-tool root-call context allocator)))
             (store! child-call
                     (orchestration-call allocator
                                         "child-call"
                                         "create_workflow_node"
                                         "dependent-node-run"
                                         "dependent"))
             (let [(mut arguments) (load (field child-call arguments))
                   (mut dependencies) (json-array allocator)]
               (json-put-string! (mut arguments) "workflow_id" "workflow-tools")
               (json-put-string! (mut arguments) "node_id" "dependent")
               (json-array-push! (mut dependencies) (JsonString "root-node-run"))
               (json-object-put! (mut arguments) "depends_on" (load dependencies))
               (store! (field child-call arguments) (load arguments)))
             (assert (orchestration-succeeded? (execute-create-workflow-node workflow-tool child-call context allocator))))
           (let [notify-tool (alloc/stack NotifyAsyncTool)
                 (mut notify-call)
                   (orchestration-call allocator
                                       "notify-call"
                                       "notify_async"
                                       ""
                                       "")]
             (store! (field notify-tool service) service)
             (let [(mut arguments) (load (field notify-call arguments))
                   (mut handles) (json-array allocator)]
               (json-put-string! (mut arguments) "group_id" "agent-batch")
               (json-array-push! (mut handles) (JsonString "child-run"))
               (json-array-push! (mut handles) (JsonString "override-child-run"))
               (json-array-push! (mut handles) (JsonString "async-bash-run"))
               (json-object-put! (mut arguments) "handles" (load handles))
               (store! (field notify-call arguments) (load arguments)))
             (let [result (execute-notify-async notify-tool (mut notify-call) context allocator)]
               (assert (orchestration-succeeded? result))
               (assert-eq (json-array-length (json-get (load (field result output)) "notifications")) 1)))
           (assert-eq (load (field controller starts)) 7)
           (let [child (service-query-events service "child-run" 0)
                 events (json-get (load (field child body)) "events")
                 created (json-array-get events 0)
                 payload (json-get created "payload")]
             (assert (= (command-string payload "provider") "fake"))
             (assert (= (command-string payload "model") "fake-model"))
             (assert (match (json-bool-value (json-get payload "notify_parent"))
                       (Some [enabled] (not enabled))
                       (None [] false))))
           (let [child (service-query-events service "override-child-run" 0)
                 events (json-get (load (field child body)) "events")
                 created (json-array-get events 0)
                 payload (json-get created "payload")]
             (assert (= (command-string payload "provider") "fake-override"))
             (assert (= (command-string payload "model") "override-model")))
           (let [async-run (service-query-events service "async-bash-run" 0)
                 events (json-get (load (field async-run body)) "events")
                 payload (json-get (json-array-get events 0) "payload")]
             (assert (= (command-string payload "provider") "async-tool"))
             (assert (= (command-string payload "model") "async-tool")))
           (let [workflow (service-query-workflow service "workflow-tools")]
             (assert-eq (load (field workflow status)) 200)
             (assert-eq (json-array-length (json-get (load (field workflow body)) "nodes")) 2))
           (let [notification (service-query-events service "notification:agent-batch" 0)
                 events (json-get (load (field notification body)) "events")
                 payload (json-get (json-array-get events 0) "payload")]
             (assert (= (command-string payload "dependency_policy") "terminal"))
             (assert-eq (json-array-length (json-get payload "depends_on")) 3)
             (assert (= (command-string payload "conversation_id")
                        (command-string (orchestration-parent-command service "parent-run")
                                        "conversation_id"))))
           (event-journal-close! journal)))
