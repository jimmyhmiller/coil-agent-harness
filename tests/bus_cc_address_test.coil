;; Address encoding tests.
;;
;; These assert byte-exact output rather than "round-trips", because the
;; receiver re-renders what it parsed and compares it against the original. An
;; encoder that is merely self-consistent -- lower-case hex, a different safe
;; set -- round-trips perfectly here and is silently degraded to opaque text on
;; the wire. The expected strings below come from the reference client.
(module harness-bus-cc-address-test)
(import "coil.primitive" :as primitive)

(import "coil.primitive" :as primitive)

(import "coil.alloc" :as alloc :use *)
(import "coil.assert" :use *)
(import "coil.slice" :use *)
(import "coil.str" :use *)
(import "harness-bus-cc-address" :use *)

(deftest an-ordinary-socket-path-needs-no-escaping
         (let [allocator (malloc-allocator)]
           (assert (= (cc-uds-address allocator "/tmp/cc-socks/39194.sock") "uds:/tmp/cc-socks/39194.sock"))))

;; A space is the common case -- macOS home directories and project paths have
;; them -- and it is outside the safe set.
(deftest bytes-outside-the-safe-set-are-percent-escaped-in-upper-case-hex
         (let [allocator (malloc-allocator)]
           (assert (= (cc-encode-address allocator "/tmp/my sock") "/tmp/my%20sock"))
           (assert (= (cc-encode-address allocator "a?b") "a%3Fb"))
           (assert (= (cc-encode-address allocator "a[b]") "a%5Bb%5D"))))

;; Percent itself must be escaped or decoding would not be injective: without
;; this, "%41" and "A" would encode to the same address.
(deftest percent-is-not-safe-and-round-trips-through-decode
         (let [allocator (malloc-allocator)]
           (assert (= (cc-encode-address allocator "100%") "100%25"))
           (assert (= (cc-decode-address allocator "100%25") "100%"))
           (assert (= (cc-decode-address allocator (cc-encode-address allocator "%41")) "%41"))))

(deftest the-safe-set-matches-the-reference-escape-class
         (assert (cc-address-safe-byte? 58))
         (assert (cc-address-safe-byte? 95))
         (assert (cc-address-safe-byte? 47))
         (assert (cc-address-safe-byte? 46))
         (assert (cc-address-safe-byte? 92))
         (assert (cc-address-safe-byte? 45))
         (assert (cc-address-safe-byte? 48))
         (assert (cc-address-safe-byte? 122))
         (assert (not (cc-address-safe-byte? 37)))
         (assert (not (cc-address-safe-byte? 32)))
         (assert (not (cc-address-safe-byte? 34)))
         (assert (not (cc-address-safe-byte? 60))))

;; Multi-byte UTF-8 escapes per byte, not per code point.
(deftest a-multibyte-character-escapes-each-byte
         (let [allocator (malloc-allocator)]
           (assert (= (cc-encode-address allocator "café") "caf%C3%A9"))
           (assert (= (cc-decode-address allocator "caf%C3%A9") "café"))))

;; A truncated or non-hex escape is data, not an error: the receiver would have
;; accepted the address, so refusing it locally loses a deliverable message.
(deftest a-malformed-escape-decodes-verbatim
         (let [allocator (malloc-allocator)]
           (assert (= (cc-decode-address allocator "a%") "a%"))
           (assert (= (cc-decode-address allocator "a%4") "a%4"))
           (assert (= (cc-decode-address allocator "a%zz") "a%zz"))))

(deftest validation-mirrors-the-receivers-own-check
         (assert (cc-address-valid? "uds:/tmp/cc-socks/1.sock"))
         (assert (cc-address-valid? "uds:/tmp/my%20sock"))
         (assert (not (cc-address-valid? "")))
         (assert (not (cc-address-valid? "uds:/tmp/my sock")))
         (assert (not (cc-address-valid? "uds:/tmp/\"quoted\""))))

(deftest an-address-longer-than-the-receiver-accepts-is-refused
         (let [allocator (malloc-allocator)
               (mut buffer) (sb-new allocator)
               (mut i) 0]
           (loop (if (>= (load i) CC_ADDRESS_MAX_BYTES)
                     (break)
                     (do
                       (sb-push-byte! (mut buffer) (cast u8 97))
                       (store! i (+ (load i) 1)))))
           (assert (cc-address-valid? (sb-str (load buffer))))
           (sb-push-byte! (mut buffer) (cast u8 97))
           (assert (not (cc-address-valid? (sb-str (load buffer)))))))

(deftest each-scheme-parses-to-its-target
         (let [allocator (malloc-allocator)
               scheme (primitive/alloc-stack CcScheme)
               target (primitive/alloc-stack (slice u8))]
           (cc-parse-address allocator "uds:/tmp/cc-socks/7.sock" scheme target)
           (assert (cc-scheme-eq (load scheme) (CcUds)))
           (assert (= (load target) "/tmp/cc-socks/7.sock"))

           (cc-parse-address allocator "bridge:abc123" scheme target)
           (assert (cc-scheme-eq (load scheme) (CcBridge)))
           (assert (= (load target) "abc123"))

           ;; A did: address keeps its prefix -- the whole string identifies the
           ;; peer, so stripping it would lose the identifier.
           (cc-parse-address allocator "did:key:z6Mk" scheme target)
           (assert (cc-scheme-eq (load scheme) (CcDid)))
           (assert (= (load target) "did:key:z6Mk"))

           (cc-parse-address allocator "whatever" scheme target)
           (assert (cc-scheme-eq (load scheme) (CcOther)))))

;; A human types a path; the protocol means a uds address.
(deftest a-bare-absolute-path-is-a-socket-address
         (let [allocator (malloc-allocator)
               scheme (primitive/alloc-stack CcScheme)
               target (primitive/alloc-stack (slice u8))]
           (cc-parse-address allocator "/tmp/cc-socks/7.sock" scheme target)
           (assert (cc-scheme-eq (load scheme) (CcUds)))
           (assert (= (load target) "/tmp/cc-socks/7.sock"))
           (assert (cc-address-local? "/tmp/cc-socks/7.sock"))
           (assert (cc-address-local? "uds:/tmp/cc-socks/7.sock"))
           (assert (not (cc-address-local? "bridge:abc")))))

;; An escaped path must survive parse as the real filesystem path, or we would
;; connect to a file that does not exist.
(deftest a-percent-escaped-path-parses-back-to-the-real-path
         (let [allocator (malloc-allocator)
               scheme (primitive/alloc-stack CcScheme)
               target (primitive/alloc-stack (slice u8))
               address (cc-uds-address allocator "/tmp/cc socks/7.sock")]
           (assert (= address "uds:/tmp/cc%20socks/7.sock"))
           (cc-parse-address allocator address scheme target)
           (assert (= (load target) "/tmp/cc socks/7.sock"))))

(deftest the-socket-path-is-the-pid-under-the-socket-directory
         (let [allocator (malloc-allocator)
               path (cc-socket-path allocator 39194)]
           (assert (= path "/tmp/cc-socks/39194.sock"))))
