(module harness-tool-executor-test)
(import "coil.primitive" :as primitive)

(import "coil.alloc" :as alloc :use *)
(import "coil.arraylist" :use *)
(import "coil.atomic" :use *)
(import "coil.match" :use *)
(import "coil.str" :use *)
(import "harness-event" :use *)
(import "harness-json" :use *)
(import "harness-tool" :use *)
(import "harness-system" :use *)
(import "harness-tool-executor" :use *)
(import "harness-bash-tool" :use *)

(defstruct ParallelProbe
  [(active (ptr i64))
   (maximum (ptr i64))])

(defn update-maximum! [(maximum (ptr i64)) (candidate i64)] (-> i64)
  (let [(mut observed) (atomic-load maximum)
        (mut done) false]
    (loop (if (or (load done) (>= (load observed) candidate))
              (break)
              (let [actual (atomic-cas maximum (load observed) candidate)]
                (if (= actual (load observed))
                    (set! done true)
                    (set! observed actual)))))
    (atomic-load maximum)))

(defn execute-probe [(probe (ptr ParallelProbe))
                     (call (ptr ToolCall))
                     (allocator (dyn Allocator))] (-> ToolResult)
  (let [active (+ (atomic-add (load (field probe active)) 1) 1)
        (mut result) (tool-result-empty (.id call) (ToolSucceeded))]
    (update-maximum! (load (field probe maximum)) active)
    (sleep-ms 80)
    (atomic-sub (load (field probe active)) 1)
    ;; The executor must promote this call-arena-owned string before closing the
    ;; worker's region.
    (set! (.output result) (JsonString (json-copy-string allocator (.id call))))
    (load result)))

(impl ToolImplementation ParallelProbe
  (execute-tool [(self (ptr ParallelProbe))
                 (call (ptr ToolCall))
                 (context (ptr ToolExecutionContext))
                 (allocator (dyn Allocator))]
                (-> ToolResult)
                (execute-probe self call allocator)))

(defstruct CountingEventSink
  [(count (ptr i64))
   (valid-envelope (ptr i64))
   (valid-proposal (ptr i64))])

(impl EventSink CountingEventSink
  (publish-event [(self (ptr CountingEventSink)) (event (ptr Event))]
                 (-> i64)
                 (do
                   (atomic-add (load (field self count)) 1)
                   (when (or (!= (load (field event version)) 1)
                             (not (str-eq (load (field event parent-operation-id))
                                          "model-1")))
                     (atomic-store (load (field self valid-envelope)) 0)
                     0)
                   (match (.kind event)
                          (ToolCallProposed []
                                            (let [payload (.payload event)]
                                              (when (or (not (match (json-string-at payload "name")
                                                               (Some [name] (str-eq name "probe"))
                                                               (None [] false)))
                                                        (not (match (json-get payload "arguments")
                                                                    (JsonObject [keys values] true)
                                                                    (_ false))))
                                                (atomic-store (load (field self valid-proposal)) 0)
                                                0)))
                          (_ 0))
                   0)))

(defn executor-tool [(allocator (dyn Allocator)) (probe (ptr ParallelProbe))] (-> ToolDefinition)
  (let [schema-result
          (json-parse allocator
                      "{\"type\":\"object\",\"properties\":{},\"required\":[],\"additionalProperties\":false}")
        definition (primitive/alloc-stack ToolDefinition)]
    (set! (.name (.spec definition)) "probe")
    (set! (.description (.spec definition)) "Parallelism probe")
    (set! (.input-schema (.spec definition)) (.value schema-result))
    (set! (.strict (.spec definition)) true)
    (set! (.effect (.spec definition)) (ReadOnly))
    (set! (.idempotent (.spec definition)) true)
    (set! (.timeout-ms (.spec definition)) 1000)
    (set! (.implementation definition) probe)
    (load definition)))

(defn executor-call [(allocator (dyn Allocator)) (id (slice u8))] (-> ToolCall)
  (let [call (primitive/alloc-stack ToolCall)]
    (set! (.id call) id)
    (set! (.name call) "probe")
    (set! (.arguments call) (json-object allocator))
    (set! (.raw-arguments call) "{}")
    (load call)))

(defn executor-bash-call [(allocator (dyn Allocator))] (-> ToolCall)
  (let [call (primitive/alloc-stack ToolCall)
        (mut arguments) (json-object allocator)]
    (json-object-put! (mut arguments) "command" (JsonString "printf worker-stack-ok"))
    (set! (.id call) "bash-worker")
    (set! (.name call) "bash")
    (set! (.arguments call) (load arguments))
    (set! (.raw-arguments call) "")
    (load call)))

;; Regression for the real macOS SIGBUS report: the platform's 512 KiB default
;; pthread stack was exhausted inside execute-bash -> subprocess/run.
(deftest executes-bash-on-a-tool-worker-with-an-explicit-stack
         (let [allocator (malloc-allocator)
               sequence (box! allocator i64 0)
               registry (box! allocator ToolRegistry (tool-registry-new allocator))
               calls (box! allocator (ArrayList ToolCall) (al-new [ToolCall] allocator))
               sink (primitive/alloc-stack NoopEventSink)
               emitter (primitive/alloc-stack EventEmitter)
               execution (primitive/alloc-stack ToolExecutionRequest)]
           (let [(mut registry-value) (load registry)]
             (register-bash-tool! (mut registry-value) allocator ".")
             (store! registry (load registry-value)))
           (al-push! [ToolCall] calls (executor-bash-call allocator))
           (store! emitter (event-emitter-new allocator sink sequence))
           (store! (field execution run-id) "bash-stack-test")
           (store! (field execution parent-operation-id) "model-1")
           (store! (field execution provider) "fixture")
           (store! (field execution model) "fixture")
           (store! (field execution registry) registry)
           (store! (field execution calls) calls)
           (store! (field execution emitter) emitter)
           (store! (field execution cancellation) (cast (ptr CancellationToken) 0))
           (store! (field execution run-deadline-monotonic-ms) 0)
           (store! (field execution max-parallel) 1)
           (let [batch (execute-tools-parallel allocator execution)
                 result (al-get [ToolResult] (load (field batch results)) 0)
                 output (load (field result output))]
             (assert (match (load (field result status)) (ToolSucceeded [] true) (_ false)))
             (assert (match (json-string-at output "stdout")
                       (Some [value] (= value "worker-stack-ok"))
                       (None [] false))))))

(deftest executes-independent-tools-concurrently-and-keeps-result-order
         (let [allocator (malloc-allocator)
               active (box! allocator i64 0)
               maximum (box! allocator i64 0)
               event-count (box! allocator i64 0)
               valid-envelope (box! allocator i64 1)
               valid-proposal (box! allocator i64 1)
               sequence (box! allocator i64 0)
               probe (box! allocator ParallelProbe (zeroed ParallelProbe))
               registry (box! allocator ToolRegistry (tool-registry-new allocator))
               calls (box! allocator (ArrayList ToolCall) (al-new [ToolCall] allocator))
               sink (primitive/alloc-stack CountingEventSink)
               emitter (primitive/alloc-stack EventEmitter)
               execution (primitive/alloc-stack ToolExecutionRequest)]
           (store! (field probe active) active)
           (store! (field probe maximum) maximum)
           (let [(mut registry-value) (load registry)]
             (tool-register! (mut registry-value) (executor-tool allocator probe))
             (store! registry (load registry-value)))
           (al-push! [ToolCall] calls (executor-call allocator "first"))
           (al-push! [ToolCall] calls (executor-call allocator "second"))
           (store! (field sink count) event-count)
           (store! (field sink valid-envelope) valid-envelope)
           (store! (field sink valid-proposal) valid-proposal)
           (event-emitter-init! emitter allocator sink sequence)
           (store! (field execution run-id) "parallel-test")
           (store! (field execution parent-operation-id) "model-1")
           (store! (field execution provider) "fake")
           (store! (field execution model) "fake")
           (store! (field execution registry) registry)
           (store! (field execution calls) calls)
           (store! (field execution emitter) emitter)
           (store! (field execution cancellation) (cast (ptr CancellationToken) 0))
           (store! (field execution run-deadline-monotonic-ms) 0)
           (store! (field execution max-parallel) 2)
           (let [batch (execute-tools-parallel allocator execution)]
             (assert-eq (al-len [ToolResult] (load (field batch results))) 2)
             (assert-eq (atomic-load maximum) 2)
             (let [first (al-get [ToolResult] (load (field batch results)) 0)]
               (assert (match (load (field first status)) (ToolSucceeded [] true) (_ false)))
               (assert (= (load (field first call-id)) "first"))
               (assert (match (json-string-value (load (field first output)))
                         (Some [text] (= text "first"))
                         (None [] false))))
             (assert-eq (atomic-load event-count) 6)
             (assert-eq (atomic-load valid-envelope) 1)
             (assert-eq (atomic-load valid-proposal) 1))))

(deftest reports-a-tool-that-exceeds-its-cooperative-deadline
         (let [allocator (malloc-allocator)
               active (box! allocator i64 0)
               maximum (box! allocator i64 0)
               event-count (box! allocator i64 0)
               valid-envelope (box! allocator i64 1)
               valid-proposal (box! allocator i64 1)
               sequence (box! allocator i64 0)
               probe (box! allocator ParallelProbe (zeroed ParallelProbe))
               registry (box! allocator ToolRegistry (tool-registry-new allocator))
               calls (box! allocator (ArrayList ToolCall) (al-new [ToolCall] allocator))
               sink (primitive/alloc-stack CountingEventSink)
               emitter (primitive/alloc-stack EventEmitter)
               execution (primitive/alloc-stack ToolExecutionRequest)
               (mut definition) (executor-tool allocator probe)]
           (store! (field probe active) active)
           (store! (field probe maximum) maximum)
           (store! (field (field definition spec) timeout-ms) 5)
           (let [(mut registry-value) (load registry)]
             (tool-register! (mut registry-value) (load definition))
             (store! registry (load registry-value)))
           (al-push! [ToolCall] calls (executor-call allocator "slow"))
           (store! (field sink count) event-count)
           (store! (field sink valid-envelope) valid-envelope)
           (store! (field sink valid-proposal) valid-proposal)
           (store! emitter (event-emitter-new allocator sink sequence))
           (store! (field execution run-id) "timeout-test")
           (store! (field execution parent-operation-id) "model-1")
           (store! (field execution provider) "fake")
           (store! (field execution model) "fake")
           (store! (field execution registry) registry)
           (store! (field execution calls) calls)
           (store! (field execution emitter) emitter)
           (store! (field execution cancellation) (cast (ptr CancellationToken) 0))
           (store! (field execution run-deadline-monotonic-ms) 0)
           (store! (field execution max-parallel) 1)
           (let [batch (execute-tools-parallel allocator execution)
                 result (al-get [ToolResult] (load (field batch results)) 0)]
             (assert (match (load (field result status)) (ToolErrored [] true) (_ false)))
             (assert (= (load (field result error)) "tool deadline exceeded"))
             (assert-eq (atomic-load event-count) 3)
             (assert-eq (atomic-load valid-envelope) 1)
             (assert-eq (atomic-load valid-proposal) 1))))
