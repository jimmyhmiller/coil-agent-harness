(module harness-event-test)

(import "coil.alloc" :as alloc :use *)
(import "coil.assert" :use *)
(import "coil.match" :use *)
(import "coil.str" :use *)
(import "harness-event" :use *)
(import "harness-json" :use *)
(import "provider-common" :use *)

(deftest serializes-the-complete-versioned-event-envelope
         (let [allocator (malloc-allocator)
               event (alloc/stack Event)]
           (store! (field event version) 1)
           (store! (field event sequence) 42)
           (store! (field event timestamp-ms) 1000)
           (store! (field event kind) (ToolCallCompleted))
           (store! (field event run-id) "run-1")
           (store! (field event agent-id) "agent-1")
           (store! (field event operation-id) "tool-1")
           (store! (field event parent-operation-id) "model-1")
           (store! (field event provider) "fake")
           (store! (field event model) "fake-model")
           (store! (field event payload) (JsonString "done"))
           (let [wire (event-to-json allocator event)]
             (assert (= (json-number-i64 (json-get wire "version")) 1))
             (assert (= (json-number-i64 (json-get wire "sequence")) 42))
             (assert (match (json-string-at wire "event")
                       (Some [value] (= value "tool.call.completed"))
                       (None [] false)))
             (assert (match (json-string-at wire "parent_operation_id")
                       (Some [value] (= value "model-1"))
                       (None [] false)))
             (assert (match (json-string-at wire "agent_id")
                       (Some [value] (= value "agent-1"))
                       (None [] false)))
             (assert (match (json-get wire "payload") (JsonString [value] (= value "done")) (_ false))))))
