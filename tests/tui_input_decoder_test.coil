(module harness-tui-input-decoder-test)

(import "coil.alloc" :use *)
(import "coil.match" :use *)
(import "coil.slice" :use *)
(import "coil.str" :use *)
(import "harness-tui-input-decoder" :use *)
(import "harness-tui-input-editor" :use *)

(defn decoder-feed-text! [(decoder (ptr InputDecoder))
                          (text (slice u8))] (-> InputDecode)
  (let [(mut at) 0
        (mut result) (InputNeedMore)]
    (loop (if (>= (load at) (slice-len [u8] text))
              (break)
              (do
                (set! result
                      (input-decoder-feed! decoder
                                           (slice-get [u8] text (load at))))
                (set! at (+ (load at) 1)))))
    (load result)))

(defn decoder-feed-escape! [(decoder (ptr InputDecoder))
                            (suffix (slice u8))] (-> InputDecode)
  (input-decoder-feed! decoder (cast u8 27))
  (decoder-feed-text! decoder suffix))

(deftest decodes-navigation-and-editing-sequences
         (let [allocator (malloc-allocator)
               (mut decoder) (input-decoder-new allocator)]
           (assert (match (input-decoder-feed! (mut decoder) (cast u8 27)) (InputNeedMore [] true) (_ false)))
           (assert (match (input-decoder-feed! (mut decoder) (cast u8 91)) (InputNeedMore [] true) (_ false)))
           (assert (match (input-decoder-feed! (mut decoder) (cast u8 68))
                          (InputDecoded [key]
                                        (match key (InputLeft [] true) (_ false)))
                          (_ false)))
           (assert (match (decoder-feed-escape! (mut decoder) "[3~")
                          (InputDecoded [key]
                                        (match key (InputDelete [] true) (_ false)))
                          (_ false)))
           (assert (match (decoder-feed-escape! (mut decoder) "[13;2u")
                          (InputDecoded [key]
                                        (match key (InputNewline [] true) (_ false)))
                          (_ false)))))

(deftest bracketed-paste-is-one-insertion-even-with-newlines
         (let [allocator (malloc-allocator)
               (mut decoder) (input-decoder-new allocator)]
           (decoder-feed-escape! (mut decoder) "[200~")
           (decoder-feed-text! (mut decoder) "first\n/quit\nlast")
           (match (decoder-feed-escape! (mut decoder) "[201~")
                  (InputDecoded [key]
                                (match key
                                       (InputInsert [text]
                                                    (assert (= text "first\n/quit\nlast")))
                                       (_ (assert false))))
                  (_ (assert false)))))

(deftest escape-becomes-dismiss-only-after-sequence-timeout
         (let [allocator (malloc-allocator)
               (mut decoder) (input-decoder-new allocator)]
           (assert (match (input-decoder-feed! (mut decoder) (cast u8 27)) (InputNeedMore [] true) (_ false)))
           (assert (match (input-decoder-timeout! (mut decoder))
                          (InputDecoded [key]
                                        (match key (InputDismiss [] true) (_ false)))
                          (_ false)))))
