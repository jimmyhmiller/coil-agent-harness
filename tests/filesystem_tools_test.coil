(module harness-filesystem-tools-test)

(import "coil.alloc" :as alloc :use *)
(import "coil.arraylist" :use *)
(import "coil.match" :use *)
(import "coil.str" :use *)
(import "harness-filesystem-tools" :use *)
(import "harness-json" :use *)
(import "harness-run-service" :use *)
(import "harness-tool" :use *)
(import "provider-common" :use *)

(defn filesystem-call [(allocator (ptr Allocator))
                       (id (slice u8))
                       (name (slice u8))
                       (path (slice u8))
                       (content (slice u8))] (-> ToolCall)
  (let [(mut arguments) (json-object allocator)
        call (alloc/stack ToolCall)]
    (json-put-string! (mut arguments) "path" path)
    (when (= name "write_text_file")
      (json-put-string! (mut arguments) "content" content)
      0)
    (set! (.id call) id)
    (set! (.name call) name)
    (set! (.arguments call) (load arguments))
    (set! (.raw-arguments call) "")
    (load call)))

(deftest reads-bounded-line-windows
         (let [window (alloc/stack LineWindow)]
           (store! window (file-line-window "one\ntwo\nthree\nfour\n" 2 2))
           (assert (= (load (field window content)) "two\nthree\n"))
           (assert-eq (load (field window total-lines)) 4)
           (assert-eq (load (field window start-line)) 2)
           (assert-eq (load (field window end-line)) 3)
           (assert-eq (load (field window next-start-line)) 4)))

(deftest reads-and-writes-bounded-workspace-relative-files
         (let [allocator (malloc-allocator)
               reader (alloc/stack ReadTextFileTool)
               writer (alloc/stack WriteTextFileTool)
               deleter (alloc/stack DeleteFileTool)
               context (alloc/stack ToolExecutionContext)
               write-call
                 (box allocator
                      ToolCall
                      (filesystem-call allocator
                                       "write-1"
                                       "write_text_file"
                                       "coil-agent-harness-filesystem-tool.txt"
                                       "hello from a tool"))
               read-call
                 (box allocator
                      ToolCall
                      (filesystem-call allocator
                                       "read-1"
                                       "read_text_file"
                                       "coil-agent-harness-filesystem-tool.txt"
                                       ""))]
           (store! (field reader root) "/tmp")
           (store! (field writer root) "/tmp")
           (store! (field deleter root) "/tmp")
           (store! (field context cancellation)
                   (cast (ptr CancellationToken) 0))
           (store! (field context run-deadline-monotonic-ms) 0)
           (store! (field context tool-deadline-monotonic-ms) 0)
           (let [written
                   (execute-write-text-file writer
                                            write-call
                                            context
                                            allocator)]
             (assert (match (load (field written status)) (ToolSucceeded [] true) (_ false)))
             (assert-eq (json-number-i64 (json-get (load (field written output)) "bytes_written"))
                        17))
           (let [read (execute-read-text-file reader read-call context allocator)
                 output (load (field read output))]
             (assert (match (load (field read status)) (ToolSucceeded [] true) (_ false)))
             (assert (= (command-string output "content") "hello from a tool"))
             (assert-eq (json-number-i64 (json-get output "bytes")) 17))
           (let [(mut edit-arguments) (json-object allocator)
                 editor (alloc/stack EditTextFileTool)
                 edit-call (box allocator ToolCall (zeroed ToolCall))]
             (store! (field editor root) "/tmp")
             (json-put-string! (mut edit-arguments)
                               "path"
                               "coil-agent-harness-filesystem-tool.txt")
             (json-put-string! (mut edit-arguments) "old_text" "from a")
             (json-put-string! (mut edit-arguments) "new_text" "via the")
             (store! (field edit-call id) "edit-1")
             (store! (field edit-call name) "edit_text_file")
             (store! (field edit-call arguments) (load edit-arguments))
             (let [edited (execute-edit-text-file editor edit-call context allocator)]
               (assert (match (load (field edited status)) (ToolSucceeded [] true) (_ false))))
             (let [read (execute-read-text-file reader read-call context allocator)]
               (assert (= (command-string (load (field read output)) "content") "hello via the tool"))))
           (let [deleted (execute-delete-file deleter read-call context allocator)]
             (assert (match (load (field deleted status)) (ToolSucceeded [] true) (_ false))))
           (let [missing (execute-read-text-file reader read-call context allocator)]
             (assert (match (load (field missing status)) (ToolErrored [] true) (_ false))))))

(deftest creates-and-removes-only-empty-relative-directories
         (let [allocator (malloc-allocator)
               creator (alloc/stack CreateDirectoryTool)
               remover (alloc/stack RemoveDirectoryTool)
               context (alloc/stack ToolExecutionContext)
               call
                 (box allocator
                      ToolCall
                      (filesystem-call allocator
                                       "directory-1"
                                       "create_directory"
                                       "coil-agent-harness-tool-directory"
                                       ""))]
           (store! (field creator root) "/tmp")
           (store! (field remover root) "/tmp")
           (store! (field context cancellation)
                   (cast (ptr CancellationToken) 0))
           ;; Clean up a directory left by an interrupted prior test.
           (execute-remove-directory remover call context allocator)
           (let [created (execute-create-directory creator call context allocator)]
             (assert (match (load (field created status)) (ToolSucceeded [] true) (_ false))))
           (let [removed (execute-remove-directory remover call context allocator)]
             (assert (match (load (field removed status)) (ToolSucceeded [] true) (_ false))))))

(deftest rejects-parent-traversal-and-registers-effect-metadata
         (let [allocator (malloc-allocator)
               reader (alloc/stack ReadTextFileTool)
               context (alloc/stack ToolExecutionContext)
               call
                 (box allocator
                      ToolCall
                      (filesystem-call allocator
                                       "read-traversal"
                                       "read_text_file"
                                       "../secret"
                                       ""))
               registry (alloc/stack ToolRegistry)]
           (store! (field reader root) "/tmp")
           (store! (field context cancellation)
                   (cast (ptr CancellationToken) 0))
           (let [result (execute-read-text-file reader call context allocator)]
             (assert (match (load (field result status)) (ToolErrored [] true) (_ false))))
           (store! registry (tool-registry-new allocator))
           (assert (register-filesystem-tools! (mut registry) allocator "/tmp"))
           (assert-eq (al-len [ToolDefinition]
                              (load (field registry definitions)))
                      6)
           (match (tool-find (load registry) "write_text_file")
             (None [] (assert false))
             (Some [definition]
                   (let [selected definition]
                     (assert (match (load (field (field selected spec) effect)) (Destructive [] true) (_ false))))))
           (match (tool-find (load registry) "create_directory")
             (None [] (assert false))
             (Some [definition]
                   (let [selected definition]
                     (assert (match (load (field (field selected spec) effect)) (Reversible [] true) (_ false))))))))
