(module harness-agent-runner-test)

(import "coil.alloc" :as alloc :use *)
(import "coil.arraylist" :use *)
(import "coil.atomic" :use *)
(import "coil.match" :use *)
(import "coil.str" :use *)
(import "harness-event" :use *)
(import "harness-json" :use *)
(import "harness-model" :use *)
(import "harness-tool" :use *)
(import "provider-common" :use *)
(import "harness-agent-runner" :use *)
(import "harness-system" :use *)

(defstruct FakeProviderState
  [(calls (ptr i64))
   (observed-continuation (ptr i64))
   (first-operation-id (slice u8))
   (second-operation-id (slice u8))])

(defstruct FakeTool [])

(defstruct SlowProvider [(delay-ms i64)])

(impl ModelProvider SlowProvider
  (provider-name [(self (ptr SlowProvider))] (-> (slice u8)) "slow")
  (provider-capabilities [(self (ptr SlowProvider))]
                         (-> ProviderCapabilities)
                         (provider-capabilities-for "slow"))
  (execute-model [(self (ptr SlowProvider))
                  (request (ptr ModelRequest))
                  (emitter (ptr EventEmitter))
                  (allocator (ptr Allocator))]
                 (-> ModelResult)
                 (do
                   (sleep-ms (load (field self delay-ms)))
                   (let [(mut response) (response-empty allocator)]
                     (store! (field response provider) "slow")
                     (store! (field response model) (load (field request model)))
                     (store! (field response response-id) "slow-response")
                     (store! (field response output-text) "too late")
                     (ModelOk (load response))))))

(defn execute-fake-tool [(self (ptr FakeTool))
                         (call (ptr ToolCall))
                         (allocator (ptr Allocator))] (-> ToolResult)
  (let [(mut result) (tool-result-empty (load (field call id)) (ToolSucceeded))]
    (store! (field result output) (load (field call arguments)))
    (load result)))

(impl ToolImplementation FakeTool
  (execute-tool [(self (ptr FakeTool))
                 (call (ptr ToolCall))
                 (context (ptr ToolExecutionContext))
                 (allocator (ptr Allocator))]
                (-> ToolResult)
                (execute-fake-tool self call allocator)))

(defn fake-definition [(allocator (ptr Allocator))] (-> ToolDefinition)
  (let [parsed
          (json-parse allocator
                      "{\"type\":\"object\",\"properties\":{},\"required\":[],\"additionalProperties\":false}")
        definition (alloc/stack ToolDefinition)
        implementation (box allocator FakeTool (zeroed FakeTool))]
    (store! (field (field definition spec) name) "fake")
    (store! (field (field definition spec) description) "fake")
    (store! (field (field definition spec) input-schema)
            (load (field parsed value)))
    (store! (field (field definition spec) strict) true)
    (store! (field (field definition spec) effect) (ReadOnly))
    (store! (field (field definition spec) idempotent) true)
    (store! (field (field definition spec) timeout-ms) 1000)
    (store! (field definition implementation) implementation)
    (load definition)))

(defn fake-call [(allocator (ptr Allocator)) (id (slice u8))] (-> ToolCall)
  (let [call (alloc/stack ToolCall)]
    (store! (field call id) id)
    (store! (field call name) "fake")
    (store! (field call arguments) (json-object allocator))
    (store! (field call raw-arguments) "{}")
    (load call)))

(defn fake-provider-execute [(state (ptr FakeProviderState))
                             (request (ptr ModelRequest))
                             (emitter (ptr EventEmitter))
                             (allocator (ptr Allocator))] (-> ModelResult)
  (let [call-number (+ (atomic-add (load (field state calls)) 1) 1)
        (mut response) (response-empty allocator)]
    (if (= call-number 1)
        (store! (field state first-operation-id)
                (load (field request operation-id)))
        (store! (field state second-operation-id)
                (load (field request operation-id))))
    (store! (field response provider) "fake")
    (store! (field response model) "fake-model")
    (if (= call-number 1)
        (do
          (store! (field response response-id) "first-response")
          ;; Both values are turn-owned and must be promoted before the provider
          ;; scratch region closes.
          (store! (field response raw-output)
                  (JsonString (json-copy-string allocator "opaque-provider-state")))
          (al-push! [ToolCall]
                    (mut (field response tool-calls))
                    (fake-call allocator "call-a"))
          (al-push! [ToolCall]
                    (mut (field response tool-calls))
                    (fake-call allocator "call-b")))
        (do
          (when (and (load (field (field request continuation) present))
                     (= (al-len [ToolResult]
                                (load (load (field (field request continuation)
                                                   tool-results))))
                        2))
            (atomic-store (load (field state observed-continuation)) 1)
            0)
          (store! (field response response-id) "final-response")
          (store! (field response output-text)
                  (json-copy-string allocator "done"))))
    (ModelOk (load response))))

(impl ModelProvider FakeProviderState
  (provider-name [(self (ptr FakeProviderState))] (-> (slice u8)) "fake")
  (provider-capabilities [(self (ptr FakeProviderState))]
                         (-> ProviderCapabilities)
                         (provider-capabilities-for "fake"))

  (execute-model [(self (ptr FakeProviderState))
                  (request (ptr ModelRequest))
                  (emitter (ptr EventEmitter))
                  (allocator (ptr Allocator))]
                 (-> ModelResult)
                 (fake-provider-execute self request emitter allocator)))

(defstruct CountingEventSink [(count (ptr i64))])

(defstruct TerminalEventSink
  [(count (ptr i64))
   (terminal-count (ptr i64))])

(impl EventSink CountingEventSink
  (publish-event [(self (ptr CountingEventSink)) (event (ptr Event))]
                 (-> i64)
                 (atomic-add (load (field self count)) 1)))

(impl EventSink TerminalEventSink
  (publish-event [(self (ptr TerminalEventSink)) (event (ptr Event))]
                 (-> i64)
                 (do
                   (atomic-add (load (field self count)) 1)
                   (match-else (load (field event kind))
                               (RunCompleted []
                                             (atomic-add (load (field self terminal-count)) 1))
                               (RunFailed []
                                          (atomic-add (load (field self terminal-count)) 1))
                               (RunCancelled []
                                             (atomic-add (load (field self terminal-count)) 1))
                               (_ 0))
                   0)))

(deftest successful-notification-registration-short-circuits-model-continuation
         (let [allocator (malloc-allocator)
               (mut calls) (al-new [ToolCall] allocator)
               (mut results) (al-new [ToolResult] allocator)
               call (alloc/stack ToolCall)
               (mut arguments) (json-object allocator)
               (mut result) (tool-result-empty "spawn-call" (ToolSucceeded))]
           (json-object-put! (mut arguments) "notify_parent" (JsonBool false))
           (store! (field call id) "spawn-call")
           (store! (field call name) "notify_async")
           (store! (field call arguments) (load arguments))
           (store! (field call raw-arguments) "")
           (al-push! [ToolCall] (mut calls) (load call))
           (al-push! [ToolResult] (mut results) (load result))
           (assert (async-delegation-batch? (mut calls) (mut results)))
           (let [stored-call (al-elem [ToolCall] (mut calls) 0)
                 (mut waiting) (load (field stored-call arguments))]
             (json-object-put! (mut waiting) "notify_parent" (JsonBool true))
             (store! (field stored-call arguments) (load waiting)))
           (assert (async-delegation-batch? (mut calls) (mut results)))
           (store! (field (al-elem [ToolResult] (mut results) 0) status) (ToolErrored))
           (assert (not (async-delegation-batch? (mut calls) (mut results))))))

(deftest unlimited-background-run-executes-tools-and-continues-the-model
         (let [allocator (malloc-allocator)
               calls (box allocator i64 0)
               observed (box allocator i64 0)
               events (box allocator i64 0)
               terminals (box allocator i64 0)
               sequence (box allocator i64 1)
               state (box allocator FakeProviderState (zeroed FakeProviderState))
               registry (box allocator ToolRegistry (tool-registry-new allocator))
               messages (box allocator (ArrayList Message) (al-new [Message] allocator))
               request (box allocator ModelRequest (zeroed ModelRequest))
               sink (alloc/stack TerminalEventSink)
               emitter (box allocator EventEmitter (zeroed EventEmitter))
               policy (alloc/stack AgentRunPolicy)]
           (store! (field state calls) calls)
           (store! (field state observed-continuation) observed)
           (tool-register! registry (fake-definition allocator))
           (store! (field request run-id) "runner-test")
           (store! (field request operation-id) "model")
           (store! (field request model) "fake-model")
           (store! (field request instructions) "")
           (store! (field request messages) messages)
           (store! (field request tools) registry)
           (store! (field request tool-choice) (ToolsAuto))
           (store! (field request parallel-tool-calls) true)
           (store! (field request reasoning) (ReasoningNone))
           (store! (field request timeout-ms) 1000)
           (store! (field sink count) events)
           (store! (field sink terminal-count) terminals)
           (store! (field emitter sink) (box allocator (dyn EventSink) sink))
           (store! (field emitter next-sequence) sequence)
           ;; Zero is the production default: continue until the model finishes.
           (store! (field policy max-model-turns) 0)
           (store! (field policy max-parallel-tools) 2)
           (let [(mut handle)
                   (run-agent-background allocator
                                         state
                                         request
                                         emitter
                                         (load policy))
                 result (agent-run-join (mut handle))]
             (assert (agent-run-finished? (mut handle)))
             (assert-eq (atomic-load calls) 2)
             (assert-eq (atomic-load observed) 1)
             (assert (str-eq (load (field state first-operation-id))
                             "model:model:1"))
             (assert (str-eq (load (field state second-operation-id))
                             "model:model:2"))
             ;; run.started, proposed/started/completed for each of the two tool
             ;; calls, and run.completed. No authorization step.
             (assert-eq (atomic-load events) 8)
             (assert-eq (atomic-load terminals) 1)
             (assert (match result
                       (ModelOk [response]
                                (let [final response]
                                  (str-eq (load (field final output-text)) "done")))
                       (ModelErr [failure] false))))))

(deftest background-run-cancellation-wins-over-a-late-model-response
         (let [allocator (malloc-allocator)
               provider (box allocator SlowProvider (zeroed SlowProvider))
               request (box allocator ModelRequest (zeroed ModelRequest))
               events (box allocator i64 0)
               terminals (box allocator i64 0)
               sequence (box allocator i64 1)
               sink (alloc/stack TerminalEventSink)
               emitter (box allocator EventEmitter (zeroed EventEmitter))
               policy (alloc/stack AgentRunPolicy)]
           (store! (field provider delay-ms) 30)
           (store! (field request run-id) "cancel-test")
           (store! (field request operation-id) "model")
           (store! (field request model) "slow-model")
           (store! (field request timeout-ms) 1000)
           (store! (field sink count) events)
           (store! (field sink terminal-count) terminals)
           (store! emitter (event-emitter-new allocator sink sequence))
           (store! (field policy max-model-turns) 1)
           (store! (field policy max-parallel-tools) 1)
           (let [(mut handle)
                   (run-agent-background allocator
                                         provider
                                         request
                                         emitter
                                         (load policy))]
             (sleep-ms 5)
             (agent-run-cancel! handle)
             (let [result (agent-run-join (mut handle))]
               (assert (match result
                         (ModelOk [response] false)
                         (ModelErr [failure]
                                   (let [failed failure]
                                     (match-else (load (field failed kind))
                                                 (CancelledFailure [] true)
                                                 (_ false))))))
               (assert-eq (atomic-load events) 2)
               (assert-eq (atomic-load terminals) 1)))))

(deftest run-deadline-wins-over-a-late-model-response
         (let [allocator (malloc-allocator)
               provider (box allocator SlowProvider (zeroed SlowProvider))
               request (box allocator ModelRequest (zeroed ModelRequest))
               events (box allocator i64 0)
               terminals (box allocator i64 0)
               sequence (box allocator i64 1)
               sink (alloc/stack TerminalEventSink)
               emitter (box allocator EventEmitter (zeroed EventEmitter))
               policy (alloc/stack AgentRunPolicy)]
           (store! (field provider delay-ms) 20)
           (store! (field request run-id) "deadline-test")
           (store! (field request operation-id) "model")
           (store! (field request model) "slow-model")
           ;; A deadline has to be asked for now, so the test asks for one --
           ;; the runner will not conjure a run budget out of `timeout-ms`.
           (store! (field request timeout-ms) 5)
           (store! (field request deadline-monotonic-ms) (deadline-from-timeout 5))
           (store! (field sink count) events)
           (store! (field sink terminal-count) terminals)
           (store! emitter (event-emitter-new allocator sink sequence))
           (store! (field policy max-model-turns) 1)
           (store! (field policy max-parallel-tools) 1)
           (let [result
                   (run-agent allocator
                              provider
                              request
                              emitter
                              (load policy))]
             (assert (match result
                       (ModelOk [response] false)
                       (ModelErr [failure]
                                 (let [failed failure]
                                   (match-else (load (field failed kind))
                                               (TimeoutFailure [] true)
                                               (_ false))))))
             (assert-eq (atomic-load events) 2)
             (assert-eq (atomic-load terminals) 1))))
