(module harness-shutdown-signal-test)

(import "coil.alloc" :as alloc :use *)
(import "coil.match" :use *)
(import "coil.thread" :use *)
(import "harness-http-listener" :use *)
(import "harness-shutdown-signal" :use *)
(import "harness-system" :use *)

(extern raise :cc c [i32] (-> i32))

(defstruct ListenerWaitJob
  [(allocator (ptr Allocator))
   (listener (ptr HttpListener))
   (shutdown (ptr ShutdownSignal))
   (result (ptr i64))])

(defn listener-wait-worker [(opaque (ptr i8))] (-> (ptr i8))
  (let [job (cast (ptr ListenerWaitJob) opaque)
        (mut done) false]
    (loop (if (load done)
              (break)
              (if (shutdown-signal-requested? (load (field job shutdown)))
                  (set! done true)
                  (shutdown-signal-wait-listener (load (field job shutdown))
                                                 (load (field job allocator))
                                                 (.fd (load (field job listener)))
                                                 25))))
    (set! (load (field job result)) 0)
    (cast (ptr i8) 0)))

(deftest wakes-a-bounded-listener-loop-for-graceful-shutdown
         (let [allocator (malloc-allocator)
               listener (alloc/stack HttpListener)
               shutdown (alloc/stack ShutdownSignal)
               result (alloc/stack i64)
               job (alloc/stack ListenerWaitJob)
               worker (alloc/stack Thread)]
           (match (http-listener-open allocator 0)
             (ListenerOpenFailed [message] (assert false))
             (ListenerOpened [opened] (store! listener opened)))
           (store! shutdown (shutdown-signal-new))
           (assert (shutdown-signal-valid? shutdown))
           (store! result -1)
           (store! (field job allocator) allocator)
           (store! (field job listener) listener)
           (store! (field job shutdown) shutdown)
           (store! (field job result) result)
           (assert-eq (cast i64
                            (thread-spawn worker
                                          (fnptr-of listener-wait-worker)
                                          (cast (ptr i8) job)))
                      0)
           (sleep-ms 20)
           (shutdown-signal-request! shutdown)
           (thread-join worker)
           (assert-eq (load result) 0)
           (shutdown-signal-close! shutdown)
           (http-listener-close! listener)))

(deftest installed-sigterm-wakes-the-shutdown-pipe
         (let [shutdown (alloc/stack ShutdownSignal)]
           (store! shutdown (shutdown-signal-new))
           (assert (shutdown-signal-valid? shutdown))
           (assert-eq (shutdown-signal-install! shutdown) 0)
           (assert-eq (cast i64 (raise 15)) 0)
           (let [(mut attempt) 0]
             (loop (if (or (shutdown-signal-requested? shutdown)
                           (>= (load attempt) 100))
                       (break)
                       (do
                         (sleep-ms 1)
                         (store! attempt (+ (load attempt) 1))))))
           (assert (shutdown-signal-requested? shutdown))
           (shutdown-signal-close! shutdown)))
