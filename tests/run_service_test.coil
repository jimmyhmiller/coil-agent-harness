(module harness-run-service-test)

(import "coil.alloc" :as alloc :use *)
(import "coil.arraylist" :use *)
(import "coil.fs" :as fs)
(import "coil.match" :use *)
(import "coil.str" :use *)
(import "harness-event" :use *)
(import "harness-event-journal" :use *)
(import "harness-json" :use *)
(import "harness-run-service" :use *)
(import "provider-common" :use *)

(defstruct FakeRunController [(starts i64) (cancels i64)])

(impl RunController FakeRunController
  (prepare-durable-provider [(self (ptr FakeRunController)) (provider-name (slice u8))] (-> i64) 0)
  (start-durable-run [(self (ptr FakeRunController)) (command (ptr Json))]
                     (-> i64)
                     (do
                       (store! (field self starts) (+ (load (field self starts)) 1))
                       0))
  (request-cancel-durable-run [(self (ptr FakeRunController)) (command (ptr Json))]
                              (-> i64)
                              0)
  (cancel-durable-run [(self (ptr FakeRunController)) (command (ptr Json))]
                      (-> RunCancellationResult)
                      (do
                        (store! (field self cancels) (+ (load (field self cancels)) 1))
                        (RunCancellationAccepted))))

(defn service-command [(allocator (ptr Allocator))
                       (command-id (slice u8))] (-> Json)
  (let [(mut command) (json-object allocator)]
    (json-object-put! (mut command) "version" (json-integer allocator 1))
    (json-put-string! (mut command) "command_id" command-id)
    (json-put-string! (mut command) "run_id" "run-1")
    (json-put-string! (mut command) "provider" "fake")
    (json-put-string! (mut command) "model" "fake-model")
    (json-put-string! (mut command) "prompt" "hello")
    (load command)))

(defn run-command [(allocator (ptr Allocator))
                   (command-id (slice u8))
                   (run-id (slice u8))] (-> Json)
  (let [(mut command) (service-command allocator command-id)]
    (json-put-string! (mut command) "run_id" run-id)
    (load command)))

(defn http-service-call-as [(service (ptr RunService))
                            (method (slice u8))
                            (target (slice u8))
                            (body (slice u8))
                            (principal (slice u8))
                            (can-observe bool)
                            (can-control bool)] (-> ServiceResponse)
  (let [request (alloc/stack ServiceHttpRequest)]
    (store! (field request method) method)
    (store! (field request target) target)
    (store! (field request body) body)
    (store! (field request principal) principal)
    (store! (field request can-observe) can-observe)
    (store! (field request can-control) can-control)
    (service-handle-http service request)))

(defn http-service-call [(service (ptr RunService))
                         (method (slice u8))
                         (target (slice u8))
                         (body (slice u8))] (-> ServiceResponse)
  (http-service-call-as service method target body "test-operator" true true))

(deftest subagents-have-private-clean-slate-conversations
         (let [allocator (malloc-allocator)
               path "/tmp/coil-agent-harness-private-subagent-conversations.jsonl"
               journal (alloc/stack EventJournal)
               sequence (box allocator i64 1)
               emitter (alloc/stack EventEmitter)
               controller (alloc/stack FakeRunController)
               service (alloc/stack RunService)]
           (fs/write-file allocator path "")
           (match (event-journal-open allocator path true)
             (JournalOpenFailed [message] (assert false))
             (JournalOpened [opened] (store! journal opened)))
           (store! emitter (event-emitter-new allocator journal sequence))
           (store! (field controller starts) 0)
           (store! (field controller cancels) 0)
           (store! (field service allocator) allocator)
           (store! (field service journal-path) path)
           (store! (field service journal) journal)
           (store! (field service emitter) emitter)
           (store! (field service controller) controller)
           (let [(mut parent) (run-command allocator "parent-create" "parent")]
             (json-put-string! (mut parent) "conversation_id" "parent-conversation")
             (json-put-string! (mut parent) "prompt" "Use three subagents")
             (let [response (service-submit-run service (mut parent) "test")]
               (assert-eq (load (field response status)) 202)))
           (let [(mut child-a) (run-command allocator "child-a-create" "child-a")
                 (mut child-b) (run-command allocator "child-b-create" "child-b")]
             (json-put-string! (mut child-a) "parent_run_id" "parent")
             (json-put-string! (mut child-a) "prompt" "Write poem A")
             (json-put-string! (mut child-b) "parent_run_id" "parent")
             (json-put-string! (mut child-b) "prompt" "Write poem B")
             (let [response-a (service-submit-run service (mut child-a) "agent:parent")
                   response-b (service-submit-run service (mut child-b) "agent:parent")]
               (assert-eq (load (field response-a status)) 202)
               (assert-eq (load (field response-b status)) 202)))
           (let [(mut grandchild) (run-command allocator "grandchild-create" "grandchild")]
             (json-put-string! (mut grandchild) "parent_run_id" "child-a")
             (json-put-string! (mut grandchild) "prompt" "Write one line")
             (let [response (service-submit-run service (mut grandchild) "agent:child-a")]
               (assert-eq (load (field response status)) 202)))
           (let [recovery (event-journal-recover allocator path)
                 events (field recovery events)
                 (mut child-a-payload) (JsonNull)
                 (mut child-b-payload) (JsonNull)
                 (mut grandchild-payload) (JsonNull)
                 (mut i) 0]
             (loop (if (>= (load i) (al-len [Json] (load events)))
                       (break)
                       (let [event (al-get [Json] (load events) (load i))]
                         (when (str-eq (command-string event "event") "run.created")
                           (cond (str-eq (command-string event "run_id") "child-a")
                                   (store! child-a-payload (json-get event "payload"))
                                 (str-eq (command-string event "run_id") "child-b")
                                   (store! child-b-payload (json-get event "payload"))
                                 (str-eq (command-string event "run_id") "grandchild")
                                   (store! grandchild-payload (json-get event "payload"))
                                 :else 0)
                           0)
                         (store! i (+ (load i) 1)))))
             (assert (str-eq (command-string (load child-a-payload) "conversation_id")
                             "agent:child-a"))
             (assert (str-eq (command-string (load child-b-payload) "conversation_id")
                             "agent:child-b"))
             (assert (str-eq (command-string (load grandchild-payload) "conversation_id")
                             "agent:grandchild"))
             (assert (str-eq (command-string (load grandchild-payload)
                                             "parent_conversation_id")
                             "agent:child-a"))
             (assert-eq (json-array-length (json-get (load child-a-payload) "messages")) 1)
             (assert-eq (json-array-length (json-get (load child-b-payload) "messages")) 1)
             (assert-eq (json-array-length (json-get (load grandchild-payload) "messages")) 1)
             (assert (str-eq (command-string (json-array-get (json-get (load grandchild-payload) "messages") 0)
                                             "content")
                             "Write one line")))
           (event-journal-close! journal)))

(deftest worker-claims-and-completes-a-durable-run-without-local-execution
         (let [allocator (malloc-allocator)
               path "/tmp/coil-agent-harness-worker-service.jsonl"
               journal (alloc/stack EventJournal)
               sequence (box allocator i64 1)
               emitter (alloc/stack EventEmitter)
               controller (alloc/stack FakeRunController)
               service (alloc/stack RunService)]
           (fs/write-file allocator path "")
           (match (event-journal-open allocator path true)
             (JournalOpenFailed [message] (assert false))
             (JournalOpened [opened] (store! journal opened)))
           (store! emitter (event-emitter-new allocator journal sequence))
           (store! (field controller starts) 0)
           (store! (field controller cancels) 0)
           (store! (field service allocator) allocator)
           (store! (field service journal-path) path)
           (store! (field service journal) journal)
           (store! (field service emitter) emitter)
           (store! (field service controller) controller)
           (let [created
                   (http-service-call service
                                      "POST"
                                      "/v1/runs"
                                      "{\"version\":1,\"command_id\":\"remote-create\",\"run_id\":\"remote-worker-run\",\"provider\":\"fake\",\"model\":\"fake-model\",\"prompt\":\"hello\",\"execution_target\":\"worker\"}")
                 registered
                   (http-service-call service
                                      "POST"
                                      "/v1/workers/register"
                                      "{\"version\":1,\"worker_id\":\"worker-1\",\"capabilities\":{\"agent_process\":true}}")
                 claimed
                   (http-service-call service
                                      "POST"
                                      "/v1/workers/claim"
                                      "{\"version\":1,\"command_id\":\"lease-1\",\"worker_id\":\"worker-1\",\"lease_ms\":30000}")
                 replayed-claim
                   (http-service-call service
                                      "POST"
                                      "/v1/workers/claim"
                                      "{\"version\":1,\"command_id\":\"lease-1\",\"worker_id\":\"worker-1\",\"lease_ms\":30000}")
                 second-claim
                   (http-service-call service
                                      "POST"
                                      "/v1/workers/claim"
                                      "{\"version\":1,\"command_id\":\"lease-2\",\"worker_id\":\"worker-2\",\"lease_ms\":30000}")]
             (assert-eq (load (field created status)) 202)
             (assert-eq (load (field registered status)) 200)
             (assert-eq (load (field controller starts)) 0)
             (assert (str-eq (command-string (load (field claimed body)) "status") "claimed"))
             (assert (str-eq (command-string (load (field claimed body)) "run_id") "remote-worker-run"))
             (assert (str-eq (command-string (load (field replayed-claim body)) "lease_id") "lease-1"))
             (assert (str-eq (command-string (load (field replayed-claim body)) "run_id") "remote-worker-run"))
             (assert (str-eq (command-string (json-get (load (field claimed body)) "assignment") "prompt") "hello"))
             (assert-eq (load (field second-claim status)) 409))
           (let [heartbeat
                   (http-service-call service
                                      "POST"
                                      "/v1/workers/heartbeat"
                                      "{\"version\":1,\"command_id\":\"heartbeat-1\",\"run_id\":\"remote-worker-run\",\"worker_id\":\"worker-1\",\"lease_id\":\"lease-1\",\"lease_ms\":30000}")
                 progress
                   (http-service-call service
                                      "POST"
                                      "/v1/workers/progress"
                                      "{\"version\":1,\"command_id\":\"progress-1\",\"run_id\":\"remote-worker-run\",\"worker_id\":\"worker-1\",\"lease_id\":\"lease-1\",\"event\":{\"event\":\"model.response.delta\",\"text\":\"hello\"}}")
                 rejected
                   (http-service-call service
                                      "POST"
                                      "/v1/workers/complete"
                                      "{\"version\":1,\"run_id\":\"remote-worker-run\",\"worker_id\":\"worker-2\",\"lease_id\":\"lease-1\",\"outcome\":\"succeeded\"}")
                 completed
                   (http-service-call service
                                      "POST"
                                      "/v1/workers/complete"
                                      "{\"version\":1,\"run_id\":\"remote-worker-run\",\"worker_id\":\"worker-1\",\"lease_id\":\"lease-1\",\"outcome\":\"succeeded\",\"output\":\"done\"}")]
             (assert (str-eq (command-string (load (field heartbeat body)) "status") "renewed"))
             (assert-eq (load (field progress status)) 202)
             (assert-eq (load (field rejected status)) 409)
             (assert-eq (load (field completed status)) 200)
             (assert (str-eq (command-string (load (field completed body)) "status") "succeeded")))
           (event-journal-close! journal)))

(deftest persists-idempotent-create-cancel-and-cursor-queries
         (let [allocator (malloc-allocator)
               path "/tmp/coil-agent-harness-run-service.jsonl"
               journal (alloc/stack EventJournal)
               sequence (box allocator i64 1)
               emitter (alloc/stack EventEmitter)
               controller (alloc/stack FakeRunController)
               service (alloc/stack RunService)]
           (fs/write-file allocator path "")
           (match (event-journal-open allocator path true)
             (JournalOpenFailed [message] (assert false))
             (JournalOpened [opened] (store! journal opened)))
           (store! emitter (event-emitter-new allocator journal sequence))
           (store! (field controller starts) 0)
           (store! (field controller cancels) 0)
           (store! (field service allocator) allocator)
           (store! (field service journal-path) path)
           (store! (field service journal) journal)
           (store! (field service emitter) emitter)
           (store! (field service controller) controller)
           (let [created
                   (http-service-call service
                                      "POST"
                                      "/v1/runs"
                                      "{\"version\":1,\"command_id\":\"create-1\",\"run_id\":\"run-1\",\"conversation_id\":\"root-conversation\",\"provider\":\"fake\",\"model\":\"fake-model\",\"prompt\":\"hello\",\"actor\":\"spoofed-client\"}")
                 duplicate
                   (http-service-call service
                                      "POST"
                                      "/v1/runs"
                                      "{\"version\":1,\"command_id\":\"create-1\",\"run_id\":\"run-1\",\"provider\":\"fake\",\"model\":\"fake-model\",\"prompt\":\"hello\"}")
                 conflicting
                   (http-service-call service
                                      "POST"
                                      "/v1/runs"
                                      "{\"version\":1,\"command_id\":\"create-2\",\"run_id\":\"run-1\",\"provider\":\"fake\",\"model\":\"fake-model\",\"prompt\":\"different\"}")
                 queried (http-service-call service "GET" "/v1/runs/run-1" "")]
             (assert-eq (load (field created status)) 202)
             (assert-eq (load (field duplicate status)) 200)
             (assert-eq (load (field conflicting status)) 409)
             (assert-eq (load (field queried status)) 200)
             (assert-eq (load (field controller starts)) 1)
             (assert (match (json-string-at (load (field queried body)) "status")
                       (Some [value] (str-eq value "queued"))
                       (None [] false))))
           (let [observed
                   (http-service-call-as service
                                         "GET"
                                         "/v1/runs/run-1"
                                         ""
                                         "test-observer"
                                         true
                                         false)
                 forbidden
                   (http-service-call-as service
                                         "POST"
                                         "/v1/runs"
                                         "{\"version\":1,\"command_id\":\"observer-create\",\"run_id\":\"observer-run\",\"provider\":\"fake\",\"model\":\"fake-model\",\"prompt\":\"hello\"}"
                                         "test-observer"
                                         true
                                         false)]
             (assert-eq (load (field observed status)) 200)
             (assert-eq (load (field forbidden status)) 403)
             (assert-eq (load (field controller starts)) 1))
           (let [recovery (event-journal-recover allocator path)
                 created-event (al-get [Json] (load (field recovery events)) 0)
                 payload (json-get created-event "payload")]
             (assert (str-eq (command-string payload "actor") "test-operator")))
           (let [events
                   (http-service-call service
                                      "GET"
                                      "/v1/runs/run-1/events?after=0"
                                      "")]
             (assert-eq (json-array-length (json-get (load (field events body)) "events")) 2))
           (let [cancelled
                   (service-cancel-run service
                                       (service-command allocator "cancel-1"))
                 duplicate-cancel
                   (service-cancel-run service
                                       (service-command allocator "cancel-1"))
                 after-create (service-query-events service "run-1" 1)]
             (assert-eq (load (field cancelled status)) 202)
             (assert-eq (load (field duplicate-cancel status)) 202)
             (assert-eq (load (field controller cancels)) 2)
             (assert-eq (json-array-length (json-get (load (field after-create body)) "events"))
                        1)
             (assert (match (json-string-at (load (field cancelled body)) "status")
                       (Some [value] (str-eq value "queued"))
                       (None [] false))))
           (let [automatic
                   (http-service-call service
                                      "POST"
                                      "/v1/runs"
                                      "{\"version\":1,\"command_id\":\"auto-create\",\"run_id\":\"auto-run\",\"provider\":\"auto\",\"model\":\"auto\",\"routing_profile\":\"low-cost\",\"requires_harness_tools\":true,\"prompt\":\"hello\"}")]
             (assert-eq (load (field automatic status)) 202)
             (assert-eq (load (field controller starts)) 2))
           (let [recovery (event-journal-recover allocator path)
                 routed-event (al-get [Json] (load (field recovery events)) 2)
                 payload (json-get routed-event "payload")
                 routing (json-get payload "routing")]
             (assert (str-eq (command-string payload "provider") "deepseek-openai"))
             (assert (str-eq (command-string payload "model") "deepseek-v4-flash"))
             (assert (str-eq (command-string routing "policy") "low-cost")))
           (let [delegated
                   (http-service-call service
                                      "POST"
                                      "/v1/runs"
                                      "{\"version\":1,\"command_id\":\"delegate-create\",\"run_id\":\"child-agent\",\"parent_run_id\":\"run-1\",\"parent_agent_id\":\"spoofed-parent\",\"prompt\":\"research this\"}")
                 missing-parent
                   (http-service-call service
                                      "POST"
                                      "/v1/runs"
                                      "{\"version\":1,\"command_id\":\"missing-parent\",\"run_id\":\"orphan-agent\",\"parent_run_id\":\"missing\",\"provider\":\"fake\",\"model\":\"fake-model\",\"prompt\":\"research this\"}")]
             (assert-eq (load (field delegated status)) 202)
             (assert-eq (load (field missing-parent status)) 404)
             (assert-eq (load (field controller starts)) 3))
           (let [recovery (event-journal-recover allocator path)
                 delegated-event (al-get [Json] (load (field recovery events)) 5)
                 created-agent-event (al-get [Json] (load (field recovery events)) 6)
                 payload (json-get delegated-event "payload")
                 message (json-get payload "message")]
             (assert (str-eq (command-string delegated-event "event") "agent.delegated"))
             (assert (str-eq (command-string delegated-event "run_id") "run-1"))
             (assert (str-eq (command-string delegated-event "agent_id") "run-1"))
             (assert (str-eq (command-string payload "parent_agent_id") "run-1"))
             (assert (str-eq (command-string payload "provider") "fake"))
             (assert (str-eq (command-string payload "model") "fake-model"))
             (assert (str-eq (command-string payload "conversation_id")
                             "agent:child-agent"))
             (assert (str-eq (command-string payload "parent_conversation_id")
                             "root-conversation"))
             ;; A new subagent is a clean slate: its request contains only the
             ;; delegation, never the parent's instruction or sibling history.
             (let [messages (json-get payload "messages")]
               (assert-eq (json-array-length messages) 1)
               (assert (str-eq (command-string (json-array-get messages 0) "content")
                               "research this")))
             (assert (str-eq (command-string message "kind") "delegation"))
             (assert (str-eq (command-string message "from") "run-1"))
             (assert (str-eq (command-string message "to") "child-agent"))
             (assert (str-eq (command-string message "content") "research this"))
             (assert (str-eq (command-string created-agent-event "event") "agent.created"))
             (assert (str-eq (command-string created-agent-event "agent_id") "child-agent")))
           (let [first-node
                   (http-service-call service
                                      "POST"
                                      "/v1/runs"
                                      "{\"version\":1,\"command_id\":\"workflow-first\",\"run_id\":\"workflow-run-1\",\"provider\":\"fake\",\"model\":\"fake-model\",\"prompt\":\"first\",\"workflow_id\":\"workflow-1\",\"workflow_version\":1,\"node_id\":\"first\",\"depends_on\":[]}")
                 second-node
                   (http-service-call service
                                      "POST"
                                      "/v1/runs"
                                      "{\"version\":1,\"command_id\":\"workflow-second\",\"run_id\":\"workflow-run-2\",\"provider\":\"fake\",\"model\":\"fake-model\",\"prompt\":\"second\",\"workflow_id\":\"workflow-1\",\"workflow_version\":1,\"node_id\":\"second\",\"depends_on\":[\"workflow-run-1\"]}")
                 missing-dependency
                   (http-service-call service
                                      "POST"
                                      "/v1/runs"
                                      "{\"version\":1,\"command_id\":\"workflow-invalid\",\"run_id\":\"workflow-run-3\",\"provider\":\"fake\",\"model\":\"fake-model\",\"prompt\":\"invalid\",\"workflow_id\":\"workflow-1\",\"workflow_version\":1,\"node_id\":\"third\",\"depends_on\":[\"missing-run\"]}")
                 graph (http-service-call service "GET" "/v1/workflows/workflow-1" "")]
             (assert-eq (load (field first-node status)) 202)
             (assert-eq (load (field second-node status)) 202)
             (assert-eq (load (field missing-dependency status)) 400)
             (assert-eq (load (field graph status)) 200)
             (assert-eq (json-array-length (json-get (load (field graph body)) "nodes")) 2)
             (assert-eq (load (field controller starts)) 5))
           (let [recovery (event-journal-recover allocator path)
                 (mut workflow-created) 0
                 (mut i) 0
                 n (al-len [Json] (load (field recovery events)))]
             (loop (if (>= (load i) n)
                       (break)
                       (let [event (al-get [Json] (load (field recovery events)) (load i))]
                         (when (str-eq (command-string event "event") "workflow.node.created")
                           (store! workflow-created (+ (load workflow-created) 1))
                           0)
                         (store! i (+ (load i) 1)))))
             (assert-eq (load workflow-created) 2))
           ;; Simulate a crash after the request audit record but before cancellation.
           ;; Retrying the command must resume the intervention instead of treating it
           ;; as complete.
           (let [(mut pending-intervention) (json-object allocator)]
             (json-object-put! (mut pending-intervention) "version" (json-integer allocator 1))
             (json-put-string! (mut pending-intervention) "command_id" "intervention-1")
             (json-put-string! (mut pending-intervention) "run_id" "workflow-run-1")
             (json-put-string! (mut pending-intervention) "action" "cancel")
             (emit-event emitter
                         0
                         (SupervisorInterventionRequested)
                         "workflow-run-1"
                         "intervention-1"
                         ""
                         "fake"
                         "fake-model"
                         (load pending-intervention)))
           (let [assessment
                   (http-service-call service
                                      "POST"
                                      "/v1/runs/workflow-run-1/assessments"
                                      "{\"version\":1,\"command_id\":\"assessment-1\",\"run_id\":\"workflow-run-1\",\"verdict\":\"needs_attention\",\"score\":42,\"rationale\":\"output should be reviewed\"}")
                 duplicate-assessment
                   (http-service-call service
                                      "POST"
                                      "/v1/runs/workflow-run-1/assessments"
                                      "{\"version\":1,\"command_id\":\"assessment-1\",\"run_id\":\"workflow-run-1\",\"verdict\":\"needs_attention\"}")
                 intervention
                   (http-service-call service
                                      "POST"
                                      "/v1/runs/workflow-run-1/interventions"
                                      "{\"version\":1,\"command_id\":\"intervention-1\",\"run_id\":\"workflow-run-1\",\"action\":\"cancel\",\"reason\":\"supervisor stopped the run\"}")]
             (assert-eq (load (field assessment status)) 202)
             (assert-eq (load (field duplicate-assessment status)) 200)
             (assert-eq (load (field intervention status)) 202)
             (assert-eq (load (field controller cancels)) 3))
           (let [events (service-query-events service "workflow-run-1" 0)
                 records (json-get (load (field events body)) "events")
                 (mut saw-assessment) false
                 (mut saw-intervention) false
                 (mut intervention-requests) 0
                 (mut i) 0
                 n (json-array-length records)]
             (loop (if (>= (load i) n)
                       (break)
                       (let [event (json-array-get records (load i))]
                         (when (str-eq (command-string event "event") "supervisor.assessment.recorded")
                           (store! saw-assessment true)
                           0)
                         (when (str-eq (command-string event "event") "supervisor.intervention.applied")
                           (store! saw-intervention true)
                           0)
                         (when (str-eq (command-string event "event") "supervisor.intervention.requested")
                           (store! intervention-requests (+ (load intervention-requests) 1))
                           0)
                         (store! i (+ (load i) 1)))))
             (assert (load saw-assessment))
             (assert (load saw-intervention))
             (assert-eq (load intervention-requests) 1))
           (event-journal-close! journal)))

(deftest http-boundary-rejects-invalid-json-and-run-id-mismatch
         (let [allocator (malloc-allocator)
               path "/tmp/coil-agent-harness-run-service-errors.jsonl"
               journal (alloc/stack EventJournal)
               sequence (box allocator i64 1)
               emitter (alloc/stack EventEmitter)
               controller (alloc/stack FakeRunController)
               service (alloc/stack RunService)]
           (fs/write-file allocator path "")
           (match (event-journal-open allocator path false)
             (JournalOpenFailed [message] (assert false))
             (JournalOpened [opened] (store! journal opened)))
           (store! emitter (event-emitter-new allocator journal sequence))
           (store! (field service allocator) allocator)
           (store! (field service journal-path) path)
           (store! (field service journal) journal)
           (store! (field service emitter) emitter)
           (store! (field service controller) controller)
           (let [invalid (http-service-call service "POST" "/v1/runs" "{")
                 dependency-without-workflow
                   (http-service-call service
                                      "POST"
                                      "/v1/runs"
                                      "{\"version\":1,\"command_id\":\"invalid-dependency\",\"run_id\":\"invalid-dependency\",\"provider\":\"fake\",\"model\":\"fake-model\",\"depends_on\":[\"other\"]}")
                 mismatch
                   (http-service-call service
                                      "POST"
                                      "/v1/runs/path-id/cancel"
                                      "{\"version\":1,\"command_id\":\"cancel\",\"run_id\":\"body-id\"}")]
             (assert-eq (load (field invalid status)) 400)
             (assert-eq (load (field dependency-without-workflow status)) 400)
             (assert-eq (load (field mismatch status)) 409))
           (event-journal-close! journal)))

(deftest restart-launches-only-queued-work-and-terminalizes-in-flight-work
         (let [allocator (malloc-allocator)
               path "/tmp/coil-agent-harness-run-service-restart.jsonl"
               journal (alloc/stack EventJournal)
               sequence (box allocator i64 1)
               emitter (alloc/stack EventEmitter)
               controller (alloc/stack FakeRunController)
               service (alloc/stack RunService)]
           (fs/write-file allocator path "")
           (match (event-journal-open allocator path true)
             (JournalOpenFailed [message] (assert false))
             (JournalOpened [opened] (store! journal opened)))
           (store! emitter (event-emitter-new allocator journal sequence))
           (store! (field controller starts) 0)
           (store! (field controller cancels) 0)
           (store! (field service allocator) allocator)
           (store! (field service journal-path) path)
           (store! (field service journal) journal)
           (store! (field service emitter) emitter)
           (store! (field service controller) controller)
           (emit-event emitter
                       1
                       (RunCreated)
                       "queued"
                       "queued"
                       ""
                       "fake"
                       "fake-model"
                       (run-command allocator "q" "queued"))
           (emit-event emitter
                       2
                       (RunCreated)
                       "running"
                       "running"
                       ""
                       "fake"
                       "fake-model"
                       (run-command allocator "r" "running"))
           (emit-event emitter
                       3
                       (RunStarted)
                       "running"
                       "running"
                       ""
                       "fake"
                       "fake-model"
                       (JsonNull))
           (emit-event emitter
                       4
                       (RunCreated)
                       "cancelling"
                       "cancelling"
                       ""
                       "fake"
                       "fake-model"
                       (run-command allocator "c" "cancelling"))
           (emit-event emitter
                       5
                       (RunCancellationRequested)
                       "cancelling"
                       "cancelling"
                       ""
                       "fake"
                       "fake-model"
                       (run-command allocator "cancel" "cancelling"))
           (assert-eq (service-recover-runs! service) 1)
           (assert-eq (load (field controller starts)) 1)
           (let [running (service-query-run service "running")
                 cancelling (service-query-run service "cancelling")]
             (assert (match (json-string-at (load (field running body)) "status")
                       (Some [value] (str-eq value "failed"))
                       (None [] false)))
             (assert (match (json-string-at (load (field cancelling body)) "status")
                       (Some [value] (str-eq value "cancelled"))
                       (None [] false))))
           (event-journal-close! journal)))
