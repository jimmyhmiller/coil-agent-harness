(module harness-factory-status-test)

(import "coil.primitive" :as primitive)

(import "coil.alloc" :as alloc :use *)
(import "coil.match" :use *)
(import "coil.slice" :use *)
(import "harness-factory-status" :use *)
(import "harness-json" :use *)
(import "harness-tool" :use *)
(import "provider-common" :use *)

(deftest worker-status-records-ready-and-not-ready-reports
         (let [allocator (malloc-allocator)
               status (box! allocator FactoryWorkerStatus (zeroed FactoryWorkerStatus))
               tool (primitive/alloc-stack FactoryStatusTool)
               call (primitive/alloc-stack ToolCall)
               (mut arguments) (json-object allocator)]
           (store! (field tool status) status)
           (json-put-bool! (mut arguments) "ready" true)
           (json-put-string! (mut arguments) "summary" "validated")
           (store! (field call id) "status-1")
           (store! (field call name) "report_worker_status")
           (store! (field call arguments) (load arguments))
           (let [result (execute-factory-status tool call allocator)]
             (assert (match (load (field result status)) (ToolSucceeded [] true) (_ false)))
             (assert (factory-worker-status-reported? status))
             (assert (factory-worker-status-ready? status)))
           (factory-worker-status-reset! status)
           (assert (not (factory-worker-status-reported? status)))
           (json-put-bool! (mut arguments) "ready" false)
           (store! (field call arguments) (load arguments))
           (execute-factory-status tool call allocator)
           (assert (factory-worker-status-reported? status))
           (assert (not (factory-worker-status-ready? status)))))

(deftest worker-status-tool-is-always-registerable
         (let [allocator (malloc-allocator)
               status (box! allocator FactoryWorkerStatus (zeroed FactoryWorkerStatus))
               (mut registry) (tool-registry-new allocator)]
           (assert (register-factory-status-tool! (mut registry) allocator status))
           (assert (match (tool-find (load registry) "report_worker_status") (Some [tool] true) (_ false)))))

;; What a worker says when it reports is the instruction for its next attempt, so
;; it has to survive the run allocator it was said in.
(deftest a-report-keeps-what-the-worker-said
         (let [allocator (malloc-allocator)
               status (box! allocator FactoryWorkerStatus (zeroed FactoryWorkerStatus))
               registry (box! allocator ToolRegistry (tool-registry-new allocator))
               call (primitive/alloc-stack ToolCall)
               (mut arguments) (json-object allocator)]
           (store! (field status allocator) allocator)
           (store! (field status has-allocator) true)
           (assert (register-factory-status-tool! registry allocator status))
           (json-object-put! (mut arguments) "ready" (JsonBool false))
           (json-put-string! (mut arguments) "summary" "one.txt is written; two.txt is missing")
           (json-put-string! (mut arguments) "evidence" "ls")
           (store! (field call id) "call-1")
           (store! (field call name) "report_worker_status")
           (store! (field call arguments) (load arguments))
           (store! (field call raw-arguments) "")
           (let [tool (box! allocator FactoryStatusTool (zeroed FactoryStatusTool))]
             (store! (field tool status) status)
             (execute-factory-status tool call allocator))
           (assert (factory-worker-status-reported? status))
           (assert (not (factory-worker-status-ready? status)))
           (assert-eq (factory-worker-status-summary status)
                      "one.txt is written; two.txt is missing")
           (assert-eq (factory-worker-status-evidence status) "ls")
           ;; Resetting for the next attempt forgets it, so one attempt's words
           ;; are never handed to the attempt after next.
           (factory-worker-status-reset! status)
           (assert-eq (slice-len [u8] (factory-worker-status-summary status)) 0)))
