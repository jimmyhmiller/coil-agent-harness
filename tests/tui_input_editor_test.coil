(module harness-tui-input-editor-test)

(import "coil.alloc" :use *)
(import "coil.match" :use *)
(import "coil.str" :use *)
(import "harness-tui-command" :use *)
(import "harness-tui-input-editor" :use *)

(deftest edits-at-utf8-boundaries-without-splitting-scalars
         (let [allocator (malloc-allocator)
               (mut editor) (input-editor-new allocator)]
           (input-editor-apply! (mut editor) (InputInsert "a界🙂b"))
           (input-editor-apply! (mut editor) (InputLeft))
           (input-editor-apply! (mut editor) (InputBackspace))
           (assert (= (input-editor-text (mut editor)) "a界b"))
           (assert (= (load (field editor cursor)) 4))
           (input-editor-apply! (mut editor) (InputHome))
           (input-editor-apply! (mut editor) (InputDelete))
           (assert (= (input-editor-text (mut editor)) "界b"))))

(deftest supports-multiline-submission-and-history-navigation
         (let [allocator (malloc-allocator)
               (mut editor) (input-editor-new allocator)]
           (input-editor-apply! (mut editor) (InputInsert "first"))
           (input-editor-apply! (mut editor) (InputNewline))
           (input-editor-apply! (mut editor) (InputInsert "second"))
           (match (input-editor-apply! (mut editor) (InputSubmit))
                  (InputSubmitted [text]
                                  (assert (= text "first\nsecond")))
                  (_ (assert false)))
           (assert (= (input-editor-text (mut editor)) ""))
           (input-editor-apply! (mut editor) (InputHistoryPrevious))
           (assert (= (input-editor-text (mut editor)) "first\nsecond"))
           (input-editor-apply! (mut editor) (InputHistoryNext))
           (assert (= (input-editor-text (mut editor)) ""))))

(deftest deletes-a-word-before-the-cursor
         (let [allocator (malloc-allocator)
               (mut editor) (input-editor-new allocator)]
           (input-editor-apply! (mut editor) (InputInsert "hello brave world"))
           (input-editor-apply! (mut editor) (InputDeleteWord))
           (assert (= (input-editor-text (mut editor)) "hello brave "))
           (input-editor-apply! (mut editor) (InputDeleteWord))
           (assert (= (input-editor-text (mut editor)) "hello "))))

(deftest completes-slash-commands-from-the-registry
         (let [allocator (malloc-allocator)
               (mut commands) (command-registry-builtin allocator)
               (mut editor) (input-editor-new-with-commands allocator (mut commands))]
           ;; One match: Tab extends all the way to the command.
           (input-editor-apply! (mut editor) (InputInsert "/gr"))
           (input-editor-apply! (mut editor) (InputComplete))
           (assert (= (input-editor-text (mut editor)) "/graph"))
           ;; Several matches that share nothing beyond what was typed: Tab takes
           ;; the highlighted row, which is the one the menu is already showing.
           (input-editor-clear! (mut editor))
           (input-editor-apply! (mut editor) (InputInsert "/c"))
           (assert (input-editor-menu-open? (mut editor)))
           (input-editor-apply! (mut editor) (InputComplete))
           (assert (= (input-editor-text (mut editor)) "/cancel"))))

(deftest an-editor-without-a-registry-never-completes
         (let [allocator (malloc-allocator)
               (mut editor) (input-editor-new allocator)]
           (input-editor-apply! (mut editor) (InputInsert "/gr"))
           (assert (not (input-editor-menu-open? (mut editor))))
           (assert (match (input-editor-apply! (mut editor) (InputComplete)) (InputUnchanged [] true) (_ false)))
           (assert (= (input-editor-text (mut editor)) "/gr"))))

(deftest the-menu-closes-once-an-argument-is-typed
         (let [allocator (malloc-allocator)
               (mut commands) (command-registry-builtin allocator)
               (mut editor) (input-editor-new-with-commands allocator (mut commands))]
           (input-editor-apply! (mut editor) (InputInsert "/model"))
           (assert (input-editor-menu-open? (mut editor)))
           (input-editor-apply! (mut editor) (InputInsert " codex"))
           (assert (not (input-editor-menu-open? (mut editor))))))

(deftest escape-dismisses-the-menu-and-typing-brings-it-back
         (let [allocator (malloc-allocator)
               (mut commands) (command-registry-builtin allocator)
               (mut editor) (input-editor-new-with-commands allocator (mut commands))]
           (input-editor-apply! (mut editor) (InputInsert "/c"))
           (assert (input-editor-menu-open? (mut editor)))
           (input-editor-apply! (mut editor) (InputDismiss))
           (assert (not (input-editor-menu-open? (mut editor))))
           ;; A dismissed menu must not stay dismissed forever, or the feature
           ;; silently disappears for the rest of the session.
           (input-editor-apply! (mut editor) (InputInsert "a"))
           (assert (input-editor-menu-open? (mut editor)))))

(deftest arrow-keys-drive-the-menu-instead-of-history-while-it-is-open
         (let [allocator (malloc-allocator)
               (mut commands) (command-registry-builtin allocator)
               (mut editor) (input-editor-new-with-commands allocator (mut commands))]
           (input-editor-apply! (mut editor) (InputInsert "history line"))
           (input-editor-apply! (mut editor) (InputSubmit))
           (input-editor-apply! (mut editor) (InputInsert "/c"))
           (input-editor-apply! (mut editor) (InputHistoryNext))
           ;; The buffer is untouched: the key moved the selection, not history.
           (assert (= (input-editor-text (mut editor)) "/c"))
           (assert (= (input-editor-menu-selected (mut editor)) 1))
           ;; Up from the top wraps to the bottom rather than sticking.
           (input-editor-apply! (mut editor) (InputHistoryPrevious))
           (input-editor-apply! (mut editor) (InputHistoryPrevious))
           (assert (= (input-editor-menu-selected (mut editor)) 2))
           (input-editor-apply! (mut editor) (InputHistoryNext))
           (input-editor-apply! (mut editor) (InputSubmit))
           (assert (= (input-editor-text (mut editor)) "/cancel"))))

(deftest kills-and-word-motions-operate-around-the-cursor
         (let [allocator (malloc-allocator)
               (mut editor) (input-editor-new allocator)]
           (input-editor-apply! (mut editor) (InputInsert "alpha beta gamma"))
           (input-editor-apply! (mut editor) (InputWordLeft))
           (input-editor-apply! (mut editor) (InputKillToEnd))
           (assert (= (input-editor-text (mut editor)) "alpha beta "))
           (input-editor-apply! (mut editor) (InputWordLeft))
           (input-editor-apply! (mut editor) (InputKillToStart))
           (assert (= (input-editor-text (mut editor)) "beta "))
           (input-editor-apply! (mut editor) (InputHome))
           (input-editor-apply! (mut editor) (InputDeleteWordForward))
           (assert (= (input-editor-text (mut editor)) " "))))

(deftest reverse-search-finds-history-and-escape-restores-the-line
         (let [allocator (malloc-allocator)
               (mut editor) (input-editor-new allocator)]
           (input-editor-apply! (mut editor) (InputInsert "build the parser"))
           (input-editor-apply! (mut editor) (InputSubmit))
           (input-editor-apply! (mut editor) (InputInsert "run the tests"))
           (input-editor-apply! (mut editor) (InputSubmit))
           (input-editor-apply! (mut editor) (InputInsert "draft"))
           (input-editor-apply! (mut editor) (InputReverseSearch))
           (assert (input-editor-search-active? (mut editor)))
           (input-editor-apply! (mut editor) (InputInsert "parser"))
           (assert (= (input-editor-text (mut editor)) "build the parser"))
           ;; Cancelling puts back exactly what was being typed before Ctrl-R.
           (input-editor-apply! (mut editor) (InputDismiss))
           (assert (not (input-editor-search-active? (mut editor))))
           (assert (= (input-editor-text (mut editor)) "draft"))))

(deftest a-failing-reverse-search-keeps-the-last-match
         (let [allocator (malloc-allocator)
               (mut editor) (input-editor-new allocator)]
           (input-editor-apply! (mut editor) (InputInsert "run the tests"))
           (input-editor-apply! (mut editor) (InputSubmit))
           (input-editor-apply! (mut editor) (InputReverseSearch))
           (input-editor-apply! (mut editor) (InputInsert "run"))
           (assert (= (input-editor-text (mut editor)) "run the tests"))
           (input-editor-apply! (mut editor) (InputInsert "zzz"))
           ;; No match for "runzzz" -- the buffer must not be cleared out from
           ;; under the user just because the next keystroke matched nothing.
           (assert (= (input-editor-text (mut editor)) "run the tests"))))
