;; The claim under test is a cost claim, not a correctness claim: unchanged rows
;; must produce NO terminal work. So these tests count the emitted operations
;; rather than inspecting a rendered string -- a planner that quietly repainted
;; everything would still look right on screen and would still be the bug.
(module harness-tui-diff-test)

(import "coil.primitive" :as primitive)

(import "coil.alloc" :as alloc :use *)
(import "coil.arraylist" :use *)
(import "coil.assert" :use *)
(import "coil.match" :use *)
(import "coil.slice" :use *)
(import "coil.str" :use *)
(import "harness-tui-frame" :use *)
(import "harness-tui-terminal-operation" :use *)
(import "harness-tui-diff" :use *)

(defn push-row! [(frame (ptr Frame)) (text (slice u8)) (role StyleRole)] (-> i64)
  (let [allocator (load (field frame allocator))
        (mut spans) (al-new [FrameSpan] allocator)]
    (al-push! [FrameSpan] (mut spans) (frame-span text (str-len text) role))
    (frame-push-spans! frame (load spans))))

(defn build-frame [(allocator (dyn Allocator))
                   (slot (ptr Frame))
                   (rows i64)
                   (changed-row i64)] (-> i64)
  (set! slot (frame-new allocator))
  (let [(mut i) 0]
    (loop (if (>= (load i) rows)
              (break)
              (do
                (push-row! slot
                           (if (= (load i) changed-row) "CHANGED" "steady row")
                           (RolePrimary))
                (set! i (+ (load i) 1))))))
  0)

(defn count-kind [(operations (ArrayList TerminalOperation))
                  (wanted i64)] (-> i64)
  (let [count (al-len [TerminalOperation] operations)
        (mut i) 0
        (mut found) 0]
    (loop (if (>= (load i) count)
              (break)
              (do
                (when (= (operation-index (al-get [TerminalOperation] operations (load i)))
                         wanted)
                  (store! found (+ (load found) 1)))
                (set! i (+ (load i) 1)))))
    (load found)))

(const OP_WRITE 0)
(const OP_ERASE 1)
(const OP_UP 2)
(const OP_DOWN 3)
(const OP_OTHER 4)

(defn operation-index [(operation TerminalOperation)] (-> i64)
  (match operation
         (TerminalWrite [_] OP_WRITE)
         (TerminalEraseLine [] OP_ERASE)
         (TerminalCursorUp [_] OP_UP)
         (TerminalCursorDown [_] OP_DOWN)
         (_ OP_OTHER)))

;; Net vertical movement must be zero: the planner is documented to leave the
;; cursor where it found it, on the last live row. If that drifts, the next
;; frame repaints the wrong rows.
(defn net-vertical [(operations (ArrayList TerminalOperation))] (-> i64)
  (let [count (al-len [TerminalOperation] operations)
        (mut i) 0
        (mut net) 0]
    (loop (if (>= (load i) count)
              (break)
              (do
                (match (al-get [TerminalOperation] operations (load i))
                       (TerminalCursorUp [rows] (set! net (- (load net) rows)))
                       (TerminalCursorDown [rows] (set! net (+ (load net) rows)))
                       (_ 0))
                (set! i (+ (load i) 1)))))
    (load net)))

(deftest an-unchanged-frame-costs-no-terminal-work
         (let [allocator (malloc-allocator)
               previous (primitive/alloc-stack Frame)
               next (primitive/alloc-stack Frame)
               (mut operations) (al-new [TerminalOperation] allocator)]
           (build-frame allocator previous 20 -1)
           (build-frame allocator next 20 -1)
           (assert (= (plan-live-diff! (mut operations) previous next) 0))
           (assert (= (count-kind (load operations) OP_ERASE) 0))
           (assert (= (count-kind (load operations) OP_WRITE) 0))
           (assert (= (net-vertical (load operations)) 0))))

;; The headline case: one row of twenty changed, so nineteen must be left alone.
(deftest only-the-changed-row-is-repainted
         (let [allocator (malloc-allocator)
               previous (primitive/alloc-stack Frame)
               next (primitive/alloc-stack Frame)
               (mut operations) (al-new [TerminalOperation] allocator)]
           (build-frame allocator previous 20 -1)
           (build-frame allocator next 20 7)
           (assert (= (plan-live-diff! (mut operations) previous next) 1))
           (assert (= (count-kind (load operations) OP_ERASE) 1))
           (assert (= (count-kind (load operations) OP_WRITE) 1))
           (assert (= (net-vertical (load operations)) 0))))

;; Same characters, different styling, is a different row -- repainting it as if
;; it matched would leave the wrong colour on screen.
(deftest a-style-only-change-still-repaints-the-row
         (let [allocator (malloc-allocator)
               previous (primitive/alloc-stack Frame)
               next (primitive/alloc-stack Frame)
               (mut operations) (al-new [TerminalOperation] allocator)]
           (store! previous (frame-new allocator))
           (store! next (frame-new allocator))
           (push-row! previous "same text" (RolePrimary))
           (push-row! next "same text" (RoleFailure))
           (assert (not (frame-same? previous next)))
           (assert (= (plan-live-diff! (mut operations) previous next) 1))
           (assert (= (count-kind (load operations) OP_ERASE) 1))))

(deftest every-changed-row-is-repainted
         (let [allocator (malloc-allocator)
               previous (primitive/alloc-stack Frame)
               next (primitive/alloc-stack Frame)
               (mut operations) (al-new [TerminalOperation] allocator)]
           (build-frame allocator previous 5 -1)
           (store! next (frame-new allocator))
           (let [(mut i) 0]
             (loop (if (>= (load i) 5)
                       (break)
                       (do
                         (push-row! next "all different" (RolePrimary))
                         (store! i (+ (load i) 1))))))
           (assert (= (plan-live-diff! (mut operations) previous next) 5))
           (assert (= (count-kind (load operations) OP_ERASE) 5))
           (assert (= (net-vertical (load operations)) 0))))

;; Committed output pushes the live region down the screen, so the old rows are
;; no longer where the diff would assume. That must decline to a full repaint.
(deftest a-frame-with-committed-output-is-not-diffable
         (let [allocator (malloc-allocator)
               committed (primitive/alloc-stack Frame)
               previous (primitive/alloc-stack Frame)
               next (primitive/alloc-stack Frame)]
           (store! committed (frame-new allocator))
           (build-frame allocator previous 3 -1)
           (build-frame allocator next 3 -1)
           (assert (diffable? committed previous next))
           (push-row! committed "a committed line" (RolePrimary))
           (assert (not (diffable? committed previous next)))))

;; A live region that grew or shrank needs rows reserved or erased, which is
;; repaint work regardless.
(deftest a-resized-live-region-is-not-diffable
         (let [allocator (malloc-allocator)
               committed (primitive/alloc-stack Frame)
               previous (primitive/alloc-stack Frame)
               next (primitive/alloc-stack Frame)]
           (store! committed (frame-new allocator))
           (build-frame allocator previous 3 -1)
           (build-frame allocator next 4 -1)
           (assert (not (diffable? committed previous next)))))

(deftest an-empty-live-region-plans-nothing
         (let [allocator (malloc-allocator)
               previous (primitive/alloc-stack Frame)
               next (primitive/alloc-stack Frame)
               (mut operations) (al-new [TerminalOperation] allocator)]
           (store! previous (frame-new allocator))
           (store! next (frame-new allocator))
           (assert (= (plan-live-diff! (mut operations) previous next) 0))
           (assert (= (al-len [TerminalOperation] (load operations)) 0))))
