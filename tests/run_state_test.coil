(module harness-run-state-test)

(import "coil.primitive" :as primitive)

(import "coil.alloc" :as alloc :use *)
(import "coil.arraylist" :use *)
(import "coil.match" :use *)
(import "coil.slice" :use *)
(import "coil.str" :use *)
(import "harness-json" :use *)
(import "harness-run-state" :use *)
(import "provider-common" :use *)

(defn state-event [(allocator (dyn Allocator))
                   (sequence i64)
                   (kind (slice u8))
                   (run-id (slice u8))
                   (command-id (slice u8))] (-> Json)
  (let [(mut event) (json-object allocator)
        (mut payload) (json-object allocator)]
    (json-object-put! (mut event) "version" (json-integer allocator 1))
    (json-object-put! (mut event) "sequence" (json-integer allocator sequence))
    (json-put-string! (mut event) "event" kind)
    (json-put-string! (mut event) "run_id" run-id)
    (json-put-string! (mut event) "provider" "fake")
    (json-put-string! (mut event) "model" "fake-model")
    (when (> (slice-len [u8] command-id) 0)
      (json-put-string! (mut payload) "command_id" command-id)
      0)
    (json-object-put! (mut event) "payload" (load payload))
    (load event)))

(deftest projects-terminal-and-interrupted-runs-after-restart
         (let [allocator (malloc-allocator)
               events (primitive/alloc-stack (ArrayList Json))]
           (store! events (al-new [Json] allocator))
           (al-push! [Json] (mut events) (state-event allocator 1 "run.created" "done" "create-1"))
           (al-push! [Json] (mut events) (state-event allocator 2 "run.started" "done" ""))
           (al-push! [Json] (mut events) (state-event allocator 3 "run.completed" "done" ""))
           (al-push! [Json] (mut events) (state-event allocator 4 "run.created" "lost" "create-2"))
           (al-push! [Json] (mut events) (state-event allocator 5 "run.started" "lost" ""))
           (let [done (project-run events "done")
                 lost (project-run-after-restart events "lost")]
             (assert (load (field done valid)))
             (assert (load (field done terminal)))
             (assert (match (load (field done status)) (RunSucceeded [] true) (_ false)))
             (assert (load (field lost valid)))
             (assert (not (load (field lost terminal))))
             (assert (match (load (field lost status)) (RunInterrupted [] true) (_ false)))
             (assert-eq (journal-command-sequence events "create-1") 1)
             (assert-eq (journal-command-sequence events "missing") 0))))

(deftest rejects-invalid-durable-run-transitions
         (let [allocator (malloc-allocator)
               events (primitive/alloc-stack (ArrayList Json))]
           (store! events (al-new [Json] allocator))
           (al-push! [Json] (mut events) (state-event allocator 1 "run.created" "run-1" ""))
           (al-push! [Json] (mut events) (state-event allocator 2 "run.completed" "run-1" ""))
           (let [view (project-run events "run-1")]
             (assert (not (load (field view valid))))
             (assert (= (load (field view error)) "run.completed from invalid state")))))
