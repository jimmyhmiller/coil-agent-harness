(module harness-interactive-authorization-test)

(import "coil.alloc" :as alloc :use *)
(import "coil.arraylist" :use *)
(import "coil.fs" :as fs)
(import "coil.match" :use *)
(import "coil.str" :use *)
(import "coil.thread" :use *)
(import "harness-event" :use *)
(import "harness-event-journal" :use *)
(import "harness-authorization-mailbox" :use *)
(import "harness-interactive-authorizer" :use *)
(import "harness-json" :use *)
(import "harness-run-service" :use *)
(import "harness-system" :use *)
(import "harness-tool" :use *)
(import "provider-common" :use *)

(defstruct AuthorizationFakeController [])
(impl RunController AuthorizationFakeController
  (start-durable-run [(self (ptr AuthorizationFakeController)) (command Json)]
                     (-> i64)
                     0)
  (cancel-durable-run [(self (ptr AuthorizationFakeController))
                       (run-id (slice u8))]
                      (-> i64)
                      0))

(defstruct AuthorizationJob
  [(authorizer (ptr InteractiveAuthorizer))
   (spec (ptr ToolSpec))
   (call (ptr ToolCall))
   (decision (ptr AuthorizationDecision))])

(defn authorization-worker [(opaque (ptr i8))] (-> (ptr i8))
  (let [job (cast (ptr AuthorizationJob) opaque)]
    (store! (load (field job decision))
            (interactive-authorize (load (field job authorizer))
                                   (load (field job spec))
                                   (load (field job call))))
    (cast (ptr i8) 0)))

(defn wait-for-authorization-request [(allocator (ptr Allocator))
                                      (path (slice u8))] (-> bool)
  (let [(mut attempt) 0
        (mut found) false]
    (loop (if (or (load found) (>= (load attempt) 200))
              (break)
              (let [recovery (event-journal-recover allocator path)]
                (when (and (load (field recovery ok))
                           (> (authorization-request-sequence (field recovery events)
                                                              "run-auth"
                                                              "call-auth")
                              0))
                  (store! found true)
                  0)
                (when (not (load found)) (sleep-ms 5) 0)
                (store! attempt (+ (load attempt) 1)))))
    (load found)))

(defn authorization-http-call [(service (ptr RunService))
                               (body (slice u8))] (-> ServiceResponse)
  (let [request (alloc/stack ServiceHttpRequest)]
    (store! (field request method) "POST")
    (store! (field request target)
            "/v1/runs/run-auth/authorizations/call-auth")
    (store! (field request body) body)
    (service-handle-http service request)))

(deftest waits-for-a-durable-idempotent-authorization-decision
         (let [allocator (malloc-allocator)
               path "/tmp/coil-agent-harness-authorization.jsonl"
               journal (alloc/stack EventJournal)
               sequence (box allocator i64 1)
               emitter (alloc/stack EventEmitter)
               mailbox (alloc/stack AuthorizationMailbox)
               controller (alloc/stack AuthorizationFakeController)
               service (alloc/stack RunService)
               authorizer (alloc/stack InteractiveAuthorizer)
               spec (alloc/stack ToolSpec)
               call (alloc/stack ToolCall)
               decision (box allocator AuthorizationDecision (Reject "not decided"))
               job (alloc/stack AuthorizationJob)
               worker (alloc/stack Thread)]
           (fs/write-file allocator path "")
           (match (event-journal-open allocator path true)
             (JournalOpenFailed [message] (assert false))
             (JournalOpened [opened] (store! journal opened)))
           (store! emitter (event-emitter-new journal sequence))
           (match (authorization-mailbox-open allocator)
             (AuthorizationMailboxOpenFailed [message] (assert false))
             (AuthorizationMailboxOpened [opened] (store! mailbox opened)))
           (store! (field service allocator) allocator)
           (store! (field service journal-path) path)
           (store! (field service journal) journal)
           (store! (field service emitter) emitter)
           (store! (field service mailbox) mailbox)
           (store! (field service controller) controller)
           (store! (field spec name) "write-file")
           (store! (field spec description) "write a file")
           (store! (field spec input-schema) (json-object allocator))
           (store! (field spec strict) true)
           (store! (field spec effect) (Reversible))
           (store! (field spec idempotent) false)
           (store! (field spec timeout-ms) 1000)
           (store! (field call id) "call-auth")
           (store! (field call name) "write-file")
           (store! (field call arguments) (JsonString "exact invocation"))
           (store! (field call raw-arguments) "\"exact invocation\"")
           (store! (field authorizer allocator) allocator)
           (store! (field authorizer journal-path) path)
           (store! (field authorizer emitter) emitter)
           (store! (field authorizer run-id) "run-auth")
           (store! (field authorizer parent-operation-id) "model-auth")
           (store! (field authorizer provider) "fake")
           (store! (field authorizer model) "fake-model")
           (store! (field authorizer cancellation)
                   (cancellation-token-new allocator))
           (store! (field authorizer mailbox) mailbox)
           (store! (field authorizer run-deadline-monotonic-ms) 0)
           (store! (field authorizer authorization-timeout-ms) 3000)
           (store! (field job authorizer) authorizer)
           (store! (field job spec) spec)
           (store! (field job call) call)
           (store! (field job decision) decision)
           (assert-eq (cast i64
                            (thread-spawn worker
                                          (fnptr-of authorization-worker)
                                          (cast (ptr i8) job)))
                      0)
           (assert (wait-for-authorization-request allocator path))
           (let [accepted
                   (authorization-http-call service
                                            "{\"version\":1,\"command_id\":\"decision-1\",\"run_id\":\"run-auth\",\"authorization_id\":\"call-auth\",\"decision\":\"allow\",\"actor\":\"operator-1\"}")
                 duplicate
                   (authorization-http-call service
                                            "{\"version\":1,\"command_id\":\"decision-1\",\"run_id\":\"run-auth\",\"authorization_id\":\"call-auth\",\"decision\":\"allow\",\"actor\":\"operator-1\"}")]
             (assert-eq (load (field accepted status)) 202)
             (assert-eq (load (field duplicate status)) 200)
             (let [conflict
                     (authorization-http-call service
                                              "{\"version\":1,\"command_id\":\"decision-2\",\"run_id\":\"run-auth\",\"authorization_id\":\"call-auth\",\"decision\":\"reject\"}")]
               (assert-eq (load (field conflict status)) 409)))
           (thread-join worker)
           (assert (match-else (load decision) (Authorize [] true) (_ false)))
           (let [recovery (event-journal-recover allocator path)]
             (assert (load (field recovery ok)))
             (assert-eq (al-len [Json] (load (field recovery events))) 2)
             (let [request-event (al-get [Json] (load (field recovery events)) 0)
                   payload (json-get request-event "payload")]
               (assert (str-eq (command-string payload "effect") "reversible"))
               (assert (str-eq (command-string payload "tool") "write-file"))))
           ;; A restarted waiter observes the durable decision immediately and does
           ;; not append a second request.
           (assert (match-else (interactive-authorize authorizer spec call)
                               (Authorize [] true)
                               (_ false)))
           (let [recovery (event-journal-recover allocator path)]
             (assert-eq (al-len [Json] (load (field recovery events))) 2))
           (authorization-mailbox-close! allocator mailbox)
           (event-journal-close! journal)))

(deftest cancellation-fails-a-pending-authorization-closed
         (let [allocator (malloc-allocator)
               path "/tmp/coil-agent-harness-authorization-cancelled.jsonl"
               journal (alloc/stack EventJournal)
               sequence (box allocator i64 1)
               emitter (alloc/stack EventEmitter)
               mailbox (alloc/stack AuthorizationMailbox)
               authorizer (alloc/stack InteractiveAuthorizer)
               spec (alloc/stack ToolSpec)
               call (alloc/stack ToolCall)
               cancellation (cancellation-token-new allocator)]
           (fs/write-file allocator path "")
           (match (event-journal-open allocator path true)
             (JournalOpenFailed [message] (assert false))
             (JournalOpened [opened] (store! journal opened)))
           (store! emitter (event-emitter-new journal sequence))
           (match (authorization-mailbox-open allocator)
             (AuthorizationMailboxOpenFailed [message] (assert false))
             (AuthorizationMailboxOpened [opened] (store! mailbox opened)))
           (store! (field spec name) "danger")
           (store! (field spec effect) (Destructive))
           (store! (field spec idempotent) false)
           (store! (field call id) "cancelled-call")
           (store! (field call name) "danger")
           (store! (field call arguments) (JsonNull))
           (store! (field authorizer allocator) allocator)
           (store! (field authorizer journal-path) path)
           (store! (field authorizer emitter) emitter)
           (store! (field authorizer run-id) "cancelled-run")
           (store! (field authorizer parent-operation-id) "model-1")
           (store! (field authorizer provider) "fake")
           (store! (field authorizer model) "fake")
           (store! (field authorizer cancellation) cancellation)
           (store! (field authorizer mailbox) mailbox)
           (store! (field authorizer run-deadline-monotonic-ms) 0)
           (store! (field authorizer authorization-timeout-ms) 3000)
           (cancellation-request! cancellation)
           (assert (match (interactive-authorize authorizer spec call)
                     (Reject [reason] (str-eq reason "authorization cancelled"))
                     (Authorize [] false)))
           (let [recovery (event-journal-recover allocator path)]
             (assert (load (field recovery ok)))
             (assert-eq (al-len [Json] (load (field recovery events))) 2)
             (assert (> (authorization-request-sequence (field recovery events)
                                                        "cancelled-run"
                                                        "cancelled-call")
                        0))
             (assert (match-else (authorization-decision (field recovery events)
                                                         "cancelled-run"
                                                         "cancelled-call")
                                 (AuthorizationRejected [reason]
                                                        (str-eq reason
                                                                "authorization cancelled"))
                                 (_ false))))
           (authorization-mailbox-close! allocator mailbox)
           (event-journal-close! journal)))
