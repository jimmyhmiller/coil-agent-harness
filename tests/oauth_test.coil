(module harness-oauth-test)

(import "coil.alloc" :use *)
(import "coil.slice" :use *)
(import "coil.str" :use *)
(import "harness-oauth" :use *)
(import "harness-json" :use *)
(import "provider-common" :use *)

(deftest sha256-pkce-matches-rfc-7636
         (let [allocator (malloc-allocator)]
           (assert-eq (oauth-pkce-challenge allocator
                                            "dBjftJeZ4CVP-mB92K27uhbUJU1p1r_wW1gFWFOEjXk")
                      "E9Melhoa2OwvFrEMTJguCHaoeK1t8URWbuGJSstw-cM")))

(deftest random-oauth-tokens-have-the-requested-entropy-length
         (let [allocator (malloc-allocator)
               first (oauth-random-token allocator 32)
               second (oauth-random-token allocator 32)]
           (assert (= (slice-len [u8] first) 43))
           (assert (= (slice-len [u8] second) 43))
           (assert (not (str-eq first second)))))

(deftest oauth-url-and-query-encoding-round-trip
         (let [allocator (malloc-allocator)]
           (assert-eq (oauth-url-encode allocator "a b+c/=") "a%20b%2Bc%2F%3D")
           (assert-eq (oauth-query-value allocator
                                         "/callback?code=a%2Bb%2Fc&state=hello+world"
                                         "code")
                      "a+b/c")
           (assert-eq (oauth-query-value allocator
                                         "/callback?code=a%2Bb%2Fc&state=hello+world"
                                         "state")
                      "hello world")))

(deftest jwt-claims-decode-url-safe-base64-without-padding
         (let [allocator (malloc-allocator)
               claims
                 (oauth-jwt-claims allocator
                                   "e30.eyJleHAiOjEyMywiY2hhdGdwdF9hY2NvdW50X2lkIjoiYWNjdC0xIn0.sig")]
           (assert (= (json-number-i64 (json-get claims "exp")) 123))
           (assert-eq (match (json-string-at claims "chatgpt_account_id")
                        (Some [value] value)
                        (None [] ""))
                      "acct-1")))

(deftest oauth-state-comparison-requires-equal-bytes-and-length
         (assert (oauth-secure-eq "same-state" "same-state"))
         (assert (not (oauth-secure-eq "same-state" "same-statf")))
         (assert (not (oauth-secure-eq "same-state" "same-state-longer"))))

(deftest oauth-callback-path-does-not-accept-prefix-lookalikes
         (assert-eq (oauth-target-path "/callback?code=ok") "/callback")
         (assert (not (str-eq (oauth-target-path "/callback-evil?code=ok")
                              "/callback"))))
