(module harness-event-journal-test)

(import "coil.primitive" :as primitive)

(import "coil.alloc" :as alloc :use *)
(import "coil.arraylist" :use *)
(import "coil.fs" :as fs)
(import "coil.match" :use *)
(import "coil.slice" :use *)
(import "coil.str" :use *)
(import "coil.thread" :use *)
(import "harness-event" :use *)
(import "harness-event-journal" :use *)
(import "harness-json" :use *)

(defstruct ConcurrentEventJob
  [(emitter (ptr EventEmitter))
   (count i64)])

(defn concurrent-event-worker [(opaque (ptr i8))] (-> (ptr i8))
  (let [job (cast (ptr ConcurrentEventJob) opaque)
        (mut i) 0]
    (loop (if (>= (load i) (.count job))
              (break)
              (do
                (emit-event (load (field job emitter))
                            (load i)
                            (CodexNotification)
                            "concurrent-run"
                            "concurrent-operation"
                            ""
                            "test"
                            "test"
                            (JsonNull))
                (set! i (+ (load i) 1)))))
    (cast (ptr i8) 0)))

(deftest persists-ordered-events-and-recovers-past-a-torn-tail
         (let [allocator (malloc-allocator)
               path "/tmp/coil-agent-harness-journal-recovery.jsonl"
               sequence (box! allocator i64 1)
               journal (primitive/alloc-stack EventJournal)]
           (fs/write-file allocator path "")
           (match (event-journal-open allocator path true)
             (JournalOpenFailed [message] (assert false))
             (JournalOpened [opened] (store! journal opened)))
           (let [emitter (primitive/alloc-stack EventEmitter)]
             (store! emitter (event-emitter-new allocator journal sequence))
             (assert-eq (emit-event emitter
                                    100
                                    (RunStarted)
                                    "run-1"
                                    "run-1"
                                    ""
                                    "fake"
                                    "fake-model"
                                    (JsonNull))
                        1)
             (assert-eq (emit-event emitter
                                    101
                                    (RunCompleted)
                                    "run-1"
                                    "run-1"
                                    ""
                                    "fake"
                                    "fake-model"
                                    (JsonString "done"))
                        2))
           (assert (not (event-journal-failed? journal)))
           (event-journal-close! journal)
           (assert (> (event-journal-append-bytes! allocator
                                                   path
                                                   "{\"version\":1")
                      0))
           (let [recovery (event-journal-recover allocator path)]
             (assert (load (field recovery ok)))
             (assert (load (field recovery ignored-torn-tail)))
             (assert-eq (load (field recovery last-sequence)) 2)
             (assert-eq (al-len [Json] (load (field recovery events))) 2)
             (assert (match (json-string-at (al-get [Json] (load (field recovery events)) 1)
                                            "event")
                       (Some [value] (= value "run.completed"))
                       (None [] false))))))

(deftest rejects-corruption-in-a-complete-journal-record
         (let [allocator (malloc-allocator)
               path "/tmp/coil-agent-harness-journal-corrupt.jsonl"]
           (fs/write-file allocator path "not-json\n")
           (let [recovery (event-journal-recover allocator path)]
             (assert (not (load (field recovery ok))))
             (assert (= (load (field recovery error)) "event journal contains invalid JSON")))))

(deftest opens-the-same-path-without-process-ownership
         (let [allocator (malloc-allocator)
               path "/tmp/coil-agent-harness-journal-owner.jsonl"
               first (primitive/alloc-stack EventJournal)
               second (primitive/alloc-stack EventJournal)]
           (fs/write-file allocator path "")
           (match (event-journal-open allocator path true)
             (JournalOpenFailed [message] (assert false))
             (JournalOpened [journal] (store! first journal)))
           (match (event-journal-open allocator path true)
             (JournalOpenFailed [message] (assert false))
             (JournalOpened [journal] (store! second journal)))
           (event-journal-close! first)
           (event-journal-close! second)))

(deftest serializes-sequence-assignment-with-concurrent-publication
         (let [allocator (malloc-allocator)
               path "/tmp/coil-agent-harness-journal-concurrent.jsonl"
               sequence (box! allocator i64 1)
               journal (primitive/alloc-stack EventJournal)
               emitter (primitive/alloc-stack EventEmitter)
               first-job (primitive/alloc-stack ConcurrentEventJob)
               second-job (primitive/alloc-stack ConcurrentEventJob)
               first-thread (primitive/alloc-stack Thread)
               second-thread (primitive/alloc-stack Thread)]
           (fs/write-file allocator path "")
           (match (event-journal-open allocator path false)
             (JournalOpenFailed [message] (assert false))
             (JournalOpened [opened] (store! journal opened)))
           (store! emitter (event-emitter-new allocator journal sequence))
           (store! (field first-job emitter) emitter)
           (store! (field first-job count) 200)
           (store! (field second-job emitter) emitter)
           (store! (field second-job count) 200)
           (assert-eq (cast i64
                            (thread-spawn first-thread
                                          (fnptr-of concurrent-event-worker)
                                          (cast (ptr i8) first-job)))
                      0)
           (assert-eq (cast i64
                            (thread-spawn second-thread
                                          (fnptr-of concurrent-event-worker)
                                          (cast (ptr i8) second-job)))
                      0)
           (thread-join first-thread)
           (thread-join second-thread)
           (event-journal-close! journal)
           (let [recovery (event-journal-recover allocator path)]
             (assert (load (field recovery ok)))
             (assert-eq (load (field recovery last-sequence)) 400)
             (assert-eq (al-len [Json] (load (field recovery events))) 400))))
