(deftest terminal-dependency-policy-releases-failed-and-cancelled-handles
         (let [(mut view) (zeroed DurableRunView)]
           (store! (field view status) (RunErrored))
           (assert (match (runtime-dependency-view-state (load view) true)
                     (RuntimeDependenciesReady [] true)
                     (_ false)))
           (assert (match (runtime-dependency-view-state (load view) false)
                     (RuntimeDependenciesFailed [] true)
                     (_ false)))
           (store! (field view status) (RunCancelledStatus))
           (assert (match (runtime-dependency-view-state (load view) true)
                     (RuntimeDependenciesReady [] true)
                     (_ false)))))

(defstruct ControllerFakeProvider [(marker i8)])

(impl ModelProvider ControllerFakeProvider
  (provider-name [(self (ptr ControllerFakeProvider))] (-> (slice u8)) "fake")
  (provider-capabilities [(self (ptr ControllerFakeProvider))]
                         (-> ProviderCapabilities)
                         (provider-capabilities-for "fake"))
  (execute-model [(self (ptr ControllerFakeProvider))
                  (request (ptr ModelRequest))
                  (emitter (ptr EventEmitter))
                  (allocator (dyn Allocator))]
                 (-> ModelResult)
                 (let [(mut response) (response-empty allocator)]
                   (set! (.provider response) "fake")
                   (set! (.model response) (.model request))
                   (set! (.response-id response) "fake-response")
                   (set! (.output-text response) "done")
                   (ModelOk (load response)))))

(defstruct ControllerFakeProviderFactory
  [(provider (ptr ControllerFakeProvider))])

(impl RuntimeProviderFactory ControllerFakeProviderFactory
  (prepare-runtime-provider [(self (ptr ControllerFakeProviderFactory))
                             (allocator (dyn Allocator))
                             (provider-name (slice u8))]
                            (-> i64)
                            0)
  (resolve-runtime-provider [(self (ptr ControllerFakeProviderFactory))
                             (allocator (dyn Allocator))
                             (provider-name (slice u8))]
                            (-> (Option (dyn ModelProvider)))
                            (if (str-eq provider-name "fake")
                                (Some (.provider self))
                                (None [(dyn ModelProvider)]))))

(defstruct QueuedProviderState
  [(calls (ptr i64))
   (active (ptr i64))
   (max-active (ptr i64))])

(defstruct QueuedFakeProvider
  [(state (ptr QueuedProviderState))])

(impl ModelProvider QueuedFakeProvider
  (provider-name [(self (ptr QueuedFakeProvider))] (-> (slice u8)) "queued-fake")
  (provider-capabilities [(self (ptr QueuedFakeProvider))]
                         (-> ProviderCapabilities)
                         (provider-capabilities-for "queued-fake"))
  (execute-model [(self (ptr QueuedFakeProvider))
                  (request (ptr ModelRequest))
                  (emitter (ptr EventEmitter))
                  (allocator (dyn Allocator))]
                 (-> ModelResult)
                 (let [state (load (field self state))
                       concurrent (+ (atomic-add (load (field state active)) 1) 1)]
                   (when (> concurrent (atomic-load (load (field state max-active))))
                     (atomic-store (load (field state max-active)) concurrent)
                     0)
                   (atomic-add (load (field state calls)) 1)
                   (sleep-ms 40)
                   (atomic-add (load (field state active)) -1)
                   (let [(mut response) (response-empty allocator)]
                     (set! (.provider response) "queued-fake")
                     (set! (.model response) (.model request))
                     (set! (.response-id response) "queued-response")
                     (set! (.output-text response) "done")
                     (ModelOk (load response))))))

(defstruct QueuedProviderFactory
  [(provider (ptr QueuedFakeProvider))])

(impl RuntimeProviderFactory QueuedProviderFactory
  (prepare-runtime-provider [(self (ptr QueuedProviderFactory))
                             (allocator (dyn Allocator))
                             (provider-name (slice u8))]
                            (-> i64)
                            0)
  (resolve-runtime-provider [(self (ptr QueuedProviderFactory))
                             (allocator (dyn Allocator))
                             (provider-name (slice u8))]
                            (-> (Option (dyn ModelProvider)))
                            (if (str-eq provider-name "queued-fake")
                                (Some (.provider self))
                                (None [(dyn ModelProvider)]))))

(defn controller-command [(allocator (dyn Allocator))] (-> Json)
  (let [(mut command) (json-object allocator)]
    (json-object-put! (mut command) "version" (json-integer allocator 1))
    (json-put-string! (mut command) "command_id" "controller-command")
    (json-put-string! (mut command) "run_id" "controller-run")
    (json-put-string! (mut command) "provider" "fake")
    (json-put-string! (mut command) "model" "fake-model")
    (json-put-string! (mut command) "prompt" "hello")
    (json-put-string! (mut command) "instructions" "test instructions")
    (json-object-put! (mut command) "timeout_ms" (json-integer allocator 5000))
    (load command)))

(deftest builds-and-retains-a-real-background-runtime-run
         (let [allocator (malloc-allocator)
               path "/tmp/coil-agent-harness-runtime-controller.jsonl"
               journal (primitive/alloc-stack EventJournal)
               sequence (box! allocator i64 1)
               emitter (primitive/alloc-stack EventEmitter)
               registry (box! allocator ToolRegistry (tool-registry-new allocator))
               provider (box! allocator ControllerFakeProvider (zeroed ControllerFakeProvider))
               provider-factory
                 (box! allocator
                      ControllerFakeProviderFactory
                      (let [factory (primitive/alloc-stack ControllerFakeProviderFactory)]
                        (store! (field factory provider) provider)
                        (load factory)))]
           (fs/write-file allocator path "")
           (match (event-journal-open allocator path true)
             (JournalOpenFailed [message] (assert false))
             (JournalOpened [opened] (store! journal opened)))
           (store! emitter (event-emitter-new allocator journal sequence))
           (let [controller
                   (box! allocator
                        RuntimeRunController
                        (runtime-controller-new allocator
                                                registry
                                                provider-factory
                                                emitter
                                                journal
                                                path))
                 command (controller-command allocator)
                 request (runtime-model-request controller command allocator)]
             (assert (= (load (field request run-id)) "controller-run"))
             (assert (= (load (field request instructions)) "test instructions"))
             (assert (> (str-len (load (field request cache-key))) 0))
             (assert (= (load (field request prompt-cache-key)) "fake/fake-model/controller-run"))
             (let [(mut scoped) (controller-command allocator)]
               (json-put-string! (mut scoped) "conversation_id" "conversation-42")
               (let [scoped-request (runtime-model-request controller (load scoped) allocator)]
                 (assert (= (load (field scoped-request prompt-cache-key)) "fake/fake-model/conversation-42"))))
             (let [(mut continued) command]
               (json-put-string! (mut continued) "previous_response_id" "response-1")
               (json-put-string! (mut continued)
                                 "continuation_cache_key"
                                 (load (field request cache-key)))
               (let [continued-request (runtime-model-request controller (load continued) allocator)]
                 (assert (load (field (field continued-request continuation) present))))
               (json-put-string! (mut continued) "model" "different-model")
               (let [invalidated-request (runtime-model-request controller (load continued) allocator)]
                 (assert (not (load (field (field invalidated-request continuation) present))))))
             ;; `timeout_ms` is the run's deadline, not the transport's. The
             ;; transport timeout is fixed and bounds a single HTTP request, so
             ;; asking for a five-second run does not also shorten the socket.
             (assert-eq (load (field request timeout-ms)) RUNTIME_TRANSPORT_TIMEOUT_MS)
             (assert (> (load (field request deadline-monotonic-ms)) 0))
             (assert (!= (load (field request cancellation))
                         (cast (ptr CancellationToken) 0)))
             (assert-eq (runtime-controller-start-provider! controller command provider) 0)
             (assert-eq (al-len [ActiveRuntimeRun]
                                (load (field controller runs)))
                        1)
             (assert-eq (runtime-controller-start-provider! controller command provider) 0)
             (assert-eq (al-len [ActiveRuntimeRun]
                                (load (field controller runs)))
                        1)
             (let [(mut attempt) 0]
               (loop (if (or (= (al-len [ActiveRuntimeRun]
                                        (load (field controller runs)))
                                0)
                             (>= (load attempt) 200))
                         (break)
                         (do
                           (sleep-ms 5)
                           (runtime-controller-reap! controller)
                           (store! attempt (+ (load attempt) 1))))))
             (assert-eq (al-len [ActiveRuntimeRun]
                                (load (field controller runs)))
                        0)
             (assert-eq (runtime-controller-launch! controller
                                                    (let [(mut unknown) command]
                                                      (json-put-string! (mut unknown)
                                                                        "provider"
                                                                        "unknown")
                                                      (load unknown)))
                        -1))
           (let [recovery (event-journal-recover allocator path)]
             (assert (load (field recovery ok)))
             (assert-eq (al-len [Json] (load (field recovery events))) 2)
             (assert (= (command-string (al-get [Json] (load (field recovery events)) 0)
                                        "event")
                        "run.started"))
             (assert (= (command-string (al-get [Json] (load (field recovery events)) 1)
                                        "event")
                        "run.completed")))
           (event-journal-close! journal)))

(deftest completed-child-injects-a-contextual-parent-notification-run
         (let [allocator (malloc-allocator)
               path "/tmp/coil-agent-harness-runtime-notification.jsonl"
               journal (primitive/alloc-stack EventJournal)
               sequence (box! allocator i64 1)
               emitter (primitive/alloc-stack EventEmitter)
               registry (box! allocator ToolRegistry (tool-registry-new allocator))
               provider (box! allocator ControllerFakeProvider (zeroed ControllerFakeProvider))
               factory
                 (box! allocator
                      ControllerFakeProviderFactory
                      (let [value (primitive/alloc-stack ControllerFakeProviderFactory)]
                        (store! (field value provider) provider)
                        (load value)))]
           (fs/write-file allocator path "")
           (match (event-journal-open allocator path true)
             (JournalOpenFailed [message] (assert false))
             (JournalOpened [opened] (store! journal opened)))
           (store! emitter (event-emitter-new allocator journal sequence))
           (let [controller
                   (box! allocator
                        RuntimeRunController
                        (runtime-controller-new allocator registry factory emitter journal path))
                 (mut parent) (controller-command allocator)
                 (mut child) (controller-command allocator)]
             (json-put-string! (mut parent) "run_id" "notification-parent")
             (json-put-string! (mut parent) "conversation_id" "conversation-1")
             (emit-event emitter
                         (now-ms)
                         (RunCreated)
                         "notification-parent"
                         "notification-parent"
                         ""
                         "fake"
                         "fake-model"
                         (load parent))
             (json-put-string! (mut child) "run_id" "notification-child")
             (json-put-string! (mut child) "parent_run_id" "notification-parent")
             (json-put-string! (mut child) "conversation_id" "agent:notification-child")
             (json-put-string! (mut child) "parent_conversation_id" "conversation-1")
             (json-put-string! (mut child) "prompt" "write the poem")
             (json-object-put! (mut child) "notify_parent" (JsonBool true))
             (assert-eq (runtime-controller-start-provider! controller (load child) provider) 0)
             (let [(mut attempt) 0]
               (loop (if (or (= (al-len [ActiveRuntimeRun] (load (field controller runs))) 0)
                             (>= (load attempt) 200))
                         (break)
                         (do
                           (sleep-ms 5)
                           (runtime-controller-reap! controller)
                           (store! attempt (+ (load attempt) 1))))))
             (assert-eq (al-len [PendingRuntimeRun] (load (field controller pending))) 1)
             (let [notification
                     (al-get [PendingRuntimeRun]
                             (load (field controller pending))
                             0)
                   command (load (field notification command))]
               (assert (= (command-string command "run_id") "notification:notification-child"))
               (assert (= (command-string command "actor") "agent-notification"))
               (assert (= (command-string command "conversation_id") "conversation-1"))
               (assert (= (match (json-array-get (json-get command "depends_on") 0)
                                 (JsonString [dependency] dependency)
                                 (_ ""))
                          "notification-parent"))))
           (let [recovery (event-journal-recover allocator path)
                 events (field recovery events)
                 (mut saw-message) false
                 (mut saw-notification) false
                 (mut i) 0]
             (loop (if (>= (load i) (al-len [Json] (load events)))
                       (break)
                       (let [event (al-get [Json] (load events) (load i))]
                         (when (= (command-string event "event") "agent.message.received")
                           (store! saw-message true)
                           0)
                         (when (= (command-string event "run_id") "notification:notification-child")
                           (store! saw-notification true)
                           0)
                         (store! i (+ (load i) 1)))))
             (assert (load saw-message))
             (assert (load saw-notification)))
           (event-journal-close! journal)))

(deftest drains-workflow-dependencies-only-after-predecessors-succeed
         (let [allocator (malloc-allocator)
               domains-before (allocation-domain-live-count)
               path "/tmp/coil-agent-harness-runtime-queue.jsonl"
               journal (primitive/alloc-stack EventJournal)
               sequence (box! allocator i64 1)
               emitter (primitive/alloc-stack EventEmitter)
               registry (box! allocator ToolRegistry (tool-registry-new allocator))
               state (primitive/alloc-stack QueuedProviderState)]
           (store! (field state calls) (box! allocator i64 0))
           (store! (field state active) (box! allocator i64 0))
           (store! (field state max-active) (box! allocator i64 0))
           (fs/write-file allocator path "")
           (match (event-journal-open allocator path true)
             (JournalOpenFailed [message] (assert false))
             (JournalOpened [opened] (store! journal opened)))
           (store! emitter (event-emitter-new allocator journal sequence))
           (let [provider
                   (box! allocator
                        QueuedFakeProvider
                        (let [value (primitive/alloc-stack QueuedFakeProvider)]
                          (store! (field value state) state)
                          (load value)))
                 factory
                   (box! allocator
                        QueuedProviderFactory
                        (let [value (primitive/alloc-stack QueuedProviderFactory)]
                          (store! (field value provider) provider)
                          (load value)))
                 controller
                   (box! allocator
                        RuntimeRunController
                        (runtime-controller-new allocator
                                                registry
                                                factory
                                                emitter
                                                journal
                                                path))
                 (mut first) (controller-command allocator)
                 (mut second) (controller-command allocator)
                 (mut independent) (controller-command allocator)
                 (mut raced) (controller-command allocator)
                 (mut cancelled) (controller-command allocator)]
             (store! (field controller max-active-runs) 0)
             (json-put-string! (mut cancelled) "run_id" "queued-run-cancelled")
             (json-put-string! (mut cancelled) "provider" "queued-fake")
             (assert-eq (start-durable-run controller cancelled) 0)
             (assert (match (cancel-durable-run controller cancelled)
                       (RunCancellationAccepted [] true)
                       (RunCancellationTerminalOrMissing [] false)
                       (RunCancellationFailed [] false)))
             (store! (field controller max-active-runs) 2)
             (json-put-string! (mut first) "run_id" "queued-run-one")
             (json-put-string! (mut first) "provider" "queued-fake")
             (json-put-string! (mut second) "run_id" "queued-run-two")
             (json-put-string! (mut second) "provider" "queued-fake")
             (json-put-string! (mut second) "workflow_id" "workflow-1")
             (json-object-put! (mut second) "workflow_version" (json-integer allocator 1))
             (json-put-string! (mut second) "node_id" "second")
             (let [(mut dependencies) (json-array allocator)]
               (json-array-push! (mut dependencies) (JsonString "queued-run-one"))
               (json-object-put! (mut second) "depends_on" (load dependencies)))
             (json-put-string! (mut independent) "run_id" "independent-run")
             (json-put-string! (mut independent) "provider" "queued-fake")
             (emit-event emitter
                         0
                         (RunCreated)
                         "queued-run-one"
                         "queued-run-one"
                         ""
                         "queued-fake"
                         "fake-model"
                         (load first))
             (emit-event emitter
                         0
                         (RunCreated)
                         "queued-run-two"
                         "queued-run-two"
                         ""
                         "queued-fake"
                         "fake-model"
                         (load second))
             (emit-event emitter
                         0
                         (RunCreated)
                         "independent-run"
                         "independent-run"
                         ""
                         "queued-fake"
                         "fake-model"
                         (load independent))
             (assert-eq (start-durable-run controller first) 0)
             (assert-eq (start-durable-run controller second) 0)
             (assert-eq (start-durable-run controller independent) 0)
             (let [(mut attempt) 0]
               (loop (if (or (and (= (atomic-load (load (field state calls))) 3)
                                  (= (atomic-load (load (field state active))) 0))
                             (>= (load attempt) 300))
                         (break)
                         (do
                           (sleep-ms 5)
                           (store! attempt (+ (load attempt) 1))))))
             (sleep-ms 20)
             (store! (field controller max-active-runs) 1)
             (json-put-string! (mut raced) "run_id" "completion-cancellation-race")
             (json-put-string! (mut raced) "provider" "queued-fake")
             (emit-event emitter
                         0
                         (RunCreated)
                         "completion-cancellation-race"
                         "completion-cancellation-race"
                         ""
                         "queued-fake"
                         "fake-model"
                         (load raced))
             (assert-eq (start-durable-run controller raced) 0)
             (let [(mut attempt) 0]
               (loop (if (or (= (atomic-load (load (field state calls))) 4)
                             (>= (load attempt) 200))
                         (break)
                         (do
                           (sleep-ms 1)
                           (store! attempt (+ (load attempt) 1))))))
             (sleep-ms 20)
             (assert (match (cancel-durable-run controller raced)
                       (RunCancellationAccepted [] true)
                       (RunCancellationTerminalOrMissing [] true)
                       (RunCancellationFailed [] false)))
             (sleep-ms 40)
             (runtime-controller-join-all! controller)
             (assert-eq (atomic-load (load (field state calls))) 4)
             (assert-eq (atomic-load (load (field state max-active))) 2)
             (let [recovery (event-journal-recover allocator path)]
               (assert (load (field recovery ok)))
               (let [first-view (project-run (field recovery events) "queued-run-one")
                     second-view (project-run (field recovery events) "queued-run-two")
                     race-view
                       (project-run (field recovery events)
                                    "completion-cancellation-race")]
                 (assert (load (field first-view valid)))
                 (assert (load (field first-view terminal)))
                 (assert (load (field second-view valid)))
                 (assert (load (field second-view terminal)))
                 (assert (load (field race-view valid)))
                 (assert (load (field race-view terminal)))
                 (let [(mut saw-ready) false
                       (mut i) 0
                       n (al-len [Json] (load (field recovery events)))]
                   (loop (if (>= (load i) n)
                             (break)
                             (let [event (al-get [Json] (load (field recovery events)) (load i))]
                               (when (and (= (command-string event "run_id") "queued-run-two")
                                          (= (command-string event "event") "workflow.node.ready"))
                                 (store! saw-ready true)
                                 0)
                               (store! i (+ (load i) 1)))))
                   (assert (load saw-ready))))))
           (event-journal-close! journal)
           (assert-eq (allocation-domain-live-count) domains-before)))

;; A command with no `timeout_ms` gets no run deadline. This is the common case
;; and the one that matters: a task runs until it finishes, fails, or is
;; cancelled. Nothing in the runtime invents a ceiling for it, because a run
;; taking a long time is not a failure -- it is the job.
(deftest a-run-has-no-deadline-unless-the-command-asks-for-one
         (let [allocator (malloc-allocator)
               (mut command) (json-object allocator)]
           (assert-eq (runtime-command-deadline (load command)) 0)
           (json-object-put! (mut command) "timeout_ms" (json-integer allocator 0))
           (assert-eq (runtime-command-deadline (load command)) 0)
           ;; And when one is asked for, it is honoured verbatim -- there is no
           ;; ceiling clamping an hour-long budget back down to minutes.
           (json-object-put! (mut command) "timeout_ms" (json-integer allocator 3600000))
           (assert (> (runtime-command-deadline (load command)) 0))))

(defstruct ToolPlaneEchoTool [(marker i8)])

(impl ToolImplementation ToolPlaneEchoTool
  (execute-tool [(self (ptr ToolPlaneEchoTool))
                 (call (ptr ToolCall))
                 (context (ptr ToolExecutionContext))
                 (allocator (dyn Allocator))]
                (-> ToolResult)
                (let [(mut result) (tool-result-empty (.id call) (ToolSucceeded))]
                  (set! (.output result) (.arguments call))
                  (load result))))

(defn tool-plane-definition [(allocator (dyn Allocator))] (-> ToolDefinition)
  (let [parsed
          (json-parse allocator
                      "{\"type\":\"object\",\"properties\":{\"text\":{\"type\":\"string\"}},\"required\":[\"text\"],\"additionalProperties\":false}")
        definition (primitive/alloc-stack ToolDefinition)
        implementation (box! allocator ToolPlaneEchoTool (zeroed ToolPlaneEchoTool))]
    (set! (.name (.spec definition)) "plane_echo")
    (set! (.description (.spec definition)) "Return the supplied text.")
    (set! (.input-schema (.spec definition)) (.value parsed))
    (set! (.strict (.spec definition)) true)
    (set! (.effect (.spec definition)) (ReadOnly))
    (set! (.idempotent (.spec definition)) true)
    (set! (.timeout-ms (.spec definition)) 1000)
    (set! (.implementation definition) implementation)
    (load definition)))

(defn tool-plane-command [(allocator (dyn Allocator))
                          (name (slice u8))
                          (arguments Json)] (-> Json)
  (let [(mut command) (json-object allocator)]
    (json-put-string! (mut command) "name" name)
    (json-object-put! (mut command) "arguments" arguments)
    (json-put-string! (mut command) "session_id" "sdk-session")
    (load command)))

(defn tool-plane-authorized? [(decision Json)] (-> bool)
  (match (json-bool-value (json-get decision "authorized"))
    (Some [value] value)
    (None [] false)))

;; The tool plane an external agent loop calls back into. Execution stays on the
;; harness path, so a bridged call is schema-checked and journaled exactly like
;; a call made by a run the harness drives itself.
(deftest tool-plane-describes-authorizes-and-invokes-registered-tools
         (let [allocator (malloc-allocator)
               path "/tmp/coil-agent-harness-tool-plane.jsonl"
               journal (primitive/alloc-stack EventJournal)
               sequence (box! allocator i64 1)
               emitter (primitive/alloc-stack EventEmitter)
               registry (box! allocator ToolRegistry (tool-registry-new allocator))
               provider (box! allocator ControllerFakeProvider (zeroed ControllerFakeProvider))
               factory
                 (box! allocator
                      ControllerFakeProviderFactory
                      (let [value (primitive/alloc-stack ControllerFakeProviderFactory)]
                        (store! (field value provider) provider)
                        (load value)))]
           (fs/write-file allocator path "")
           (match (event-journal-open allocator path true)
             (JournalOpenFailed [message] (assert false))
             (JournalOpened [opened] (store! journal opened)))
           (store! emitter (event-emitter-new allocator journal sequence))
           (assert (tool-register! registry (tool-plane-definition allocator)))
           (let [controller
                   (box! allocator
                        RuntimeRunController
                        (runtime-controller-new allocator registry factory emitter journal path))
                 (mut arguments) (json-object allocator)]
             (let [catalog (runtime-controller-tools-json controller allocator)
                   tools (json-get catalog "tools")]
               (assert-eq (json-number-i64 (json-get catalog "version")) 1)
               (assert-eq (json-array-length tools) 1)
               (let [entry (json-array-get tools 0)]
                 (assert (= (command-string entry "name") "plane_echo"))
                 (assert (= (command-string entry "effect") "read_only"))
                 (assert-eq (json-number-i64 (json-get entry "timeout_ms")) 1000)
                 (assert (match (json-bool-value (json-get entry "idempotent"))
                           (Some [value] value)
                           (None [] false)))
                 (assert (= (command-string (json-get entry "input_schema") "type") "object"))))
             (json-put-string! (mut arguments) "text" "hello")
             (let [command (tool-plane-command allocator "plane_echo" (load arguments))]
               (assert (tool-plane-authorized? (runtime-controller-authorize-tool controller
                                                                                  command
                                                                                  allocator)))
               (let [result (runtime-controller-invoke-tool controller command allocator)]
                 (assert (= (command-string result "status") "succeeded"))
                 (assert (= (command-string result "session_id") "sdk-session"))
                 (assert (= (command-string (json-get result "output") "text") "hello"))
                 ;; Absent a call ID the tool name identifies the operation, so
                 ;; the journaled events still name what ran.
                 (assert (= (command-string result "call_id") "plane_echo"))))
             ;; A tool the model invented is reported as a tool result, not a
             ;; transport failure it cannot act on.
             (let [unknown (tool-plane-command allocator "missing" (json-object allocator))
                   decision (runtime-controller-authorize-tool controller unknown allocator)]
               (assert (not (tool-plane-authorized? decision)))
               (assert (= (command-string decision "reason") "unknown tool"))
               (assert (= (command-string (runtime-controller-invoke-tool controller
                                                                          unknown
                                                                          allocator)
                                          "status")
                          "unknown")))
             ;; Arguments that miss the schema are refused before the tool runs.
             (let [malformed (tool-plane-command allocator "plane_echo" (json-object allocator))]
               (assert (not (tool-plane-authorized? (runtime-controller-authorize-tool controller
                                                                                       malformed
                                                                                       allocator))))
               (assert (= (command-string (runtime-controller-invoke-tool controller
                                                                          malformed
                                                                          allocator)
                                          "status")
                          "denied"))))
           (let [recovery (event-journal-recover allocator path)
                 events (field recovery events)
                 (mut completed) 0
                 (mut i) 0]
             (assert (load (field recovery ok)))
             (loop (if (>= (load i) (al-len [Json] (load events)))
                       (break)
                       (let [event (al-get [Json] (load events) (load i))]
                         (when (and (= (command-string event "event") "tool.call.completed")
                                    (= (command-string event "run_id") "sdk-session"))
                           (assert (= (command-string event "provider") "agent-sdk"))
                           (store! completed (+ (load completed) 1))
                           0)
                         (store! i (+ (load i) 1)))))
             (assert-eq (load completed) 1))
           (event-journal-close! journal)))
