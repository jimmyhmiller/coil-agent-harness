(module harness-runtime-controller-test)

(import "coil.alloc" :as alloc :use *)
(import "coil.arraylist" :use *)
(import "coil.atomic" :use *)
(import "coil.fs" :as fs)
(import "coil.match" :use *)
(import "coil.str" :use *)
(import "harness-event" :use *)
(import "harness-allocation-domain" :use *)
(import "harness-event-journal" :use *)
(import "harness-authorization-mailbox" :use *)
(import "harness-json" :use *)
(import "harness-model" :use *)
(import "harness-run-service" :use *)
(import "harness-run-state" :use *)
(import "harness-runtime-controller" :use *)
(import "harness-system" :use *)
(import "harness-tool" :use *)
(import "provider-common" :use *)

(defstruct ControllerFakeProvider [])
(impl ModelProvider ControllerFakeProvider
  (provider-name [(self (ptr ControllerFakeProvider))] (-> (slice u8)) "fake")
  (execute-model [(self (ptr ControllerFakeProvider))
                  (request (ptr ModelRequest))
                  (emitter (ptr EventEmitter))
                  (allocator (ptr Allocator))]
                 (-> ModelResult)
                 (let [(mut response) (response-empty allocator)]
                   (store! (field response provider) "fake")
                   (store! (field response model) (load (field request model)))
                   (store! (field response response-id) "fake-response")
                   (store! (field response output-text) "done")
                   (ModelOk (load response)))))

(defstruct ControllerFakeProviderFactory
  [(provider (ptr ControllerFakeProvider))])

(impl RuntimeProviderFactory ControllerFakeProviderFactory
  (resolve-runtime-provider [(self (ptr ControllerFakeProviderFactory))
                             (allocator (ptr Allocator))
                             (provider-name (slice u8))]
                            (-> (Option (dyn ModelProvider)))
                            (if (str-eq provider-name "fake")
                                (Some (load (field self provider)))
                                (None [(dyn ModelProvider)]))))

(defstruct QueuedProviderState
  [(calls (ptr i64))
   (active (ptr i64))
   (max-active (ptr i64))])

(defstruct QueuedFakeProvider
  [(state (ptr QueuedProviderState))])

(impl ModelProvider QueuedFakeProvider
  (provider-name [(self (ptr QueuedFakeProvider))] (-> (slice u8)) "queued-fake")
  (execute-model [(self (ptr QueuedFakeProvider))
                  (request (ptr ModelRequest))
                  (emitter (ptr EventEmitter))
                  (allocator (ptr Allocator))]
                 (-> ModelResult)
                 (let [state (load (field self state))
                       concurrent (+ (atomic-add (load (field state active)) 1) 1)]
                   (when (> concurrent (atomic-load (load (field state max-active))))
                     (atomic-store (load (field state max-active)) concurrent)
                     0)
                   (atomic-add (load (field state calls)) 1)
                   (sleep-ms 40)
                   (atomic-add (load (field state active)) -1)
                   (let [(mut response) (response-empty allocator)]
                     (store! (field response provider) "queued-fake")
                     (store! (field response model) (load (field request model)))
                     (store! (field response response-id) "queued-response")
                     (store! (field response output-text) "done")
                     (ModelOk (load response))))))

(defstruct QueuedProviderFactory
  [(provider (ptr QueuedFakeProvider))])

(impl RuntimeProviderFactory QueuedProviderFactory
  (resolve-runtime-provider [(self (ptr QueuedProviderFactory))
                             (allocator (ptr Allocator))
                             (provider-name (slice u8))]
                            (-> (Option (dyn ModelProvider)))
                            (if (str-eq provider-name "queued-fake")
                                (Some (load (field self provider)))
                                (None [(dyn ModelProvider)]))))

(defn controller-command [(allocator (ptr Allocator))] (-> Json)
  (let [(mut command) (json-object allocator)]
    (json-object-put! (mut command) "version" (json-integer allocator 1))
    (json-put-string! (mut command) "command_id" "controller-command")
    (json-put-string! (mut command) "run_id" "controller-run")
    (json-put-string! (mut command) "provider" "fake")
    (json-put-string! (mut command) "model" "fake-model")
    (json-put-string! (mut command) "prompt" "hello")
    (json-put-string! (mut command) "instructions" "test instructions")
    (json-object-put! (mut command) "timeout_ms" (json-integer allocator 5000))
    (load command)))

(deftest builds-and-retains-a-real-background-runtime-run
         (let [allocator (malloc-allocator)
               path "/tmp/coil-agent-harness-runtime-controller.jsonl"
               journal (alloc/stack EventJournal)
               sequence (box allocator i64 1)
               emitter (alloc/stack EventEmitter)
               mailbox (alloc/stack AuthorizationMailbox)
               registry (box allocator ToolRegistry (tool-registry-new allocator))
               provider (box allocator ControllerFakeProvider (zeroed ControllerFakeProvider))
               provider-factory
                 (box allocator
                      ControllerFakeProviderFactory
                      (let [factory (alloc/stack ControllerFakeProviderFactory)]
                        (store! (field factory provider) provider)
                        (load factory)))]
           (fs/write-file allocator path "")
           (match (event-journal-open allocator path true)
             (JournalOpenFailed [message] (assert false))
             (JournalOpened [opened] (store! journal opened)))
           (store! emitter (event-emitter-new journal sequence))
           (match (authorization-mailbox-open allocator)
             (AuthorizationMailboxOpenFailed [message] (assert false))
             (AuthorizationMailboxOpened [opened] (store! mailbox opened)))
           (let [controller
                   (box allocator
                        RuntimeRunController
                        (runtime-controller-new allocator
                                                registry
                                                provider-factory
                                                emitter
                                                mailbox
                                                path))
                 command (controller-command allocator)
                 request (runtime-model-request controller command allocator)]
             (assert (str-eq (load (field request run-id)) "controller-run"))
             (assert (str-eq (load (field request instructions)) "test instructions"))
             (assert-eq (load (field request timeout-ms)) 5000)
             (assert (> (load (field request deadline-monotonic-ms)) 0))
             (assert (!= (load (field request cancellation))
                         (cast (ptr CancellationToken) 0)))
             (assert-eq (runtime-controller-start-provider! controller command provider) 0)
             (assert-eq (al-len [ActiveRuntimeRun]
                                (load (field controller runs)))
                        1)
             (assert-eq (runtime-controller-start-provider! controller command provider) 0)
             (assert-eq (al-len [ActiveRuntimeRun]
                                (load (field controller runs)))
                        1)
             (let [(mut attempt) 0]
               (loop (if (or (= (al-len [ActiveRuntimeRun]
                                        (load (field controller runs)))
                                0)
                             (>= (load attempt) 200))
                         (break)
                         (do
                           (sleep-ms 5)
                           (runtime-controller-reap! controller)
                           (store! attempt (+ (load attempt) 1))))))
             (assert-eq (al-len [ActiveRuntimeRun]
                                (load (field controller runs)))
                        0)
             (assert-eq (runtime-controller-launch! controller
                                                    (let [(mut unknown) command]
                                                      (json-put-string! (mut unknown)
                                                                        "provider"
                                                                        "unknown")
                                                      (load unknown)))
                        -1))
           (let [recovery (event-journal-recover allocator path)]
             (assert (load (field recovery ok)))
             (assert-eq (al-len [Json] (load (field recovery events))) 2)
             (assert (str-eq (command-string (al-get [Json] (load (field recovery events)) 0)
                                             "event")
                             "run.started"))
             (assert (str-eq (command-string (al-get [Json] (load (field recovery events)) 1)
                                             "event")
                             "run.completed")))
           (authorization-mailbox-close! allocator mailbox)
           (event-journal-close! journal)))

(deftest drains-durable-runs-in-fifo-order-within-the-capacity-limit
         (let [allocator (malloc-allocator)
               domains-before (allocation-domain-live-count)
               path "/tmp/coil-agent-harness-runtime-queue.jsonl"
               journal (alloc/stack EventJournal)
               sequence (box allocator i64 1)
               emitter (alloc/stack EventEmitter)
               mailbox (alloc/stack AuthorizationMailbox)
               registry (box allocator ToolRegistry (tool-registry-new allocator))
               state (alloc/stack QueuedProviderState)]
           (store! (field state calls) (box allocator i64 0))
           (store! (field state active) (box allocator i64 0))
           (store! (field state max-active) (box allocator i64 0))
           (fs/write-file allocator path "")
           (match (event-journal-open allocator path true)
             (JournalOpenFailed [message] (assert false))
             (JournalOpened [opened] (store! journal opened)))
           (store! emitter (event-emitter-new journal sequence))
           (match (authorization-mailbox-open allocator)
             (AuthorizationMailboxOpenFailed [message] (assert false))
             (AuthorizationMailboxOpened [opened] (store! mailbox opened)))
           (let [provider
                   (box allocator
                        QueuedFakeProvider
                        (let [value (alloc/stack QueuedFakeProvider)]
                          (store! (field value state) state)
                          (load value)))
                 factory
                   (box allocator
                        QueuedProviderFactory
                        (let [value (alloc/stack QueuedProviderFactory)]
                          (store! (field value provider) provider)
                          (load value)))
                 controller
                   (box allocator
                        RuntimeRunController
                        (runtime-controller-new allocator
                                                registry
                                                factory
                                                emitter
                                                mailbox
                                                path))
                 (mut first) (controller-command allocator)
                 (mut second) (controller-command allocator)
                 (mut raced) (controller-command allocator)
                 (mut cancelled) (controller-command allocator)]
             (store! (field controller max-active-runs) 0)
             (json-put-string! (mut cancelled) "run_id" "queued-run-cancelled")
             (json-put-string! (mut cancelled) "provider" "queued-fake")
             (assert-eq (start-durable-run controller (load cancelled)) 0)
             (assert (match (cancel-durable-run controller (load cancelled))
                       (RunCancellationAccepted [] true)
                       (RunCancellationTerminalOrMissing [] false)
                       (RunCancellationFailed [] false)))
             (store! (field controller max-active-runs) 2)
             (json-put-string! (mut first) "run_id" "queued-run-one")
             (json-put-string! (mut first) "provider" "queued-fake")
             (json-put-string! (mut second) "run_id" "queued-run-two")
             (json-put-string! (mut second) "provider" "queued-fake")
             (emit-event emitter
                         0
                         (RunCreated)
                         "queued-run-one"
                         "queued-run-one"
                         ""
                         "queued-fake"
                         "fake-model"
                         (load first))
             (emit-event emitter
                         0
                         (RunCreated)
                         "queued-run-two"
                         "queued-run-two"
                         ""
                         "queued-fake"
                         "fake-model"
                         (load second))
             (assert-eq (start-durable-run controller (load first)) 0)
             (assert-eq (start-durable-run controller (load second)) 0)
             (let [(mut attempt) 0]
               (loop (if (or (and (= (atomic-load (load (field state calls))) 2)
                                  (= (atomic-load (load (field state active))) 0))
                             (>= (load attempt) 300))
                         (break)
                         (do
                           (sleep-ms 5)
                           (store! attempt (+ (load attempt) 1))))))
             (sleep-ms 20)
             (store! (field controller max-active-runs) 1)
             (json-put-string! (mut raced) "run_id" "completion-cancellation-race")
             (json-put-string! (mut raced) "provider" "queued-fake")
             (emit-event emitter
                         0
                         (RunCreated)
                         "completion-cancellation-race"
                         "completion-cancellation-race"
                         ""
                         "queued-fake"
                         "fake-model"
                         (load raced))
             (assert-eq (start-durable-run controller (load raced)) 0)
             (let [(mut attempt) 0]
               (loop (if (or (= (atomic-load (load (field state calls))) 3)
                             (>= (load attempt) 200))
                         (break)
                         (do
                           (sleep-ms 1)
                           (store! attempt (+ (load attempt) 1))))))
             (sleep-ms 20)
             (assert (match (cancel-durable-run controller (load raced))
                       (RunCancellationAccepted [] true)
                       (RunCancellationTerminalOrMissing [] true)
                       (RunCancellationFailed [] false)))
             (sleep-ms 40)
             (runtime-controller-join-all! controller)
             (assert-eq (atomic-load (load (field state calls))) 3)
             (assert-eq (atomic-load (load (field state max-active))) 2)
             (let [recovery (event-journal-recover allocator path)]
               (assert (load (field recovery ok)))
               (let [first-view (project-run (field recovery events) "queued-run-one")
                     second-view (project-run (field recovery events) "queued-run-two")
                     race-view
                       (project-run (field recovery events)
                                    "completion-cancellation-race")]
                 (assert (load (field first-view valid)))
                 (assert (load (field first-view terminal)))
                 (assert (load (field second-view valid)))
                 (assert (load (field second-view terminal)))
                 (assert (load (field race-view valid)))
                 (assert (load (field race-view terminal))))))
           (assert-eq (allocation-domain-live-count) domains-before)
           (authorization-mailbox-close! allocator mailbox)
           (event-journal-close! journal)))
