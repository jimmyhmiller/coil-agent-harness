;; The server loop against real sockets and real emitted events.
;;
;; Three subscribers, two of which want the same run, prove fan-out actually
;; reaches more than one socket. The last case kills a subscriber mid-stream,
;; which is what decides whether one broken client can hurt the others.
;;
;; That last case used to kill the process: writing to a closed peer raised
;; SIGPIPE, and nothing in Coil could take it off its default action. Fixed in
;; coil.socket (SO_NOSIGPIPE on Darwin, MSG_NOSIGNAL on Linux), so a closed peer
;; now surfaces as an ordinary write error and the subscriber is retired.
(module harness-bus-server-test)
(import "coil.primitive" :as primitive)

(import "coil.alloc" :as alloc :use *)
(import "coil.arraylist" :use *)
(import "coil.assert" :use *)
(import "coil.match" :use *)
(import "coil.slice" :use *)
(import "coil.socket" :as socket)
(import "coil.str" :as str :use *)
(import "harness-event" :use *)
(import "harness-event-journal" :use *)
(import "harness-json" :use *)
(import "harness-bus-protocol" :use *)
(import "harness-bus-frame" :use *)
(import "harness-bus-unix" :use *)
(import "harness-bus-router" :use *)
(import "harness-bus-publisher" :use *)
(import "harness-bus-observer" :use *)
(import "harness-bus-event-sink" :use *)
(import "harness-bus-server" :use *)

(extern unlink :cc c [(ptr i8)] (-> i32))

(const SOCKET_PATH "/tmp/harness-bus-server-test.sock")
(const JOURNAL_PATH "/tmp/harness-bus-server-test.jsonl")

(defn remove-path [(path (slice u8))] (-> i64)
  (let [c-path (str/str->cstr (malloc-allocator) path)]
    (if (= (cast i64 c-path) 0) 0 (do (unlink c-path) 0))))

;; Connect a client and complete the Subscribe handshake from its side.
(defn subscribe-client! [(allocator (dyn Allocator))
                         (client (ptr UnixTransport))
                         (codec (dyn Codec))
                         (topic (slice u8))] (-> bool)
  (if (!= (unix-transport-connect! client SOCKET_PATH) 0)
      false
      (let [envelope (primitive/alloc-stack Envelope)]
        (set! envelope (envelope-new "sub" (Agent "client") (Service) (Subscribe) topic))
        (try (let [bytes (try-or! (codec-encode codec allocator envelope) false)]
                  (= (frame-write! client bytes) FRAME_OK))))))

;; Read one event name off a client socket, or "" if nothing arrives.
(defn receive-event-kind [(transport (ptr UnixTransport))
                          (codec (dyn Codec))
                          (allocator (dyn Allocator))] (-> (slice u8))
  (let [out (primitive/alloc-stack (slice u8))
        envelope (primitive/alloc-stack Envelope)]
    (if (!= (frame-read transport allocator out) FRAME_OK)
        ""
        (try (let [_ (try-or! (codec-decode codec allocator (load out) envelope) "")]
                  (let [parsed (primitive/alloc-stack JsonParseResult)]
                    (store! parsed (json-parse allocator (load (field envelope body))))
                    (if (not (load (field parsed ok)))
                        ""
                        (match (json-string-at (load (field parsed value)) "event")
                          (Some [name] name)
                          (None [] "")))))))))

(defn emit-sample [(emitter (ptr EventEmitter)) (kind EventKind)] (-> i64)
  (emit-event emitter 1000 kind "chat-1" "op-1" "" "fake" "fake-model" (JsonNull)))

(deftest the-server-fans-one-run-out-to-every-subscriber-of-it
         (let [allocator (malloc-allocator)
               listener (primitive/alloc-stack socket/UnixListener)
               codec (primitive/alloc-stack MessagePackCodec)
               journal (primitive/alloc-stack EventJournal)
               observer (primitive/alloc-stack BusObserverSink)
               tee (primitive/alloc-stack TeeEventSink)
               emitter (primitive/alloc-stack EventEmitter)
               router (primitive/alloc-stack Router)
               server (primitive/alloc-stack BusServer)
               sequence (primitive/alloc-stack i64)
               watcher-a (primitive/alloc-stack UnixTransport)
               watcher-b (primitive/alloc-stack UnixTransport)
               bystander (primitive/alloc-stack UnixTransport)]
           (remove-path SOCKET_PATH)
           (remove-path JOURNAL_PATH)
           (match (socket/unix-listen listener SOCKET_PATH 8)
             (Err [_] (assert false))
             (Ok [_] 0))
           (match (event-journal-open allocator JOURNAL_PATH true)
             (JournalOpenFailed [message] (assert false))
             (JournalOpened [opened] (store! journal opened)))
           (bus-observer-init! observer allocator 64)
           (tee-event-sink-init! tee allocator journal observer)
           (store! sequence 1)
           (event-emitter-init! emitter allocator tee sequence)
           (store! router (router-new allocator))
           (bus-server-init! server allocator router observer codec)

           ;; Two subscribers want chat-1; one wants a different run entirely.
           (assert (subscribe-client! allocator watcher-a codec (run-topic allocator "chat-1")))
           (assert (= (bus-server-accept! server listener) 1))
           (assert (subscribe-client! allocator watcher-b codec (run-topic allocator "chat-1")))
           (assert (= (bus-server-accept! server listener) 1))
           (assert (subscribe-client! allocator bystander codec (run-topic allocator "chat-2")))
           (assert (= (bus-server-accept! server listener) 1))
           (assert (= (bus-server-live-count server) 3))

           (assert (> (emit-sample emitter (RunStarted)) 0))
           ;; One event, two recipients -- fan-out, not a broadcast to everyone.
           (assert (= (bus-server-drain! server) 2))
           (assert (= (receive-event-kind watcher-a codec allocator) "run.started"))
           (assert (= (receive-event-kind watcher-b codec allocator) "run.started"))

           (bus-server-close! server)
           (event-journal-close! journal)
           (socket/unix-listener-close! listener)
           (remove-path SOCKET_PATH)
           (remove-path JOURNAL_PATH)))

;; A client that connects and never sends its Subscribe frame must not become a
;; subscriber, and must not wedge the accept path.
(deftest a-client-that-never-subscribes-is-refused
         (let [allocator (malloc-allocator)
               listener (primitive/alloc-stack socket/UnixListener)
               codec (primitive/alloc-stack MessagePackCodec)
               observer (primitive/alloc-stack BusObserverSink)
               router (primitive/alloc-stack Router)
               server (primitive/alloc-stack BusServer)
               silent (primitive/alloc-stack UnixTransport)]
           (remove-path SOCKET_PATH)
           (match (socket/unix-listen listener SOCKET_PATH 8)
             (Err [_] (assert false))
             (Ok [_] 0))
           (bus-observer-init! observer allocator 16)
           (store! router (router-new allocator))
           (bus-server-init! server allocator router observer codec)

           (assert (= (unix-transport-connect! silent SOCKET_PATH) 0))
           ;; Close without ever sending a Subscribe frame.
           (transport-close! silent)
           (assert (= (bus-server-accept! server listener) -1))
           (assert (= (bus-server-live-count server) 0))

           (bus-server-close! server)
           (socket/unix-listener-close! listener)
           (remove-path SOCKET_PATH)))

;; A client that speaks the protocol but not the handshake is refused too,
;; rather than being guessed at.
(deftest a-client-that-sends-the-wrong-kind-is-refused
         (let [allocator (malloc-allocator)
               listener (primitive/alloc-stack socket/UnixListener)
               codec (primitive/alloc-stack MessagePackCodec)
               observer (primitive/alloc-stack BusObserverSink)
               router (primitive/alloc-stack Router)
               server (primitive/alloc-stack BusServer)
               client (primitive/alloc-stack UnixTransport)
               envelope (primitive/alloc-stack Envelope)]
           (remove-path SOCKET_PATH)
           (match (socket/unix-listen listener SOCKET_PATH 8)
             (Err [_] (assert false))
             (Ok [_] 0))
           (bus-observer-init! observer allocator 16)
           (store! router (router-new allocator))
           (bus-server-init! server allocator router observer codec)

           (assert (= (unix-transport-connect! client SOCKET_PATH) 0))
           (store! envelope
                   (envelope-new "x" (Agent "client") (Service) (Instruction) "run.chat-1"))
           (match (codec-encode codec allocator envelope)
             (Err [_] (assert false))
             (Ok [bytes] (assert (= (frame-write! client bytes) FRAME_OK))))
           (assert (= (bus-server-accept! server listener) -1))
           (assert (= (bus-server-live-count server) 0))

           (bus-server-close! server)
           (transport-close! client)
           (socket/unix-listener-close! listener)
           (remove-path SOCKET_PATH)))

;; The case that decides whether one broken client can hurt the others: a
;; subscriber whose socket is gone.
(deftest a-dead-subscriber-is-retired-and-the-others-keep-receiving
         (let [allocator (malloc-allocator)
               listener (primitive/alloc-stack socket/UnixListener)
               codec (primitive/alloc-stack MessagePackCodec)
               journal (primitive/alloc-stack EventJournal)
               observer (primitive/alloc-stack BusObserverSink)
               tee (primitive/alloc-stack TeeEventSink)
               emitter (primitive/alloc-stack EventEmitter)
               router (primitive/alloc-stack Router)
               server (primitive/alloc-stack BusServer)
               sequence (primitive/alloc-stack i64)
               doomed (primitive/alloc-stack UnixTransport)
               survivor (primitive/alloc-stack UnixTransport)]
           (remove-path SOCKET_PATH)
           (remove-path JOURNAL_PATH)
           (match (socket/unix-listen listener SOCKET_PATH 8)
             (Err [_] (assert false))
             (Ok [_] 0))
           (match (event-journal-open allocator JOURNAL_PATH true)
             (JournalOpenFailed [message] (assert false))
             (JournalOpened [opened] (store! journal opened)))
           (bus-observer-init! observer allocator 64)
           (tee-event-sink-init! tee allocator journal observer)
           (store! sequence 1)
           (event-emitter-init! emitter allocator tee sequence)
           (store! router (router-new allocator))
           (bus-server-init! server allocator router observer codec)

           (assert (subscribe-client! allocator doomed codec (run-topic allocator "chat-1")))
           (assert (= (bus-server-accept! server listener) 1))
           (assert (subscribe-client! allocator survivor codec (run-topic allocator "chat-1")))
           (assert (= (bus-server-accept! server listener) 1))
           (assert (= (bus-server-live-count server) 2))

           ;; The client goes away without telling the server.
           (transport-close! doomed)

           (assert (> (emit-sample emitter (RunStarted)) 0))
           (bus-server-drain! server)
           (assert (> (emit-sample emitter (RunCompleted)) 0))
           (bus-server-drain! server)

           ;; The survivor got everything; the dead one was dropped.
           (assert (= (receive-event-kind survivor codec allocator) "run.started"))
           (assert (= (receive-event-kind survivor codec allocator) "run.completed"))
           (assert (= (bus-server-live-count server) 1))

           (bus-server-close! server)
           (event-journal-close! journal)
           (socket/unix-listener-close! listener)
           (remove-path SOCKET_PATH)
           (remove-path JOURNAL_PATH)))

;; A client that connects and then goes silent must be refused on a bound, not
;; waited on. Once the bus shares a thread with the run service, waiting here
;; would stall every other client -- so this is a liveness test, not a politeness
;; one. It fails by hanging rather than by asserting, which is why the timeout
;; matters more than the return value.
(deftest a-silent-client-is-refused-on-a-deadline-rather-than-waited-on
         (let [allocator (malloc-allocator)
               listener (primitive/alloc-stack socket/UnixListener)
               codec (primitive/alloc-stack MessagePackCodec)
               observer (primitive/alloc-stack BusObserverSink)
               router (primitive/alloc-stack Router)
               server (primitive/alloc-stack BusServer)
               silent (primitive/alloc-stack UnixTransport)]
           (remove-path SOCKET_PATH)
           (match (socket/unix-listen listener SOCKET_PATH 8)
             (Err [_] (assert false))
             (Ok [_] 0))
           (bus-observer-init! observer allocator 16)
           (store! router (router-new allocator))
           (bus-server-init! server allocator router observer codec)

           ;; Connect and deliberately send nothing, holding the socket open.
           (assert (= (unix-transport-connect! silent SOCKET_PATH) 0))
           (assert (= (bus-server-accept! server listener) -1))
           (assert (= (bus-server-live-count server) 0))

           (transport-close! silent)
           (bus-server-close! server)
           (socket/unix-listener-close! listener)
           (remove-path SOCKET_PATH)))

;; Polling with a short accept timeout must not report a phantom subscriber when
;; nothing is pending -- the serve loop calls this on every tick.
(deftest polling-an-idle-listener-reports-nothing-pending
         (let [allocator (malloc-allocator)
               listener (primitive/alloc-stack socket/UnixListener)
               codec (primitive/alloc-stack MessagePackCodec)
               observer (primitive/alloc-stack BusObserverSink)
               router (primitive/alloc-stack Router)
               server (primitive/alloc-stack BusServer)]
           (remove-path SOCKET_PATH)
           (match (socket/unix-listen listener SOCKET_PATH 8)
             (Err [_] (assert false))
             (Ok [_] 0))
           (bus-observer-init! observer allocator 16)
           (store! router (router-new allocator))
           (bus-server-init! server allocator router observer codec)
           (assert (= (bus-server-accept-for! server listener 1) 0))
           (assert (= (bus-server-live-count server) 0))
           (bus-server-close! server)
           (socket/unix-listener-close! listener)
           (remove-path SOCKET_PATH)))
