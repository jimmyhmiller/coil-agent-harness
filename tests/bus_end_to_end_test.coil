;; The grounding test.
;;
;; Everything else in the bus suite tests one layer against fakes. This runs the
;; real thing: a real EventEmitter, writing through a real EventJournal on disk
;; AND the bus observer sink, routed to a subscriber over a real unix socket,
;; decoded on the other side. If the bus is useful, this is the test that says
;; so; if it is only a pile of abstractions, this is the test that fails.
;;
;; It asserts three things a per-layer test cannot:
;;   * a subscriber receives real emitted events, in order, with real content;
;;   * the durable journal still gets every event (observing changed nothing);
;;   * a subscriber that stops reading cannot stall the run -- it loses events
;;     instead, and the loss is counted.
(module harness-bus-end-to-end-test)

(import "coil.primitive" :as primitive)

(import "coil.alloc" :as alloc :use *)
(import "coil.arraylist" :use *)
(import "coil.assert" :use *)
(import "coil.fs" :as fs)
(import "coil.match" :use *)
(import "coil.slice" :use *)
(import "coil.socket" :as socket)
(import "coil.str" :as str :use *)
(import "coil.time" :as time)
(import "harness-event" :use *)
(import "harness-event-journal" :use *)
(import "harness-json" :use *)
(import "harness-bus-protocol" :use *)
(import "harness-bus-frame" :use *)
(import "harness-bus-unix" :use *)
(import "harness-bus-router" :use *)
(import "harness-bus-publisher" :use *)
(import "harness-bus-observer" :use *)
(import "harness-bus-event-sink" :use *)

(extern unlink :cc c [(ptr i8)] (-> i32))

(const SOCKET_PATH "/tmp/harness-bus-e2e-test.sock")
(const JOURNAL_PATH "/tmp/harness-bus-e2e-test.jsonl")

(defn remove-path [(path (slice u8))] (-> i64)
  (let [c-path (str/str->cstr (malloc-allocator) path)]
    (if (= (cast i64 c-path) 0) 0 (do (unlink c-path) 0))))

(defn connect-pair [(listener (ptr socket/UnixListener))
                    (client (ptr UnixTransport))
                    (server (ptr UnixTransport))] (-> bool)
  (remove-path SOCKET_PATH)
  (try (let [_ (try-or! (socket/unix-listen listener SOCKET_PATH 8) false)]
            (if (!= (unix-transport-connect! client SOCKET_PATH) 0)
                false
                (match (time/duration-seconds 2)
                  (Err [_] false)
                  (Ok [duration]
                      (let [accepted (primitive/alloc-stack socket/UnixConnection)]
                        (match (socket/unix-accept-for listener accepted duration)
                          (Err [_] false)
                          (Ok [_]
                              (do
                                (unix-transport-adopt! server (load accepted))
                                true))))))))))

;; Move everything the observer queued onto the subscriber's transport. This is
;; the loop a real server runs; keeping it in the test until it earns a module
;; keeps the shape honest.
(defn drain-to-subscriber! [(sink (ptr BusObserverSink))
                            (router (ptr Router))
                            (codec (dyn Codec))
                            (allocator (dyn Allocator))
                            (transport (ptr UnixTransport))
                            (handle i64)] (-> i64)
  (let [pending (bus-observer-pending sink)
        (mut i) 0
        (mut sent) 0]
    (loop (if (>= (load i) pending)
              (break)
              (let [envelope (bus-observer-at sink (load i))
                    (mut recipients) (al-new [i64] allocator)]
                (router-recipients router envelope (mut recipients))
                (let [n (al-len [i64] (load recipients))
                      (mut r) 0]
                  (loop (if (>= (load r) n)
                            (break)
                            (do
                              (when (= (al-get [i64] (load recipients) (load r)) handle)
                                (match (codec-encode codec allocator envelope)
                                  (Err [_] 0)
                                  (Ok [bytes]
                                      (do
                                        (frame-write! transport bytes)
                                        (store! sent (+ (load sent) 1))
                                        0))))
                              (set! r (+ (load r) 1)))))
                  (set! i (+ (load i) 1))))))
    (bus-observer-clear! sink)
    (load sent)))

;; Read one envelope back off the wire and report the `event` field of its body.
(defn receive-event-kind [(transport (ptr UnixTransport))
                          (codec (dyn Codec))
                          (allocator (dyn Allocator))] (-> (slice u8))
  (let [out (primitive/alloc-stack (slice u8))
        envelope (primitive/alloc-stack Envelope)]
    (if (!= (frame-read transport allocator out) FRAME_OK)
        ""
        (try (let [_ (try-or! (codec-decode codec allocator (load out) envelope)
                              "")]
                  ;; The body is the journal's own canonical event JSON, so a
                  ;; subscriber reads exactly what the journal recorded.
                  (let [parsed (primitive/alloc-stack JsonParseResult)]
                    (store! parsed (json-parse allocator (load (field envelope body))))
                    (if (not (load (field parsed ok)))
                        ""
                        (match (json-string-at (load (field parsed value)) "event")
                          (Some [name] name)
                          (None [] "")))))))))

(defn emit-sample [(emitter (ptr EventEmitter)) (kind EventKind)] (-> i64)
  (emit-event emitter 1000 kind "chat-1" "op-1" "" "fake" "fake-model" (JsonNull)))

(deftest a-subscriber-receives-real-emitted-events-over-a-socket
         (let [allocator (malloc-allocator)
               listener (primitive/alloc-stack socket/UnixListener)
               client (primitive/alloc-stack UnixTransport)
               server (primitive/alloc-stack UnixTransport)
               codec (primitive/alloc-stack MessagePackCodec)
               journal (primitive/alloc-stack EventJournal)
               observer (primitive/alloc-stack BusObserverSink)
               tee (primitive/alloc-stack TeeEventSink)
               emitter (primitive/alloc-stack EventEmitter)
               router (primitive/alloc-stack Router)
               sequence (primitive/alloc-stack i64)]
           (remove-path JOURNAL_PATH)
           (assert (connect-pair listener client server))
           (match (event-journal-open allocator JOURNAL_PATH true)
             (JournalOpenFailed [message] (assert false))
             (JournalOpened [opened] (store! journal opened)))
           (bus-observer-init! observer allocator 64)
           (tee-event-sink-init! tee allocator journal observer)
           (store! sequence 1)
           (event-emitter-init! emitter allocator tee sequence)
           (store! router (router-new allocator))

           (let [subscriber (router-attach! router (Agent "tui-1"))]
             (router-subscribe! router subscriber (run-topic allocator "chat-1"))

             ;; Real events, through the real emitter.
             (assert (> (emit-sample emitter (RunCreated)) 0))
             (assert (> (emit-sample emitter (RunStarted)) 0))
             (assert (> (emit-sample emitter (RunCompleted)) 0))

             (assert (= (bus-observer-pending observer) 3))
             (assert (= (drain-to-subscriber! observer
                                              router
                                              codec
                                              allocator
                                              server
                                              subscriber)
                        3))

             ;; The subscriber sees real events, in emission order.
             (assert (= (receive-event-kind client codec allocator) "run.created"))
             (assert (= (receive-event-kind client codec allocator) "run.started"))
             (assert (= (receive-event-kind client codec allocator) "run.completed")))

           (event-journal-close! journal)

           ;; Observing must not have cost the durable record anything.
           (let [recovery (primitive/alloc-stack JournalRecovery)]
             (store! recovery (event-journal-recover allocator JOURNAL_PATH))
             (assert (load (field recovery ok)))
             (assert (= (al-len [Json] (load (field recovery events))) 3))
             (assert (= (load (field recovery last-sequence)) 3)))

           (transport-close! client)
           (transport-close! server)
           (socket/unix-listener-close! listener)
           (remove-path SOCKET_PATH)
           (remove-path JOURNAL_PATH)))

;; The promise the whole design rests on: a subscriber that stops reading loses
;; events, and the run keeps going.
(deftest a-subscriber-that-stops-reading-cannot-stall-the-run
         (let [allocator (malloc-allocator)
               journal (primitive/alloc-stack EventJournal)
               observer (primitive/alloc-stack BusObserverSink)
               tee (primitive/alloc-stack TeeEventSink)
               emitter (primitive/alloc-stack EventEmitter)
               sequence (primitive/alloc-stack i64)]
           (remove-path JOURNAL_PATH)
           (match (event-journal-open allocator JOURNAL_PATH true)
             (JournalOpenFailed [message] (assert false))
             (JournalOpened [opened] (store! journal opened)))
           ;; A queue far smaller than the number of events, and nobody draining.
           (bus-observer-init! observer allocator 4)
           (tee-event-sink-init! tee allocator journal observer)
           (store! sequence 1)
           (event-emitter-init! emitter allocator tee sequence)

           (let [(mut i) 0]
             (loop (if (>= (load i) 20)
                       (break)
                       (do
                         ;; Every emission still succeeds -- the run is never
                         ;; blocked by the fact that nobody is listening.
                         (assert (> (emit-sample emitter (RunStarted)) 0))
                         (store! i (+ (load i) 1))))))

           ;; The queue held its bound and the loss was counted, not hidden.
           (assert (= (bus-observer-pending observer) 4))
           (assert (= (bus-observer-dropped observer) 16))

           (event-journal-close! journal)

           ;; Crucially, the DURABLE record is complete. Only the observer lost
           ;; events; the journal is the source of truth and is untouched.
           (let [recovery (primitive/alloc-stack JournalRecovery)]
             (store! recovery (event-journal-recover allocator JOURNAL_PATH))
             (assert (load (field recovery ok)))
             (assert (= (al-len [Json] (load (field recovery events))) 20)))
           (remove-path JOURNAL_PATH)))
