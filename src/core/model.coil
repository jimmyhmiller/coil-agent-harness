(module harness-model)

(import "coil.alloc" :as alloc :use *)
(import "coil.arraylist" :use *)
(import "coil.str" :use *)
(import "harness-json" :use *)
(import "harness-tool" :use *)
(import "harness-event" :use *)

(defsum MessageRole
  (SystemRole [])
  (UserRole [])
  (AssistantRole []))

(defstruct Message
  [(role MessageRole)
   (content (slice u8))])

(defsum ReasoningEffort
  (ReasoningNone [])
  (ReasoningLow [])
  (ReasoningMedium [])
  (ReasoningHigh [])
  (ReasoningXHigh [])
  (ReasoningMax []))

(defsum ModelToolChoice
  (ToolsAuto [])
  (ToolsNone [])
  (ToolsRequired [])
  (ToolForced [(name (slice u8))]))

;; Provider-neutral continuation data. `previous-output` is deliberately opaque to
;; the runtime: an adapter can preserve reasoning/signature items without projecting
;; them into a lossy common message format.
(defstruct ModelContinuation
  [(present bool)
   (previous-response-id (slice u8))
   ;; Provider-owned conversation/session handle (for example a Codex thread id).
   ;; This is deliberately separate from a response id: the two have different
   ;; continuation semantics and conflating them silently destroys cache reuse.
   (provider-session-id (slice u8))
   (previous-output Json)
   (tool-results (ptr (ArrayList ToolResult)))])

(defstruct ModelRequest
  [(run-id (slice u8))
   (operation-id (slice u8))
   (model (slice u8))
   (instructions (slice u8))
   (cache-key (slice u8))
   (prompt-cache-key (slice u8))
   (messages (ptr (ArrayList Message)))
   (tools (ptr ToolRegistry))
   (tool-authorizer (dyn ToolAuthorizer))
   (tool-choice ModelToolChoice)
   (parallel-tool-calls bool)
   (reasoning ReasoningEffort)
   (max-output-tokens i64)
   (timeout-ms i64)
   (deadline-monotonic-ms i64)
   (cancellation (ptr CancellationToken))
   (run-lifecycle (ptr i64))
   (continuation ModelContinuation)])

(defn model-request-cancelled? [(request (ptr ModelRequest))] (-> bool)
  (cancellation-requested? (load (field request cancellation))))

(defstruct ModelUsage
  [(input-tokens i64)
   (output-tokens i64)
   (reasoning-tokens i64)
   (cached-input-tokens i64)])

(defstruct ModelResponse
  [(provider (slice u8))
   (model (slice u8))
   (response-id (slice u8))
   (provider-session-id (slice u8))
   (output-text (slice u8))
   (tool-calls (ArrayList ToolCall))
   (usage ModelUsage)
   (raw-output Json)])

(defsum ModelFailureKind
  (ConfigurationFailure [])
  (TransportFailure [])
  (AuthenticationFailure [])
  (RateLimitFailure [])
  (ProviderFailure [])
  (ProtocolFailure [])
  (TimeoutFailure [])
  (CancelledFailure []))

(defstruct ModelFailure
  [(kind ModelFailureKind)
   (provider (slice u8))
   (status-code i64)
   (message (slice u8))
   (retryable bool)])

(defsum ModelResult
  (ModelOk [(response ModelResponse)])
  (ModelErr [(failure ModelFailure)]))

(defn model-response-clone-into [(target (ptr Allocator))
                                 (source ModelResponse)] (-> ModelResponse)
  (let [result (alloc/stack ModelResponse)
        (mut calls) (al-new [ToolCall] target)
        source-calls (field source tool-calls)
        (mut at) 0
        count (al-len [ToolCall] (load source-calls))]
    (al-reserve! [ToolCall] (mut calls) count)
    (loop (if (>= (load at) count)
              (break)
              (do
                (al-push! [ToolCall]
                          (mut calls)
                          (tool-call-clone-into target
                                                (al-get [ToolCall] (load source-calls) (load at))))
                (store! at (+ (load at) 1)))))
    (store! (field result provider)
            (json-copy-string target (load (field source provider))))
    (store! (field result model)
            (json-copy-string target (load (field source model))))
    (store! (field result response-id)
            (json-copy-string target (load (field source response-id))))
    (store! (field result provider-session-id)
            (json-copy-string target (load (field source provider-session-id))))
    (store! (field result output-text)
            (json-copy-string target (load (field source output-text))))
    (store! (field result tool-calls) (load calls))
    (store! (field result usage) (load (field source usage)))
    (store! (field result raw-output)
            (json-clone target (load (field source raw-output))))
    (load result)))

(defn model-failure-clone-into [(target (ptr Allocator))
                                (source ModelFailure)] (-> ModelFailure)
  (let [result (alloc/stack ModelFailure)]
    (store! (field result kind) (load (field source kind)))
    (store! (field result provider)
            (json-copy-string target (load (field source provider))))
    (store! (field result status-code) (load (field source status-code)))
    (store! (field result message)
            (json-copy-string target (load (field source message))))
    (store! (field result retryable) (load (field source retryable)))
    (load result)))

(defn model-result-clone-into [(target (ptr Allocator))
                               (source ModelResult)] (-> ModelResult)
  (match source
    (ModelOk [response] (ModelOk (model-response-clone-into target response)))
    (ModelErr [failure] (ModelErr (model-failure-clone-into target failure)))))

;; Capabilities are explicit provider-boundary facts used by routing and UIs. Cost
;; tier is a relative policy input (1 is cheapest), not a billing estimate.
(defstruct ProviderCapabilities
  [(streaming bool)
   (harness-tools bool)
   (parallel-tools bool)
   (reasoning bool)
   (subscription-auth bool)
   (cost-tier i64)])

(defn provider-capabilities-for [(name (slice u8))] (-> ProviderCapabilities)
  (let [capabilities (alloc/stack ProviderCapabilities)
        codex (or (str-eq name "codex") (str-eq name "codex-app-server"))
        claude (or (str-eq name "claude") (str-eq name "claude-anthropic"))]
    (store! (field capabilities streaming) true)
    (store! (field capabilities harness-tools) true)
    (store! (field capabilities parallel-tools) true)
    (store! (field capabilities reasoning) true)
    (store! (field capabilities subscription-auth) (or codex claude))
    (store! (field capabilities cost-tier)
            (cond (or (str-eq name "deepseek-openai")
                      (str-eq name "deepseek-anthropic"))
                    1
                  (or codex claude) 2
                  (or (str-eq name "openai")
                      (str-eq name "openai-responses"))
                    3
                  :else 0))
    (load capabilities)))

(deftrait ModelProvider [Self]
  (provider-name [(self (ptr Self))] (-> (slice u8)))
  (provider-capabilities [(self (ptr Self))] (-> ProviderCapabilities))
  (execute-model [(self (ptr Self))
                  (request (ptr ModelRequest))
                  (emitter (ptr EventEmitter))
                  (allocator (ptr Allocator))]
                 (-> ModelResult)))

(defn reasoning-effort-name [(effort ReasoningEffort)] (-> (slice u8))
  (match effort
    (ReasoningNone [] "none")
    (ReasoningLow [] "low")
    (ReasoningMedium [] "medium")
    (ReasoningHigh [] "high")
    (ReasoningXHigh [] "xhigh")
    (ReasoningMax [] "max")))

(defn message-role-name [(role MessageRole)] (-> (slice u8))
  (match role
    (SystemRole [] "system")
    (UserRole [] "user")
    (AssistantRole [] "assistant")))
