(defn write-slice [(fd i64) (value (slice u8))] (-> i64)
  (let [writer (alloc/stack io/Writer)]
    (match (io/write-all (io/fd-writer writer fd)
                         (cast (ptr i8) (slice-data [u8] value))
                         (slice-len [u8] value))
      (Ok [written] written)
      (Err [failure] -1))))

(defn write-line [(fd i64) (value (slice u8))] (-> i64)
  (write-slice fd value)
  (let [newline (alloc/stack (array u8 1))]
    (store! (index newline 0) (cast u8 10))
    (write-slice fd (slice-new [u8] (index newline 0) 1))))

;; Tool groups are a deliberately small runtime configuration seam. An absent
;; variable preserves the interactive harness defaults; factories can expose a
;; narrower registry without requiring a different binary.
(defn tool-group-enabled? [(allocator (ptr Allocator))
                           (name (slice u8))] (-> bool)
  (match (os/env-get allocator "HARNESS_TOOL_GROUPS")
    (Err [failure] true)
    (Ok [found]
      (match found
        (None [] true)
        (Some [configured]
          (let [(mut value) configured
                enabled
                  (match (str-find (os/owned-string-slice (load value)) name)
                    (Some [position] true)
                    (None [] false))]
            (os/owned-string-free allocator value)
            enabled))))))

(defn cli-usage [] (-> i64)
  (write-line 2 "COIL agent harness")
  (write-line 2 "usage: harness <run|tool> <openai|deepseek-openai|deepseek-anthropic|codex|claude> <model> <prompt>")
  (write-line 2 "       harness <login|logout> <codex|claude>")
  (write-line 2 "       harness tui [--plain] [journal-path]")
  (write-line 2 "       harness serve <port> <journal-path>")
  (write-line 2 "       harness factory run <factory-folder> [workspace] [model]")
  (write-line 2 "       harness peers [--all] [--realm <name>]")
  (write-line 2 "       harness send [--realm <name>] <peer> <message>")
  (write-line 2 "  run   allows the model to choose whether to call the echo tool")
  (write-line 2 "  tool  requires the model to call the echo tool")
  (write-line 2 "  peers lists reachable Claude Code sessions; --all keeps dead sockets")
  (write-line 2 "  send  delivers a message into a session's prompt queue")
  (write-line 2 "        <peer> is a name, pid, session id, name prefix, or uds: address")
  (write-line 2 "  --realm selects the peer namespace. 'claude-code' (the default) shares")
  (write-line 2 "        Claude Code's directories and interoperates with its sessions; any")
  (write-line 2 "        other name is a private namespace using the same protocol with no")
  (write-line 2 "        contact in either direction. HARNESS_BUS_REALM sets the default.")
  64)

(defn cli-factory-run-owned [(factory-directory (slice u8))
                              (requested-workspace (slice u8))
                              (model (slice u8))
                              (allocator (ptr Allocator))] (-> i64)
  (match (load-factory-definition allocator factory-directory)
    (FactoryInvalid [message] (do (write-line 2 message) 65))
    (FactoryLoaded [definition-value]
      (let [definition definition-value
            workspace
              (if (> (slice-len [u8] requested-workspace) 0)
                  requested-workspace
                  (let [root ".factory-workspaces"
                        (mut name) (sb-new allocator)]
                    (directory-create-all allocator root 448)
                    (sb-push-str! (mut name) (load (field definition name)))
                    (sb-push-str! (mut name) "-")
                    (sb-push-str! (mut name)
                                  (json-stringify allocator
                                    (json-integer allocator (now-ms))))
                    (let [created (path-join allocator root (sb-finish! (mut name)))]
                      (directory-create-all allocator created 448)
                      created)))
            runs-root (path-join allocator ".factory-runs" (load (field definition name)))
            (mut run-name) (sb-new allocator)]
        (directory-create-all allocator workspace 448)
        (directory-create-all allocator runs-root 448)
        (sb-push-str! (mut run-name)
                      (json-stringify allocator (json-integer allocator (now-ms))))
        (sb-push-str! (mut run-name) ".jsonl")
        (let [journal-path (path-join allocator runs-root (sb-finish! (mut run-name)))
              (mut journal) (cast (ptr EventJournal) 0)]
          (write-line 1 (concat-or-empty allocator "factory workspace: " workspace))
          (write-line 1 (concat-or-empty allocator "factory journal: " journal-path))
          (match (event-journal-open allocator journal-path true)
            (JournalOpenFailed [message] (do (write-line 2 message) 74))
            (JournalOpened [opened]
              (let [sequence (box allocator i64 1)
                    emitter (box allocator EventEmitter (zeroed EventEmitter))]
                (store! journal (box allocator EventJournal opened))
                (event-emitter-init! emitter allocator (load journal) sequence)
                (let [code (run-factory-definition allocator
                                                   definition
                                                   workspace
                                                   "codex"
                                                   model
                                                   emitter)]
                  (event-journal-close! journal)
                  code)))))))))

(defn cli-factory-run [(factory-directory (slice u8))
                        (workspace (slice u8))
                        (model (slice u8))] (-> i64)
  (let [owner (malloc-allocator)
        process-region (alloc/stack region/Region)]
    (region/region-init process-region owner)
    (let [result (cli-factory-run-owned factory-directory workspace model
                                         (region/region-allocator process-region))]
      (region/region-close! process-region)
      result)))

(defstruct CliEventSink [(allocator (ptr Allocator))])

(defn publish-cli-event [(self (ptr CliEventSink)) (event (ptr Event))] (-> i64)
  (let [scratch-region (alloc/stack region/Region)]
    (region/region-init scratch-region (load (field self allocator)))
    (let [scratch (region/region-allocator scratch-region)
          record (event-to-json scratch event)
          result (write-line 2 (json-stringify scratch record))]
      (region/region-close! scratch-region)
      result)))

(impl EventSink CliEventSink
  (publish-event [(self (ptr CliEventSink)) (event (ptr Event))]
                 (-> i64)
                 (publish-cli-event self event)))

(defstruct EchoTool [(reserved u8)])

(defn execute-echo [(self (ptr EchoTool))
                    (call (ptr ToolCall))
                    (allocator (ptr Allocator))] (-> ToolResult)
  (let [(mut result) (tool-result-empty (load (field call id)) (ToolSucceeded))]
    (store! (field result output) (load (field call arguments)))
    (load result)))

(impl ToolImplementation EchoTool
  (execute-tool [(self (ptr EchoTool))
                 (call (ptr ToolCall))
                 (context (ptr ToolExecutionContext))
                 (allocator (ptr Allocator))]
                (-> ToolResult)
                (execute-echo self call allocator)))

(defn echo-schema [(allocator (ptr Allocator))] (-> Json)
  (let [(mut text) (json-object allocator)
        (mut properties) (json-object allocator)
        (mut required) (json-array allocator)
        (mut schema) (json-object allocator)]
    (json-object-put! (mut text) "type" (JsonString "string"))
    (json-object-put! (mut properties) "text" (load text))
    (json-array-push! (mut required) (JsonString "text"))
    (json-object-put! (mut schema) "type" (JsonString "object"))
    (json-object-put! (mut schema) "properties" (load properties))
    (json-object-put! (mut schema) "required" (load required))
    (json-object-put! (mut schema) "additionalProperties" (JsonBool false))
    (load schema)))

(defn echo-definition [(allocator (ptr Allocator))] (-> ToolDefinition)
  (let [definition (alloc/stack ToolDefinition)
        implementation (box allocator EchoTool (zeroed EchoTool))]
    (store! (field (field definition spec) name) "echo")
    (store! (field (field definition spec) description)
            "Return the supplied text. Multiple calls may run in parallel.")
    (store! (field (field definition spec) input-schema) (echo-schema allocator))
    (store! (field (field definition spec) strict) true)
    (store! (field (field definition spec) effect) (ReadOnly))
    (store! (field (field definition spec) idempotent) true)
    (store! (field (field definition spec) timeout-ms) 10000)
    (store! (field definition implementation) implementation)
    (load definition)))

(defn make-request [(allocator (ptr Allocator))
                    (model (slice u8))
                    (prompt (slice u8))
                    (force-tool bool)
                    (registry (ptr ToolRegistry))] (-> ModelRequest)
  (let [request (alloc/stack ModelRequest)
        messages (box allocator (ArrayList Message) (al-new [Message] allocator))
        message (alloc/stack Message)]
    (store! (field message role) (UserRole))
    (store! (field message content) prompt)
    (al-push! [Message] messages (load message))
    (store! (field request run-id) "cli-run")
    (store! (field request operation-id) "model-1")
    (store! (field request model) model)
    (store! (field request instructions)
            "Be concise. Use tools when they are required by the request.")
    (store! (field request messages) messages)
    (store! (field request tools) registry)
    (store! (field request tool-choice)
            (if force-tool (ToolForced "echo") (ToolsAuto)))
    (store! (field request parallel-tool-calls) true)
    ; DeepSeek thinking mode rejects forced tool selection. The CLI's deterministic
    ; tool smoke test therefore disables reasoning; normal runs retain it.
    (store! (field request reasoning)
            (if force-tool (ReasoningNone) (ReasoningMedium)))
    (store! (field request max-output-tokens) 2048)
    (store! (field request timeout-ms) 120000)
    (store! (field request deadline-monotonic-ms) 0)
    (store! (field request cancellation) (cast (ptr CancellationToken) 0))
    (store! (field (field request continuation) present) false)
    (store! (field (field request continuation) previous-response-id) "")
    (store! (field (field request continuation) previous-output) (JsonNull))
    (store! (field (field request continuation) tool-results)
            (cast (ptr (ArrayList ToolResult)) 0))
    (load request)))

(defn cli-run-provider [(allocator (ptr Allocator))
                        (registry (ptr ToolRegistry))
                        (provider (dyn ModelProvider))
                        (model (slice u8))
                        (prompt (slice u8))
                        (force-tool bool)] (-> i64)
  (let [request
          (box allocator
               ModelRequest
               (make-request allocator model prompt force-tool registry))
        sequence (box allocator i64 1)
        sink (alloc/stack CliEventSink)
        policy (alloc/stack AgentRunPolicy)]
    (store! (field sink allocator) allocator)
    (let [emitter (box allocator EventEmitter (zeroed EventEmitter))]
      (event-emitter-init! emitter allocator sink sequence)
      (store! (field policy max-model-turns) 0)
      (store! (field policy max-parallel-tools) 8)
      (match (run-agent allocator
                        provider
                        request
                        emitter
                        (load policy))
        (ModelOk [response]
                 (let [success response]
                   (write-line 1 (load (field success output-text)))
                   0))
        (ModelErr [failure]
                  (let [failed failure]
                    (write-line 2 (load (field failed message)))
                    1))))))

(defn cli-run-owned [(provider-name (slice u8))
                     (model (slice u8))
                     (prompt (slice u8))
                     (force-tool bool)
                     (process-allocator (ptr Allocator))
                     (run-allocator (ptr Allocator))] (-> i64)
  (let [allocator run-allocator
        registry
          (box process-allocator
               ToolRegistry
               (tool-registry-new process-allocator))
        openai-context (box allocator OpenAIResponsesContext (openai-context-default allocator))
        deepseek-openai-context (box allocator DeepSeekOpenAIContext (deepseek-openai-context-default allocator))
        deepseek-anthropic-context
          (box allocator DeepSeekAnthropicContext (deepseek-anthropic-context-default allocator))
        cwd-result (os/current-dir allocator)
        cwd
          (match cwd-result
            (Ok [owned] (os/owned-string-slice owned))
            (Err [failure] "."))
        codex-context-value (box allocator CodexAppServerContext (codex-context cwd))
        claude-context-value (box allocator ClaudeAnthropicContext (claude-anthropic-context-default allocator))]
    (tool-register! registry (echo-definition process-allocator))
    (cond (str-eq provider-name "openai") (cli-run-provider allocator registry openai-context model prompt force-tool)
          (str-eq provider-name "deepseek-openai")
            (cli-run-provider allocator registry deepseek-openai-context model prompt force-tool)
          (str-eq provider-name "deepseek-anthropic")
            (cli-run-provider allocator registry deepseek-anthropic-context model prompt force-tool)
          (str-eq provider-name "codex")
            (cli-run-provider allocator registry codex-context-value model prompt force-tool)
          (str-eq provider-name "claude")
            (cli-run-provider allocator registry claude-context-value model prompt force-tool)
          :else
            (do
              (write-line 2 "unknown provider")
              64))))

(defn cli-run [(provider-name (slice u8))
               (model (slice u8))
               (prompt (slice u8))
               (force-tool bool)] (-> i64)
  (let [owner (malloc-allocator)
        process-region (alloc/stack region/Region)
        (mut result) 70]
    (region/region-init process-region owner)
    (let [process-allocator (region/region-allocator process-region)
          run-domain (allocation-domain-open process-allocator)]
      (when (allocation-domain-valid? run-domain)
        (store! result
                (cli-run-owned provider-name
                               model
                               prompt
                               force-tool
                               process-allocator
                               (allocation-domain-allocator run-domain)))
        0)
      (allocation-domain-close! process-allocator run-domain)
      (region/region-close! process-region)
      (load result))))

(defn cli-auth-token [(allocator (ptr Allocator))] (-> (slice u8))
  (match (os/env-get allocator "HARNESS_OPERATOR_TOKEN")
    (Ok [found]
        (match found
          (Some [value] (os/owned-string-slice value))
          (None []
                (match (os/env-get allocator "HARNESS_AUTH_TOKEN")
                  (Ok [legacy]
                      (match legacy
                        (Some [value] (os/owned-string-slice value))
                        (None [] "")))
                  (Err [failure] "")))))
    (Err [failure] "")))

(defn cli-observer-token [(allocator (ptr Allocator))] (-> (slice u8))
  (match (os/env-get allocator "HARNESS_OBSERVER_TOKEN")
    (Ok [found]
        (match found
          (Some [value] (os/owned-string-slice value))
          (None [] "")))
    (Err [failure] "")))

(defn cli-claude-auth [(login bool)] (-> i64)
  (let [owner (malloc-allocator)
        process-region (alloc/stack region/Region)]
    (region/region-init process-region owner)
    (let [allocator (region/region-allocator process-region)
          result
            (if login
                (claude-login allocator)
                (claude-logout allocator))]
      (region/region-close! process-region)
      result)))

(defn cli-codex-auth [(login bool)] (-> i64)
  (let [owner (malloc-allocator)
        process-region (alloc/stack region/Region)]
    (region/region-init process-region owner)
    (let [allocator (region/region-allocator process-region)
          result
            (if login
                (codex-direct-login allocator)
                (codex-direct-logout allocator))]
      (region/region-close! process-region)
      result)))

(defn cli-tui-owned [(journal-path (slice u8))
                     (force-plain bool)
                     (process-allocator (ptr Allocator))
                     (service-allocator (ptr Allocator))
                     (session-allocator (ptr Allocator))] (-> i64)
  (let [allocator service-allocator
        (mut journal) (cast (ptr EventJournal) 0)
        (mut overrides) (terminal-overrides-from-env process-allocator)]
    (when force-plain
      (store! (field overrides force-plain) true)
      0)
    (let [profile (terminal-detect-profile process-allocator (load overrides))]
      (block :tui
             (match (event-journal-open allocator journal-path true)
               (JournalOpenFailed [message]
                                  (do
                                    (write-line 2 message)
                                    (return-from :tui 74)))
               (JournalOpened [opened]
                              (store! journal (box allocator EventJournal opened))))
             (let [recovery (event-journal-recover allocator journal-path)]
               (when (not (load (field recovery ok)))
                 (write-line 2 (load (field recovery error)))
                 (event-journal-close! journal)
                 (return-from :tui 65))
               (let [sequence (box allocator i64 (+ (load (field recovery last-sequence)) 1))
                     emitter (box allocator EventEmitter (zeroed EventEmitter))
                     registry
                       (box process-allocator
                            ToolRegistry
                            (tool-registry-new process-allocator))
                     provider-factory
                       (box allocator
                            DefaultRuntimeProviderFactory
                            (zeroed DefaultRuntimeProviderFactory))
                     controller
                       (box allocator
                            RuntimeRunController
                            (runtime-controller-new allocator
                                                    registry
                                                    provider-factory
                                                    emitter
                                                    journal
                                                    journal-path))
                     service (box allocator RunService (zeroed RunService))]
                 (event-emitter-init! emitter allocator (load journal) sequence)
                 (when (< (default-runtime-provider-factory-init! provider-factory allocator) 0)
                   (write-line 2 "could not initialize runtime provider factory")
                   (event-journal-close! journal)
                   (return-from :tui 70))
                 (store! (field provider-factory tui-fixture)
                         (box process-allocator
                              TuiFixtureProvider
                              (zeroed TuiFixtureProvider)))
                 (when (tool-group-enabled? allocator "filesystem")
                   (register-filesystem-tools! registry process-allocator ".")
                   (register-search-text-tool! registry process-allocator ".")
                   0)
                 (when (tool-group-enabled? allocator "bash")
                   (register-bash-tool! registry process-allocator ".")
                   0)
                 (store! (field service allocator) allocator)
                 (store! (field service journal-path) journal-path)
                 (store! (field service journal) journal)
                 (store! (field service emitter) emitter)
                 (store! (field service controller) controller)
                 (when (tool-group-enabled? allocator "orchestration")
                   (register-orchestration-tools! registry process-allocator service)
                   0)
                 (when (< (service-recover-runs! service) 0)
                   (write-line 2 "could not recover durable runs")
                   (runtime-controller-join-all! controller)
                   (default-runtime-provider-factory-close! provider-factory)
                   (event-journal-close! journal)
                   (return-from :tui 65))
                 (let [result (tui-loop service session-allocator profile)]
                   (runtime-controller-join-all! controller)
                   (default-runtime-provider-factory-close! provider-factory)
                   (event-journal-close! journal)
                   (tui-output-reset service-allocator profile)
                   result)))))))

(defn cli-tui [(journal-path (slice u8)) (force-plain bool)] (-> i64)
  (let [owner (malloc-allocator)
        process-region (alloc/stack region/Region)
        session-region (alloc/stack region/Region)
        (mut result) 70]
    (region/region-init process-region owner)
    (let [process-allocator (region/region-allocator process-region)
          service-domain (allocation-domain-open process-allocator)]
      (when (allocation-domain-valid? service-domain)
        (let [service-allocator (allocation-domain-allocator service-domain)]
          (region/region-init session-region service-allocator)
          (store! result
                  (cli-tui-owned journal-path
                                 force-plain
                                 process-allocator
                                 service-allocator
                                 (region/region-allocator session-region)))
          ;; Every run worker is joined before the thread-confined session closes.
          (region/region-close! session-region))
        0)
      (allocation-domain-close! process-allocator service-domain)
      (region/region-close! process-region)
      (load result))))

(defn cli-tui-default [(force-plain bool)] (-> i64)
  (let [owner (malloc-allocator)
        scratch-region (alloc/stack region/Region)]
    (region/region-init scratch-region owner)
    (let [allocator (region/region-allocator scratch-region)
          state-root
            (match (os/env-get allocator "HARNESS_STATE_DIR")
              (Ok [configured]
                  (match configured
                    (Some [value] (os/owned-string-slice value))
                    (None []
                          (match (os/env-get allocator "HOME")
                            (Ok [home]
                                (match home
                                  (Some [value]
                                        (path-join allocator
                                                   (os/owned-string-slice value)
                                                   ".coil-harness"))
                                  (None [] "/tmp/coil-harness")))
                            (Err [home-failure] "/tmp/coil-harness")))))
              (Err [missing]
                   (match (os/env-get allocator "HOME")
                     (Ok [home]
                         (match home
                           (Some [value]
                                 (path-join allocator
                                            (os/owned-string-slice value)
                                            ".coil-harness"))
                           (None [] "/tmp/coil-harness")))
                     (Err [home-missing] "/tmp/coil-harness"))))
          runs-directory (path-join allocator state-root "runs")
          process-id (json-stringify allocator (json-integer allocator (process/id)))
          timestamp (json-stringify allocator (json-integer allocator (now-ms)))
          filename
            (concat-or-empty allocator
                             "tui."
                             (concat-or-empty allocator
                                              process-id
                                              (concat-or-empty allocator
                                                               "."
                                                               (concat-or-empty allocator
                                                                                timestamp
                                                                                ".jsonl"))))
          path (path-join allocator runs-directory filename)
          directory-result (directory-create-all allocator runs-directory 448)
          result
            (if (= directory-result 0)
                (cli-tui path force-plain)
                (do
                  (write-line 2 "error: could not create the Coil harness state directory")
                  73))]
      (region/region-close! scratch-region)
      result)))

(defn cli-serve-owned [(port-text (slice u8))
                       (journal-path (slice u8))
                       (process-allocator (ptr Allocator))
                       (service-allocator (ptr Allocator))] (-> i64)
  (let [allocator service-allocator
        auth-token (cli-auth-token process-allocator)
        observer-token (cli-observer-token process-allocator)
        service-auth (alloc/stack ServiceAuth)
        (mut journal) (cast (ptr EventJournal) 0)
        listener (alloc/stack HttpListener)]
    (block :serve
           (when (= (slice-len [u8] auth-token) 0)
             (write-line 2 "HARNESS_OPERATOR_TOKEN or HARNESS_AUTH_TOKEN must be set and non-empty")
             (return-from :serve 78))
           (store! (field service-auth operator-token) auth-token)
           (store! (field service-auth observer-token) observer-token)
           (let [port
                   (match (str-parse-int port-text)
                     (Some [value] value)
                     (None []
                           (do
                             (write-line 2 "serve port must be an integer")
                             (return-from :serve 64))))]
             (when (or (< port 0) (> port 65535))
               (write-line 2 "serve port must be between 0 and 65535")
               (return-from :serve 64))
             (match (event-journal-open allocator journal-path true)
               (JournalOpenFailed [message]
                                  (do
                                    (write-line 2 message)
                                    (return-from :serve 74)))
               (JournalOpened [opened]
                              (store! journal (box allocator EventJournal opened))))
             (let [recovery (event-journal-recover allocator journal-path)]
               (when (not (load (field recovery ok)))
                 (write-line 2 (load (field recovery error)))
                 (event-journal-close! journal)
                 (return-from :serve 65))
               (let [sequence
                       (box allocator
                            i64
                            (+ (load (field recovery last-sequence)) 1))
                     emitter (box allocator EventEmitter (zeroed EventEmitter))
                     registry
                       (box process-allocator
                            ToolRegistry
                            (tool-registry-new process-allocator))
                     provider-factory
                       (box allocator
                            DefaultRuntimeProviderFactory
                            (zeroed DefaultRuntimeProviderFactory))
                     controller
                       (box allocator
                            RuntimeRunController
                            (runtime-controller-new allocator
                                                    registry
                                                    provider-factory
                                                    emitter
                                                    journal
                                                    journal-path))
                     service (box allocator RunService (zeroed RunService))]
                 (event-emitter-init! emitter allocator (load journal) sequence)
                 (when (< (default-runtime-provider-factory-init! provider-factory allocator) 0)
                   (write-line 2 "could not initialize runtime provider factory")
                   (event-journal-close! journal)
                   (return-from :serve 70))
                 (store! (field provider-factory tui-fixture)
                         (box process-allocator
                              TuiFixtureProvider
                              (zeroed TuiFixtureProvider)))
                 (tool-register! registry (echo-definition process-allocator))
                 (when (tool-group-enabled? allocator "filesystem")
                   (register-filesystem-tools! registry process-allocator ".")
                   (register-search-text-tool! registry process-allocator ".")
                   0)
                 (when (tool-group-enabled? allocator "bash")
                   (register-bash-tool! registry process-allocator ".")
                   0)
                 (store! (field service allocator) allocator)
                 (store! (field service journal-path) journal-path)
                 (store! (field service journal) journal)
                 (store! (field service emitter) emitter)
                 (store! (field service controller) controller)
                 (when (tool-group-enabled? allocator "orchestration")
                   (register-orchestration-tools! registry process-allocator service)
                   0)
                 (match (http-listener-open allocator port)
                   (ListenerOpenFailed [message]
                                       (do
                                         (write-line 2 message)
                                         (default-runtime-provider-factory-close! provider-factory)
                                         (event-journal-close! journal)
                                         (return-from :serve 69)))
                   (ListenerOpened [opened] (store! listener opened)))
                 (when (< (service-recover-runs! service) 0)
                   (write-line 2 "could not recover durable runs")
                   (runtime-controller-join-all! controller)
                   (default-runtime-provider-factory-close! provider-factory)
                   (http-listener-close! listener)
                   (event-journal-close! journal)
                   (return-from :serve 65))
                 (write-line 2
                             (concat-or-empty allocator
                                              "listening on 127.0.0.1:"
                                              (json-stringify allocator
                                                              (json-integer allocator
                                                                            (load (field listener port))))))
                 (let [shutdown (alloc/stack ShutdownSignal)
                       (mut server-code) 0]
                   (store! shutdown (shutdown-signal-new))
                   (if (or (not (shutdown-signal-valid? shutdown))
                           (!= (shutdown-signal-install! shutdown) 0))
                       (do
                         (write-line 2 "could not install shutdown signal handlers")
                         (store! server-code -1))
                       (store! server-code
                               (serve-run-service-until-shutdown allocator
                                                                 listener
                                                                 service
                                                                 service-auth
                                                                 shutdown)))
                   (shutdown-signal-close! shutdown)
                   (runtime-controller-join-all! controller)
                   (default-runtime-provider-factory-close! provider-factory)
                   (http-listener-close! listener)
                   (event-journal-close! journal)
                   (if (= (load server-code) 0) 0 74))))))))

(defn cli-serve [(port-text (slice u8))
                 (journal-path (slice u8))] (-> i64)
  (let [owner (malloc-allocator)
        process-region (alloc/stack region/Region)
        (mut result) 70]
    (region/region-init process-region owner)
    (let [process-allocator (region/region-allocator process-region)
          service-domain (allocation-domain-open process-allocator)]
      (when (allocation-domain-valid? service-domain)
        (store! result
                (cli-serve-owned port-text
                                 journal-path
                                 process-allocator
                                 (allocation-domain-allocator service-domain)))
        0)
      (allocation-domain-close! process-allocator service-domain)
      (region/region-close! process-region)
      (load result))))

;; ---------------------------------------------------------------------------
;; Claude Code peers
;; ---------------------------------------------------------------------------

(defn push-peer-field! [(buffer (mut StrBuf))
                        (separator (slice u8))
                        (value (slice u8))] (-> i64)
  (when (> (slice-len [u8] value) 0)
    (sb-push-str! (mut buffer) separator)
    (sb-push-str! (mut buffer) value)
    0)
  0)

;; ---------------------------------------------------------------------------
;; Argument scanning for the peer commands
;; ---------------------------------------------------------------------------
;;
;; These commands take an optional flag anywhere among their arguments, so the
;; positional shapes cannot be enumerated the way the older commands are without
;; multiplying cases. Scanning is smaller and keeps `--realm` from having to
;; sit in one fixed slot.

;; `--realm` is the only option carrying a value, so it is the only one whose
;; following token has to be skipped when counting positionals.
(defn cli-option-takes-value? [(name (slice u8))] (-> bool)
  (str-eq name "--realm"))

(defn cli-flag? [(count i64) (argv (ptr (ptr i8))) (name (slice u8))] (-> bool)
  (let [(mut found) false
        (mut i) 2]
    (loop (if (or (>= (load i) count) (load found))
              (break)
              (do
                (when (str-eq (cstr->str (load (index argv (load i)))) name)
                  (store! found true)
                  0)
                (store! i (+ (load i) 1)))))
    (load found)))

;; The value following `name`, or empty when absent. Empty is also what a
;; trailing `--realm` with nothing after it yields, which `cc-realm-init!`
;; already treats as "use the configured default".
(defn cli-option [(count i64)
                  (argv (ptr (ptr i8)))
                  (name (slice u8))] (-> (slice u8))
  (let [(mut value) ""
        (mut i) 2]
    (loop (if (or (>= (load i) count) (> (slice-len [u8] (load value)) 0))
              (break)
              (do
                (when (and (str-eq (cstr->str (load (index argv (load i)))) name)
                           (< (+ (load i) 1) count))
                  (store! value (cstr->str (load (index argv (+ (load i) 1)))))
                  0)
                (store! i (+ (load i) 1)))))
    (load value)))

;; The nth argument that is not a flag or a flag's value.
(defn cli-positional [(count i64)
                      (argv (ptr (ptr i8)))
                      (wanted i64)] (-> (slice u8))
  (let [(mut seen) 0
        (mut found) ""
        (mut i) 2]
    (loop (if (or (>= (load i) count) (> (slice-len [u8] (load found)) 0))
              (break)
              (let [argument (cstr->str (load (index argv (load i))))]
                (if (starts-with argument "--")
                    (store! i (+ (load i) (if (cli-option-takes-value? argument) 2 1)))
                    (do
                      (when (= (load seen) wanted)
                        (store! found argument)
                        0)
                      (store! seen (+ (load seen) 1))
                      (store! i (+ (load i) 1)))))))
    (load found)))

(defn cli-unknown-flag [(count i64) (argv (ptr (ptr i8)))] (-> (slice u8))
  (let [(mut bad) ""
        (mut i) 2]
    (loop (if (or (>= (load i) count) (> (slice-len [u8] (load bad)) 0))
              (break)
              (let [argument (cstr->str (load (index argv (load i))))]
                (if (starts-with argument "--")
                    (do
                      (when (not (or (str-eq argument "--all")
                                     (str-eq argument "--realm")))
                        (store! bad argument)
                        0)
                      (store! i (+ (load i) (if (cli-option-takes-value? argument) 2 1))))
                    (store! i (+ (load i) 1))))))
    (load bad)))

;; ---------------------------------------------------------------------------
;; Peer commands
;; ---------------------------------------------------------------------------

;; One line per peer. Unregistered peers print their address instead of a name
;; rather than being hidden: they are reachable, and a listing that omitted them
;; would misrepresent who is actually out there.
(defn cli-peers-in [(realm (ptr CcRealm))
                    (allocator (ptr Allocator))
                    (include-dead bool)] (-> i64)
  (let [(mut peers) (cc-discover realm allocator include-dead)
        n (al-len [CcPeer] peers)
        (mut printed) 0
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (let [peer (al-elem [CcPeer] (mut peers) (load i))
                    (mut line) (sb-new allocator)]
                ;; The session we are running inside is hidden unless asked
                ;; for. It is reachable, and messaging it would be a loop.
                (if (and (load (field peer self)) (not include-dead))
                    0
                    (do
                      (if (> (slice-len [u8] (load (field peer name))) 0)
                          (sb-push-str! (mut line) (load (field peer name)))
                          (sb-push-str! (mut line) (load (field peer address))))
                      (sb-push-str! (mut line) "  pid ")
                      (cc-push-decimal! (mut line) (load (field peer pid)))
                      (push-peer-field! (mut line) "  " (load (field peer kind)))
                      (push-peer-field! (mut line) "  " (load (field peer status)))
                      (push-peer-field! (mut line) "  " (load (field peer cwd)))
                      (when (not (load (field peer alive)))
                        (sb-push-str! (mut line) "  [dead socket]")
                        0)
                      (when (not (load (field peer registered)))
                        (sb-push-str! (mut line) "  [unregistered]")
                        0)
                      (when (load (field peer self))
                        (sb-push-str! (mut line) "  [self]")
                        0)
                      (write-line 1 (sb-str (load line)))
                      (store! printed (+ (load printed) 1))
                      0))
                (store! i (+ (load i) 1)))))
    ;; Counted rather than derived from the peer count, which would report
    ;; "found nothing" as a listing when the only peer present was ourselves.
    (when (= (load printed) 0)
      (write-line 2
                  (if (load (field realm interop))
                      "no reachable Claude Code sessions"
                      "no reachable peers in this realm"))
      0)
    0))

(defn cli-peers [(realm-name (slice u8)) (include-dead bool)] (-> i64)
  (let [owner (malloc-allocator)
        region (alloc/stack region/Region)]
    (region/region-init region owner)
    (let [allocator (region/region-allocator region)
          realm (alloc/stack CcRealm)]
      (cc-realm-init! realm allocator realm-name)
      (cli-peers-in realm allocator include-dead)
      (region/region-close! region)
      0)))

(defn cli-peer-send [(realm-name (slice u8))
                     (target (slice u8))
                     (message (slice u8))] (-> i64)
  (let [owner (malloc-allocator)
        region (alloc/stack region/Region)]
    (region/region-init region owner)
    (let [allocator (region/region-allocator region)
          realm (alloc/stack CcRealm)
          identity (alloc/stack CcIdentity)]
      (cc-realm-init! realm allocator realm-name)
      ;; No reply address: this process does not bind a socket, so a reply has
      ;; nowhere to go. The message still delivers -- reachability never
      ;; required registration -- it simply cannot be answered.
      (cc-identity-init! identity "" "coil-harness" "bypass")
      (let [outcome (cc-peer-send realm allocator identity target message "")]
        (if (= outcome CC_SEND_OK)
            (do (region/region-close! region) 0)
            (do
              (write-line 2 (cc-send-error-name outcome))
              (region/region-close! region)
              69))))))

(defn main [(argc i32) (argv (ptr (ptr i8)))] (-> i64)
  (let [count (cast i64 argc)]
    (if (< count 2)
        (cli-usage)
        (let [command (cstr->str (load (index argv 1)))]
          (if (or (str-eq command "login") (str-eq command "logout"))
              (if (= count 3)
                  (let [provider (cstr->str (load (index argv 2)))
                        login (str-eq command "login")]
                    (cond (str-eq provider "codex") (cli-codex-auth login)
                          (str-eq provider "claude") (cli-claude-auth login)
                          :else (cli-usage)))
                  (cli-usage))
              (if (str-eq command "factory")
                  (if (and (>= count 4)
                           (<= count 6)
                           (str-eq (cstr->str (load (index argv 2))) "run"))
                      (cli-factory-run
                        (cstr->str (load (index argv 3)))
                        (if (>= count 5) (cstr->str (load (index argv 4))) "")
                        (if (>= count 6)
                            (cstr->str (load (index argv 5)))
                            "gpt-5.6-luna"))
                      (cli-usage))
              (if (str-eq command "tui")
                  (cond (= count 2) (cli-tui-default false)
                        (= count 3)
                          (let [argument (cstr->str (load (index argv 2)))]
                            (if (str-eq argument "--plain")
                                (cli-tui-default true)
                                (cli-tui argument false)))
                        (= count 4)
                          (if (str-eq (cstr->str (load (index argv 2))) "--plain")
                              (cli-tui (cstr->str (load (index argv 3))) true)
                              (cli-usage))
                        :else (cli-usage))
                  (if (str-eq command "peers")
                      (if (> (slice-len [u8] (cli-unknown-flag count argv)) 0)
                          (cli-usage)
                          (cli-peers (cli-option count argv "--realm")
                                     (cli-flag? count argv "--all")))
                      (if (str-eq command "send")
                          (let [target (cli-positional count argv 0)
                                message (cli-positional count argv 1)]
                            (if (or (> (slice-len [u8] (cli-unknown-flag count argv)) 0)
                                    (or (= (slice-len [u8] target) 0)
                                        (= (slice-len [u8] message) 0)))
                                (cli-usage)
                                (cli-peer-send (cli-option count argv "--realm")
                                               target
                                               message)))
                          (if (str-eq command "serve")
                              (if (= count 4)
                                  (cli-serve (cstr->str (load (index argv 2)))
                                             (cstr->str (load (index argv 3))))
                                  (cli-usage))
                              (if (< count 5)
                                  (cli-usage)
                                  (let [provider (cstr->str (load (index argv 2)))
                                        model (cstr->str (load (index argv 3)))
                                        prompt (cstr->str (load (index argv 4)))]
                                    (cond (str-eq command "run") (cli-run provider model prompt false)
                                          (str-eq command "tool") (cli-run provider model prompt true)
                                          :else (cli-usage))))))))))))))
