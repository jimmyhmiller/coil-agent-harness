(module harness-default-tools)

(import "coil.alloc" :as alloc :use *)
(import "coil.match" :use *)
(import "coil.os" :as os)
(import "coil.primitive" :as primitive)
(import "coil.slice" :use *)
(import "coil.str" :use *)
(import "harness-json" :use *)
(import "harness-tool" :use *)

;;; Exact membership in a comma-separated tool-group list. Registration grants
;;; execution authority, so a substring such as `not-bash` must never enable the
;;; `bash` group.
(defn tool-group-list-has? [(configured (slice u8))
                            (name (slice u8))] (-> bool)
  (let [n (slice-len [u8] configured)
        (mut start) 0
        (mut at) 0
        (mut found) false]
    (loop (if (or (> (load at) n) (load found))
              (break)
              (if (or (= (load at) n)
                      (= (cast i64 (slice-get [u8] configured (load at))) 44))
                  (do
                    (when (= (subslice [u8] configured (load start) (load at)) name)
                      (set! found true)
                      0)
                    (set! start (+ (load at) 1))
                    (set! at (+ (load at) 1)))
                  (set! at (+ (load at) 1)))))
    (load found)))

;;; Tool groups are a deliberately small runtime configuration seam. An absent
;;; variable preserves the interactive harness defaults; factories can expose a
;;; narrower registry without requiring a different binary.
(defn tool-group-enabled? [(allocator (dyn Allocator))
                           (name (slice u8))] (-> bool)
  (match (os/env-get allocator "HARNESS_TOOL_GROUPS")
    (Err [failure] true)
    (Ok [found]
        (match found
          (None [] true)
          (Some [configured]
                (let [(mut value) configured
                      enabled
                        (tool-group-list-has? (os/owned-string-slice (load value)) name)]
                  (os/owned-string-free allocator value)
                  enabled))))))

(defstruct EchoTool [(reserved u8)])

(defn execute-echo [(self (ptr EchoTool))
                    (call (ptr ToolCall))
                    (allocator (dyn Allocator))] (-> ToolResult)
  (let [(mut result) (tool-result-empty (.id call) (ToolSucceeded))]
    (set! (.output result) (.arguments call))
    (load result)))

(impl ToolImplementation EchoTool
  (execute-tool [(self (ptr EchoTool))
                 (call (ptr ToolCall))
                 (context (ptr ToolExecutionContext))
                 (allocator (dyn Allocator))]
                (-> ToolResult)
                (execute-echo self call allocator)))

(defn echo-schema [(allocator (dyn Allocator))] (-> Json)
  (let [(mut text) (json-object allocator)
        (mut properties) (json-object allocator)
        (mut required) (json-array allocator)
        (mut schema) (json-object allocator)]
    (json-object-put! (mut text) "type" (JsonString "string"))
    (json-object-put! (mut properties) "text" (load text))
    (json-array-push! (mut required) (JsonString "text"))
    (json-object-put! (mut schema) "type" (JsonString "object"))
    (json-object-put! (mut schema) "properties" (load properties))
    (json-object-put! (mut schema) "required" (load required))
    (json-object-put! (mut schema) "additionalProperties" (JsonBool false))
    (load schema)))

(defn echo-definition [(allocator (dyn Allocator))] (-> ToolDefinition)
  (let [definition (primitive/alloc-stack ToolDefinition)
        implementation (box! allocator EchoTool (zeroed EchoTool))]
    (set! (.name (.spec definition)) "echo")
    (set! (.description (.spec definition)) "Return the supplied text. Multiple calls may run in parallel.")
    (set! (.input-schema (.spec definition)) (echo-schema allocator))
    (set! (.strict (.spec definition)) true)
    (set! (.effect (.spec definition)) (ReadOnly))
    (set! (.idempotent (.spec definition)) true)
    (set! (.timeout-ms (.spec definition)) 10000)
    (set! (.implementation definition) implementation)
    (load definition)))
