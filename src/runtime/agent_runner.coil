(module harness-agent-runner)

(import "coil.primitive" :as primitive)

(import "coil.alloc" :as alloc :use *)
(import "coil.arraylist" :use *)
(import "coil.atomic" :use *)
(import "coil.match" :use *)
(import "coil.scratch" :as scratch)
(import "coil.str" :use *)
(import "coil.thread" :use *)
(import "harness-event" :use *)
(import "harness-json" :use *)
(import "harness-model" :use *)
(import "coil.slice" :use *)
(import "harness-run-inbox" :use *)
(import "provider-common" :use *)
(import "harness-tool" :use *)
(import "harness-system" :use *)
(import "harness-tool-executor" :use *)

(defstruct AgentRunPolicy
  [(max-model-turns i64)
   (max-parallel-tools i64)])

(const MODEL_REQUEST_MAX_ATTEMPTS 3)
(const MODEL_REQUEST_RETRY_BASE_MS 250)

(const RUN_LIFECYCLE_QUEUED 0)
(const RUN_LIFECYCLE_RUNNING 1)
(const RUN_LIFECYCLE_CANCEL_RESERVED 2)
(const RUN_LIFECYCLE_CANCELLING 3)
(const RUN_LIFECYCLE_TERMINAL 4)

;; Caller-owned request/provider dependencies must outlive the handle. The job itself
;; is allocator-owned and its completion flag is safe to poll from another thread.
(defstruct AgentRunJob
  [(allocator (dyn Allocator))
   (provider (ptr (dyn ModelProvider)))
   (request (ptr ModelRequest))
   (emitter (ptr EventEmitter))
   (policy AgentRunPolicy)
   (result ModelResult)
   (lifecycle (ptr i64))
   (completed (ptr i64))])

(defn runner-terminal-event [(emitter (ptr EventEmitter))
                             (request (ptr ModelRequest))
                             (lifecycle (ptr i64))
                             (kind EventKind)
                             (payload Json)] (-> i64)
  (block :terminal
           (loop (let [state (atomic-load lifecycle)]
                   (cond (= state RUN_LIFECYCLE_CANCEL_RESERVED) 0
                         (= state RUN_LIFECYCLE_RUNNING)
                           (when (= (atomic-cas lifecycle
                                                RUN_LIFECYCLE_RUNNING
                                                RUN_LIFECYCLE_TERMINAL)
                                    RUN_LIFECYCLE_RUNNING)
                             (return-from :terminal (runner-event emitter request kind payload))
                             0)
                         (= state RUN_LIFECYCLE_CANCELLING)
                           (when (= (atomic-cas lifecycle
                                                RUN_LIFECYCLE_CANCELLING
                                                RUN_LIFECYCLE_TERMINAL)
                                    RUN_LIFECYCLE_CANCELLING)
                             (return-from :terminal (runner-event emitter request (RunCancelled) (JsonNull)))
                             0)
                         :else (return-from :terminal 0))))))

(defstruct AgentRunHandle
  [(thread Thread)
   (job (ptr AgentRunJob))
   (spawned bool)
   (joined bool)])

(defn runner-event [(emitter (ptr EventEmitter))
                    (request (ptr ModelRequest))
                    (kind EventKind)
                    (payload Json)] (-> i64)
  (emit-event emitter
              (now-ms)
              kind
              (.run-id request)
              (.operation-id request)
              ""
              "runtime"
              (.model request)
              payload))

(defn runner-model-operation-id [(allocator (dyn Allocator))
                                 (root-operation-id (slice u8))
                                 (turn i64)] (-> (slice u8))
  (let [(mut value) (sb-new allocator)]
    (sb-push-str! (mut value) root-operation-id)
    (sb-push-str! (mut value) ":model:")
    (sb-push-str! (mut value)
                  (json-stringify allocator (json-integer allocator turn)))
    (sb-finish! (mut value))))

;; Notification registration is the terminal action of an asynchronous setup
;; turn. Starts must continue through the model once so it can compose their
;; returned handles into notify_async; after that registration, another provider
;; round trip merely to say "registered" would keep the TUI busy unnecessarily.
(defn async-delegation-batch? [(calls (ptr (ArrayList ToolCall)))
                               (results (ptr (ArrayList ToolResult)))] (-> bool)
  (let [count (al-len [ToolCall] (load calls))
        (mut valid) (> count 0)
        (mut i) 0]
    (when (!= count (al-len [ToolResult] (load results)))
      (store! valid false)
      0)
    (loop (if (or (not (load valid)) (>= (load i) count))
              (break)
              (let [call (al-get [ToolCall] (load calls) (load i))
                    result (al-get [ToolResult] (load results) (load i))
                    succeeded
                      (match (.status result)
                        (ToolSucceeded [] true)
                        (_ false))]
                (when (or (not (= (load (field call name)) "notify_async"))
                          (not succeeded))
                  (store! valid false)
                  0)
                (set! i (+ (load i) 1)))))
    (load valid)))

(defn runner-budget-failure [] (-> ModelResult)
  (let [failure (primitive/alloc-stack ModelFailure)]
    (set! (.kind failure) (ConfigurationFailure))
    (set! (.provider failure) "runtime")
    (set! (.status-code failure) 0)
    (set! (.message failure) "model turn budget exhausted")
    (set! (.retryable failure) false)
    (ModelErr (load failure))))

(defn runner-stop-failure [(kind ModelFailureKind)
                           (message (slice u8))] (-> ModelResult)
  (let [failure (primitive/alloc-stack ModelFailure)]
    (set! (.kind failure) kind)
    (set! (.provider failure) "runtime")
    (set! (.status-code failure) 0)
    (set! (.message failure) message)
    (set! (.retryable failure) false)
    (ModelErr (load failure))))

;; A run deadline is opt-in: zero means the run has none, and that is the normal
;; case. The runner deliberately does NOT synthesise one from `timeout-ms` --
;; that field bounds a single HTTP request, and borrowing it as a run budget is
;; what used to fail long tasks. When there is no deadline this predicate is
;; false forever and the run ends only by finishing, failing, or cancellation.
(defn request-deadline-expired? [(request (ptr ModelRequest))] (-> bool)
  (let [deadline (.deadline-monotonic-ms request)]
    (and (> deadline 0) (= (deadline-remaining-ms deadline 0) 0))))

(defn request-cancelled? [(request (ptr ModelRequest))] (-> bool)
  (cancellation-requested? (load (field request cancellation))))

(defn runner-retry-event [(allocator (dyn Allocator))
                          (emitter (ptr EventEmitter))
                          (request (ptr ModelRequest))
                          (attempt i64)
                          (delay-ms i64)
                          (failure ModelFailure)] (-> i64)
  (let [(mut payload) (json-object allocator)]
    (json-object-put! (mut payload) "next_attempt" (json-integer allocator (+ attempt 1)))
    (json-object-put! (mut payload) "delay_ms" (json-integer allocator delay-ms))
    (json-object-put! (mut payload)
                      "status_code"
                      (json-integer allocator (.status-code failure)))
    (json-object-put! (mut payload)
                      "failure"
                      (JsonString (.message failure)))
    (runner-event emitter request (ModelRequestRetryScheduled) (load payload))))

;; Retry only failures explicitly classified by the provider as transient. The
;; same request and operation id are reused, so this neither loses continuation
;; state nor becomes an additional logical model turn.
(defn execute-model-with-retry [(allocator (dyn Allocator))
                                (provider (dyn ModelProvider))
                                (request (ptr ModelRequest))
                                (emitter (ptr EventEmitter))] (-> ModelResult)
  (let [(mut attempt) 0
        (mut done) false
        (mut result) (runner-stop-failure (ProtocolFailure) "model request did not run")]
    (loop (if (load done)
              (break)
              (do
                (set! attempt (+ (load attempt) 1))
                (let [turn-scratch (primitive/alloc-stack scratch/ScratchArena)]
                  (scratch/scratch-init turn-scratch (malloc-allocator))
                  (let [turn-result
                          (execute-model provider
                                         request
                                         emitter
                                         (scratch/scratch-allocator turn-scratch))]
                    (set! result (model-result-clone-into allocator turn-result)))
                  (scratch/scratch-close! turn-scratch))
                (match (load result)
                  (ModelOk [response] (set! done true))
                  (ModelErr [failure]
                    (let [failure-value failure]
                      (if (and (.retryable failure-value)
                               (< (load attempt) MODEL_REQUEST_MAX_ATTEMPTS)
                               (not (request-cancelled? request))
                               (not (request-deadline-expired? request)))
                          (let [delay-ms (* MODEL_REQUEST_RETRY_BASE_MS (load attempt))]
                            (runner-retry-event allocator
                                                emitter
                                                request
                                                (load attempt)
                                                delay-ms
                                                failure-value)
                            (sleep-ms delay-ms))
                          (set! done true))))))))
    (load result)))

;; Run the model/tool loop until the model produces no function calls, a provider
;; fails, or an explicitly configured positive turn limit is reached. Zero means
;; unlimited, which is the normal policy: an internal loop counter must not turn
;; unfinished work into a user-visible failure. Provider continuations retain
;; opaque prior output so reasoning/signature fields are never lost.
(defn run-agent [(allocator (dyn Allocator))
                 (provider (dyn ModelProvider))
                 (request (ptr ModelRequest))
                 (emitter (ptr EventEmitter))
                 (policy AgentRunPolicy)] (-> ModelResult)
  (let [current (box! allocator ModelRequest (load request))
        ;; Where a person can speak into this run while it is going.
        inbox (box! allocator RunInbox (inbox-open (load (field request inbox))))
        lifecycle
          (if (= (load (field request run-lifecycle)) (cast (ptr i64) 0))
              (box! allocator i64 RUN_LIFECYCLE_QUEUED)
              (load (field request run-lifecycle)))
        (mut turn) 0
        root-operation-id (.operation-id request)
        (mut finished) false
        owns-cancellation
          (= (load (field current cancellation))
             (cast (ptr CancellationToken) 0))
        (mut final) (runner-budget-failure)]
    (when owns-cancellation
      (store! (field current cancellation) (cancellation-token-new allocator))
      0)
    (set! (.run-lifecycle current) lifecycle)
    (atomic-cas lifecycle RUN_LIFECYCLE_QUEUED RUN_LIFECYCLE_RUNNING)
    (runner-event emitter request (RunStarted) (JsonNull))
    (loop (if (or (load finished)
                  (and (> (.max-model-turns policy) 0)
                       (>= (load turn) (.max-model-turns policy))))
              (break)
              (if (request-cancelled? current)
                  (do
                    (set! final
                          (runner-stop-failure (CancelledFailure)
                                               "agent run cancelled"))
                    (set! finished true)
                    (runner-terminal-event emitter
                                           request
                                           lifecycle
                                           (RunCancelled)
                                           (JsonNull)))
                  (if (request-deadline-expired? current)
                      (do
                        (set! final
                              (runner-stop-failure (TimeoutFailure)
                                                   "agent run deadline exceeded"))
                        (set! finished true)
                        (runner-terminal-event emitter
                                               request
                                               lifecycle
                                               (RunFailed)
                                               (JsonString "agent run deadline exceeded")))
                      (do
                        (set! turn (+ (load turn) 1))
                        (runner-deliver-messages! allocator current inbox emitter)
                        (set! (.operation-id current)
                              (runner-model-operation-id allocator
                                                         root-operation-id
                                                         (load turn)))
                        (let [model-result
                                (execute-model-with-retry allocator provider current emitter)]
                            (if (request-cancelled? current)
                                (do
                                  (set! final
                                        (runner-stop-failure (CancelledFailure)
                                                             "agent run cancelled"))
                                  (set! finished true)
                                  (runner-terminal-event emitter
                                                         request
                                                         lifecycle
                                                         (RunCancelled)
                                                         (JsonNull)))
                                (if (request-deadline-expired? current)
                                    (do
                                      (set! final
                                            (runner-stop-failure (TimeoutFailure)
                                                                 "agent run deadline exceeded"))
                                      (set! finished true)
                                      (runner-terminal-event emitter
                                                             request
                                                             lifecycle
                                                             (RunFailed)
                                                             (JsonString "agent run deadline exceeded")))
                                    (match model-result
                                      (ModelErr [failure]
                                                (let [failure-value failure]
                                                  (set! final (ModelErr failure))
                                                  (set! finished true)
                                                  (runner-terminal-event emitter
                                                                         request
                                                                         lifecycle
                                                                         (RunFailed)
                                                                         (JsonString (.message failure-value)))))
                                      (ModelOk [response]
                                               (let [response-value response
                                                     call-count
                                                       (al-len [ToolCall]
                                                               (.tool-calls response-value))]
                                                 (if (= call-count 0)
                                                     (do
                                                       (set! final (ModelOk response))
                                                       (set! finished true)
                                                       (runner-terminal-event emitter
                                                                              request
                                                                              lifecycle
                                                                              (RunCompleted)
                                                                              (JsonString (.response-id response-value))))
                                                     (let [calls
                                                             (box! allocator
                                                                  (ArrayList ToolCall)
                                                                  (load (field response-value tool-calls)))
                                                           execution (primitive/alloc-stack ToolExecutionRequest)]
                                                       (set! (.run-id execution) (.run-id current))
                                                       (set! (.parent-operation-id execution)
                                                             (.operation-id current))
                                                       (set! (.provider execution) (provider-name provider))
                                                       (set! (.model execution) (.model current))
                                                       (set! (.registry execution) (load (field current tools)))
                                                       (set! (.calls execution) calls)
                                                       (set! (.emitter execution) emitter)
                                                       (set! (.cancellation execution)
                                                             (load (field current cancellation)))
                                                       (set! (.run-deadline-monotonic-ms execution)
                                                             (.deadline-monotonic-ms current))
                                                       (set! (.max-parallel execution)
                                                             (.max-parallel-tools policy))
                                                       (let [batch (execute-tools-parallel allocator execution)
                                                             results
                                                               (box! allocator
                                                                    (ArrayList ToolResult)
                                                                    (load (field batch results)))]
                                                         (if (async-delegation-batch? calls results)
                                                             (do
                                                               (set! final (ModelOk response))
                                                               (set! finished true)
                                                               (runner-terminal-event emitter
                                                                                      request
                                                                                      lifecycle
                                                                                      (RunCompleted)
                                                                                      (JsonString (.response-id response-value))))
                                                             (do
                                                               (set! (.present (.continuation current)) true)
                                                               (set! (.previous-response-id (.continuation current))
                                                                     (.response-id response-value))
                                                               (set! (.previous-output (.continuation current))
                                                                     (.raw-output response-value))
                                                               (set! (.tool-results (.continuation current)) results)
                                                               (continuation-remember! allocator
                                                                                       (field current continuation)
                                                                                       (.raw-output response-value)
                                                                                       results)
                                                               ; Required/forced selection is an initial-turn constraint.
                                                               ; Continuing with it would force an endless tool loop after
                                                               ; the requested result has already been supplied.
                                                               (set! (.tool-choice current) (ToolsAuto))))))))))))))))))
    (when (not (load finished))
      (runner-terminal-event emitter
                             request
                             lifecycle
                             (RunFailed)
                             (JsonString "model turn budget exhausted"))
      0)
    (when owns-cancellation
      (cancellation-token-close! (load (field current cancellation)))
      0)
    (load final)))

;; Keep the turn that just finished. The list is created on first use so a
;; request that never continues carries nothing.
(defn continuation-remember! [(allocator (dyn Allocator))
                              (continuation (ptr ModelContinuation))
                              (output Json)
                              (results (ptr (ArrayList ToolResult)))] (-> i64)
  (when (= (cast i64 (load (field continuation turns))) 0)
    (store! (field continuation turns)
            (box! allocator (ArrayList ContinuationTurn) (al-new [ContinuationTurn] allocator)))
    0)
  (let [(mut turn) (zeroed ContinuationTurn)]
    (set! (.output turn) output)
    (set! (.results turn) results)
    (set! (.user-text turn) "")
    (al-push! [ContinuationTurn] (load (field continuation turns)) (load turn))
    0))

;; Put what a person said into the conversation, in order.
;;
;; Before the first model turn there is nothing to attach it to, so it joins the
;; prompt as another user message. After that it becomes a turn of its own, which
;; is what keeps "you said this after the second tool call" true in the
;; transcript the model reads.
;; What a person says arrives in the middle of a conversation the model is
;; already deep in, right after a tool result, where it reads like more context
;; rather than a change of orders. It is framed so it cannot be mistaken for
;; either: this is the person watching, and what they just said wins.
(defn interjection-text [(allocator (dyn Allocator)) (text (slice u8))] (-> (slice u8))
  (let [(mut framed) (sb-new allocator)]
    (sb-push-str! (mut framed)
                  "[message from the person watching this run — this arrived just now and takes precedence over the instructions you were given earlier. Follow it from here, and say what you are doing differently.]\n\n")
    (sb-push-str! (mut framed) text)
    (sb-finish! (mut framed))))

;; Returns where the message went: 0 into the prompt, because the model has not
;; said anything yet, and 1 as its own turn in the transcript. The journal
;; records which, because "the agent ignored me" and "the message went somewhere
;; the model does not read" look identical from outside.
;; A person's message is a change of orders, not an aside. Delivering it into the
;; turn gets it acted on now; adding it to the instructions is what keeps it true
;; afterwards. Without the second half an agent does the thing it was told and
;; then drifts back to its original assignment on the next turn, which is worse
;; than not listening at all.
(defn instructions-with-order [(allocator (dyn Allocator))
                               (instructions (slice u8))
                               (raw (slice u8))] (-> (slice u8))
  (let [(mut whole) (sb-new allocator)]
    (sb-push-str! (mut whole) instructions)
    (sb-push-str! (mut whole)
                  "\n\nStanding instruction from the person watching this run, given while it was running. It replaces any earlier instruction it contradicts, including the assignment, and stays in force for the rest of the run:\n")
    (sb-push-str! (mut whole) raw)
    (sb-finish! (mut whole))))

(defn continuation-interject! [(allocator (dyn Allocator))
                               (request (ptr ModelRequest))
                               (raw (slice u8))] (-> i64)
  (let [continuation (field request continuation)
        text (interjection-text allocator raw)]
    (store! (field request instructions)
            (instructions-with-order allocator
                                     (load (field request instructions))
                                     raw))
    (if (not (load (field continuation present)))
        (let [(mut spoken) (zeroed Message)]
          (set! (.role spoken) (UserRole))
          (set! (.content spoken) text)
          (al-push! [Message] (load (field request messages)) (load spoken))
          0)
        (do
          (when (= (cast i64 (load (field continuation turns))) 0)
            (store! (field continuation turns)
                    (box! allocator
                         (ArrayList ContinuationTurn)
                         (al-new [ContinuationTurn] allocator)))
            0)
          (let [turns (load (field continuation turns))
                n (al-len [ContinuationTurn] (load turns))]
            ;; Attach it to the turn that just finished rather than inventing an
            ;; empty one. A wire that pairs an assistant turn with exactly one
            ;; user turn then carries the message beside the tool results it
            ;; interrupted, which is where a person's words belong.
            (if (and (> n 0)
                     (= (slice-len [u8]
                                   (.user-text (al-elem [ContinuationTurn]
                                                        turns
                                                        (- n 1))))
                        0))
                (do
                  (set! (.user-text (al-elem [ContinuationTurn] turns (- n 1))) text)
                  1)
                (let [(mut turn) (zeroed ContinuationTurn)]
                  (set! (.output turn) (JsonNull))
                  (set! (.results turn) (cast (ptr (ArrayList ToolResult)) 0))
                  (set! (.user-text turn) text)
                  (al-push! [ContinuationTurn] turns (load turn))
                  1)))))))

;; Everything a person has said since the last turn. Draining here, immediately
;; before the model is asked anything, is what makes a message land at the first
;; moment the conversation can take one.
(defn runner-deliver-messages! [(allocator (dyn Allocator))
                                (request (ptr ModelRequest))
                                (inbox (ptr RunInbox))
                                (emitter (ptr EventEmitter))] (-> i64)
  (if (= (slice-len [u8] (.path inbox)) 0)
      0
      (let [messages (inbox-drain! allocator inbox)
            n (al-len [(slice u8)] messages)
            (mut i) 0]
        (loop (if (>= (load i) n)
                  (break)
                  (let [text (al-get [(slice u8)] messages (load i))
                        placement (continuation-interject! allocator request text)
                        (mut record) (json-object allocator)]
                    (json-put-string! (mut record) "text" text)
                    (json-put-string! (mut record)
                                      "placement"
                                      (if (= placement 0) "prompt" "turn"))
                    (json-object-put! (mut record)
                                      "turns"
                                      (json-integer allocator
                                                    (let [turns (load (field (field request continuation) turns))]
                                                      (if (= (cast i64 turns) 0)
                                                          0
                                                          (al-len [ContinuationTurn] (load turns))))))
                    (runner-event emitter request (OperatorMessageDelivered) (load record))
                    (set! i (+ (load i) 1)))))
        n)))

(defn agent-run-worker [(opaque (ptr i8))] (-> (ptr i8))
  (let [job (cast (ptr AgentRunJob) opaque)
        result
          (run-agent (load (field job allocator))
                     (load (load (field job provider)))
                     (load (field job request))
                     (load (field job emitter))
                     (.policy job))]
    (set! (.result job) result)
    (atomic-store (load (field job completed)) 1)
    (cast (ptr i8) 0)))

;; Start an owned background worker. Completion is observable through the same event
;; emitter as a foreground run; callers poll `agent-run-finished?` and eventually join.
;; The handle owns the request's cancellation resource and releases it during join.
(defn run-agent-background [(allocator (dyn Allocator))
                            (provider (dyn ModelProvider))
                            (request (ptr ModelRequest))
                            (emitter (ptr EventEmitter))
                            (policy AgentRunPolicy)] (-> AgentRunHandle)
  (let [job (box! allocator AgentRunJob (zeroed AgentRunJob))
        provider-cell (box! allocator (dyn ModelProvider) provider)
        completed (box! allocator i64 0)
        handle (primitive/alloc-stack AgentRunHandle)]
    (when (= (load (field request cancellation))
             (cast (ptr CancellationToken) 0))
      (store! (field request cancellation) (cancellation-token-new allocator))
      0)
    (set! (.allocator job) allocator)
    (set! (.provider job) provider-cell)
    (set! (.request job) request)
    (set! (.emitter job) emitter)
    (set! (.policy job) policy)
    (set! (.result job) (runner-budget-failure))
    (store! (field job lifecycle)
            (if (= (load (field request run-lifecycle)) (cast (ptr i64) 0))
                (box! allocator i64 RUN_LIFECYCLE_QUEUED)
                (load (field request run-lifecycle))))
    (set! (.run-lifecycle request) (load (field job lifecycle)))
    (set! (.completed job) completed)
    (set! (.job handle) job)
    (set! (.spawned handle)
          (= (thread-spawn (field handle thread)
                           (fnptr-of agent-run-worker)
                           (cast (ptr i8) job))
             0))
    (set! (.joined handle) false)
    (load handle)))

(defn agent-run-finished? [(handle (ptr AgentRunHandle))] (-> bool)
  (or (not (.spawned handle))
      (= (atomic-load (load (field (load (field handle job)) completed))) 1)))

(defn agent-run-cancel! [(handle (ptr AgentRunHandle))] (-> i64)
  (let [job (load (field handle job))
        request (load (field job request))]
    (cancellation-request! (load (field request cancellation)))))

;; Reserve cancellation against terminal publication. While reserved, the worker
;; cannot publish a terminal event; the controller durably publishes the request
;; and then calls `agent-run-confirm-cancellation!`.
(defn agent-run-reserve-cancellation! [(handle (ptr AgentRunHandle))] (-> i64)
  (let [lifecycle (load (field (load (field handle job)) lifecycle))]
    (block :reserve
             (loop (let [state (atomic-load lifecycle)]
                     (cond (= state RUN_LIFECYCLE_QUEUED) 0
                           (= state RUN_LIFECYCLE_RUNNING)
                             (when (= (atomic-cas lifecycle
                                                  RUN_LIFECYCLE_RUNNING
                                                  RUN_LIFECYCLE_CANCEL_RESERVED)
                                      RUN_LIFECYCLE_RUNNING)
                               (return-from :reserve 0)
                               0)
                           (= state RUN_LIFECYCLE_CANCEL_RESERVED) (return-from :reserve 1)
                           (= state RUN_LIFECYCLE_CANCELLING) (return-from :reserve 1)
                           :else (return-from :reserve -1)))))))

(defn agent-run-confirm-cancellation! [(handle (ptr AgentRunHandle))] (-> i64)
  (let [job (load (field handle job))
        request (load (field job request))]
    (cancellation-request! (load (field request cancellation)))
    (atomic-cas (load (field job lifecycle))
                RUN_LIFECYCLE_CANCEL_RESERVED
                RUN_LIFECYCLE_CANCELLING)
    0))

(defn agent-run-abort-cancellation! [(handle (ptr AgentRunHandle))] (-> i64)
  (atomic-cas (load (field (load (field handle job)) lifecycle))
              RUN_LIFECYCLE_CANCEL_RESERVED
              RUN_LIFECYCLE_RUNNING)
  0)

;; Join exactly once and return the terminal result. A second join is harmless and
;; returns the stored result. A spawn failure is reported as a configuration failure.
(defn agent-run-join [(handle (mut AgentRunHandle))] (-> ModelResult)
  (if (not (.spawned handle))
      (let [job (load (field handle job))
            failure (runner-budget-failure)]
        (when (not (load (field handle joined)))
          (cancellation-token-close! (load (field (load (field job request)) cancellation)))
          (store! (field handle joined) true)
          0)
        (match failure
          (ModelErr [value]
                    (let [(mut failed) value]
                      (set! (.message failed) "could not spawn agent worker")
                      (ModelErr (load failed))))
          (ModelOk [response] failure)))
      (do
        (when (not (load (field handle joined)))
          (thread-join (field handle thread))
          (cancellation-token-close! (load (field (load (field (load (field handle job)) request)) cancellation)))
          (store! (field handle joined) true)
          0)
        (.result (load (field handle job))))))
