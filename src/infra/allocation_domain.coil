(module harness-allocation-domain)

(import "coil.alloc" :as alloc :use *)
(import "coil.atomic" :use *)
(import "coil.match" :use *)
(import "coil.region" :as region)
(import "coil.result" :use *)
(import "coil.sync" :as sync)

(defstruct AllocationDomain
  [(region region/Region)
   (mutex sync/Mutex)
   (allocator Allocator)
   (valid bool)])

(defn allocation-domain-count-cell [] (-> (ptr i64))
  (alloc/static i64))

(defn allocation-domain-alloc [(context (ptr i8))
                               (size i64)
                               (alignment i64)] (-> (Option (ptr i8)))
  (let [domain (cast (ptr AllocationDomain) context)]
    (match (sync/mutex-lock! (field domain mutex))
      (Err [failure] (None))
      (Ok [locked]
          (let [result
                  (raw-alloc (region/region-allocator (field domain region))
                             size
                             alignment)]
            (sync/mutex-unlock! (field domain mutex))
            result)))))

(defn allocation-domain-resize [(context (ptr i8))
                                (pointer (ptr i8))
                                (old-size i64)
                                (new-size i64)
                                (alignment i64)] (-> (Option (ptr i8)))
  (let [domain (cast (ptr AllocationDomain) context)]
    (match (sync/mutex-lock! (field domain mutex))
      (Err [failure] (None))
      (Ok [locked]
          ;; Growable collections express their first allocation as
          ;; resize(NULL, 0, size). Region's resize hook linearly searches its
          ;; ownership list even for NULL, turning construction quadratic. Keep
          ;; these as distinct return paths: merging Option(pointer) aggregates
          ;; across this branch is currently miscompiled by LLVM -O3.
          (if (= old-size 0)
              (let [allocated
                      (raw-alloc (region/region-allocator (field domain region))
                                 new-size
                                 alignment)]
                (sync/mutex-unlock! (field domain mutex))
                allocated)
              (let [resized
                      (raw-resize (region/region-allocator (field domain region))
                                  pointer
                                  old-size
                                  new-size
                                  alignment)]
                (sync/mutex-unlock! (field domain mutex))
                resized))))))

(defn allocation-domain-free [(context (ptr i8))
                              (pointer (ptr i8))
                              (size i64)
                              (alignment i64)] (-> i64)
  (let [domain (cast (ptr AllocationDomain) context)]
    (match (sync/mutex-lock! (field domain mutex))
      (Err [failure] -1)
      (Ok [locked]
          (do
            (raw-free (region/region-allocator (field domain region))
                      pointer
                      size
                      alignment)
            (sync/mutex-unlock! (field domain mutex))
            0)))))

(defn allocation-domain-open [(owner (ptr Allocator))] (-> (ptr AllocationDomain))
  (let [domain (box owner AllocationDomain (zeroed AllocationDomain))]
    (region/region-init (field domain region) owner)
    (match (sync/mutex-init-with-allocator (field domain mutex) owner)
      (Err [failure]
           (do
             (region/region-close! (field domain region))
             (set! (.valid domain) false)))
      (Ok [mutex]
          (do
            (set! (.alloc (.allocator domain)) (fnptr-of allocation-domain-alloc))
            (set! (.resize (.allocator domain)) (fnptr-of allocation-domain-resize))
            (set! (.free (.allocator domain)) (fnptr-of allocation-domain-free))
            (set! (.ctx (.allocator domain)) (cast (ptr i8) domain))
            (set! (.valid domain) true)
            (atomic-add (allocation-domain-count-cell) 1))))
    domain))

(defn allocation-domain-valid? [(domain (ptr AllocationDomain))] (-> bool)
  (and (!= domain (cast (ptr AllocationDomain) 0))
       (.valid domain)))

(defn allocation-domain-allocator [(domain (ptr AllocationDomain))] (-> (ptr Allocator))
  (field domain allocator))

(defn allocation-domain-close! [(owner (ptr Allocator))
                                (domain (ptr AllocationDomain))] (-> i64)
  (when (!= domain (cast (ptr AllocationDomain) 0))
    (when (load (field domain valid))
      (sync/mutex-lock! (field domain mutex))
      (region/region-close! (field domain region))
      (store! (field domain valid) false)
      (sync/mutex-unlock! (field domain mutex))
      (sync/mutex-destroy! (field domain mutex))
      (atomic-add (allocation-domain-count-cell) -1)
      0)
    (destroy owner domain)
    0)
  0)

(defn allocation-domain-live-count [] (-> i64)
  (atomic-load (allocation-domain-count-cell)))
