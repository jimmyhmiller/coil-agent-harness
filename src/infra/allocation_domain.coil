(module harness-allocation-domain)
(import "coil.primitive" :as primitive)

(import "coil.alloc" :as alloc :use *)
(import "coil.atomic" :use *)
(import "coil.match" :use *)
(import "coil.region" :as region)
(import "coil.result" :use *)
(import "coil.sync" :as sync)

(defstruct AllocationDomain
  [(region region/Region)
   (mutex sync/Mutex)
   (valid bool)])

(defn allocation-domain-count-cell [] (-> (ptr i64))
  (primitive/alloc-static i64))

(defn allocation-domain-alloc [(domain (ptr AllocationDomain))
                               (request (ref AllocRequest))] (-> (Option (ptr i8)))
  (match (sync/mutex-lock! (field domain mutex))
    (Err [failure] (None))
    (Ok [locked]
        (let [result
                (raw-alloc (region/region-allocator (field domain region)) request)]
          (sync/mutex-unlock! (field domain mutex))
          result))))

(defn allocation-domain-resize [(domain (ptr AllocationDomain))
                                (pointer (ptr i8))
                                (old (ref AllocRequest))
                                (new (ref AllocRequest))] (-> bool)
  (match (sync/mutex-lock! (field domain mutex))
    (Err [failure] false)
    (Ok [locked]
        (let [resized
                (raw-resize (region/region-allocator (field domain region))
                            pointer
                            old
                            new)]
          (sync/mutex-unlock! (field domain mutex))
          resized))))

(defn allocation-domain-remap [(domain (ptr AllocationDomain))
                               (pointer (ptr i8))
                               (old (ref AllocRequest))
                               (new (ref AllocRequest))] (-> (Option (ptr i8)))
  (match (sync/mutex-lock! (field domain mutex))
    (Err [failure] (None))
    (Ok [locked]
        (let [remapped
                (raw-remap (region/region-allocator (field domain region))
                           pointer
                           old
                           new)]
          (sync/mutex-unlock! (field domain mutex))
          remapped))))

(defn allocation-domain-free [(domain (ptr AllocationDomain))
                              (pointer (ptr i8))
                              (request (ref AllocRequest))] (-> i64)
  (match (sync/mutex-lock! (field domain mutex))
    (Err [failure] -1)
    (Ok [locked]
        (do
          (raw-free (region/region-allocator (field domain region)) pointer request)
          (sync/mutex-unlock! (field domain mutex))
          0))))

(impl Allocator AllocationDomain
  (allocate [(self (ptr AllocationDomain)) (request (ref AllocRequest))]
            (-> (Option (ptr i8)))
            (allocation-domain-alloc self request))
  (resize [(self (ptr AllocationDomain))
           (memory (ptr i8))
           (old (ref AllocRequest))
           (new (ref AllocRequest))]
          (-> bool)
          (allocation-domain-resize self memory old new))
  (remap [(self (ptr AllocationDomain))
          (memory (ptr i8))
          (old (ref AllocRequest))
          (new (ref AllocRequest))]
         (-> (Option (ptr i8)))
         (allocation-domain-remap self memory old new))
  (deallocate [(self (ptr AllocationDomain))
               (memory (ptr i8))
               (request (ref AllocRequest))]
              (-> i64)
              (allocation-domain-free self memory request)))

(defn allocation-domain-open [(owner (dyn Allocator))] (-> (ptr AllocationDomain))
  (let [domain (box! owner AllocationDomain (zeroed AllocationDomain))]
    (region/region-init (field domain region) owner)
    (match (sync/mutex-init-with-allocator (field domain mutex) owner)
      (Err [failure]
           (do
             (region/region-close! (field domain region))
             (set! (.valid domain) false)))
      (Ok [mutex]
          (do
            (set! (.valid domain) true)
            (atomic-add (allocation-domain-count-cell) 1))))
    domain))

(defn allocation-domain-valid? [(domain (ptr AllocationDomain))] (-> bool)
  (and (!= domain (cast (ptr AllocationDomain) 0))
       (.valid domain)))

(defn allocation-domain-allocator [(domain (ptr AllocationDomain))] (-> (dyn Allocator))
  (primitive/make-dyn Allocator domain))

(defn allocation-domain-close! [(owner (dyn Allocator))
                                (domain (ptr AllocationDomain))] (-> i64)
  (when (!= domain (cast (ptr AllocationDomain) 0))
    (when (load (field domain valid))
      (sync/mutex-lock! (field domain mutex))
      (region/region-close! (field domain region))
      (store! (field domain valid) false)
      (sync/mutex-unlock! (field domain mutex))
      (sync/mutex-destroy! (field domain mutex))
      (atomic-add (allocation-domain-count-cell) -1)
      0)
    (destroy owner domain)
    0)
  0)

(defn allocation-domain-live-count [] (-> i64)
  (atomic-load (allocation-domain-count-cell)))
