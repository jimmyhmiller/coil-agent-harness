(module harness-http)

(import "coil.alloc" :as alloc :use *)
(import "coil.arraylist" :use *)
(import "coil.http.client" :as client)
(import "coil.primitive" :as primitive)
(import "coil.result" :use *)
(import "coil.slice" :use *)
(import "coil.str" :use *)
(import "harness-tool" :use *)

; Preserve the harness transport contract as its own exported constants instead
; of depending on coil.http.client constants leaking globally across modules.
(const BODY-CONTINUE 0)
(const BODY-STOP 1)

;; Providers reach HTTP only through StreamingHttpTransport; this module adapts
;; that boundary to coil.http.client. There is no longer any libcurl surface here
;; — both the buffered and the streaming path go through the client.

(defstruct HttpChunkSink
  [(context (ptr i8))
   (consume (fnptr c [(ptr u8) usize (ptr i8)] usize))])

(defstruct HttpRequest
  [(url (slice u8))
   (headers (ptr (ArrayList (slice u8))))
   (body (slice u8))
   (timeout-ms i64)
   (cancellation (ptr CancellationToken))
   (chunks HttpChunkSink)])

(defstruct HttpResponse
  [(transport-code i64)
   (status-code i64)
   (body (slice u8))
   (error (slice u8))])

;; Providers depend on this narrow streaming boundary rather than libcurl. Request
;; and response aggregates cross dynamic dispatch by pointer to keep the ABI stable
;; and to make complete byte-stream behavior injectable in contract tests.
(deftrait StreamingHttpTransport [Self]
  (send-streaming-http [(self (ptr Self))
                        (allocator (ptr Allocator))
                        (request (ptr HttpRequest))
                        (response (mut HttpResponse))]
                       (-> i64)))

(defstruct CurlStreamingHttpTransport [(reserved u8)])

(defstruct StreamingCapture
  [(sink HttpChunkSink)
   (body (ArrayList u8))
   (max-captured-bytes i64)])

(defn discard-http-chunk [(data (ptr u8)) (len usize) (context (ptr i8))] (-> usize)
  len)

;; Adapts the harness chunk sink to `coil.http.client`'s `BodySink`, and keeps the
;; capped copy of the body that the client does not: `request-stream` delivers
;; bytes and never buffers them, while `HttpResponse.body` is still expected to
;; hold the transcript up to `max-captured-bytes`.
;;
;; A harness sink reports how many bytes it accepted, and anything short of the
;; whole chunk is how it asks to stop — that is what `BODY-STOP` means here. The
;; bytes are transport-owned and only valid for this call, which is why the
;; retained copy is made before the sink is given a chance to stop.
(defn capture-streaming-chunk [(data (ptr u8))
                               (length i64)
                               (opaque (ptr i8))] (-> i64)
  (let [capture (cast (ptr StreamingCapture) opaque)
        current (al-len [u8] (.body capture))
        available (- (.max-captured-bytes capture) current)
        retained (if (< available length) available length)
        sink (field capture sink)]
    (when (> retained 0)
      (al-extend! [u8] (mut (field capture body)) data retained)
      0)
    (let [accepted
            (cast i64
                  (primitive/call-ptr (.consume sink)
                                      data
                                      (cast usize length)
                                      (load (field sink context))))]
      (if (< accepted length) BODY-STOP BODY-CONTINUE))))

(defn header-colon [(line (slice u8))] (-> i64)
  (let [(mut i) 0
        (mut found) -1]
    (loop (if (>= (load i) (slice-len [u8] line))
              (break)
              (if (= (cast i64 (slice-get [u8] line (load i))) 58)
                  (do (set! found (load i)) (break))
                  (set! i (+ (load i) 1)))))
    (load found)))

(defn request-headers [(allocator (ptr Allocator))
                       (lines (ptr (ArrayList (slice u8))))] (-> (slice client/Header))
  (let [(mut headers) (al-new [client/Header] allocator)
        (mut i) 0
        count (al-len [(slice u8)] (load lines))]
    (al-reserve! [client/Header] (mut headers) count)
    (loop (if (>= (load i) count)
              (break)
              (let [line (al-get [(slice u8)] (load lines) (load i))
                    colon (header-colon line)]
                (when (> colon 0)
                  (let [header (alloc/stack client/Header)
                        value-start
                          (if (and (< (+ colon 1) (slice-len [u8] line))
                                   (= (cast i64 (slice-get [u8] line (+ colon 1))) 32))
                              (+ colon 2)
                              (+ colon 1))]
                    (store! (field header name) (subslice [u8] line 0 colon))
                    (store! (field header value)
                            (subslice [u8] line value-start (slice-len [u8] line)))
                    (al-push! [client/Header] (mut headers) (load header))))
                (set! i (+ (load i) 1)))))
    (al-into-slice [client/Header] (mut headers))))

;; Adapt the harness's existing POST shape to Coil's supported HTTP client.
(defn http-post [(allocator (ptr Allocator)) (request (ptr HttpRequest))] (-> HttpResponse)
  (let [headers (request-headers allocator (load (field request headers)))
        native-request (alloc/stack client/Request)
        result (alloc/stack HttpResponse)]
    (set! (.transport-code result) 0)
    (set! (.status-code result) 0)
    (set! (.body result) "")
    (set! (.error result) "")
    (set! (.method native-request) "POST")
    (set! (.url native-request) (.url request))
    (set! (.headers native-request) headers)
    (set! (.body native-request) (.body request))
    (set! (.connect-timeout-ms native-request) (.timeout-ms request))
    (set! (.timeout-ms native-request) (.timeout-ms request))
    (set! (.follow-redirects native-request) false)
    (match (client/request allocator native-request)
      (Ok [response]
          (do
            (set! (.status-code result) (client/response-status response))
            (set! (.body result) (client/response-body response))))
      (Err [failure]
           (do
             (set! (.transport-code result) -1)
             (set! (.error result) "HTTP transport failed"))))
    (load result)))

;; Incremental transport for provider SSE, on `coil.http.client/request-stream`.
;;
;; The retained body is still ours to build: the client hands bytes to the sink
;; and buffers nothing, so `capture-streaming-chunk` keeps the capped copy that
;; `HttpResponse.body` promises.
(defn http-post-stream [(allocator (ptr Allocator))
                        (request (ptr HttpRequest))] (-> HttpResponse)
  (let [headers (request-headers allocator (load (field request headers)))
        native-request (alloc/stack client/Request)
        capture (alloc/stack StreamingCapture)
        sink (alloc/stack client/BodySink)
        result (alloc/stack HttpResponse)]
    (set! (.transport-code result) 0)
    (set! (.status-code result) 0)
    (set! (.body result) "")
    (set! (.error result) "")
    (set! (.sink capture) (.chunks request))
    (set! (.body capture) (al-new [u8] allocator))
    (set! (.max-captured-bytes capture) 1048576)
    (set! (.context sink) (cast (ptr i8) capture))
    (set! (.consume sink) (fnptr-of capture-streaming-chunk))
    (set! (.method native-request) "POST")
    (set! (.url native-request) (.url request))
    (set! (.headers native-request) headers)
    (set! (.body native-request) (.body request))
    ;; One budget covered both the connect and the total deadline before, and
    ;; `Request` splits them; keep them equal rather than quietly tightening one.
    (set! (.connect-timeout-ms native-request) (.timeout-ms request))
    (set! (.timeout-ms native-request) (.timeout-ms request))
    (set! (.follow-redirects native-request) false)
    (match (if (= (load (field request cancellation))
                  (cast (ptr CancellationToken) 0))
               (client/request-stream allocator native-request (load sink))
               (client/request-stream-cancellable allocator
                                                  native-request
                                                  (load sink)
                                                  (field (load (field request cancellation)) native)))
      (Ok [response]
          (do
            ;; A consumer stop is a successful transfer that ended early, not a
            ;; failure: the status and headers arrived before any body byte did.
            (set! (.status-code result) (client/streaming-response-status response))
            (client/streaming-response-free allocator response)
            0))
      (Err [failure]
           (do
             (set! (.transport-code result) -1)
             (set! (.error result) "HTTP streaming transport failed")
             (match failure
               (client/Transport [code message]
                                 (do
                                   (set! (.transport-code result) code)
                                   (when (> (slice-len [u8] message) 0)
                                     (store! (field result error) message)
                                     0)
                                   0))
               (client/OutOfMemory [] (set! (.error result) "out of memory"))
               (client/InvalidRequest [] (set! (.error result) "invalid request")))
             0)))
    ;; Whatever arrived before a failure is still worth reporting — the old
    ;; implementation returned it too, and a provider's error body is often the
    ;; only explanation of what went wrong.
    (set! (.body result) (al-into-slice [u8] (mut (.body capture))))
    (load result)))

(impl StreamingHttpTransport CurlStreamingHttpTransport
  (send-streaming-http [(self (ptr CurlStreamingHttpTransport))
                        (allocator (ptr Allocator))
                        (request (ptr HttpRequest))
                        (response (mut HttpResponse))]
                       (-> i64)
                       (do
                         (set! response (http-post-stream allocator request))
                         0)))

(defn streaming-http-send [(transport (dyn StreamingHttpTransport))
                           (allocator (ptr Allocator))
                           (request (ptr HttpRequest))] (-> HttpResponse)
  (let [response (alloc/stack HttpResponse)]
    (set! (.transport-code response) -1)
    (set! (.status-code response) 0)
    (set! (.body response) "")
    (set! (.error response) "streaming transport did not produce a response")
    (if (!= (send-streaming-http transport allocator request (mut response)) 0)
        (do
          (set! (.transport-code response) -1)
          (when (= (slice-len [u8] (load (field response error))) 0)
            (store! (field response error) "streaming transport failed")
            0))
        0)
    (load response)))
