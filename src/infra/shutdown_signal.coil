(module harness-shutdown-signal)

(import "coil.alloc" :as alloc :use *)

(extern harness_shutdown_open :cc c [] (-> (ptr i8)))
(extern harness_shutdown_install :cc c [(ptr i8)] (-> i64))
(extern harness_shutdown_request :cc c [(ptr i8)] (-> i64))
(extern harness_shutdown_requested :cc c [(ptr i8)] (-> i64))
(extern harness_shutdown_wait_listener :cc c [(ptr i8) i32 i32] (-> i64))
(extern harness_shutdown_close :cc c [(ptr i8)] (-> i64))

(defstruct ShutdownSignal
  [(handle (ptr i8))])

(defn shutdown-signal-new [] (-> ShutdownSignal)
  (let [shutdown (alloc/stack ShutdownSignal)]
    (store! (field shutdown handle) (harness_shutdown_open))
    (load shutdown)))

(defn shutdown-signal-valid? [(shutdown (ptr ShutdownSignal))] (-> bool)
  (!= (load (field shutdown handle)) (cast (ptr i8) 0)))

(defn shutdown-signal-install! [(shutdown (ptr ShutdownSignal))] (-> i64)
  (harness_shutdown_install (load (field shutdown handle))))

(defn shutdown-signal-request! [(shutdown (ptr ShutdownSignal))] (-> i64)
  (harness_shutdown_request (load (field shutdown handle))))

(defn shutdown-signal-requested? [(shutdown (ptr ShutdownSignal))] (-> bool)
  (= (harness_shutdown_requested (load (field shutdown handle))) 1))

(defn shutdown-signal-wait-listener [(shutdown (ptr ShutdownSignal))
                                     (listener-fd i64)
                                     (timeout-ms i64)] (-> i64)
  (harness_shutdown_wait_listener (load (field shutdown handle))
                                  (cast i32 listener-fd)
                                  (cast i32 timeout-ms)))

(defn shutdown-signal-close! [(shutdown (ptr ShutdownSignal))] (-> i64)
  (let [handle (load (field shutdown handle))]
    (if (= handle (cast (ptr i8) 0))
        0
        (do
          (store! (field shutdown handle) (cast (ptr i8) 0))
          (harness_shutdown_close handle)))))
