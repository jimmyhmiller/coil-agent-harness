(module harness-shutdown-signal)

(import "coil.alloc" :as alloc :use *)
(import "coil.atomic" :use *)

(extern signal
        :cc
        c
        [i32 (fnptr c [i32] i64)]
        (-> (fnptr c [i32] i64)))

(const HARNESS_SIGINT 2)
(const HARNESS_SIGTERM 15)

(defstruct ShutdownSignal
  [(requested (ptr i64))])

;; Signal handlers cannot safely allocate or take locks. This process-global
;; cell lets the handler perform one atomic store; the server observes it from
;; its bounded poll loop.
(defn shutdown-signal-cell [] (-> (ptr i64))
  (alloc/static i64))

(defn shutdown-signal-handle [(signal-number i32)] (-> i64)
  (atomic-store (shutdown-signal-cell) 1))

(defn shutdown-signal-new [] (-> ShutdownSignal)
  (let [shutdown (alloc/stack ShutdownSignal)]
    (atomic-store (shutdown-signal-cell) 0)
    (store! (field shutdown requested) (shutdown-signal-cell))
    (load shutdown)))

(defn shutdown-signal-install! [(shutdown (ptr ShutdownSignal))] (-> i64)
  (atomic-store (load (field shutdown requested)) 0)
  (signal HARNESS_SIGINT (fnptr-of shutdown-signal-handle))
  (signal HARNESS_SIGTERM (fnptr-of shutdown-signal-handle))
  0)

(defn shutdown-signal-request! [(shutdown (ptr ShutdownSignal))] (-> i64)
  (atomic-store (load (field shutdown requested)) 1))

(defn shutdown-signal-requested? [(shutdown (ptr ShutdownSignal))] (-> bool)
  (= (atomic-load (load (field shutdown requested))) 1))
