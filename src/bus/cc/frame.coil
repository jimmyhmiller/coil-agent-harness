;; Claude Code frames: newline-delimited JSON, one frame per line.
;;
;; The shape is small but every field is load-bearing in a way that is not
;; obvious from looking at it:
;;
;;   `session_id` is omitted rather than set. If it is present and does not
;;   equal the receiver's own session id, the frame is dropped SILENTLY -- no
;;   error, no receipt. Sending it speculatively converts a working message into
;;   an invisible one, so it is set only when deliberately pinning a session.
;;
;;   `from` is a reply address, not an identity claim. The receiver does resolve
;;   the connecting process's pid, but only to detect self-sends; nothing
;;   verifies `from`. It is here so replies have somewhere to go.
;;
;;   `priority` is `next` (what SendMessage uses, front of the queue) or
;;   `later`.
;;
;; The content field carries the `<cross-session-message>` envelope as text --
;; see envelope.coil for why identity rides inside a string rather than beside
;; it.
(module harness-bus-cc-frame)

(import "coil.alloc" :as alloc :use *)
(import "coil.fs" :as fs)
(import "coil.primitive" :as primitive)
(import "coil.io" :as io)
(import "coil.match" :use *)
(import "coil.result" :use *)
(import "coil.slice" :use *)
(import "coil.str" :use *)
(import "harness-json" :use *)

(const CC_MSG_VERSION 1)
(const CC_PEER_PROTOCOL 1)

;; A connection accumulating this much without a newline is dropped by the
;; receiver. Enforced on our side too, so an oversized frame fails where it is
;; built rather than as an unexplained disconnect.
(const CC_MAX_LINE_BYTES 1048576)

;; ---------------------------------------------------------------------------
;; Message ids
;; ---------------------------------------------------------------------------

;; Restated rather than imported: `coil.fs` exports this as a const, which the
;; module alias does not carry across.
(const CC_O_RDONLY 0)

;; Sixteen bytes from the kernel. `read-file` is not usable here: it reads to
;; EOF, and /dev/urandom has none.
(defn cc-random-bytes [(allocator (dyn Allocator))
                       (buffer (ptr u8))
                       (length i64)] (-> bool)
  (match (fs/file-open (str->cstr allocator "/dev/urandom") CC_O_RDONLY 0)
    (Err [failure] false)
    (Ok [opened]
        (let [file (primitive/alloc-stack fs/File)
              reader (primitive/alloc-stack io/Reader)]
          (set! file opened)
          (let [source (fs/file-reader reader file)
                outcome (io/read-exact source (cast (ptr i8) buffer) length)]
            (fs/file-close file)
            (match outcome
              (Err [failure] false)
              (Ok [_] true)))))))

(defn cc-hex-lower [(value i64)] (-> u8)
  (cast u8 (if (< value 10) (+ 48 value) (+ 87 value))))

;; A version 4 UUID, formatted as the receiver's own ids are. Randomness comes
;; from the kernel rather than a seeded generator because two harness processes
;; started in the same millisecond must not mint colliding ids -- a receipt is
;; matched to an outstanding message by this value alone.
(defn cc-new-message-id [(allocator (dyn Allocator))] (-> (slice u8))
  (let [bytes (primitive/alloc-stack (array u8 16))]
    (if (not (cc-random-bytes allocator (cast (ptr u8) bytes) 16))
        ""
        (do
          ;; Version 4 and the RFC 4122 variant, as the format requires.
          (set! (index bytes 6) (cast u8 (primitive/ior (primitive/iand (cast i64 (load (index bytes 6))) 15) 64)))
          (set! (index bytes 8) (cast u8 (primitive/ior (primitive/iand (cast i64 (load (index bytes 8))) 63) 128)))
          (let [(mut buffer) (sb-new allocator)
                (mut i) 0]
            (loop (if (>= (load i) 16)
                      (break)
                      (do
                        (when (or (or (= (load i) 4) (= (load i) 6))
                                  (or (= (load i) 8) (= (load i) 10)))
                          (sb-push-byte! (mut buffer) (cast u8 45))
                          0)
                        (let [byte (cast i64 (load (index bytes (load i))))]
                          (sb-push-byte! (mut buffer) (cc-hex-lower (/ byte 16)))
                          (sb-push-byte! (mut buffer) (cc-hex-lower (% byte 16))))
                        (set! i (+ (load i) 1)))))
            (sb-finish! (mut buffer)))))))

;; ---------------------------------------------------------------------------
;; Building frames
;; ---------------------------------------------------------------------------

;; A `user` frame: the one that lands in a session's prompt queue.
;;
;; `session-id` empty means "do not pin", which is almost always what you want.
;; `from` empty means "no reply address", which is legal -- a one-shot sender
;; that never listens can still deliver.
(defn cc-user-frame [(allocator (dyn Allocator))
                     (message-id (slice u8))
                     (content (slice u8))
                     (from (slice u8))
                     (priority (slice u8))
                     (session-id (slice u8))] (-> Json)
  (let [(mut frame) (json-object allocator)
        (mut message) (json-object allocator)]
    (json-object-put! (mut message) "role" (JsonString "user"))
    (json-object-put! (mut message) "content" (JsonString content))
    (json-object-put! (mut frame) "msgV" (json-integer allocator CC_MSG_VERSION))
    (json-object-put! (mut frame) "msg_id" (JsonString message-id))
    (json-object-put! (mut frame) "type" (JsonString "user"))
    (json-object-put! (mut frame) "message" (load message))
    (json-object-put! (mut frame)
                      "priority"
                      (JsonString (if (= (slice-len [u8] priority) 0) "next" priority)))
    (when (> (slice-len [u8] from) 0)
      (json-object-put! (mut frame) "from" (JsonString from))
      0)
    ;; Deliberately conditional. See the module comment: a mismatched
    ;; session_id is dropped without a trace.
    (when (> (slice-len [u8] session-id) 0)
      (json-object-put! (mut frame) "session_id" (JsonString session-id))
      0)
    (load frame)))

(defn cc-control-frame [(allocator (dyn Allocator))
                        (message-id (slice u8))
                        (action (slice u8))] (-> Json)
  (let [(mut frame) (json-object allocator)]
    (json-object-put! (mut frame) "msgV" (json-integer allocator CC_MSG_VERSION))
    (json-object-put! (mut frame) "msg_id" (JsonString message-id))
    (json-object-put! (mut frame) "type" (JsonString "control"))
    (json-object-put! (mut frame) "action" (JsonString action))
    (load frame)))

(defn cc-rename-frame [(allocator (dyn Allocator))
                       (message-id (slice u8))
                       (name (slice u8))] (-> Json)
  (let [(mut frame) (cc-control-frame allocator message-id "rename")]
    (json-object-put! (mut frame) "name" (JsonString name))
    (load frame)))

;; A delivery receipt for a message someone sent us. The receiver accepts one
;; only if `from` lives in the same socket directory as its own socket, so the
;; address here must be our real bound path.
(defn cc-status-frame [(allocator (dyn Allocator))
                       (message-id (slice u8))
                       (status (slice u8))
                       (reason (slice u8))
                       (from (slice u8))
                       (original-id (slice u8))] (-> Json)
  (let [(mut frame) (cc-control-frame allocator message-id "peer_message_status")]
    (json-object-put! (mut frame) "status" (JsonString status))
    (when (> (slice-len [u8] reason) 0)
      (json-object-put! (mut frame) "reason" (JsonString reason))
      0)
    (when (> (slice-len [u8] from) 0)
      (json-object-put! (mut frame) "from" (JsonString from))
      0)
    (json-object-put! (mut frame) "orig_msg_id" (JsonString original-id))
    (load frame)))

;; Serialize a frame as one NDJSON line, trailing newline included. Returns an
;; empty slice if the result would exceed what the receiver will read, so an
;; oversized frame fails here rather than as a dropped connection.
(defn cc-frame-line [(allocator (dyn Allocator)) (frame Json)] (-> (slice u8))
  (let [(mut buffer) (sb-new allocator)]
    (sb-push-str! (mut buffer) (json-stringify allocator frame))
    (sb-push-byte! (mut buffer) (cast u8 10))
    (let [line (sb-str (load buffer))]
      (if (> (slice-len [u8] line) CC_MAX_LINE_BYTES)
          ""
          (sb-finish! (mut buffer))))))

;; ---------------------------------------------------------------------------
;; Reading frames
;; ---------------------------------------------------------------------------

(defsum CcFrameKind
  (CcUserFrame [])
  (CcControlFrame [])
  (CcUnknownFrame []))

(defstruct CcFrame
  [(kind CcFrameKind)
   (message-id (slice u8))
   ;; `user` frames only: the raw `message.content`, still enveloped.
   (content (slice u8))
   (from (slice u8))
   (priority (slice u8))
   (session-id (slice u8))
   ;; `control` frames only.
   (action (slice u8))
   (status (slice u8))
   (name (slice u8))
   (original-id (slice u8))])

(defn cc-frame-init! [(frame (ptr CcFrame))] (-> i64)
  (set! (.kind frame) (CcUnknownFrame))
  (set! (.message-id frame) "")
  (set! (.content frame) "")
  (set! (.from frame) "")
  (set! (.priority frame) "")
  (set! (.session-id frame) "")
  (set! (.action frame) "")
  (set! (.status frame) "")
  (set! (.name frame) "")
  (set! (.original-id frame) "")
  0)

(defn cc-json-string-or [(value Json) (key (slice u8)) (fallback (slice u8))] (-> (slice u8))
  (match (json-string-at value key)
    (None [] fallback)
    (Some [text] text)))

;; Parse one NDJSON line. Returns false when the line is not JSON or not an
;; object; an unrecognized `type` parses successfully as CcUnknownFrame, because
;; a future frame kind is not a protocol error and must not drop the connection.
(defn cc-frame-parse [(allocator (dyn Allocator))
                      (line (slice u8))
                      (out (ptr CcFrame))] (-> bool)
  (cc-frame-init! out)
  (let [result (json-parse allocator line)]
    (if (not (.ok result))
        false
        (let [value (.value result)]
          (if (not (json-object-has? value "type"))
              false
              (let [kind (cc-json-string-or value "type" "")]
                (set! (.message-id out) (cc-json-string-or value "msg_id" ""))
                (set! (.from out) (cc-json-string-or value "from" ""))
                (cond (= kind "user")
                        (do
                          (store! (field out kind) (CcUserFrame))
                          (store! (field out priority)
                                  (cc-json-string-or value "priority" "next"))
                          (store! (field out session-id)
                                  (cc-json-string-or value "session_id" ""))
                          (store! (field out content)
                                  (cc-json-string-or (json-get value "message") "content" ""))
                          ;; An empty or non-string content is ignored by the
                          ;; receiver, so treat it as a frame we cannot act on.
                          (> (slice-len [u8] (load (field out content))) 0))
                      (= kind "control")
                        (do
                          (store! (field out kind) (CcControlFrame))
                          (store! (field out action) (cc-json-string-or value "action" ""))
                          (store! (field out status) (cc-json-string-or value "status" ""))
                          (store! (field out name) (cc-json-string-or value "name" ""))
                          (store! (field out original-id)
                                  (cc-json-string-or value "orig_msg_id" ""))
                          true)
                      :else true)))))))
