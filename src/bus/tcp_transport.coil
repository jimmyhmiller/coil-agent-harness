;; A TCP carrier for the bus.
;;
;; This exists so that "remote execution" needs no protocol of its own: the
;; envelopes, framing, and routing are identical to the local case, and only
;; this file knows a network is involved. A unix-socket carrier will be a
;; sibling of this file implementing the same trait, so nothing above it moves.
;;
;; Socket errors collapse to the two transport codes on purpose. Callers above
;; this layer can only ever do one of two things -- stop talking to this peer,
;; or report it -- so the precise errno is a logging concern, not a routing one.
(module harness-bus-tcp)

(import "coil.alloc" :as alloc :use *)
(import "coil.match" :use *)
(import "coil.slice" :use *)

(import "coil.socket" :as socket)
(import "harness-bus-protocol" :use *)

(defstruct TcpTransport [(connection socket/TcpConnection)])

;; Take ownership of a connection that was accepted elsewhere (the server side).
(defn tcp-transport-adopt! [(transport (ptr TcpTransport))
                            (connection socket/TcpConnection)] (-> i64)
  (store! (field transport connection) connection)
  0)

;; Dial a peer (the client side). Returns 0, or a negative transport code.
(defn tcp-transport-connect! [(allocator (ptr Allocator))
                              (transport (ptr TcpTransport))
                              (host (slice u8))
                              (port i64)] (-> i64)
  (match (socket/tcp-connect allocator (field transport connection) host port)
    (Err [failure] TRANSPORT_FAILED)
    (Ok [_] 0)))

;; `socket-error-code` is coil.socket's own stable numbering for its errors, and
;; 2 is its `Closed`. Going through it rather than matching the sum directly
;; keeps this file working when new SocketError variants are added -- a
;; peer disconnecting is the only case the bus distinguishes.
(const SOCKET_ERROR_CLOSED 2)

(defn socket-error-transport-code [(failure socket/SocketError)] (-> i64)
  (if (= (socket/socket-error-code failure) SOCKET_ERROR_CLOSED)
      TRANSPORT_CLOSED
      TRANSPORT_FAILED))

(impl Transport TcpTransport
  (transport-read [(self (ptr TcpTransport)) (buffer (ptr i8)) (length i64)]
                  (-> i64)
                  (match (socket/tcp-read (field self connection) buffer length)
                    (Err [failure] (socket-error-transport-code failure))
                    ;; 0 is a clean close, which the framing layer reads as EOF
                    ;; between frames and truncation part-way through one.
                    (Ok [n] n)))
  (transport-write [(self (ptr TcpTransport)) (buffer (ptr i8)) (length i64)]
                   (-> i64)
                   (match (socket/tcp-write (field self connection) buffer length)
                     (Err [failure] (socket-error-transport-code failure))
                     (Ok [n] n)))
  (transport-close! [(self (ptr TcpTransport))]
                    (-> i64)
                    (socket/tcp-connection-close! (field self connection))))
