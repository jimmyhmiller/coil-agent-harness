(module harness-tui-busy-input)

(import "coil.match" :use *)
(import "harness-tui-input-editor" :use *)

(defsum BusyInputIntent
  (BusyInputCancel [])
  (BusyInputSuspend [])
  (BusyInputClose [])
  (BusyInputIgnore []))

;;; Escape means "get me out of whatever this is", and what that is depends on who
;;; is reading. At the composer it dismisses the completion menu and otherwise does
;;; nothing. During a run there is nothing to dismiss and the composer is closed, so
;;; it cancels -- the same thing Ctrl-C does. The decoder stays neutral and each
;;; reader decides, rather than the decoder guessing which mode it is in.
(defn busy-input-intent [(key InputKey)] (-> BusyInputIntent)
  (match key
         (InputInterrupt [] (BusyInputCancel))
         (InputDismiss [] (BusyInputCancel))
         (InputSuspend [] (BusyInputSuspend))
         (InputEndOfFile [] (BusyInputClose))
         (_ (BusyInputIgnore))))
