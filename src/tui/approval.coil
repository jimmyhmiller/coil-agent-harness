(module harness-tui-approval)

(import "coil.alloc" :use *)
(import "coil.str" :use *)
(import "harness-event" :use *)
(import "harness-json" :use *)
(import "provider-common" :use *)

(defsum ApprovalChoice
  (ApprovalAllowOnce [])
  (ApprovalReject [(reason (slice u8))]))

(defn approval-choice [(answer (slice u8))] (-> ApprovalChoice)
  (if (or (str-eq answer "y") (str-eq answer "yes"))
      (ApprovalAllowOnce)
      (ApprovalReject "rejected in terminal")))

(defn approval-command [(allocator (ptr Allocator))
                        (run-id (slice u8))
                        (authorization-id (slice u8))
                        (choice ApprovalChoice)] (-> Json)
  (let [(mut command) (json-object allocator)]
    (json-object-put! (mut command) "version" (json-integer allocator 1))
    (json-put-string! (mut command)
                      "command_id"
                      (concat-or-empty allocator
                                       "tui-authorization:"
                                       authorization-id))
    (json-put-string! (mut command) "run_id" run-id)
    (json-put-string! (mut command) "authorization_id" authorization-id)
    (json-put-string! (mut command) "provider" "service")
    (json-put-string! (mut command) "model" "service")
    (match choice
      (ApprovalAllowOnce [] (json-put-string! (mut command) "decision" "allow"))
      (ApprovalReject [reason]
                      (do
                        (json-put-string! (mut command) "decision" "reject")
                        (json-put-string! (mut command) "reason" reason))))
    (load command)))
