(module harness-tui-input-decoder)

(import "coil.alloc" :as alloc :use *)
(import "coil.arraylist" :use *)
(import "coil.slice" :use *)
(import "harness-tui-input-editor" :use *)

(const INPUT_PASTE_LIMIT 1048576)

(defsum InputDecode
  (InputNeedMore [])
  (InputDecoded [(key InputKey)])
  (InputIgnored [])
  (InputPasteTooLarge []))

(defstruct InputDecoder
  [(allocator (ptr Allocator))
   (escape (ArrayList u8))
   (paste (ArrayList u8))
   (pasting bool)])

(defn input-decoder-new [(allocator (ptr Allocator))] (-> InputDecoder)
  (let [decoder (alloc/stack InputDecoder)]
    (store! (field decoder allocator) allocator)
    (store! (field decoder escape) (al-new [u8] allocator))
    (store! (field decoder paste) (al-new [u8] allocator))
    (store! (field decoder pasting) false)
    (load decoder)))

(defn input-array-slice [(bytes (ref (ArrayList u8)))] (-> (slice u8))
  (slice-new [u8] (load (field bytes data)) (al-len [u8] (load bytes))))

(defn input-array-prefix? [(bytes (ref (ArrayList u8)))
                           (expected (slice u8))] (-> bool)
  (let [count (al-len [u8] (load bytes))
        expected-count (slice-len [u8] expected)
        (mut at) 0
        (mut matches) (<= count expected-count)]
    (loop (if (or (not (load matches)) (>= (load at) count))
              (break)
              (do
                (when (!= (al-get [u8] (load bytes) (load at))
                          (slice-get [u8] expected (load at)))
                  (store! matches false)
                  0)
                (store! at (+ (load at) 1)))))
    (load matches)))

(defn input-array-eq? [(bytes (ref (ArrayList u8)))
                       (expected (slice u8))] (-> bool)
  (and (= (al-len [u8] (load bytes)) (slice-len [u8] expected))
       (input-array-prefix? bytes expected)))

(defn input-escape-prefix? [(bytes (ref (ArrayList u8)))
                            (suffix (slice u8))] (-> bool)
  (let [count (al-len [u8] (load bytes))
        suffix-count (slice-len [u8] suffix)
        (mut at) 1
        (mut matches)
          (and (> count 0)
               (and (= (al-get [u8] (load bytes) 0) (cast u8 27))
                    (<= (- count 1) suffix-count)))]
    (loop (if (or (not (load matches)) (>= (load at) count))
              (break)
              (do
                (when (!= (al-get [u8] (load bytes) (load at))
                          (slice-get [u8] suffix (- (load at) 1)))
                  (store! matches false)
                  0)
                (store! at (+ (load at) 1)))))
    (load matches)))

(defn input-escape-eq? [(bytes (ref (ArrayList u8)))
                        (suffix (slice u8))] (-> bool)
  (and (= (al-len [u8] (load bytes)) (+ (slice-len [u8] suffix) 1))
       (input-escape-prefix? bytes suffix)))

(defn input-copy-array [(decoder (ptr InputDecoder))
                        (bytes (ref (ArrayList u8)))] (-> (slice u8))
  (input-copy (load (field decoder allocator)) (input-array-slice bytes)))

(defn input-paste-ended? [(decoder (ptr InputDecoder))] (-> bool)
  (let [count (al-len [u8] (load (field decoder paste)))
        suffix "[201~"
        marker-count 6]
    (if (< count marker-count)
        false
        (let [(mut at) 0
              (mut matches) true]
          (loop (if (or (not (load matches)) (>= (load at) marker-count))
                    (break)
                    (do
                      (let [actual
                              (al-get [u8]
                                      (load (field decoder paste))
                                      (+ (- count marker-count) (load at)))
                            expected
                              (if (= (load at) 0)
                                  (cast u8 27)
                                  (slice-get [u8] suffix (- (load at) 1)))]
                        (when (!= actual expected)
                          (store! matches false)
                          0))
                      (store! at (+ (load at) 1)))))
          (load matches)))))

(defn input-decoder-finish-paste! [(decoder (ptr InputDecoder))] (-> InputDecode)
  (let [marker-count 6
        content-count (- (al-len [u8] (load (field decoder paste))) marker-count)
        content
          (input-copy (load (field decoder allocator))
                      (slice-new [u8]
                                 (load (field (field decoder paste) data))
                                 content-count))]
    (al-clear! [u8] (mut (field decoder paste)))
    (store! (field decoder pasting) false)
    (InputDecoded (InputInsert content))))

(defn input-decoder-escape-known-prefix? [(decoder (ptr InputDecoder))] (-> bool)
  (or (input-escape-prefix? (mut (field decoder escape)) "[A")
      (or (input-escape-prefix? (mut (field decoder escape)) "[B")
          (or (input-escape-prefix? (mut (field decoder escape)) "[C")
              (or (input-escape-prefix? (mut (field decoder escape)) "[D")
                  (or (input-escape-prefix? (mut (field decoder escape)) "[H")
                      (or (input-escape-prefix? (mut (field decoder escape)) "[F")
                          (or (input-escape-prefix? (mut (field decoder escape)) "[3~")
                              (or (input-escape-prefix? (mut (field decoder escape)) "[200~")
                                  (input-escape-prefix? (mut (field decoder escape))
                                                        "[13;2u"))))))))))

;; ESC immediately followed by a byte that is not `[` is an Alt-modified key, not
;; the start of a CSI sequence. Terminals send Alt this way by default, so without
;; this branch alt+backspace and alt+b were swallowed by the unknown-prefix check.
(defn input-decoder-alt-key [(byte u8)] (-> InputDecode)
  (cond (= byte (cast u8 98)) (InputDecoded (InputWordLeft))
        (= byte (cast u8 102)) (InputDecoded (InputWordRight))
        (= byte (cast u8 100)) (InputDecoded (InputDeleteWordForward))
        (or (= byte (cast u8 127)) (= byte (cast u8 8))) (InputDecoded (InputDeleteWord))
        :else (InputIgnored)))

(defn input-decoder-finish-escape! [(decoder (ptr InputDecoder))] (-> InputDecode)
  (let [escape (mut (field decoder escape))]
    (cond (input-escape-eq? escape "[A") (InputDecoded (InputHistoryPrevious))
          (input-escape-eq? escape "[B") (InputDecoded (InputHistoryNext))
          (input-escape-eq? escape "[C") (InputDecoded (InputRight))
          (input-escape-eq? escape "[D") (InputDecoded (InputLeft))
          (input-escape-eq? escape "[H") (InputDecoded (InputHome))
          (input-escape-eq? escape "[F") (InputDecoded (InputEnd))
          (input-escape-eq? escape "[3~") (InputDecoded (InputDelete))
          (input-escape-eq? escape "[13;2u") (InputDecoded (InputNewline))
          (input-escape-eq? escape "[200~")
            (do
              (store! (field decoder pasting) true)
              (al-clear! [u8] (mut (field decoder paste)))
              (InputNeedMore))
          :else (InputIgnored))))

(defn input-decoder-escape-complete? [(decoder (ptr InputDecoder))] (-> bool)
  (let [escape (mut (field decoder escape))]
    (or (input-escape-eq? escape "[A")
        (or (input-escape-eq? escape "[B")
            (or (input-escape-eq? escape "[C")
                (or (input-escape-eq? escape "[D")
                    (or (input-escape-eq? escape "[H")
                        (or (input-escape-eq? escape "[F")
                            (or (input-escape-eq? escape "[3~")
                                (or (input-escape-eq? escape "[200~")
                                    (input-escape-eq? escape "[13;2u")))))))))))

(defn input-decoder-feed! [(decoder (ptr InputDecoder))
                           (byte u8)] (-> InputDecode)
  (cond (load (field decoder pasting))
          (do
            (al-push! [u8] (mut (field decoder paste)) byte)
            (cond (input-paste-ended? decoder) (input-decoder-finish-paste! decoder)
                  (> (al-len [u8] (load (field decoder paste))) INPUT_PASTE_LIMIT)
                    (do
                      (al-clear! [u8] (mut (field decoder paste)))
                      (store! (field decoder pasting) false)
                      (InputPasteTooLarge))
                  :else (InputNeedMore)))
        (> (al-len [u8] (load (field decoder escape))) 0)
          (do
            (al-push! [u8] (mut (field decoder escape)) byte)
            (cond (and (= (al-len [u8] (load (field decoder escape))) 2)
                       (!= byte (cast u8 91)))
                    (let [decoded (input-decoder-alt-key byte)]
                      (al-clear! [u8] (mut (field decoder escape)))
                      decoded)
                  (not (input-decoder-escape-known-prefix? decoder))
                    (do
                      (al-clear! [u8] (mut (field decoder escape)))
                      (InputIgnored))
                  (input-decoder-escape-complete? decoder)
                    (let [decoded (input-decoder-finish-escape! decoder)]
                      (al-clear! [u8] (mut (field decoder escape)))
                      decoded)
                  :else (InputNeedMore)))
        (= byte (cast u8 27))
          (do
            (al-push! [u8] (mut (field decoder escape)) byte)
            (InputNeedMore))
        (= byte (cast u8 13)) (InputDecoded (InputSubmit))
        (= byte (cast u8 10)) (InputDecoded (InputNewline))
        (= byte (cast u8 3)) (InputDecoded (InputInterrupt))
        (= byte (cast u8 26)) (InputDecoded (InputSuspend))
        (= byte (cast u8 4)) (InputDecoded (InputEndOfFile))
        (or (= byte (cast u8 127)) (= byte (cast u8 8))) (InputDecoded (InputBackspace))
        (= byte (cast u8 23)) (InputDecoded (InputDeleteWord))
        (= byte (cast u8 1)) (InputDecoded (InputHome))
        (= byte (cast u8 5)) (InputDecoded (InputEnd))
        (= byte (cast u8 11)) (InputDecoded (InputKillToEnd))
        (= byte (cast u8 21)) (InputDecoded (InputKillToStart))
        (= byte (cast u8 18)) (InputDecoded (InputReverseSearch))
        (= byte (cast u8 9)) (InputDecoded (InputComplete))
        (>= byte (cast u8 32))
          (let [single (alloc/stack (array u8 1))]
            (store! (index single 0) byte)
            (InputDecoded (InputInsert (input-copy (load (field decoder allocator))
                                                   (slice-new [u8] (index single 0) 1)))))
        :else (InputIgnored)))

;; A lone Escape is meaningful only after the reader's short sequence timeout. It
;; dismisses whatever is open; the editor decides what that means. It is NOT an
;; interrupt: Escape at an idle composer used to write a literal `^C` into the
;; transcript, and cancelling an active run is the busy reader's job, not this
;; one's -- the composer is not even accepting input then.
(defn input-decoder-timeout! [(decoder (ptr InputDecoder))] (-> InputDecode)
  (if (= (al-len [u8] (load (field decoder escape))) 1)
      (do
        (al-clear! [u8] (mut (field decoder escape)))
        (InputDecoded (InputDismiss)))
      (do
        (al-clear! [u8] (mut (field decoder escape)))
        (InputIgnored))))
