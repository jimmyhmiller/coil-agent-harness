(module harness-tui-approval-input)

(import "coil.alloc" :as alloc :use *)
(import "coil.match" :use *)
(import "coil.region" :as region)
(import "harness-tui-approval" :use *)
(import "harness-tui-frame" :use *)
(import "harness-tui-input-decoder" :use *)
(import "harness-tui-input-editor" :use *)
(import "harness-tui-input-reader" :use *)
(import "harness-tui-output" :use *)
(import "harness-tui-render-inline" :use *)
(import "harness-tui-terminal" :use *)
(import "harness-tui-view" :use *)
(import "harness-tui-view-layout" :use *)

(defsum ApprovalInputIntent
  (ApprovalInputContinue [])
  (ApprovalInputResolve [(choice ApprovalChoice)])
  (ApprovalInputSuspend [])
  (ApprovalInputClose []))

(defn approval-input-intent [(key InputKey)] (-> ApprovalInputIntent)
  (match-else key
              (InputInsert [text] (ApprovalInputResolve (approval-choice text)))
              (InputSubmit []
                           (ApprovalInputResolve (ApprovalReject "rejected in terminal")))
              (InputInterrupt []
                              (ApprovalInputResolve (ApprovalReject "rejected in terminal")))
              (InputSuspend [] (ApprovalInputSuspend))
              (InputEndOfFile [] (ApprovalInputClose))
              (_ (ApprovalInputContinue))))

(defn approval-input-prompt! [(allocator (ptr Allocator))
                              (renderer (ptr InlineRenderer))
                              (profile (ref TerminalProfile))] (-> i64)
  (let [cycle (alloc/stack region/Region)]
    (region/region-init cycle allocator)
    (let [scratch (region/region-allocator cycle)
          view (terminal-view (view-flow (RoleWarning) "  " "    " "Allow once? [y/N] "))
          (mut laid-out) (view-layout scratch view (load (field profile width)))
          (mut committed) (frame-new scratch)]
      (tui-output-inline-update! renderer
                                 scratch
                                 profile
                                 (mut committed)
                                 (mut (field laid-out frame))))
    (region/region-close! cycle)
    0))

(defn approval-input-clear! [(renderer (ptr InlineRenderer))
                             (allocator (ptr Allocator))
                             (profile (ref TerminalProfile))] (-> i64)
  (let [cycle (alloc/stack region/Region)]
    (region/region-init cycle allocator)
    (let [scratch (region/region-allocator cycle)
          (mut empty-committed) (frame-new scratch)
          (mut empty-live) (frame-new scratch)]
      (tui-output-inline-update! renderer
                                 scratch
                                 profile
                                 (mut empty-committed)
                                 (mut empty-live)))
    (region/region-close! cycle)
    0))

(defn approval-input-interactive [(allocator (ptr Allocator))
                                  (profile (ref TerminalProfile))] (-> ApprovalChoice)
  (let [(mut lifecycle) (input-reader-lifecycle-new)
        (mut decoder) (input-decoder-new allocator)
        (mut renderer) (inline-renderer-new)]
    (if (not (input-reader-lifecycle-enter! allocator (mut lifecycle) profile))
        (ApprovalReject "terminal input failed")
        (block :choice
               (approval-input-prompt! allocator (mut renderer) profile)
               (loop (let [byte
                             (input-reader-byte allocator
                                                (mut decoder)
                                                (mut lifecycle)
                                                250)
                           decoded
                             (cond (= byte -4) (InputDecoded (InputEndOfFile))
                                   (= byte -3) (InputDecoded (InputInterrupt))
                                   (= byte -2) (input-decoder-timeout! (mut decoder))
                                   (< byte 0) (InputDecoded (InputEndOfFile))
                                   :else
                                     (input-decoder-feed! (mut decoder)
                                                          (cast u8 byte)))]
                       (match decoded
                         (InputNeedMore [] 0)
                         (InputIgnored [] 0)
                         (InputPasteTooLarge []
                                             (do
                                               (approval-input-clear! (mut renderer)
                                                                      allocator
                                                                      profile)
                                               (input-reader-finish! allocator
                                                                     (mut lifecycle)
                                                                     profile)
                                               (return-from :choice
                                                            (ApprovalReject "pasted choice was too large"))))
                         (InputDecoded [key]
                                       (match (approval-input-intent key)
                                         (ApprovalInputContinue [] 0)
                                         (ApprovalInputResolve [choice]
                                                               (do
                                                                 (approval-input-clear! (mut renderer)
                                                                                        allocator
                                                                                        profile)
                                                                 (input-reader-finish! allocator
                                                                                       (mut lifecycle)
                                                                                       profile)
                                                                 (return-from :choice choice)))
                                         (ApprovalInputSuspend []
                                                               (do
                                                                 (approval-input-clear! (mut renderer)
                                                                                        allocator
                                                                                        profile)
                                                                 (input-reader-finish! allocator
                                                                                       (mut lifecycle)
                                                                                       profile)
                                                                 (terminal-suspend-process)
                                                                 (if (input-reader-lifecycle-enter! allocator
                                                                                                    (mut lifecycle)
                                                                                                    profile)
                                                                     (approval-input-prompt! allocator
                                                                                             (mut renderer)
                                                                                             profile)
                                                                     (return-from :choice
                                                                                  (ApprovalReject "terminal input failed")))))
                                         (ApprovalInputClose []
                                                             (do
                                                               (approval-input-clear! (mut renderer)
                                                                                      allocator
                                                                                      profile)
                                                               (input-reader-finish! allocator
                                                                                     (mut lifecycle)
                                                                                     profile)
                                                               (return-from :choice
                                                                            (ApprovalReject "terminal input closed")))))))))))))
