(module harness-tui-layout)

(import "coil.alloc" :as alloc :use *)
(import "coil.arraylist" :use *)
(import "coil.match" :use *)
(import "coil.slice" :use *)
(import "coil.str" :use *)
(import "harness-json" :use *)
(import "harness-tui-cells" :use *)
(import "harness-tui-frame" :use *)
(import "harness-tui-model" :use *)
(import "harness-tui-tool-presenter" :use *)
(import "harness-tui-transcript" :use *)
(import "harness-tui-syntax" :use *)
(import "harness-tui-view" :use *)
(import "harness-tui-view-layout" :use *)

(defstruct LayoutOptions
  [(width i64)
   (unicode bool)
   (compact bool)
   (expanded bool)])

(defn layout-options [(width i64) (unicode bool) (expanded bool)] (-> LayoutOptions)
  (let [options (alloc/stack LayoutOptions)]
    (set! (.width options) (if (< width 12) 12 width))
    (set! (.unicode options) unicode)
    (set! (.compact options) false)
    (set! (.expanded options) expanded)
    (load options)))

(defn layout-options-profile [(width i64)
                              (unicode bool)
                              (compact bool)
                              (expanded bool)] (-> LayoutOptions)
  (let [(mut options) (layout-options width unicode expanded)]
    (set! (.compact options) compact)
    (load options)))

(defn layout-state-word [(state PresentationState)] (-> (slice u8))
  (match state
    (PresentationPending [] "queued")
    (PresentationRunning [] "running")
    (PresentationSucceeded [] "done")
    (PresentationFailed [] "failed")
    (PresentationRejected [] "rejected")
    (PresentationCancelled [] "cancelled")))

(defn layout-state-role [(state PresentationState)] (-> StyleRole)
  (match state
    (PresentationSucceeded [] (RoleSuccess))
    (PresentationFailed [] (RoleFailure))
    (PresentationRejected [] (RoleFailure))
    (PresentationCancelled [] (RoleFailure))
    (PresentationPending [] (RoleMuted))
    (PresentationRunning [] (RoleMuted))))

(defn layout-join [(allocator (ptr Allocator))
                   (first (slice u8))
                   (second (slice u8))] (-> (slice u8))
  (let [(mut builder) (sb-new allocator)]
    (sb-push-str! (mut builder) first)
    (when (> (slice-len [u8] second) 0)
      (sb-push-str! (mut builder) "  ")
      (sb-push-str! (mut builder) second)
      0)
    (sb-finish! (mut builder))))

(defn layout-diagnostic-text [(allocator (ptr Allocator))
                              (value Json)] (-> (slice u8))
  (let [text (json-stringify allocator value)
        count (slice-len [u8] text)
        limit (if (> count 512) 512 count)
        (mut end) limit]
    (loop (if (or (<= count 512)
                  (or (<= (load end) 0)
                      (not (utf8-continuation? (cast i64 (slice-get [u8] text (load end)))))))
              (break)
              (set! end (- (load end) 1))))
    (if (> count 512)
        (let [(mut output) (sb-new allocator)]
          (sb-push-str! (mut output) (subslice [u8] text 0 (load end)))
          (sb-push-str! (mut output) "…")
          (sb-finish! (mut output)))
        text)))

;; ---------------------------------------------------------------------------
;; Markdown fences
;;
;; Assistant text is markdown. Only fenced blocks are treated specially; the rest
;; is left exactly as the model wrote it, because a transcript that rewrites prose
;; is a transcript you cannot trust to be quoting.
;;
;; An unterminated fence -- which every streaming answer has, for as long as it is
;; still arriving -- highlights what has come in so far and ends there. That makes
;; the block appear progressively rather than snapping into place at the end.
;; ---------------------------------------------------------------------------

(defn layout-line-end [(text (slice u8)) (from i64)] (-> i64)
  (let [n (slice-len [u8] text)
        (mut at) from]
    (loop (if (or (>= (load at) n) (= (slice-get [u8] text (load at)) (cast u8 10)))
              (break)
              (set! at (+ (load at) 1))))
    (load at)))

(defn layout-fence-at? [(text (slice u8)) (at i64)] (-> bool)
  (let [n (slice-len [u8] text)]
    (and (<= (+ at 3) n)
         (and (= (slice-get [u8] text at) (cast u8 96))
              (and (= (slice-get [u8] text (+ at 1)) (cast u8 96))
                   (= (slice-get [u8] text (+ at 2)) (cast u8 96)))))))

;; Push `body` as alternating prose and code nodes.
(defn layout-push-markdown! [(allocator (ptr Allocator))
                             (root (ptr ViewNode))
                             (body (slice u8))
                             (first-prefix (slice u8))
                             (continuation (slice u8))
                             (role StyleRole)] (-> i64)
  (let [n (slice-len [u8] body)
        (mut at) 0
        (mut prose-start) 0
        (mut opened) false]
    (loop (if (> (load at) n)
              (break)
              (if (and (< (load at) n)
                       (and (layout-fence-at? body (load at))
                            (or (= (load at) 0)
                                (= (slice-get [u8] body (- (load at) 1)) (cast u8 10)))))
                  (let [info-end (layout-line-end body (+ (load at) 3))
                        info (subslice [u8] body (+ (load at) 3) info-end)
                        code-start (if (< info-end n) (+ info-end 1) n)
                        ;; Scan for the closing fence at the start of a line.
                        (mut scan) code-start
                        (mut close) -1]
                    ;; Emit the prose that ran up to this fence.
                    (when (> (load at) (load prose-start))
                      (view-stack-push! root
                                        (view-flow role
                                                   (if (= (load prose-start) 0)
                                                       first-prefix
                                                       continuation)
                                                   continuation
                                                   (subslice [u8]
                                                             body
                                                             (load prose-start)
                                                             (- (load at) 1))))
                      0)
                    (loop (if (or (>= (load scan) n) (>= (load close) 0))
                              (break)
                              (if (and (layout-fence-at? body (load scan))
                                       (or (= (load scan) code-start)
                                           (= (slice-get [u8] body (- (load scan) 1))
                                              (cast u8 10))))
                                  (set! close (load scan))
                                  (set! scan (+ (layout-line-end body (load scan)) 1)))))
                    (let [code-end
                            (if (>= (load close) 0)
                                (if (> (load close) code-start) (- (load close) 1) code-start)
                                n)]
                      (view-stack-push! root
                                        (view-code info
                                                   (subslice [u8] body code-start code-end)
                                                   continuation))
                      (set! opened true)
                      (set! at
                            (if (>= (load close) 0)
                                (+ (layout-line-end body (load close)) 1)
                                (+ n 1)))
                      (set! prose-start (load at))))
                  (set! at (+ (load at) 1)))))
    ;; Whatever prose is left after the last fence.
    (when (< (load prose-start) n)
      (view-stack-push! root
                        (view-flow role
                                   (if (= (load prose-start) 0) first-prefix continuation)
                                   continuation
                                   (subslice [u8] body (load prose-start) n)))
      0)
    ;; A body with no fence at all still has to render.
    (when (and (not (load opened)) (= n 0))
      (view-stack-push! root (view-flow role first-prefix continuation ""))
      0)
    0))

(defn layout-view-push! [(allocator (ptr Allocator))
                         (root (ptr ViewNode))
                         (item (ref PresentationBlock))
                         (options (ref LayoutOptions))] (-> i64)
  (let [unicode (.unicode options)]
    (match (.kind item)
      (UserBlock []
                 (view-stack-push! root
                                   (view-flow (RolePrimary)
                                              (if unicode "❯ " "> ")
                                              "  "
                                              (.body item))))
      ;; A model turn that produced only tool calls still opens an assistant block
      ;; on `model.request.started` and never receives text. Rendering it emits a
      ;; bare bullet above every tool group, so an empty turn that has settled
      ;; contributes no rows at all. An unsettled one still shows progress, and a
      ;; failed one still shows its bullet so the failure is not silent.
      (AssistantBlock []
                      (let [body (.body item)
                            empty (= (slice-len [u8] body) 0)
                            unsettled
                              (match (.state item)
                                     (PresentationPending [] true)
                                     (PresentationRunning [] true)
                                     (_ false))
                            failed
                              (match (.state item) (PresentationSucceeded [] false) (_ true))]
                        (cond (and empty (and (not unsettled) (not failed))) 0
                              (and empty unsettled)
                                (view-stack-push! root
                                                  (view-flow (RolePrimary)
                                                             (if unicode "● " "assistant: ")
                                                             "  "
                                                             "Thinking…"))
                              :else
                                (layout-push-markdown! allocator
                                                       root
                                                       body
                                                       (if unicode "● " "assistant: ")
                                                       "  "
                                                       (RolePrimary)))))
      (ToolBlock []
                 (let [tool
                         (present-tool allocator
                                       (.title item)
                                       (.arguments item)
                                       (.result item))
                       heading
                         (layout-join allocator
                                      (.label tool)
                                      (.subject tool))
                       ;; The presenter's summary wins when it has one. A bash
                       ;; call that exits non-zero is a SUCCESSFUL tool call, so
                       ;; the lifecycle state says "done" while the thing the
                       ;; user cares about is "exit 1".
                       state
                         (if (> (slice-len [u8] (.summary tool)) 0)
                             (.summary tool)
                             (layout-state-word (.state item)))
                       show-state
                         (not (and (.compact options)
                                   (match (.state item) (PresentationSucceeded [] true) (_ false))))
                       suffix
                         (if show-state
                             (layout-join allocator "" state)
                             "")]
                   (view-stack-push! root
                                     (view-decorated-flow (layout-state-role (.state item))
                                                          (if unicode "  ⏺ " "  tool: ")
                                                          (RoleMuted)
                                                          "    "
                                                          heading
                                                          (RolePrimary)
                                                          suffix
                                                          (layout-state-role (.state item))))
                   ;; Why it failed, if it did. A row reading "Read README.md
                   ;; failed" with no reason is the single least useful thing the
                   ;; transcript can say -- it looks like the file is at fault
                   ;; when the actual cause (a deadline, a traversal check) is
                   ;; sitting unread in the block's detail. Shown even in compact
                   ;; mode: an error is never the noise compact is stripping.
                   (when (> (slice-len [u8] (load (field item detail))) 0)
                     (view-stack-push! root
                                       (view-flow (RoleFailure)
                                                  (if unicode "    ⎿ " "    | ")
                                                  "      "
                                                  (load (field item detail))))
                     0)
                   ;; What the call produced, indented under it. Compact mode drops
                   ;; it: that mode exists to strip everything that is not the
                   ;; conversation, and a result preview is the first thing to go.
                   (when (and (not (load (field options compact)))
                              (> (slice-len [u8] (load (field tool preview))) 0))
                     (view-stack-push! root
                                       (view-flow (RoleMuted)
                                                  (if unicode "    ⎿ " "    | ")
                                                  "      "
                                                  (load (field tool preview))))
                     0)
                   (when (load (field options expanded))
                     (view-stack-push! root
                                       (view-flow (RoleMuted)
                                                  "    arguments: "
                                                  "      "
                                                  (layout-diagnostic-text allocator
                                                                          (load (field item arguments)))))
                     (match (load (field item result))
                            (JsonNull [] 0)
                            (_ (do
                                 (view-stack-push! root
                                                   (view-flow (RoleMuted)
                                                              "    result: "
                                                              "      "
                                                              (layout-diagnostic-text allocator
                                                                                      (load (field item result)))))
                                 0)))
                     (when (> (slice-len [u8] (load (field item detail))) 0)
                       (view-stack-push! root
                                         (view-flow (RoleMuted)
                                                    "    detail: "
                                                    "      "
                                                    (load (field item detail))))
                       0)
                     0)))
      (AgentBlock []
                  (view-stack-push! root
                                    (view-flow (layout-state-role (.state item))
                                               (if unicode "    • " "    - ")
                                               "      "
                                               (layout-join allocator
                                                            (.id item)
                                                            (layout-state-word (.state item))))))
      (WorkflowBlock []
                     (view-stack-push! root
                                       (view-flow (layout-state-role (.state item))
                                                  (if unicode "    • " "    - ")
                                                  "      "
                                                  (layout-join allocator
                                                               (.body item)
                                                               (layout-state-word (.state item))))))
      (ErrorBlock []
                  (view-stack-push! root
                                    (view-flow (RoleFailure)
                                               "  error: "
                                               "    "
                                               (.detail item)))))
    0))

(defn layout-model-range-view [(allocator (ptr Allocator))
                               (model (ptr PresentationModel))
                               (start i64)
                               (end i64)
                               (options (ref LayoutOptions))] (-> ViewNode)
  (let [(mut root) (view-stack allocator 0)
        count (al-len [PresentationBlock] (.blocks model))
        limit (if (> end count) count end)
        (mut at) (if (< start 0) 0 start)]
    (loop (if (>= (load at) limit)
              (break)
              (let [item
                      (al-get [PresentationBlock]
                              (.blocks model)
                              (load at))
                    previous-kind
                      (if (> (load at) 0)
                          (let [previous
                                  (al-get [PresentationBlock]
                                          (.blocks model)
                                          (- (load at) 1))]
                            (.kind previous))
                          (ErrorBlock))]
                (match (.kind item)
                       (AgentBlock []
                                   (when (match previous-kind (AgentBlock [] false) (_ true))
                                     (view-stack-push! (mut root)
                                                       (view-flow (RoleMuted)
                                                                  "  "
                                                                  "  "
                                                                  "Subagents"))
                                     0))
                       (WorkflowBlock []
                                      (when (match previous-kind (WorkflowBlock [] false) (_ true))
                                        (view-stack-push! (mut root)
                                                          (view-flow (RoleMuted)
                                                                     "  "
                                                                     "  "
                                                                     "Workflow"))
                                        0))
                       (_ 0))
                (layout-view-push! allocator (mut root) item options)
                (set! at (+ (load at) 1)))))
    (load root)))

(defn layout-model-range [(allocator (ptr Allocator))
                          (model (ptr PresentationModel))
                          (start i64)
                          (end i64)
                          (options (ref LayoutOptions))] (-> Frame)
  (let [view (terminal-view (layout-model-range-view allocator model start end options))
        laid-out (view-layout allocator view (.width options))]
    (.frame laid-out)))
