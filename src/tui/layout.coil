(module harness-tui-layout)

(import "coil.alloc" :as alloc :use *)
(import "coil.arraylist" :use *)
(import "coil.match" :use *)
(import "coil.slice" :use *)
(import "coil.str" :use *)
(import "harness-json" :use *)
(import "harness-tui-cells" :use *)
(import "harness-tui-frame" :use *)
(import "harness-tui-model" :use *)
(import "harness-tui-tool-presenter" :use *)
(import "harness-tui-transcript" :use *)
(import "harness-tui-view" :use *)
(import "harness-tui-view-layout" :use *)

(defstruct LayoutOptions
  [(width i64)
   (unicode bool)
   (compact bool)
   (expanded bool)])

(defn layout-options [(width i64) (unicode bool) (expanded bool)] (-> LayoutOptions)
  (let [options (alloc/stack LayoutOptions)]
    (store! (field options width) (if (< width 12) 12 width))
    (store! (field options unicode) unicode)
    (store! (field options compact) false)
    (store! (field options expanded) expanded)
    (load options)))

(defn layout-options-profile [(width i64)
                              (unicode bool)
                              (compact bool)
                              (expanded bool)] (-> LayoutOptions)
  (let [(mut options) (layout-options width unicode expanded)]
    (store! (field options compact) compact)
    (load options)))

(defn layout-state-word [(state PresentationState)] (-> (slice u8))
  (match state
    (PresentationPending [] "queued")
    (PresentationRunning [] "running")
    (PresentationSucceeded [] "done")
    (PresentationFailed [] "failed")
    (PresentationRejected [] "rejected")
    (PresentationCancelled [] "cancelled")))

(defn layout-state-role [(state PresentationState)] (-> StyleRole)
  (match state
    (PresentationSucceeded [] (RoleSuccess))
    (PresentationFailed [] (RoleFailure))
    (PresentationRejected [] (RoleFailure))
    (PresentationCancelled [] (RoleFailure))
    (PresentationPending [] (RoleMuted))
    (PresentationRunning [] (RoleMuted))))

(defn layout-join [(allocator (ptr Allocator))
                   (first (slice u8))
                   (second (slice u8))] (-> (slice u8))
  (let [(mut builder) (sb-new allocator)]
    (sb-push-str! (mut builder) first)
    (when (> (slice-len [u8] second) 0)
      (sb-push-str! (mut builder) "  ")
      (sb-push-str! (mut builder) second)
      0)
    (sb-finish! (mut builder))))

(defn layout-diagnostic-text [(allocator (ptr Allocator))
                              (value Json)] (-> (slice u8))
  (let [text (json-stringify allocator value)
        count (slice-len [u8] text)
        limit (if (> count 512) 512 count)
        (mut end) limit]
    (loop (if (or (<= count 512)
                  (or (<= (load end) 0)
                      (not (utf8-continuation? (cast i64 (slice-get [u8] text (load end)))))))
              (break)
              (store! end (- (load end) 1))))
    (if (> count 512)
        (let [(mut output) (sb-new allocator)]
          (sb-push-str! (mut output) (subslice [u8] text 0 (load end)))
          (sb-push-str! (mut output) "…")
          (sb-finish! (mut output)))
        text)))

(defn layout-view-push! [(allocator (ptr Allocator))
                         (root (ptr ViewNode))
                         (item (ref PresentationBlock))
                         (options (ref LayoutOptions))] (-> i64)
  (let [unicode (load (field options unicode))]
    (match (load (field item kind))
      (UserBlock []
                 (view-stack-push! root
                                   (view-flow (RolePrimary)
                                              (if unicode "❯ " "> ")
                                              "  "
                                              (load (field item body)))))
      (AssistantBlock []
                      (view-stack-push! root
                                        (view-flow (RolePrimary)
                                                   (if unicode "● " "assistant: ")
                                                   "  "
                                                   (if (and (= (slice-len [u8]
                                                                          (load (field item body)))
                                                               0)
                                                            (match-else (load (field item state))
                                                                        (PresentationRunning [] true)
                                                                        (_ false)))
                                                       "Thinking…"
                                                       (load (field item body))))))
      (ToolBlock []
                 (let [tool
                         (present-tool (load (field item title))
                                       (load (field item arguments))
                                       (load (field item result)))
                       heading
                         (layout-join allocator
                                      (load (field tool label))
                                      (load (field tool subject)))
                       state (layout-state-word (load (field item state)))
                       show-state
                         (not (and (load (field options compact))
                                   (match-else (load (field item state))
                                               (PresentationSucceeded [] true)
                                               (_ false))))
                       suffix
                         (if show-state
                             (layout-join allocator "" state)
                             "")]
                   (view-stack-push! root
                                     (view-decorated-flow (layout-state-role (load (field item state)))
                                                          (if unicode "  ⏺ " "  tool: ")
                                                          (RoleMuted)
                                                          "    "
                                                          heading
                                                          (RolePrimary)
                                                          suffix
                                                          (layout-state-role (load (field item state)))))
                   (when (load (field options expanded))
                     (view-stack-push! root
                                       (view-flow (RoleMuted)
                                                  "    arguments: "
                                                  "      "
                                                  (layout-diagnostic-text allocator
                                                                          (load (field item arguments)))))
                     (match-else (load (field item result))
                                 (JsonNull [] 0)
                                 (_ (do
                                      (view-stack-push! root
                                                        (view-flow (RoleMuted)
                                                                   "    result: "
                                                                   "      "
                                                                   (layout-diagnostic-text allocator
                                                                                           (load (field item result)))))
                                      0)))
                     (when (> (slice-len [u8] (load (field item detail))) 0)
                       (view-stack-push! root
                                         (view-flow (RoleMuted)
                                                    "    detail: "
                                                    "      "
                                                    (load (field item detail))))
                       0)
                     0)))
      (ApprovalBlock []
                     (let [subject
                             (layout-join allocator
                                          (load (field item title))
                                          (load (field item body)))
                           stable (presentation-state-stable? (load (field item state)))
                           line
                             (if stable
                                 (layout-join allocator
                                              subject
                                              (layout-state-word (load (field item state))))
                                 subject)]
                       (view-stack-push! root
                                         (view-flow (if stable
                                                        (layout-state-role (load (field item state)))
                                                        (RoleWarning))
                                                    "  approval: "
                                                    "    "
                                                    line))))
      (AgentBlock []
                  (view-stack-push! root
                                    (view-flow (layout-state-role (load (field item state)))
                                               (if unicode "    • " "    - ")
                                               "      "
                                               (layout-join allocator
                                                            (load (field item id))
                                                            (layout-state-word (load (field item state)))))))
      (WorkflowBlock []
                     (view-stack-push! root
                                       (view-flow (layout-state-role (load (field item state)))
                                                  (if unicode "    • " "    - ")
                                                  "      "
                                                  (layout-join allocator
                                                               (load (field item body))
                                                               (layout-state-word (load (field item state)))))))
      (ErrorBlock []
                  (view-stack-push! root
                                    (view-flow (RoleFailure)
                                               "  error: "
                                               "    "
                                               (load (field item detail))))))
    0))

(defn layout-model-range-view [(allocator (ptr Allocator))
                               (model (ptr PresentationModel))
                               (start i64)
                               (end i64)
                               (options (ref LayoutOptions))] (-> ViewNode)
  (let [(mut root) (view-stack allocator 0)
        count (al-len [PresentationBlock] (load (field model blocks)))
        limit (if (> end count) count end)
        (mut at) (if (< start 0) 0 start)]
    (loop (if (>= (load at) limit)
              (break)
              (let [item
                      (al-get [PresentationBlock]
                              (load (field model blocks))
                              (load at))
                    previous-kind
                      (if (> (load at) 0)
                          (let [previous
                                  (al-get [PresentationBlock]
                                          (load (field model blocks))
                                          (- (load at) 1))]
                            (load (field previous kind)))
                          (ErrorBlock))]
                (match-else (load (field item kind))
                            (AgentBlock []
                                        (when (match-else previous-kind
                                                          (AgentBlock [] false)
                                                          (_ true))
                                          (view-stack-push! (mut root)
                                                            (view-flow (RoleMuted)
                                                                       "  "
                                                                       "  "
                                                                       "Subagents"))
                                          0))
                            (WorkflowBlock []
                                           (when (match-else previous-kind
                                                             (WorkflowBlock [] false)
                                                             (_ true))
                                             (view-stack-push! (mut root)
                                                               (view-flow (RoleMuted)
                                                                          "  "
                                                                          "  "
                                                                          "Workflow"))
                                             0))
                            (_ 0))
                (layout-view-push! allocator (mut root) item options)
                (store! at (+ (load at) 1)))))
    (load root)))

(defn layout-model-range [(allocator (ptr Allocator))
                          (model (ptr PresentationModel))
                          (start i64)
                          (end i64)
                          (options (ref LayoutOptions))] (-> Frame)
  (let [view (terminal-view (layout-model-range-view allocator model start end options))
        laid-out (view-layout allocator view (load (field options width)))]
    (load (field laid-out frame))))
