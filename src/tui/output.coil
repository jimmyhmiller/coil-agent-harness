(module harness-tui-output)
(import "coil.primitive" :as primitive)

(import "coil.primitive" :as primitive)

(import "coil.alloc" :as alloc :use *)
(import "coil.arraylist" :use *)
(import "coil.io" :as io)
(import "coil.match" :use *)
(import "coil.slice" :use *)
(import "coil.str" :use *)
(import "harness-tui-frame" :use *)
(import "harness-tui-render-inline" :use *)
(import "harness-tui-render-plain" :use *)
(import "harness-tui-terminal" :use *)
(import "harness-tui-terminal-operation" :use *)

;; Application code submits frames and output intents here. This module and the
;; renderer/driver layers are the only TUI code that writes presentation bytes.
(defn tui-output-write-slice [(fd i64) (value (slice u8))] (-> i64)
  (let [writer (primitive/alloc-stack io/Writer)]
    (match (io/write-all (io/fd-writer writer fd)
                         (cast (ptr i8) (slice-data [u8] value))
                         (slice-len [u8] value))
      (Ok [written] written)
      (Err [failure] -1))))

(defn tui-output-write-line [(allocator (dyn Allocator))
                             (fd i64)
                             (value (slice u8))] (-> i64)
  (let [(mut line) (sb-new allocator)]
    (sb-push-str! (mut line) value)
    (when (= (isatty (cast i32 fd)) 1)
      (sb-push-byte! (mut line) (cast u8 13))
      0)
    (sb-push-str! (mut line) "\n")
    (tui-output-write-slice fd (sb-finish! (mut line)))))

(defn tui-output-write-frame [(allocator (dyn Allocator))
                              (frame (ptr Frame))
                              (profile (ref TerminalProfile))] (-> i64)
  (if (.interactive profile)
      (let [(mut renderer) (inline-renderer-new)
            (mut empty) (frame-new allocator)]
        (tui-output-inline-update! (mut renderer)
                                   allocator
                                   profile
                                   frame
                                   (mut empty)))
      (tui-output-write-slice 1 (render-frame-plain allocator frame))))

(defn tui-output-execute-plan! [(allocator (dyn Allocator))
                                (profile (ref TerminalProfile))
                                (operations (ptr (ArrayList TerminalOperation)))] (-> i64)
  (let [(mut at) 0
        count (al-len [TerminalOperation] (load operations))]
    (loop (if (>= (load at) count)
              (break)
              (do
                (terminal-execute! allocator
                                   1
                                   profile
                                   (al-get [TerminalOperation]
                                           (load operations)
                                           (load at)))
                (set! at (+ (load at) 1)))))
    0))

;; A repaint walks the cursor across every row it rewrites. Hiding it for the
;; duration means the terminal never draws that walk, which is what stops the
;; block cursor skittering around during a stream.
(defn tui-output-inline-update! [(renderer (ptr InlineRenderer))
                                 (allocator (dyn Allocator))
                                 (profile (ref TerminalProfile))
                                 (committed (ptr Frame))
                                 (live (ptr Frame))] (-> i64)
  (terminal-execute! allocator 1 profile (TerminalHideCursor))
  (let [(mut operations) (inline-renderer-plan-with! renderer allocator committed live)]
    (tui-output-execute-plan! allocator profile (mut operations))))

(defn tui-output-clear-screen [(allocator (dyn Allocator))
                               (profile (ref TerminalProfile))] (-> i64)
  (terminal-execute! allocator 1 profile (TerminalClearScreen)))

(defn tui-output-reset [(allocator (dyn Allocator))
                        (profile (ref TerminalProfile))] (-> i64)
  (terminal-execute! allocator 1 profile (TerminalResetStyle)))
