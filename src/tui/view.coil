(module harness-tui-view)
(import "coil.primitive" :as primitive)

(import "coil.primitive" :as primitive)

(import "coil.alloc" :as alloc :use *)
(import "coil.arraylist" :use *)
(import "coil.match" :use *)
(import "harness-tui-frame" :use *)

;;; Declarative presentation nodes. They describe hierarchy and intent only; cell
;;; measurement, wrapping, row budgets, and terminal coordinates belong to layout.
(defstruct ViewFlow
  [(role StyleRole)
   (first-prefix (slice u8))
   (continuation-prefix (slice u8))
   (text (slice u8))])

;;; One row of a selection list rendered beneath the composer. Kept generic on
;;; purpose: the view layer knows about "a list with one row highlighted", not
;;; about slash commands, so the same node serves any future picker.
(defstruct ViewMenuEntry
  [(label (slice u8))
   (detail (slice u8))
   (selected bool)])

(defstruct ViewInput
  [(prompt (slice u8))
   (text (slice u8))
   (cursor-offset i64)
   (row-budget i64)
   ;; Null when no menu is open. The composer is the only node that owns a menu,
   ;; because the menu has to share its redraw and its cursor ownership.
   (menu (ptr (ArrayList ViewMenuEntry)))
   (menu-overflow i64)])

;;; A fenced code block. The language is kept as the author wrote it so the
;;; highlighter, not the view layer, decides what it means.
(defstruct ViewCode
  [(language (slice u8))
   (code (slice u8))
   (prefix (slice u8))])

(defstruct ViewDecoratedFlow
  [(line-role StyleRole)
   (first-prefix (slice u8))
   (prefix-role StyleRole)
   (continuation-prefix (slice u8))
   (body (slice u8))
   (body-role StyleRole)
   (suffix (slice u8))
   (suffix-role StyleRole)])

(defsum ViewNode
  (ViewFlowNode [(flow ViewFlow)])
  (ViewDecoratedFlowNode [(flow ViewDecoratedFlow)])
  (ViewInputNode [(input ViewInput)])
  (ViewCodeNode [(code ViewCode)])
  (ViewSpacerNode [(rows i64)])
  (ViewTailNode [(rows i64) (child (ptr ViewNode))])
  (ViewStackNode [(gap i64) (children (ptr (ArrayList ViewNode)))]))

(defstruct TerminalView [(root ViewNode)])

(defn view-flow [(role StyleRole)
                 (first-prefix (slice u8))
                 (continuation-prefix (slice u8))
                 (text (slice u8))] (-> ViewNode)
  (let [flow (primitive/alloc-stack ViewFlow)]
    (set! (.role flow) role)
    (set! (.first-prefix flow) first-prefix)
    (set! (.continuation-prefix flow) continuation-prefix)
    (set! (.text flow) text)
    (ViewFlowNode (load flow))))

(defn view-menu-entry [(label (slice u8))
                       (detail (slice u8))
                       (selected bool)] (-> ViewMenuEntry)
  (let [entry (primitive/alloc-stack ViewMenuEntry)]
    (set! (.label entry) label)
    (set! (.detail entry) detail)
    (set! (.selected entry) selected)
    (load entry)))

(defn view-input-with-menu [(prompt (slice u8))
                            (text (slice u8))
                            (cursor-offset i64)
                            (row-budget i64)
                            (menu (ptr (ArrayList ViewMenuEntry)))
                            (menu-overflow i64)] (-> ViewNode)
  (let [input (primitive/alloc-stack ViewInput)]
    (set! (.prompt input) prompt)
    (set! (.text input) text)
    (set! (.cursor-offset input) cursor-offset)
    (set! (.row-budget input) row-budget)
    (set! (.menu input) menu)
    (set! (.menu-overflow input) menu-overflow)
    (ViewInputNode (load input))))

(defn view-input [(prompt (slice u8))
                  (text (slice u8))
                  (cursor-offset i64)
                  (row-budget i64)] (-> ViewNode)
  (view-input-with-menu prompt
                        text
                        cursor-offset
                        row-budget
                        (cast (ptr (ArrayList ViewMenuEntry)) 0)
                        0))

(defn view-code [(language (slice u8))
                 (code (slice u8))
                 (prefix (slice u8))] (-> ViewNode)
  (let [value (primitive/alloc-stack ViewCode)]
    (set! (.language value) language)
    (set! (.code value) code)
    (set! (.prefix value) prefix)
    (ViewCodeNode (load value))))

(defn view-decorated-flow [(line-role StyleRole)
                           (first-prefix (slice u8))
                           (prefix-role StyleRole)
                           (continuation-prefix (slice u8))
                           (body (slice u8))
                           (body-role StyleRole)
                           (suffix (slice u8))
                           (suffix-role StyleRole)] (-> ViewNode)
  (let [flow (primitive/alloc-stack ViewDecoratedFlow)]
    (set! (.line-role flow) line-role)
    (set! (.first-prefix flow) first-prefix)
    (set! (.prefix-role flow) prefix-role)
    (set! (.continuation-prefix flow) continuation-prefix)
    (set! (.body flow) body)
    (set! (.body-role flow) body-role)
    (set! (.suffix flow) suffix)
    (set! (.suffix-role flow) suffix-role)
    (ViewDecoratedFlowNode (load flow))))

(defn view-spacer [(rows i64)] (-> ViewNode)
  (ViewSpacerNode (if (< rows 0) 0 rows)))

(defn view-tail [(allocator (dyn Allocator))
                 (rows i64)
                 (child ViewNode)] (-> ViewNode)
  (ViewTailNode (if (< rows 0) 0 rows)
                (box! allocator ViewNode child)))

(defn view-stack [(allocator (dyn Allocator)) (gap i64)] (-> ViewNode)
  (ViewStackNode (if (< gap 0) 0 gap)
                 (box! allocator
                      (ArrayList ViewNode)
                      (al-new [ViewNode] allocator))))

(defn view-stack-push! [(stack-node (ptr ViewNode)) (child ViewNode)] (-> i64)
  (match (load stack-node)
         (ViewStackNode [gap children]
                        (do (al-push! [ViewNode] children child) 0))
         (_ 0)))

(defn terminal-view [(root ViewNode)] (-> TerminalView)
  (let [view (primitive/alloc-stack TerminalView)]
    (set! (.root view) root)
    (load view)))
