(module harness-tui-render-inline)
(import "coil.primitive" :as primitive)

(import "coil.alloc" :as alloc :use *)
(import "coil.arraylist" :use *)
(import "harness-allocation-domain" :use *)
(import "harness-tui-diff" :use *)
(import "harness-tui-frame" :use *)
(import "harness-tui-terminal-operation" :use *)

;; While a live region exists, the cursor is left on its final row. A trailing LF
;; would scroll the terminal whenever that row is at the bottom of the viewport,
;; turning every streamed delta into another scrollback entry. Stable output is
;; the only output allowed to advance beyond the final rendered row.
;; `owner` is null for a renderer that does not retain frames, which keeps the
;; original constructor working and makes diffing strictly opt-in. A retaining
;; renderer keeps its own deep copy of the last live frame so the next one can
;; be diffed against it; see harness-tui-diff for why it copies rather than
;; hashes.
(defstruct InlineRenderer
  [(previous-live-height i64)
   (owner (dyn Allocator))
   (retaining bool)
   (retained Frame)
   (retained-domain (ptr AllocationDomain))
   (has-retained bool)])

;; Retain the live frame for the next plan, releasing the previous retention.
;; The old domain is closed only AFTER the new copy exists, so a failed
;; allocation leaves the renderer with no retention rather than a dangling one.
(defn inline-renderer-retain! [(renderer (ptr InlineRenderer))
                               (live (ptr Frame))] (-> i64)
  (if (not (load (field renderer retaining)))
      0
      (let [owner (load (field renderer owner))
            domain (allocation-domain-open owner)]
          (if (not (allocation-domain-valid? domain))
              (do (set! (.has-retained renderer) false) 0)
              (let [previous-domain (load (field renderer retained-domain))
                    had-previous (.has-retained renderer)
                    clone (primitive/alloc-stack Frame)]
                (frame-clone! (allocation-domain-allocator domain) live clone)
                (set! (.retained renderer) (load clone))
                (set! (.retained-domain renderer) domain)
                (set! (.has-retained renderer) true)
                (when had-previous
                  (allocation-domain-close! owner previous-domain)
                  0)
                0)))))

;; Release the retained frame. A renderer that outlives its allocator must be
;; closed, or the last retention leaks.
(defn inline-renderer-close! [(renderer (ptr InlineRenderer))] (-> i64)
  (when (load (field renderer has-retained))
    (allocation-domain-close! (load (field renderer owner))
                              (load (field renderer retained-domain)))
    (store! (field renderer has-retained) false)
    0)
  0)

;; A renderer that diffs consecutive live frames instead of repainting them.
(defn inline-renderer-new-retaining [(owner (dyn Allocator))] (-> InlineRenderer)
  (let [renderer (primitive/alloc-stack InlineRenderer)]
    (set! (.previous-live-height renderer) 0)
    (set! (.owner renderer) owner)
    (set! (.retaining renderer) true)
    (set! (.has-retained renderer) false)
    (load renderer)))

(defn inline-renderer-new [] (-> InlineRenderer)
  (let [renderer (primitive/alloc-stack InlineRenderer)]
    (set! (.previous-live-height renderer) 0)
    (set! (.retaining renderer) false)
    (set! (.has-retained renderer) false)
    (load renderer)))

(defn inline-operations-new [(allocator (dyn Allocator))] (-> (ArrayList TerminalOperation))
  (al-new [TerminalOperation] allocator))

(defn inline-push! [(operations (ptr (ArrayList TerminalOperation)))
                    (operation TerminalOperation)] (-> i64)
  (al-push! [TerminalOperation] operations operation)
  0)

(defn inline-plan-clear! [(operations (ptr (ArrayList TerminalOperation)))
                          (height i64)] (-> i64)
  (when (> height 0)
    (inline-push! operations (TerminalCursorUp height))
    (let [(mut row) 0]
      (loop (if (>= (load row) height)
                (break)
                (do
                  (inline-push! operations (TerminalCarriageReturn))
                  (inline-push! operations (TerminalEraseLine))
                  (inline-push! operations (TerminalLineBreak))
                  (store! row (+ (load row) 1)))))))
  0)

;; Streaming output leaves the cursor on its final owned row, unlike the input
;; renderer which leaves the cursor below its owned region.
(defn inline-plan-clear-live! [(operations (ptr (ArrayList TerminalOperation)))
                               (height i64)] (-> i64)
  (when (> height 0)
    (when (> height 1)
      (inline-push! operations (TerminalCursorUp (- height 1)))
      0)
    (let [(mut row) 0]
      (loop (if (>= (load row) height)
                (break)
                (do
                  (inline-push! operations (TerminalCarriageReturn))
                  (inline-push! operations (TerminalEraseLine))
                  (when (< (+ (load row) 1) height)
                    (inline-push! operations (TerminalCursorDown 1))
                    0)
                  (store! row (+ (load row) 1))))))
    (when (> height 1)
      (inline-push! operations (TerminalCursorUp (- height 1)))
      0))
  0)

(defn inline-plan-frame! [(operations (ptr (ArrayList TerminalOperation)))
                          (frame (ref Frame))] (-> i64)
  (let [(mut at) 0
        count (al-len [FrameLine] (.lines frame))]
    (loop (if (>= (load at) count)
              (break)
              (let [line (al-get [FrameLine] (.lines frame) (load at))]
                (let [(mut span-at) 0
                      span-count (al-len [FrameSpan] (.spans line))]
                  (loop (if (>= (load span-at) span-count)
                            (break)
                            (let [span
                                    (al-get [FrameSpan]
                                            (.spans line)
                                            (load span-at))]
                              (inline-push! operations
                                            (TerminalSetRole (.role span)))
                              (inline-push! operations
                                            (TerminalWrite (.text span)))
                              (set! span-at (+ (load span-at) 1))))))
                (inline-push! operations (TerminalResetStyle))
                (inline-push! operations (TerminalLineBreak))
                (set! at (+ (load at) 1)))))
    0))

;; Draw mutable rows without advancing past the final row. Inter-row CRLF is
;; safe; only a line break after the last row would grow scrollback on redraw.
(defn inline-plan-live-frame! [(operations (ptr (ArrayList TerminalOperation)))
                               (frame (ref Frame))] (-> i64)
  (let [(mut at) 0
        count (al-len [FrameLine] (.lines frame))]
    (loop (if (>= (load at) count)
              (break)
              (let [line (al-get [FrameLine] (.lines frame) (load at))]
                (let [(mut span-at) 0
                      span-count (al-len [FrameSpan] (.spans line))]
                  (loop (if (>= (load span-at) span-count)
                            (break)
                            (let [span
                                    (al-get [FrameSpan]
                                            (.spans line)
                                            (load span-at))]
                              (inline-push! operations
                                            (TerminalSetRole (.role span)))
                              (inline-push! operations
                                            (TerminalWrite (.text span)))
                              (set! span-at (+ (load span-at) 1))))))
                (inline-push! operations (TerminalResetStyle))
                (when (< (+ (load at) 1) count)
                  (inline-push! operations (TerminalLineBreak))
                  0)
                (set! at (+ (load at) 1)))))
    0))

;; Make room for a growing live frame before painting any of its content. If the
;; cursor is already on the terminal's bottom row, these line breaks scroll erased
;; blank rows into scrollback. Painting first would instead make each partial first
;; line immutable as the frame grows, which is the streamed-text duplication bug.
(defn inline-plan-reserve-live! [(operations (ptr (ArrayList TerminalOperation)))
                                 (height i64)] (-> i64)
  (when (> height 1)
    (let [(mut row) 1]
      (loop (if (>= (load row) height)
                (break)
                (do
                  (inline-push! operations (TerminalLineBreak))
                  (store! row (+ (load row) 1))))))
    (inline-push! operations (TerminalCursorUp (- height 1)))
    0)
  0)

;; A committed frame is written once after the old live region is erased. The new
;; live frame is then drawn beneath it and remains the only mutable terminal area.
(defn inline-renderer-plan-with! [(renderer (ptr InlineRenderer))
                                  (scratch (dyn Allocator))
                                  (committed (ptr Frame))
                                  (live (ptr Frame))] (-> (ArrayList TerminalOperation))
  (let [(mut operations) (inline-operations-new scratch)
        live-height (al-len [FrameLine] (.lines live))]
    ;; Diff when the retained frame makes it valid; otherwise repaint. The two
    ;; paths leave the cursor in the same place and produce the same screen, so
    ;; declining the diff is always safe.
    (if (and (.has-retained renderer)
             (diffable? committed (field renderer retained) live))
        (plan-live-diff! (mut operations) (field renderer retained) live)
        (do
          (inline-plan-clear-live! (mut operations)
                                   (.previous-live-height renderer))
          (inline-plan-frame! (mut operations) committed)
          (inline-plan-reserve-live! (mut operations) live-height)
          (inline-plan-live-frame! (mut operations) live)
          0))
    (set! (.previous-live-height renderer) live-height)
    (inline-renderer-retain! renderer live)
    (load operations)))

(defn inline-renderer-plan! [(renderer (ptr InlineRenderer))
                             (committed (ptr Frame))
                             (live (ptr Frame))] (-> (ArrayList TerminalOperation))
  (inline-renderer-plan-with! renderer
                              (load (field live allocator))
                              committed
                              live))
