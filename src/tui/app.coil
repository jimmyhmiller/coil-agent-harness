(const TUI_COMMIT_BLOCK_BATCH 128)
(defstruct TuiConversation [(conversation-id (slice u8))])

(defstruct TuiNotificationSource
  [(service (ptr RunService))
   (allocator (dyn Allocator))
   (conversation-id (slice u8))
   (cursor i64)
   (pending (ArrayList (slice u8)))
   (pending-next i64)])

(impl InputIdleObserver TuiNotificationSource
  (input-idle-notification? [(self (ptr TuiNotificationSource))]
                            (-> bool)
                            (if (< (.pending-next self)
                                   (al-len [(slice u8)] (.pending self)))
                                true
                                (let [recovery
                                        (service-recover-into (load (field self service))
                                                              (load (field self allocator)))]
                                  (if (not (.ok recovery))
                                      false
                                      (let [events (field recovery events)
                                            (mut i) 0
                                            n (al-len [Json] (load events))]
                                        (loop (if (>= (load i) n)
                                                  (break)
                                                  (let [event (al-get [Json] (load events) (load i))
                                                        sequence (json-number-i64 (json-get event "sequence"))
                                                        payload (json-get event "payload")]
                                                    (when (and (> sequence (load (field self cursor)))
                                                               (and (str-eq (command-string event "event")
                                                                            "run.created")
                                                                    (and (str-eq (command-string payload "actor")
                                                                                 "agent-notification")
                                                                         (str-eq (command-string payload
                                                                                                 "conversation_id")
                                                                                 (load (field self conversation-id))))))
                                                      (al-push! [(slice u8)]
                                                                (mut (field self pending))
                                                                (json-copy-string (load (field self allocator))
                                                                                  (command-string event "run_id")))
                                                      0)
                                                    (set! i (+ (load i) 1)))))
                                        (set! (.cursor self) (.last-sequence recovery))
                                        (< (.pending-next self)
                                           (al-len [(slice u8)] (.pending self)))))))))

(defn tui-notification-current [(source (ptr TuiNotificationSource))] (-> (slice u8))
  (al-get [(slice u8)]
          (.pending source)
          (.pending-next source)))

(defn tui-notification-consume! [(source (ptr TuiNotificationSource))] (-> i64)
  (set! (.pending-next source) (+ (.pending-next source) 1))
  0)

(defn tui-read [(allocator (dyn Allocator))
                (prompt (slice u8))] (-> (slice u8))
  (tui-output-write-slice 1 prompt)
  (let [reader (primitive/alloc-stack io/Reader)]
    (match (io/read-line-alloc allocator (io/fd-reader reader 0) 65536)
      (Ok [owned] (io/owned-bytes-slice owned))
      (Err [failure] ""))))

(defn tui-command [(allocator (dyn Allocator))
                   (run-id (slice u8))
                   (provider (slice u8))
                   (model (slice u8))
                   (effort (slice u8))
                   (prompt (slice u8))] (-> Json)
  (let [(mut command) (json-object allocator)]
    (json-object-put! (mut command) "version" (json-integer allocator 1))
    (json-put-string! (mut command)
                      "command_id"
                      (concat-or-empty allocator "tui:" run-id))
    (json-put-string! (mut command) "run_id" run-id)
    (json-put-string! (mut command)
                      "provider"
                      (if (= (slice-len [u8] provider) 0) "auto" provider))
    (json-put-string! (mut command)
                      "model"
                      (if (= (slice-len [u8] model) 0) "auto" model))
    ;; Omitted when empty so a command from a client that does not pick an
    ;; effort is byte-identical to the ones this harness used to send.
    (when (> (slice-len [u8] effort) 0)
      (json-put-string! (mut command) "effort" effort)
      0)
    (json-put-string! (mut command) "prompt" prompt)
    (load command)))

(defn tui-dependencies [(allocator (dyn Allocator))
                        (source (slice u8))] (-> Json)
  (let [(mut result) (json-array allocator)
        (mut remaining) source
        (mut done) false]
    (loop (if (load done)
              (break)
              (match (str-find (load remaining) ",")
                (None []
                      (do
                        (when (> (slice-len [u8] (load remaining)) 0)
                          (json-array-push! (mut result) (JsonString (load remaining)))
                          0)
                        (set! done true)))
                (Some [position]
                      (do
                        (when (> position 0)
                          (json-array-push! (mut result)
                                            (JsonString (subslice [u8]
                                                                  (load remaining)
                                                                  0
                                                                  position)))
                          0)
                        (set! remaining
                              (subslice [u8]
                                        (load remaining)
                                        (+ position 1)
                                        (slice-len [u8] (load remaining)))))))))
    (load result)))

(defn tui-print-response [(allocator (dyn Allocator))
                          (response ServiceResponse)
                          (profile (ref TerminalProfile))] (-> i64)
  (tui-render-view allocator
                   profile
                   (service-view-generic allocator
                                         (.status response)
                                         (.body response)
                                         (.unicode profile))))

(defn tui-print-run-response [(allocator (dyn Allocator))
                              (response ServiceResponse)
                              (profile (ref TerminalProfile))] (-> i64)
  (tui-render-view allocator
                   profile
                   (service-view-run allocator
                                     (.status response)
                                     (.body response)
                                     (.unicode profile))))

(defn tui-print-workflow-response [(allocator (dyn Allocator))
                                   (response ServiceResponse)
                                   (profile (ref TerminalProfile))] (-> i64)
  (tui-render-view allocator
                   profile
                   (service-view-workflow allocator
                                          (.status response)
                                          (.body response)
                                          (.unicode profile))))

(defn tui-read-secondary [(allocator (dyn Allocator))
                          (profile (ref TerminalProfile))
                          (prompt (slice u8))] (-> (slice u8))
  (if (.interactive profile)
      (let [(mut editor) (input-editor-new allocator)]
        (match (input-read-interactive allocator (mut editor) profile prompt)
          (InputReadSubmitted [text] text)
          (InputReadNotification [] "")
          (InputReadInterrupted [] "")
          (InputReadQuit [] "")
          (InputReadClosed [] "")
          (InputReadFailed [] "")))
      (let [text (tui-read allocator prompt)]
        (tui-output-write-line allocator 1 text)
        text)))

;; The provider names `/model` accepts. `auto` defers to the routing profile; every
;; other name must be one the runtime factory can actually resolve, which is exactly
;; what the router already knows. Validating here means a typo is rejected while the
;; old selection still works, instead of being stored and failing on the next turn
;; with an error that never names the bad value.
(defn tui-selectable-provider? [(provider (slice u8))] (-> bool)
  (or (= provider "auto") (route-known-provider? provider)))

(defn tui-provider-choices [] (-> (slice u8))
  "auto, openai, deepseek-openai, deepseek-anthropic, codex, claude")

;; Empty input means "keep what is already selected", so pressing Enter through the
;; prompts is a no-op rather than a silent reset to auto.
(defn tui-entered-or [(entered (slice u8)) (current (slice u8))] (-> (slice u8))
  (if (= (slice-len [u8] entered) 0) current entered))

(defn tui-model-prompt [(allocator (dyn Allocator))
                        (default-model (slice u8))] (-> (slice u8))
  (concat-or-empty allocator
                   "  model ["
                   (concat-or-empty allocator default-model "]: ")))

(defn tui-report-selection [(allocator (dyn Allocator))
                            (profile (ref TerminalProfile))
                            (provider (slice u8))
                            (model (slice u8))
                            (effort (slice u8))] (-> i64)
  (tui-render-view allocator
                   profile
                   (view-flow (RoleMuted)
                              "  using "
                              "    "
                              (concat-or-empty allocator
                                               provider
                                               (concat-or-empty allocator
                                                                "/"
                                                                (concat-or-empty allocator
                                                                                 model
                                                                                 (if (> (slice-len [u8] effort) 0)
                                                                                     (concat-or-empty allocator
                                                                                                      "  effort "
                                                                                                      effort)
                                                                                     "")))))))

;; ---------------------------------------------------------------------------
;; Model selection
;;
;; Two pickers rather than one flat list: a combined model-times-effort menu
;; would be five rows per model and would make you re-choose the model to change
;; the effort. The second picker is skipped entirely for models that reject an
;; effort parameter, so the menu never offers a control that does nothing.
;; ---------------------------------------------------------------------------

(defn tui-model-entries [(allocator (dyn Allocator))
                         (catalog (ptr ModelCatalog))] (-> (ptr (ArrayList ChoiceEntry)))
  (let [entries (box! allocator (ArrayList ChoiceEntry) (al-new [ChoiceEntry] allocator))
        n (model-catalog-count catalog)
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (let [choice (model-catalog-at catalog (load i))]
                (al-push! [ChoiceEntry]
                          entries
                          (choice-entry (.label choice)
                                        (.summary choice)))
                (set! i (+ (load i) 1)))))
    entries))

(defn tui-effort-entries [(allocator (dyn Allocator))] (-> (ptr (ArrayList ChoiceEntry)))
  (let [entries (box! allocator (ArrayList ChoiceEntry) (al-new [ChoiceEntry] allocator))
        (mut i) 0]
    (loop (if (>= (load i) EFFORT_CHOICE_COUNT)
              (break)
              (let [choice (primitive/alloc-stack EffortChoice)]
                (set! choice (effort-choice-at (load i)))
                (al-push! [ChoiceEntry]
                          entries
                          (choice-entry (.label choice)
                                        (.summary choice)))
                (set! i (+ (load i) 1)))))
    entries))

(defn tui-create [(service (ptr RunService))
                  (allocator (dyn Allocator))
                  (mode (slice u8))
                  (profile (ref TerminalProfile))] (-> i64)
  (let [run-id (tui-read-secondary allocator profile "Run ID: ")
        provider (tui-read-secondary allocator profile "Provider [auto]: ")
        model (tui-read-secondary allocator profile "Model [auto]: ")
        prompt (tui-read-secondary allocator profile "Prompt: ")
        (mut command) (tui-command allocator run-id provider model "" prompt)]
    (when (= mode "agent")
      (json-put-string! (mut command)
                        "parent_run_id"
                        (tui-read-secondary allocator profile "Parent run ID: "))
      0)
    (when (= mode "workflow")
      (json-put-string! (mut command)
                        "workflow_id"
                        (tui-read-secondary allocator profile "Workflow ID: "))
      (json-object-put! (mut command) "workflow_version" (json-integer allocator 1))
      (json-put-string! (mut command)
                        "node_id"
                        (tui-read-secondary allocator profile "Node ID: "))
      (json-object-put! (mut command)
                        "depends_on"
                        (tui-dependencies allocator
                                          (tui-read-secondary allocator
                                                              profile
                                                              "Dependencies (comma-separated run IDs): ")))
      0)
    (tui-print-response allocator
                        (service-submit-run service (mut command) "tui-operator")
                        profile)))

(defn tui-render-view [(session-allocator (dyn Allocator))
                       (profile (ref TerminalProfile))
                       (root ViewNode)] (-> i64)
  (let [cycle (primitive/alloc-stack region/Region)]
    (region/region-init cycle session-allocator)
    (let [scratch (region/region-allocator cycle)
          view (terminal-view root)
          (mut laid-out) (view-layout scratch view (.width profile))
          result
            (tui-output-write-frame scratch
                                    (mut (.frame laid-out))
                                    profile)]
      (region/region-close! cycle)
      result)))

(defn tui-header [(allocator (dyn Allocator))
                  (profile (ref TerminalProfile))] (-> i64)
  (let [(mut root) (view-stack allocator 0)]
    (view-stack-push! (mut root)
                      (view-flow (RoleMuted)
                                 ""
                                 ""
                                 (if (.unicode profile)
                                     "Coil · auto/auto · /help for commands"
                                     "Coil | auto/auto | /help for commands")))
    (view-stack-push! (mut root) (view-spacer 1))
    (tui-render-view allocator profile (load root))))

(defn tui-help [(allocator (dyn Allocator))
                (registry (ptr CommandRegistry))
                (profile (ref TerminalProfile))] (-> i64)
  (let [(mut root) (view-stack allocator 0)
        n (command-count registry)
        (mut widest) 0
        (mut i) 0]
    (view-stack-push! (mut root) (view-flow (RolePrimary) "" "" "Commands"))
    (loop (if (>= (load i) n)
              (break)
              (let [width (slice-len [u8] (.name (command-at registry (load i))))]
                (when (> width (load widest)) (store! widest width) 0)
                (set! i (+ (load i) 1)))))
    (set! i 0)
    (loop (if (>= (load i) n)
              (break)
              (let [spec (command-at registry (load i))
                    (mut line) (sb-new allocator)]
                (sb-push-str! (mut line) "  ")
                (sb-push-str! (mut line) (.name spec))
                (let [(mut pad) (slice-len [u8] (.name spec))]
                  (loop (if (>= (load pad) (+ (load widest) 2))
                            (break)
                            (do
                              (sb-push-byte! (mut line) (cast u8 32))
                              (set! pad (+ (load pad) 1))))))
                (sb-push-str! (mut line) (.summary spec))
                (view-stack-push! (mut root)
                                  (view-flow (RolePrimary) "" "" (sb-finish! (mut line))))
                (set! i (+ (load i) 1)))))
    (view-stack-push! (mut root)
                      (view-flow (RoleMuted)
                                 ""
                                 ""
                                 "  Tab completes · ↑↓ choose · Esc dismisses · Ctrl-R searches history"))
    (tui-render-view allocator profile (load root))))

(defn tui-event-for-run-or-child? [(model (ptr PresentationModel))
                                   (event Json)
                                   (run-id (slice u8))] (-> bool)
  (let [event-run-id (command-string event "run_id")]
    (or (= event-run-id run-id)
        (>= (presentation-block-index model event-run-id (AgentBlock)) 0))))

(defn tui-write-model-range [(allocator (dyn Allocator))
                             (model (ptr PresentationModel))
                             (start i64)
                             (end i64)
                             (profile (ref TerminalProfile))] (-> i64)
  (let [options
          (layout-options-profile (.width profile)
                                  (.unicode profile)
                                  (.compact profile)
                                  (.expanded profile))
        (mut at) start]
    (loop (if (>= (load at) end)
              (break)
              (let [next
                      (if (> end (+ (load at) TUI_COMMIT_BLOCK_BATCH))
                          (+ (load at) TUI_COMMIT_BLOCK_BATCH)
                          end)
                    (mut frame) (layout-model-range allocator model (load at) next options)]
                (tui-output-write-slice 1
                                        (render-frame-plain allocator (mut frame)))
                (set! at next))))
    0))

(defn tui-render-presentation-cycle! [(allocator (dyn Allocator))
                                      (model (ptr PresentationModel))
                                      (policy (ptr TranscriptPolicy))
                                      (rendered-count (ptr i64))
                                      (live-committed (ptr i64))
                                      (renderer (ptr InlineRenderer))
                                      (profile (ref TerminalProfile))
                                      (width i64)
                                      (height i64)
                                      (busy bool)
                                      (cancelling bool)] (-> i64)
  (let [before (load rendered-count)
        after (.committed-count policy)]
    (if (.interactive profile)
        (let [options
                (layout-options-profile width
                                        (.unicode profile)
                                        (.compact profile)
                                        (.expanded profile))
              (mut committed-at) before
              (mut empty) (frame-new allocator)]
          (loop (if (>= (load committed-at) after)
                    (break)
                    (let [next
                            (if (> after (+ (load committed-at) TUI_COMMIT_BLOCK_BATCH))
                                (+ (load committed-at) TUI_COMMIT_BLOCK_BATCH)
                                after)
                          (mut laid)
                            (layout-model-range allocator
                                                model
                                                (load committed-at)
                                                next
                                                options)
                          ;; Rows of this range that were already written while
                          ;; it was live must not be written again. Only the
                          ;; first batch can overlap: it is the one that starts
                          ;; where the live region started.
                          (mut committed)
                            (if (and (= (load committed-at) before)
                                     (> (load live-committed) 0))
                                (frame-range allocator
                                             (mut laid)
                                             (load live-committed)
                                             (al-len [FrameLine] (.lines laid)))
                                (load laid))]
                      (tui-output-inline-update! renderer
                                                 allocator
                                                 profile
                                                 (mut committed)
                                                 (mut empty))
                      (set! committed-at next))))
          (let [(mut live-body) (view-stack allocator 0)]
            (view-stack-push! (mut live-body)
                              (layout-model-range-view allocator
                                                       model
                                                       after
                                                       (al-len [PresentationBlock]
                                                               (.blocks model))
                                                       options))
            ;; The live region is bounded by what the renderer can still
            ;; address, which is the visible height -- not a fixed dozen rows.
            ;; A long answer used to be squeezed into twelve rows with its
            ;; beginning replaced by an ellipsis, which is why streaming looked
            ;; truncated and refused to scroll.
            (let [available (- height 4)
                  live-limit (if (< available 3) 3 available)
                  status-rows (if busy 1 0)
                  body-budget
                    (if (> (- live-limit status-rows) 1)
                        (- live-limit status-rows)
                        1)
                  (mut body)
                    (view-layout allocator
                                 (terminal-view (load live-body))
                                 width)
                  total (al-len [FrameLine] (.lines (.frame body)))
                  ;; Everything above the window has stopped changing, so it is
                  ;; committed as ordinary output and scrolls away like any
                  ;; other transcript instead of being elided.
                  overflow (if (> total body-budget) (- total body-budget) 0)]
              (when (> overflow (load live-committed))
                (let [(mut spill)
                        (frame-range allocator
                                     (mut (field body frame))
                                     (load live-committed)
                                     overflow)]
                  (tui-output-inline-update! renderer
                                             allocator
                                             profile
                                             (mut spill)
                                             (mut empty)))
                (store! live-committed overflow)
                0)
              (let [(mut visible)
                      (frame-range allocator
                                   (mut (.frame body))
                                   (load live-committed)
                                   total)]
                (when busy
                  (let [(mut status)
                          (view-layout allocator
                                       (terminal-view (view-flow (RoleMuted)
                                                                 ""
                                                                 ""
                                                                 (if cancelling
                                                                     "  cancelling…"
                                                                     "  esc to interrupt")))
                                       width)
                        rows (al-len [FrameLine] (load (field (field status frame) lines)))
                        (mut at) 0]
                    (loop (if (>= (load at) rows)
                              (break)
                              (do
                                (al-push! [FrameLine]
                                          (mut (field visible lines))
                                          (al-get [FrameLine]
                                                  (load (field (field status frame) lines))
                                                  (load at)))
                                (store! at (+ (load at) 1))))))
                  0)
                (tui-output-inline-update! renderer
                                           allocator
                                           profile
                                           (mut empty)
                                           (mut visible))
                ;; The cursor has nowhere meaningful to sit while a run streams:
                ;; the composer is closed and the last painted row moves on every
                ;; delta. Leave it hidden until the composer takes it back.
                (when (not busy)
                  (terminal-execute! allocator 1 profile (TerminalShowCursor))
                  0)))))
        (when (> after before)
          (tui-write-model-range allocator model before after profile)
          0))
    (when (> after before)
      (store! live-committed 0)
      0)
    (set! rendered-count after)
    0))

(defn tui-render-presentation! [(session-allocator (dyn Allocator))
                                (model (ptr PresentationModel))
                                (policy (ptr TranscriptPolicy))
                                (rendered-count (ptr i64))
                                (live-committed (ptr i64))
                                (renderer (ptr InlineRenderer))
                                (profile (ref TerminalProfile))
                                (width i64)
                                (height i64)
                                (busy bool)
                                (cancelling bool)] (-> i64)
  (let [cycle (primitive/alloc-stack region/Region)]
    (region/region-init cycle session-allocator)
    (let [result
            (tui-render-presentation-cycle! (region/region-allocator cycle)
                                            model
                                            policy
                                            rendered-count
                                            live-committed
                                            renderer
                                            profile
                                            width
                                            height
                                            busy
                                            cancelling)]
      (region/region-close! cycle)
      result)))

(defn tui-request-cancel! [(service (ptr RunService))
                           (allocator (dyn Allocator))
                           (run-id (slice u8))] (-> i64)
  (let [(mut command) (json-object allocator)]
    (json-object-put! (mut command) "version" (json-integer allocator 1))
    (json-put-string! (mut command)
                      "command_id"
                      (concat-or-empty allocator "tui-cancel:" run-id))
    (json-put-string! (mut command) "run_id" run-id)
    (json-put-string! (mut command) "provider" "service")
    (json-put-string! (mut command) "model" "service")
    (service-request-cancel-durable-run service (load command))))

(defn tui-watch-run [(service (ptr RunService))
                     (allocator (dyn Allocator))
                     (run-id (slice u8))
                     (assistant (ptr StrBuf))
                     (profile (ref TerminalProfile))] (-> i64)
  (let [(mut cursor) 0
        (mut done) false
        (mut dirty) false
        (mut cancelling) false
        (mut rendered-count) 0
        ;; How many rows of the current live block have already scrolled into
        ;; the transcript. Reset whenever the block finishes committing.
        (mut live-committed) 0
        (mut model) (presentation-model-new allocator)
        (mut policy) (transcript-policy-new)
        (mut inline-renderer) (inline-renderer-new-retaining allocator)
        (mut run-input) (input-reader-lifecycle-new)
        (mut run-decoder) (input-decoder-new allocator)
        (mut input-open) false
        (mut width)
          (let [queried (terminal-query-width (cast i32 1))]
            (if (>= queried 12) queried (.width profile)))
        (mut height)
          (let [queried (terminal-query-height (cast i32 1))]
            (if (>= queried 6) queried (.height profile)))]
    (when (load (field profile interactive))
      (store! input-open
              (input-reader-lifecycle-enter! allocator
                                             (mut run-input)
                                             profile))
      0)
    (loop (if (load done)
              (break)
              (let [cycle (primitive/alloc-stack scratch/ScratchArena)
                    queried-width (terminal-query-width (cast i32 1))
                    queried-height (terminal-query-height (cast i32 1))
                    resized
                      (and (.interactive profile)
                           (or (and (>= queried-width 12)
                                    (!= queried-width (load width)))
                               (and (>= queried-height 6)
                                    (!= queried-height (load height)))))
                    recovery
                      (do
                        (scratch/scratch-init cycle (malloc-allocator))
                        (service-recover-into service
                                              (scratch/scratch-allocator cycle)))]
                (when resized
                  (when (>= queried-width 12) (store! width queried-width) 0)
                  (when (>= queried-height 6) (store! height queried-height) 0)
                  (store! dirty true)
                  0)
                (if (not (.ok recovery))
                    (set! done true)
                    (let [events (field recovery events)
                          n (al-len [Json] (load events))]
                      (loop (if (>= (load cursor) n)
                                (break)
                                (let [event (al-get [Json] (load events) (load cursor))
                                      kind (command-string event "event")]
                                  (when (and (= (command-string event "run_id") run-id)
                                             (= kind "model.response.delta"))
                                    (match (json-get event "payload")
                                           (JsonString [text]
                                                       (sb-push-str! assistant text))
                                           (_ 0))
                                    0)
                                  (when (tui-event-for-run-or-child? (mut model) event run-id)
                                    (when (presentation-apply-event! (mut model) event)
                                      (transcript-advance! (mut policy) (mut model))
                                      (if (= kind "run.created")
                                          (store! rendered-count
                                                  (load (field policy committed-count)))
                                          (store! dirty true))
                                      0)
                                    (when (run-watch-event-finishes-root? event run-id)
                                      (store! done true)
                                      0)
                                    0)
                                  (set! cursor (+ (load cursor) 1)))))
                      (when (load dirty)
                        (tui-render-presentation! allocator
                                                  (mut model)
                                                  (mut policy)
                                                  (mut rendered-count)
                                                  (mut live-committed)
                                                  (mut inline-renderer)
                                                  profile
                                                  (load width)
                                                  (load height)
                                                  (not (load done))
                                                  (load cancelling))
                        (store! dirty false)
                        0)
                      (when (load input-open)
                        (let [byte
                                (input-reader-byte allocator
                                                   (mut run-decoder)
                                                   (mut run-input)
                                                   0)
                              decoded
                                (cond (= byte -4) (InputDecoded (InputEndOfFile))
                                      (= byte -3) (InputDecoded (InputInterrupt))
                                      (= byte -2)
                                        (if (> (al-len [u8]
                                                       (load (field run-decoder escape)))
                                               0)
                                            (input-decoder-timeout! (mut run-decoder))
                                            (InputIgnored))
                                      :else
                                        (input-decoder-feed! (mut run-decoder)
                                                             (cast u8 byte)))]
                          (match decoded
                            (InputDecoded [key]
                                          (match (busy-input-intent key)
                                            (BusyInputCancel []
                                                             (when (not (load cancelling))
                                                               ;; A keypress must have a synchronous visual
                                                               ;; consequence. Render the acknowledgement before
                                                               ;; journal recovery/cancellation coordination, both
                                                               ;; of which may touch a large journal.
                                                               (store! cancelling true)
                                                               (tui-render-presentation! allocator
                                                                                         (mut model)
                                                                                         (mut policy)
                                                                                         (mut rendered-count)
                                                                                         (mut live-committed)
                                                                                         (mut inline-renderer)
                                                                                         profile
                                                                                         (load width)
                                                                                         (load height)
                                                                                         true
                                                                                         true)
                                                               (let [status
                                                                       (tui-request-cancel! service
                                                                                            allocator
                                                                                            run-id)]
                                                                 (if (= status 0)
                                                                     ;; Interrupt means return control to the human;
                                                                     ;; the durable worker can finish unwinding in the
                                                                     ;; background and remains inspectable by run ID.
                                                                     (do
                                                                       ;; Cancellation is not an assistant message and
                                                                       ;; is not an error. Erase the mutable run region;
                                                                       ;; the already-committed user prompt remains.
                                                                       (let [(mut empty) (frame-new allocator)]
                                                                         (tui-output-inline-update! (mut inline-renderer)
                                                                                                    allocator
                                                                                                    profile
                                                                                                    (mut empty)
                                                                                                    (mut empty)))
                                                                       (store! done true))
                                                                     (do
                                                                       (store! cancelling false)
                                                                       (store! dirty true)))
                                                                 0)
                                                               0))
                                            (BusyInputSuspend []
                                                              (do
                                                                (input-reader-finish! allocator
                                                                                      (mut run-input)
                                                                                      profile)
                                                                (store! input-open false)
                                                                (terminal-suspend-process)
                                                                (store! input-open
                                                                        (input-reader-lifecycle-enter! allocator
                                                                                                       (mut run-input)
                                                                                                       profile))
                                                                (store! dirty true)
                                                                0))
                                            (BusyInputClose [] (store! done true))
                                            (BusyInputIgnore [] 0)))
                            (InputNeedMore [] 0)
                            (InputIgnored [] 0)
                            (InputPasteTooLarge [] 0)))
                        0)
                      (scratch/scratch-close! cycle)
                      (when (not (load done))
                        (sleep-ms 16)
                        0))))))
    (when (load input-open)
      (input-reader-finish! allocator (mut run-input) profile)
      (store! input-open false)
      0)
    ;; Release the retained live frame; the watch is over and its last
    ;; retention would otherwise outlive the loop.
    (inline-renderer-close! (mut inline-renderer))
    (tui-output-write-line allocator 1 "")
    0))

(defn tui-run-id-counter [] (-> (ptr i64))
  (primitive/alloc-static i64))

(defn tui-new-run-id [(allocator (dyn Allocator))] (-> (slice u8))
  (let [timestamp (json-stringify allocator (json-integer allocator (now-ms)))
        process-id (json-stringify allocator (json-integer allocator (process/id)))
        counter
          (json-stringify allocator
                          (json-integer allocator
                                        (atomic-add (tui-run-id-counter) 1)))]
    (concat-or-empty allocator
                     "chat-"
                     (concat-or-empty allocator
                                      timestamp
                                      (concat-or-empty allocator
                                                       "-"
                                                       (concat-or-empty allocator
                                                                        process-id
                                                                        (concat-or-empty allocator
                                                                                         "-"
                                                                                         counter)))))))

(defn tui-conversation-id [(allocator (dyn Allocator))] (-> (slice u8))
  (match (os/env-get allocator "HARNESS_CONVERSATION_ID")
    (Ok [found]
        (match found
          (Some [owned]
                (let [(mut value) owned
                      configured (os/owned-string-slice (load value))
                      result
                        (if (> (slice-len [u8] configured) 0)
                            (json-copy-string allocator configured)
                            (tui-new-run-id allocator))]
                  (os/owned-string-free allocator value)
                  result))
          (None [] (tui-new-run-id allocator))))
    (Err [failure] (tui-new-run-id allocator))))

(defn tui-submit-prompt [(service (ptr RunService))
                         (allocator (dyn Allocator))
                         (provider (slice u8))
                         (model (slice u8))
                         (effort (slice u8))
                         (prompt (slice u8))
                         (history (ptr TuiConversation))
                         (profile (ref TerminalProfile))] (-> (slice u8))
  (let [run-id (tui-new-run-id allocator)
        (mut command) (tui-command allocator run-id provider model effort prompt)]
    (json-put-string! (mut command) "conversation_id" (.conversation-id history))
    (let [response (service-submit-run service (mut command) "tui-user")]
      (if (and (>= (.status response) 200)
               (< (.status response) 300))
          (do
            (let [(mut assistant) (sb-new allocator)]
              (tui-watch-run service allocator run-id (mut assistant) profile)
              run-id))
          (do (tui-print-response allocator response profile) "")))))

(defn tui-primary-prompt [(allocator (dyn Allocator))
                          (provider (slice u8))
                          (model (slice u8))
                          (effort (slice u8))
                          (unicode bool)] (-> (slice u8))
  (let [(mut value) (sb-new allocator)]
    ;; The composer is the bottom-owned live region, so this compact prefix is
    ;; a persistent status bar without stealing a transcript row.
    (sb-push-str! (mut value) "[")
    (sb-push-str! (mut value) provider)
    (sb-push-str! (mut value) "/")
    (sb-push-str! (mut value) model)
    (when (> (slice-len [u8] effort) 0)
      (sb-push-str! (mut value) " · ")
      (sb-push-str! (mut value) effort)
      0)
    (sb-push-str! (mut value) "]")
    (sb-finish! (mut value))))

(defn tui-status-provider [(provider (slice u8))] (-> (slice u8))
  (if (or (= (slice-len [u8] provider) 0) (= provider "auto"))
      (route-profile-provider "balanced" false)
      provider))

(defn tui-status-model [(provider (slice u8))
                        (model (slice u8))] (-> (slice u8))
  (if (or (= (slice-len [u8] model) 0) (= model "auto"))
      (route-default-model (tui-status-provider provider))
      model))

(defn tui-read-primary [(allocator (dyn Allocator))
                        (editor (ptr InputEditor))
                        (profile (ref TerminalProfile))
                        (provider (slice u8))
                        (model (slice u8))
                        (effort (slice u8))
                        (observer (dyn InputIdleObserver))] (-> InputReadResult)
  (if (.interactive profile)
      (do
        (input-editor-set-status! editor
                                  (tui-primary-prompt allocator
                                                      (tui-status-provider provider)
                                                      (tui-status-model provider model)
                                                      effort
                                                      (.unicode profile)))
        (input-read-primary-observed allocator
                                     editor
                                     profile
                                     (if (.unicode profile) "❯ " "> ")
                                     observer))
      (let [text
              (tui-read allocator
                        (if (.unicode profile) "❯ " "> "))]
        (tui-output-write-line allocator 1 text)
        (InputReadSubmitted text))))

(defn tui-loop [(service (ptr RunService))
                (allocator (dyn Allocator))
                (profile (ref TerminalProfile))] (-> i64)
  (let [fixture-provider (terminal-env-eq? allocator "HARNESS_TUI_TEST_PROVIDER" "1")
        (mut done) false
        (mut provider) (if fixture-provider "tui-fixture" "auto")
        (mut model) (if fixture-provider "fixture-model" "auto")
        ;; Empty means "let the runtime decide" -- the same thing an older
        ;; client sends. Only an explicit pick puts a level on the wire.
        (mut effort) ""
        (mut catalog) (model-catalog-default allocator)
        (mut current-run) ""
        (mut history) (zeroed TuiConversation)
        notifications (box! allocator TuiNotificationSource (zeroed TuiNotificationSource))
        (mut commands) (command-registry-builtin allocator)
        (mut editor) (input-editor-new-with-commands allocator (mut commands))]
    (set! (.conversation-id history) (tui-conversation-id allocator))
    (set! (.service notifications) service)
    (set! (.allocator notifications) allocator)
    (set! (.conversation-id notifications) (.conversation-id history))
    (set! (.pending notifications) (al-new [(slice u8)] allocator))
    (set! (.pending-next notifications) 0)
    (let [initial (service-recover-into service allocator)]
      (set! (.cursor notifications) (if (.ok initial) (.last-sequence initial) 0)))
    (tui-header allocator profile)
    ;; The balanced TUI route currently selects Codex. Prepare its execution
    ;; strategy after rendering the header but before accepting the first prompt,
    ;; so startup is visible and the first submitted message reuses the live
    ;; connection. Product-fixture sessions must remain entirely offline.
    (when (not fixture-provider)
      (service-prepare-provider! service "codex")
      0)
    (loop (if (load done)
              (break)
              (match (tui-read-primary allocator
                                       (mut editor)
                                       profile
                                       (load provider)
                                       (load model)
                                       (load effort)
                                       notifications)
                (InputReadSubmitted [action]
                                    (cond (or (= action "/quit") (= action "/exit")) (store! done true)
                                          (= action "/help") (tui-help allocator (mut commands) profile)
                                          (= action "/clear")
                                            (do
                                              (tui-output-clear-screen allocator profile)
                                              (tui-header allocator profile))
                                          (= action "/conversation")
                                            (tui-output-write-line allocator
                                                                   1
                                                                   (concat-or-empty allocator
                                                                                    "  conversation "
                                                                                    (load (field history
                                                                                                 conversation-id))))
                                          (= action "/new")
                                            (do
                                              (store! (field history conversation-id)
                                                      (tui-new-run-id allocator))
                                              (store! (field notifications conversation-id)
                                                      (load (field history conversation-id)))
                                              (tui-output-write-line allocator
                                                                     1
                                                                     (concat-or-empty allocator
                                                                                      "  new conversation "
                                                                                      (load (field history
                                                                                                   conversation-id)))))
                                          (= action "/model")
                                            (let [entries (tui-model-entries allocator (mut catalog))
                                                  at
                                                    (model-catalog-find (mut catalog)
                                                                        (load provider)
                                                                        (load model))]
                                              (match (input-read-choice allocator
                                                                        profile
                                                                        "  model: "
                                                                        entries
                                                                        at)
                                                (ChoiceSelected [index]
                                                                (let [choice (model-catalog-at (mut catalog) index)]
                                                                  (store! provider (load (field choice provider)))
                                                                  (store! model (load (field choice model)))
                                                                  ;; A model that takes no effort clears any
                                                                  ;; level left over from the previous pick --
                                                                  ;; carrying it forward would send a parameter
                                                                  ;; the provider rejects.
                                                                  (if (not (load (field choice effort)))
                                                                      (store! effort "")
                                                                      (match (input-read-choice allocator
                                                                                                profile
                                                                                                "  effort: "
                                                                                                (tui-effort-entries allocator)
                                                                                                (effort-index (load (field choice
                                                                                                                           default-effort))))
                                                                        (ChoiceSelected [level]
                                                                                        (let [picked
                                                                                                (primitive/alloc-stack EffortChoice)]
                                                                                          (store! picked
                                                                                                  (effort-choice-at level))
                                                                                          (store! effort
                                                                                                  (load (field picked
                                                                                                               label)))))
                                                                        (ChoiceCancelled []
                                                                                         (store! effort
                                                                                                 (load (field choice
                                                                                                              default-effort))))
                                                                        (ChoiceClosed [] (store! done true))
                                                                        (ChoiceFailed [] 0)))
                                                                  (when (= (load provider) "codex")
                                                                    (service-prepare-provider! service "codex")
                                                                    0)
                                                                  (tui-report-selection allocator
                                                                                        profile
                                                                                        (load provider)
                                                                                        (load model)
                                                                                        (load effort))))
                                                (ChoiceCancelled [] 0)
                                                (ChoiceClosed [] (store! done true))
                                                (ChoiceFailed []
                                                              (tui-output-write-line allocator
                                                                                     2
                                                                                     "  could not open the model picker"))))
                                          (= action "/agent")
                                            (do
                                              (if (= (slice-len [u8] (load current-run)) 0)
                                                  (tui-output-write-line allocator
                                                                         1
                                                                         "  Start a conversation before delegating a subagent.")
                                                  (let [prompt
                                                          (tui-read-secondary allocator
                                                                              profile
                                                                              "  subagent task: ")
                                                        run-id (tui-new-run-id allocator)
                                                        (mut command)
                                                          (tui-command allocator
                                                                       run-id
                                                                       (load provider)
                                                                       (load model)
                                                                       (load effort)
                                                                       prompt)]
                                                    (json-put-string! (mut command)
                                                                      "parent_run_id"
                                                                      (load current-run))
                                                    (let [response (service-submit-run service (mut command) "tui-user")]
                                                      (if (and (>= (load (field response status)) 200)
                                                               (< (load (field response status)) 300))
                                                          (let [(mut ignored) (sb-new allocator)]
                                                            (tui-watch-run service
                                                                           allocator
                                                                           run-id
                                                                           (mut ignored)
                                                                           profile))
                                                          (tui-print-response allocator response profile)))))
                                              0)
                                          (= action "/workflow") (tui-create service allocator "workflow" profile)
                                          (= action "/status")
                                            (tui-print-run-response allocator
                                                                    (service-query-run service
                                                                                       (tui-read-secondary allocator
                                                                                                           profile
                                                                                                           "  run id: "))
                                                                    profile)
                                          (= action "/graph")
                                            (tui-print-workflow-response allocator
                                                                         (service-query-workflow service
                                                                                                 (tui-read-secondary allocator
                                                                                                                     profile
                                                                                                                     "  workflow id: "))
                                                                         profile)
                                          (= action "/cancel")
                                            (let [run-id
                                                    (tui-read-secondary allocator
                                                                        profile
                                                                        "  run id: ")
                                                  (mut command) (json-object allocator)]
                                              (json-object-put! (mut command) "version" (json-integer allocator 1))
                                              (json-put-string! (mut command)
                                                                "command_id"
                                                                (concat-or-empty allocator "tui-cancel:" run-id))
                                              (json-put-string! (mut command) "run_id" run-id)
                                              (json-put-string! (mut command) "provider" "service")
                                              (json-put-string! (mut command) "model" "service")
                                              (tui-print-response allocator
                                                                  (service-cancel-run service (load command))
                                                                  profile))
                                          (= (slice-len [u8] action) 0) 0
                                          ;; Anything else beginning with a slash is a
                                          ;; mistyped command, not a prompt. Sending it to
                                          ;; the model hides the typo behind whatever the
                                          ;; model decides to say about it.
                                          (and (starts-with action "/")
                                               (not (command-known? (mut commands) action)))
                                            (do
                                              (tui-output-write-line allocator
                                                                     2
                                                                     (concat-or-empty allocator
                                                                                      "  unknown command "
                                                                                      action))
                                              (tui-output-write-line allocator
                                                                     2
                                                                     "  /help lists the commands")
                                              0)
                                          :else
                                            (do
                                              (tui-output-write-line allocator 1 "")
                                              (let [run-id
                                                      (tui-submit-prompt service
                                                                         allocator
                                                                         (load provider)
                                                                         (load model)
                                                                         (load effort)
                                                                         action
                                                                         (mut history)
                                                                         profile)]
                                                (when (> (slice-len [u8] run-id) 0)
                                                  (store! current-run run-id)
                                                  0)))))
                (InputReadInterrupted [] 0)
                (InputReadNotification []
                                       (let [run-id (tui-notification-current notifications)
                                             (mut ignored) (sb-new allocator)]
                                         (let [child
                                                 (if (starts-with run-id "notification:")
                                                     (subslice [u8]
                                                               run-id
                                                               13
                                                               (slice-len [u8] run-id))
                                                     run-id)]
                                           (tui-render-view allocator
                                                            profile
                                                            (view-flow (RoleSuccess)
                                                                       (if (.unicode profile)
                                                                           "  ✓ "
                                                                           "  done: ")
                                                                       "    "
                                                                       (concat-or-empty allocator
                                                                                        "Async completion "
                                                                                        (concat-or-empty allocator
                                                                                                         child
                                                                                                         " complete")))))
                                         (tui-watch-run service allocator run-id (mut ignored) profile)
                                         (tui-notification-consume! notifications)))
                (InputReadQuit [] (set! done true))
                (InputReadClosed [] (set! done true))
                (InputReadFailed []
                                 (do
                                   (tui-output-write-line allocator
                                                          2
                                                          "interactive input failed")
                                   (set! done true))))))
    0))
