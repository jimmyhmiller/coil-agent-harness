(module harness-tui-input-editor)
(import "coil.primitive" :as primitive)

(import "coil.alloc" :as alloc :use *)
(import "coil.arraylist" :use *)
(import "coil.match" :use *)
(import "coil.slice" :use *)
(import "coil.str" :use *)
(import "harness-tui-cells" :use *)
(import "harness-tui-command" :use *)

(defsum InputKey
  (InputInsert [(text (slice u8))])
  (InputWordLeft [])
  (InputWordRight [])
  (InputDeleteWordForward [])
  (InputKillToEnd [])
  (InputKillToStart [])
  (InputReverseSearch [])
  (InputDismiss [])
  (InputLeft [])
  (InputRight [])
  (InputHome [])
  (InputEnd [])
  (InputBackspace [])
  (InputDelete [])
  (InputDeleteWord [])
  (InputComplete [])
  (InputNewline [])
  (InputSubmit [])
  (InputHistoryPrevious [])
  (InputHistoryNext [])
  (InputInterrupt [])
  (InputSuspend [])
  (InputEndOfFile []))

(defsum InputIntent
  (InputChanged [])
  (InputUnchanged [])
  (InputSubmitted [(text (slice u8))])
  (InputInterrupted [])
  (InputSuspended [])
  (InputClosed []))

;; `commands` is null for secondary prompts (a run id, a provider name), which is
;; how those prompts get no completion menu without a separate editor type.
;;
;; The completion menu is DERIVED from the text rather than stored: matches are
;; recomputed from the buffer on every read. Only the selection index and an
;; explicit dismissal are state, because those are the two things the text cannot
;; tell you. Storing the match list too would give it a second chance to disagree
;; with the buffer.
(defstruct InputEditor
  [(allocator (dyn Allocator))
   (bytes (ArrayList u8))
   (cursor i64)
   (history (ArrayList (slice u8)))
   (history-index i64)
   (commands (ptr CommandRegistry))
   (menu-index i64)
   (menu-dismissed bool)
   (search-active bool)
   (search-query (ArrayList u8))
   (search-index i64)
   (search-saved (slice u8))
   ;; Optional bottom-row context owned by the caller (for example, model).
   (status (slice u8))])

(defn input-editor-new-with-commands [(allocator (dyn Allocator))
                                      (commands (ptr CommandRegistry))] (-> InputEditor)
  (let [editor (primitive/alloc-stack InputEditor)]
    (set! (.allocator editor) allocator)
    (set! (.bytes editor) (al-new [u8] allocator))
    (set! (.cursor editor) 0)
    (set! (.history editor) (al-new [(slice u8)] allocator))
    (set! (.history-index editor) 0)
    (set! (.commands editor) commands)
    (set! (.menu-index editor) 0)
    (set! (.menu-dismissed editor) false)
    (set! (.search-active editor) false)
    (set! (.search-query editor) (al-new [u8] allocator))
    (set! (.search-index editor) 0)
    (set! (.search-saved editor) "")
    (set! (.status editor) "")
    (load editor)))

(defn input-editor-set-status! [(editor (ptr InputEditor))
                                (status (slice u8))] (-> i64)
  (set! (.status editor) status)
  0)

(defn input-editor-new [(allocator (dyn Allocator))] (-> InputEditor)
  (input-editor-new-with-commands allocator (cast (ptr CommandRegistry) 0)))

(defn input-editor-text [(editor (ptr InputEditor))] (-> (slice u8))
  (slice-new [u8]
             (load (field (field editor bytes) data))
             (al-len [u8] (.bytes editor))))

(defn input-copy [(allocator (dyn Allocator)) (text (slice u8))] (-> (slice u8))
  (let [(mut output) (sb-new allocator)]
    (sb-push-str! (mut output) text)
    (sb-finish! (mut output))))

(defn input-editor-clear! [(editor (ptr InputEditor))] (-> i64)
  (al-clear! [u8] (mut (.bytes editor)))
  (set! (.cursor editor) 0)
  (set! (.history-index editor) (al-len [(slice u8)] (.history editor)))
  0)

(defn input-editor-insert-byte! [(editor (ptr InputEditor))
                                 (byte u8)] (-> i64)
  (let [cursor (.cursor editor)
        old-length (al-len [u8] (.bytes editor))]
    (al-push! [u8] (mut (.bytes editor)) byte)
    (let [(mut at) old-length]
      (loop (if (<= (load at) cursor)
                (break)
                (do
                  (al-set! [u8]
                           (mut (.bytes editor))
                           (load at)
                           (al-get [u8]
                                   (.bytes editor)
                                   (- (load at) 1)))
                  (set! at (- (load at) 1))))))
    (al-set! [u8] (mut (.bytes editor)) cursor byte)
    (set! (.cursor editor) (+ cursor 1))
    0))

(defn input-editor-insert! [(editor (ptr InputEditor))
                            (text (slice u8))] (-> i64)
  (let [(mut at) 0
        count (slice-len [u8] text)]
    (loop (if (>= (load at) count)
              (break)
              (do
                (input-editor-insert-byte! editor (slice-get [u8] text (load at)))
                (set! at (+ (load at) 1)))))
    0))

(defn input-editor-remove-range! [(editor (ptr InputEditor))
                                  (start i64)
                                  (end i64)] (-> i64)
  (let [length (al-len [u8] (.bytes editor))
        bounded-start (if (< start 0) 0 start)
        bounded-end (if (> end length) length end)
        amount (- bounded-end bounded-start)]
    (when (> amount 0)
      (let [(mut at) bounded-start]
        (loop (if (>= (+ (load at) amount) length)
                  (break)
                  (do
                    (al-set! [u8]
                             (mut (field editor bytes))
                             (load at)
                             (al-get [u8]
                                     (load (field editor bytes))
                                     (+ (load at) amount)))
                    (store! at (+ (load at) 1))))))
      (let [(mut remaining) amount]
        (loop (if (<= (load remaining) 0)
                  (break)
                  (do
                    (al-pop! [u8] (mut (field editor bytes)))
                    (store! remaining (- (load remaining) 1))))))
      (store! (field editor cursor) bounded-start)
      0)
    0))

(defn input-editor-previous-boundary-from [(editor (ptr InputEditor))
                                           (position i64)] (-> i64)
  (let [(mut at) (- position 1)]
    (loop (if (or (<= (load at) 0)
                  (not (utf8-continuation? (cast i64
                                                 (al-get [u8]
                                                         (.bytes editor)
                                                         (load at))))))
              (break)
              (set! at (- (load at) 1))))
    (if (< (load at) 0) 0 (load at))))

(defn input-editor-previous-boundary [(editor (ptr InputEditor))] (-> i64)
  (input-editor-previous-boundary-from editor
                                       (.cursor editor)))

(defn input-editor-next-boundary [(editor (ptr InputEditor))] (-> i64)
  (let [cursor (.cursor editor)
        length (al-len [u8] (.bytes editor))]
    (if (>= cursor length)
        length
        (let [scalar (utf8-decode (input-editor-text editor) cursor)]
          (if (.valid scalar)
              (+ cursor (.length scalar))
              (+ cursor 1))))))

(defn input-editor-replace! [(editor (ptr InputEditor))
                             (text (slice u8))] (-> i64)
  (al-clear! [u8] (mut (.bytes editor)))
  (set! (.cursor editor) 0)
  (input-editor-insert! editor text))

(defn input-editor-history! [(editor (ptr InputEditor))
                             (direction i64)] (-> InputIntent)
  (let [count (al-len [(slice u8)] (.history editor))
        current (.history-index editor)
        next
          (if (< direction 0)
              (if (> current 0) (- current 1) current)
              (if (< current count) (+ current 1) current))]
    (if (= next current)
        (InputUnchanged)
        (do
          (set! (.history-index editor) next)
          (input-editor-replace! editor
                                 (if (= next count)
                                     ""
                                     (al-get [(slice u8)]
                                             (.history editor)
                                             next)))
          (InputChanged)))))

(defn input-editor-submit! [(editor (ptr InputEditor))] (-> InputIntent)
  (let [text
          (input-copy (load (field editor allocator))
                      (input-editor-text editor))]
    (when (> (slice-len [u8] text) 0)
      (al-push! [(slice u8)] (mut (field editor history)) text)
      0)
    (input-editor-clear! editor)
    (InputSubmitted text)))

;; ---------------------------------------------------------------------------
;; Completion menu
;; ---------------------------------------------------------------------------

;; The buffer is a bare slash command -- and so a completion candidate -- only
;; while it is a single leading-slash word. Once a space or newline appears the
;; user is typing an argument, not choosing a command, and the menu must get out
;; of the way.
(defn input-editor-menu-prefix [(editor (ptr InputEditor))] (-> (slice u8))
  (let [text (input-editor-text editor)
        n (slice-len [u8] text)]
    (if (or (= n 0) (!= (slice-get [u8] text 0) (cast u8 47)))
        ""
        (let [(mut i) 0
              (mut ok) true]
          (loop (if (>= (load i) n)
                    (break)
                    (let [byte (slice-get [u8] text (load i))]
                      (if (or (= byte (cast u8 32)) (= byte (cast u8 10)))
                          (do (set! ok false) (break))
                          (set! i (+ (load i) 1))))))
          (if (load ok) text "")))))

(defn input-editor-menu-matches [(editor (ptr InputEditor))] (-> (ArrayList i64))
  (let [registry (load (field editor commands))
        prefix (input-editor-menu-prefix editor)]
    (if (or (= registry (cast (ptr CommandRegistry) 0))
            (= (slice-len [u8] prefix) 0))
        (al-new [i64] (load (field editor allocator)))
        (command-matches (load (field editor allocator)) registry prefix))))

(defn input-editor-menu-open? [(editor (ptr InputEditor))] (-> bool)
  (if (or (.menu-dismissed editor) (.search-active editor))
      false
      (let [(mut matches) (input-editor-menu-matches editor)]
        (> (al-len [i64] (load matches)) 0))))

;; Clamp rather than wrap-and-store: the match list shrinks as the user types, so
;; a stored index is routinely stale by the time it is read.
(defn input-editor-menu-selected [(editor (ptr InputEditor))] (-> i64)
  (let [(mut matches) (input-editor-menu-matches editor)
        count (al-len [i64] (load matches))
        index (.menu-index editor)]
    (cond (<= count 0) -1
          (< index 0) 0
          (>= index count) (- count 1)
          :else index)))

(defn input-editor-menu-move! [(editor (ptr InputEditor)) (delta i64)] (-> InputIntent)
  (let [(mut matches) (input-editor-menu-matches editor)
        count (al-len [i64] (load matches))]
    (if (<= count 0)
        (InputUnchanged)
        (let [current (input-editor-menu-selected editor)
              next (% (+ (+ current delta) count) count)]
          (set! (.menu-index editor) next)
          (InputChanged)))))

;; True when taking the highlighted row would actually change the line. Enter
;; only steals the keystroke when this holds: with `/quit` typed and `/quit`
;; highlighted, "accepting" it is a no-op, and a no-op that also swallows Enter
;; is a composer that will not submit.
(defn input-editor-menu-would-change? [(editor (ptr InputEditor))] (-> bool)
  (let [registry (load (field editor commands))
        (mut matches) (input-editor-menu-matches editor)
        selected (input-editor-menu-selected editor)]
    (if (or (< selected 0) (= registry (cast (ptr CommandRegistry) 0)))
        false
        (not (= (.name (command-at registry
                                   (al-get [i64] (load matches) selected)))
                (input-editor-text editor))))))

(defn input-editor-menu-accept! [(editor (ptr InputEditor))] (-> InputIntent)
  (let [registry (load (field editor commands))
        (mut matches) (input-editor-menu-matches editor)
        count (al-len [i64] (load matches))
        selected (input-editor-menu-selected editor)]
    (if (or (<= count 0) (< selected 0))
        (InputUnchanged)
        (let [name
                (.name (command-at registry (al-get [i64] (load matches) selected)))]
          (input-editor-replace! editor name)
          (set! (.menu-index editor) 0)
          (InputChanged)))))

;; Tab extends to the longest shared prefix first and only accepts the selection
;; once there is nothing left to share. That is what makes Tab feel like a shell:
;; it never guesses past the point where the candidates agree.
(defn input-editor-complete! [(editor (ptr InputEditor))] (-> InputIntent)
  (let [registry (load (field editor commands))
        prefix (input-editor-menu-prefix editor)]
    (if (or (= registry (cast (ptr CommandRegistry) 0))
            (= (slice-len [u8] prefix) 0))
        (InputUnchanged)
        (let [(mut matches) (command-matches (load (field editor allocator)) registry prefix)
              count (al-len [i64] (load matches))]
          (if (= count 0)
              (InputUnchanged)
              (let [shared
                      (command-common-prefix (load (field editor allocator))
                                             registry
                                             (mut matches))]
                (if (> (slice-len [u8] shared) (slice-len [u8] prefix))
                    (do
                      (input-editor-replace! editor shared)
                      (set! (.menu-dismissed editor) false)
                      (InputChanged))
                    (input-editor-menu-accept! editor))))))))

;; ---------------------------------------------------------------------------
;; Reverse history search
;; ---------------------------------------------------------------------------

(defn input-editor-search-text [(editor (ptr InputEditor))] (-> (slice u8))
  (slice-new [u8]
             (load (field (field editor search-query) data))
             (al-len [u8] (.search-query editor))))

(defn input-editor-search-active? [(editor (ptr InputEditor))] (-> bool)
  (.search-active editor))

(defn input-contains? [(haystack (slice u8)) (needle (slice u8))] (-> bool)
  (let [n (slice-len [u8] haystack)
        m (slice-len [u8] needle)]
    (if (= m 0)
        true
        (if (> m n)
            false
            (let [(mut at) 0
                  (mut found) false]
              (loop (if (or (load found) (> (+ (load at) m) n))
                        (break)
                        (let [(mut i) 0
                              (mut same) true]
                          (loop (if (or (not (load same)) (>= (load i) m))
                                    (break)
                                    (do
                                      (when (!= (slice-get [u8] haystack (+ (load at) (load i)))
                                                (slice-get [u8] needle (load i)))
                                        (store! same false)
                                        0)
                                      (set! i (+ (load i) 1)))))
                          (if (load same)
                              (set! found true)
                              (set! at (+ (load at) 1))))))
              (load found))))))

;; Search backwards from `from`, newest first. Returns -1 for no match, which
;; leaves the buffer alone so a failing search does not destroy what was typed.
(defn input-editor-search-find [(editor (ptr InputEditor)) (from i64)] (-> i64)
  (let [needle (input-editor-search-text editor)
        (mut at) from
        (mut found) -1]
    (loop (if (or (< (load at) 0) (>= (load found) 0))
              (break)
              (do
                (when (input-contains? (al-get [(slice u8)]
                                               (load (field editor history))
                                               (load at))
                                       needle)
                  (store! found (load at))
                  0)
                (set! at (- (load at) 1)))))
    (load found)))

(defn input-editor-search-apply! [(editor (ptr InputEditor)) (from i64)] (-> InputIntent)
  (let [found (input-editor-search-find editor from)]
    (if (< found 0)
        (InputChanged)
        (do
          (set! (.search-index editor) found)
          (input-editor-replace! editor
                                 (al-get [(slice u8)] (.history editor) found))
          (InputChanged)))))

(defn input-editor-search-begin! [(editor (ptr InputEditor))] (-> InputIntent)
  (if (.search-active editor)
      ;; A second Ctrl-R steps to the next older match.
      (input-editor-search-apply! editor (- (.search-index editor) 1))
      (do
        (set! (.search-saved editor) (input-copy (load (field editor allocator)) (input-editor-text editor)))
        (al-clear! [u8] (mut (.search-query editor)))
        (set! (.search-active editor) true)
        (set! (.search-index editor) (- (al-len [(slice u8)] (.history editor)) 1))
        (InputChanged))))

(defn input-editor-search-end! [(editor (ptr InputEditor)) (restore bool)] (-> i64)
  (when (load (field editor search-active))
    (store! (field editor search-active) false)
    (al-clear! [u8] (mut (field editor search-query)))
    (when restore
      (input-editor-replace! editor (load (field editor search-saved)))
      0)
    0)
  0)

;; ---------------------------------------------------------------------------
;; Word and line kills
;; ---------------------------------------------------------------------------

(defn input-editor-word-start [(editor (ptr InputEditor))] (-> i64)
  (let [(mut start) (.cursor editor)]
    (loop (if (<= (load start) 0)
              (break)
              (let [previous (input-editor-previous-boundary-from editor (load start))
                    byte (al-get [u8] (.bytes editor) previous)]
                (if (or (= byte (cast u8 32)) (= byte (cast u8 10)))
                    (set! start previous)
                    (break)))))
    (loop (if (<= (load start) 0)
              (break)
              (let [previous (input-editor-previous-boundary-from editor (load start))
                    byte (al-get [u8] (.bytes editor) previous)]
                (if (or (= byte (cast u8 32)) (= byte (cast u8 10)))
                    (break)
                    (set! start previous)))))
    (load start)))

(defn input-editor-word-end [(editor (ptr InputEditor))] (-> i64)
  (let [length (al-len [u8] (.bytes editor))
        saved (.cursor editor)
        (mut at) saved]
    (loop (if (>= (load at) length)
              (break)
              (let [byte (al-get [u8] (.bytes editor) (load at))]
                (if (or (= byte (cast u8 32)) (= byte (cast u8 10)))
                    (set! at (+ (load at) 1))
                    (break)))))
    (loop (if (>= (load at) length)
              (break)
              (let [byte (al-get [u8] (.bytes editor) (load at))]
                (if (or (= byte (cast u8 32)) (= byte (cast u8 10)))
                    (break)
                    (set! at (+ (load at) 1))))))
    (load at)))

;; ---------------------------------------------------------------------------
;; Key application
;;
;; Three modes share one buffer: reverse search, an open completion menu, and
;; ordinary editing. Search is checked first because while it is active every
;; printable byte belongs to the query rather than the line. The menu is checked
;; second, and only for the four keys it actually claims -- up, down, Tab, and
;; Escape -- so every other key keeps working exactly as it does with no menu.
;; ---------------------------------------------------------------------------

(defn input-editor-search-key! [(editor (ptr InputEditor))
                                (key InputKey)] (-> InputIntent)
  (match key
         (InputInsert [text]
                      (do
                        (let [(mut at) 0
                              count (slice-len [u8] text)]
                          (loop (if (>= (load at) count)
                                    (break)
                                    (do
                                      (al-push! [u8]
                                                (mut (.search-query editor))
                                                (slice-get [u8] text (load at)))
                                      (set! at (+ (load at) 1))))))
                        (input-editor-search-apply! editor
                                                    (- (al-len [(slice u8)] (.history editor)) 1))))
         (InputBackspace []
                         (do
                           (when (> (al-len [u8] (load (field editor search-query))) 0)
                             (al-pop! [u8] (mut (field editor search-query)))
                             0)
                           (input-editor-search-apply! editor
                                                       (- (al-len [(slice u8)] (.history editor)) 1))))
         (InputReverseSearch [] (input-editor-search-begin! editor))
         ;; Escape and Ctrl-C abandon the search and put back what was typed
         ;; before it started. Neither interrupts the run.
         (InputDismiss [] (do (input-editor-search-end! editor true) (InputChanged)))
         (InputInterrupt [] (do (input-editor-search-end! editor true) (InputChanged)))
         (InputSubmit []
                      (do
                        (input-editor-search-end! editor false)
                        (input-editor-submit! editor)))
         ;; Any movement key leaves search with the match in the buffer,
         ;; which is how readline lets you land on a line and then edit it.
         (_ (do (input-editor-search-end! editor false) (InputChanged)))))

(defn input-editor-apply! [(editor (ptr InputEditor))
                           (key InputKey)] (-> InputIntent)
  (if (.search-active editor)
      (input-editor-search-key! editor key)
      (let [menu (input-editor-menu-open? editor)]
        (match key
          (InputInsert [text]
                       (do
                         (input-editor-insert! editor text)
                         (set! (.menu-dismissed editor) false)
                         (set! (.menu-index editor) 0)
                         (InputChanged)))
          (InputLeft []
                     (if (<= (.cursor editor) 0)
                         (InputUnchanged)
                         (do
                           (set! (.cursor editor) (input-editor-previous-boundary editor))
                           (InputChanged))))
          (InputRight []
                      (let [next (input-editor-next-boundary editor)]
                        (if (= next (.cursor editor))
                            (InputUnchanged)
                            (do (set! (.cursor editor) next) (InputChanged)))))
          (InputWordLeft []
                         (let [start (input-editor-word-start editor)]
                           (if (= start (.cursor editor))
                               (InputUnchanged)
                               (do (set! (.cursor editor) start) (InputChanged)))))
          (InputWordRight []
                          (let [end (input-editor-word-end editor)]
                            (if (= end (.cursor editor))
                                (InputUnchanged)
                                (do (set! (.cursor editor) end) (InputChanged)))))
          (InputHome []
                     (do (set! (.cursor editor) 0) (InputChanged)))
          (InputEnd []
                    (do
                      (set! (.cursor editor) (al-len [u8] (.bytes editor)))
                      (InputChanged)))
          (InputBackspace []
                          (if (<= (.cursor editor) 0)
                              (InputUnchanged)
                              (do
                                (input-editor-remove-range! editor
                                                            (input-editor-previous-boundary editor)
                                                            (.cursor editor))
                                (set! (.menu-dismissed editor) false)
                                (InputChanged))))
          (InputDelete []
                       (let [next (input-editor-next-boundary editor)]
                         (if (= next (.cursor editor))
                             (InputUnchanged)
                             (do
                               (input-editor-remove-range! editor
                                                           (.cursor editor)
                                                           next)
                               (InputChanged)))))
          (InputDeleteWord []
                           (let [original (.cursor editor)
                                 start (input-editor-word-start editor)]
                             (if (= start original)
                                 (InputUnchanged)
                                 (do
                                   (input-editor-remove-range! editor start original)
                                   (set! (.menu-dismissed editor) false)
                                   (InputChanged)))))
          (InputDeleteWordForward []
                                  (let [original (.cursor editor)
                                        end (input-editor-word-end editor)]
                                    (if (= end original)
                                        (InputUnchanged)
                                        (do
                                          (input-editor-remove-range! editor original end)
                                          (set! (.cursor editor) original)
                                          (InputChanged)))))
          (InputKillToEnd []
                          (let [cursor (.cursor editor)
                                length (al-len [u8] (.bytes editor))]
                            (if (>= cursor length)
                                (InputUnchanged)
                                (do
                                  (input-editor-remove-range! editor cursor length)
                                  (set! (.cursor editor) cursor)
                                  (InputChanged)))))
          (InputKillToStart []
                            (let [cursor (.cursor editor)]
                              (if (<= cursor 0)
                                  (InputUnchanged)
                                  (do
                                    (input-editor-remove-range! editor 0 cursor)
                                    (set! (.menu-dismissed editor) false)
                                    (InputChanged)))))
          (InputComplete [] (input-editor-complete! editor))
          (InputNewline []
                        (do (input-editor-insert! editor "\n") (InputChanged)))
          ;; With the menu open Enter takes the highlighted command instead of
          ;; submitting a half-typed one. The command still has to be submitted
          ;; with a second Enter, so nothing runs from one keystroke.
          (InputSubmit []
                       (if (and menu (input-editor-menu-would-change? editor))
                           (input-editor-menu-accept! editor)
                           (input-editor-submit! editor)))
          (InputHistoryPrevious []
                                (if menu
                                    (input-editor-menu-move! editor -1)
                                    (input-editor-history! editor -1)))
          (InputHistoryNext []
                            (if menu
                                (input-editor-menu-move! editor 1)
                                (input-editor-history! editor 1)))
          (InputReverseSearch [] (input-editor-search-begin! editor))
          ;; Escape closes the menu when one is open. Only a bare Escape with
          ;; nothing to dismiss reaches the caller as an interrupt, which is why
          ;; dismissal and interruption are separate keys rather than one.
          (InputDismiss []
                        (if menu
                            (do (set! (.menu-dismissed editor) true) (InputChanged))
                            (InputUnchanged)))
          (InputInterrupt [] (InputInterrupted))
          (InputSuspend [] (InputSuspended))
          (InputEndOfFile [] (InputClosed))))))
