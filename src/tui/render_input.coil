(module harness-tui-render-input)

(import "coil.primitive" :as primitive)

(import "coil.alloc" :as alloc :use *)
(import "coil.arraylist" :use *)
(import "harness-allocation-domain" :use *)
(import "harness-tui-diff" :use *)
(import "harness-tui-frame" :use *)
(import "harness-tui-render-inline" :use *)
(import "harness-tui-terminal-operation" :use *)
(import "harness-tui-view-layout" :use *)

(defstruct InputRenderer
  [(previous-height i64)
   (previous-cursor-row i64)
   (previous-menu-rows i64)
   (owner (dyn Allocator))
   (retaining bool)
   (retained Frame)
   (retained-domain (ptr AllocationDomain))
   (has-retained bool)])

(defn input-renderer-new [] (-> InputRenderer)
  (let [renderer (primitive/alloc-stack InputRenderer)]
    (set! (.previous-height renderer) 0)
    (set! (.previous-cursor-row renderer) 0)
    (set! (.previous-menu-rows renderer) 0)
    (set! (.owner renderer) (zeroed (dyn Allocator)))
    (set! (.retaining renderer) false)
    (set! (.has-retained renderer) false)
    (load renderer)))

(defn input-renderer-new-retaining [(owner (dyn Allocator))] (-> InputRenderer)
  (let [(mut renderer) (input-renderer-new)]
    (set! (.owner renderer) owner)
    (set! (.retaining renderer) true)
    (load renderer)))

(defn input-renderer-release! [(renderer (ptr InputRenderer))] (-> i64)
  (when (load (field renderer has-retained))
    (allocation-domain-close! (load (field renderer owner))
                              (load (field renderer retained-domain)))
    (store! (field renderer has-retained) false)
    0)
  0)

(defn input-renderer-retain! [(renderer (ptr InputRenderer))
                              (frame (ptr Frame))] (-> i64)
  (let [owner (load (field renderer owner))]
    (if (not (.retaining renderer))
        0
        (let [domain (allocation-domain-open owner)]
          (if (not (allocation-domain-valid? domain))
              (do (input-renderer-release! renderer) 0)
              (let [old-domain (load (field renderer retained-domain))
                    had-old (.has-retained renderer)
                    clone (primitive/alloc-stack Frame)]
                (frame-clone! (allocation-domain-allocator domain) frame clone)
                (set! (.retained renderer) (load clone))
                (set! (.retained-domain renderer) domain)
                (set! (.has-retained renderer) true)
                (when had-old
                  (allocation-domain-close! owner old-domain)
                  0)
                0))))))

(defn input-renderer-final-row! [(renderer (ptr InputRenderer))
                                 (operations (ptr (ArrayList TerminalOperation)))] (-> i64)
  (let [height (.previous-height renderer)]
    (when (> height 0)
      (inline-push! operations (TerminalCarriageReturn))
      (let [rows (- (- height 1) (load (field renderer previous-cursor-row)))]
        (when (> rows 0)
          (inline-push! operations (TerminalCursorDown rows))
          0))
      0)
    0))

;; `menu-rows` is supplied by the caller rather than read back off the layout.
;; The reader builds the menu, so it is the only thing that knows the count for
;; certain -- deriving it from a struct field meant trusting a value that could
;; be uninitialised, and an over-count here erases live transcript rows above the
;; composer.
(defn input-renderer-plan-with! [(renderer (ptr InputRenderer))
                                 (scratch (dyn Allocator))
                                 (layout (ptr ViewLayout))
                                 (menu-rows i64)] (-> (ArrayList TerminalOperation))
  (let [(mut operations) (inline-operations-new scratch)
        frame (mut (.frame layout))
        height (al-len [FrameLine] (.lines frame))
        cursor-row (.cursor-row layout)]
    (input-renderer-final-row! renderer (mut operations))
    ;; The cursor is now on the previous frame's last row, exactly the position
    ;; expected by the row diff. A normal keystroke therefore rewrites only the
    ;; row containing the edit instead of clearing and repainting the composer.
    (if (and (.has-retained renderer)
             (= (.previous-height renderer) height))
        (plan-live-diff! (mut operations)
                         (field renderer retained)
                         (field layout frame))
        (do
          (inline-plan-clear-live! (mut operations)
                                   (.previous-height renderer))
          (inline-plan-live-frame! (mut operations) frame)
          0))
    (let [rows (- (- height 1) cursor-row)]
      (when (> rows 0)
        (inline-push! (mut operations) (TerminalCursorUp rows))
        0))
    (inline-push! (mut operations) (TerminalCarriageReturn))
    (inline-push! (mut operations)
                  (TerminalCursorRight (.cursor-column layout)))
    (set! (.previous-height renderer) height)
    (set! (.previous-cursor-row renderer) cursor-row)
    (set! (.previous-menu-rows renderer) (if (< menu-rows 0) 0 menu-rows))
    (input-renderer-retain! renderer (field layout frame))
    (load operations)))

(defn input-renderer-plan! [(renderer (ptr InputRenderer))
                            (layout (ptr ViewLayout))] (-> (ArrayList TerminalOperation))
  (input-renderer-plan-with! renderer
                             (load (field (field layout frame) allocator))
                             layout
                             0))

;; Committing turns the composer into transcript. The menu is not transcript, so
;; its rows are erased from the bottom up first and the line break is emitted
;; from the composer's last row. Without this the highlighted completion row
;; stays on screen forever, one copy per submitted command.
(defn input-renderer-commit-plan! [(renderer (ptr InputRenderer))
                                   (scratch (dyn Allocator))] (-> (ArrayList TerminalOperation))
  (let [(mut operations) (inline-operations-new scratch)
        menu-rows (.previous-menu-rows renderer)]
    (input-renderer-final-row! renderer (mut operations))
    (when (> menu-rows 0)
      (let [(mut remaining) menu-rows]
        (loop (if (<= (load remaining) 0)
                  (break)
                  (do
                    (inline-push! (mut operations) (TerminalCarriageReturn))
                    (inline-push! (mut operations) (TerminalEraseLine))
                    (inline-push! (mut operations) (TerminalCursorUp 1))
                    (store! remaining (- (load remaining) 1))))))
      0)
    (when (> (load (field renderer previous-height)) 0)
      (inline-push! (mut operations) (TerminalCarriageReturn))
      (inline-push! (mut operations) (TerminalLineBreak))
      0)
    (set! (.previous-height renderer) 0)
    (set! (.previous-cursor-row renderer) 0)
    (set! (.previous-menu-rows renderer) 0)
    (input-renderer-release! renderer)
    (load operations)))

(defn input-renderer-clear-plan! [(renderer (ptr InputRenderer))
                                  (scratch (dyn Allocator))] (-> (ArrayList TerminalOperation))
  (let [(mut operations) (inline-operations-new scratch)]
    (input-renderer-final-row! renderer (mut operations))
    (inline-plan-clear-live! (mut operations)
                             (.previous-height renderer))
    (set! (.previous-height renderer) 0)
    (set! (.previous-cursor-row renderer) 0)
    (set! (.previous-menu-rows renderer) 0)
    (input-renderer-release! renderer)
    (load operations)))
