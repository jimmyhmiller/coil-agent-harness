(module harness-tui-view-layout)

(import "coil.alloc" :as alloc :use *)
(import "coil.arraylist" :use *)
(import "coil.match" :use *)
(import "coil.slice" :use *)
(import "coil.str" :use *)
(import "harness-tui-cells" :use *)
(import "harness-tui-frame" :use *)
(import "harness-tui-syntax" :use *)
(import "harness-tui-view" :use *)

(defstruct ViewLayout
  [(frame Frame)
   (cursor-present bool)
   (cursor-row i64)
   (cursor-column i64)])

(defn view-layout-hex-byte [(byte i64)] (-> u8)
  (cast u8 (if (< byte 10) (+ 48 byte) (+ 55 byte))))

(defn view-layout-control! [(builder (mut StrBuf)) (byte i64)] (-> i64)
  (sb-push-str! (mut builder) "\\x")
  (sb-push-byte! (mut builder) (view-layout-hex-byte (/ byte 16)))
  (sb-push-byte! (mut builder) (view-layout-hex-byte (% byte 16))))

(defn view-layout-prefix! [(builder (mut StrBuf)) (prefix (slice u8))] (-> i64)
  (sb-push-str! (mut builder) prefix)
  (let [cells (text-cell-width prefix)] (if (< cells 0) 0 cells)))

(defn view-layout-flow! [(frame (ptr Frame))
                         (flow (ptr ViewFlow))
                         (width i64)] (-> i64)
  (let [(mut builder) (sb-new (load (field frame allocator)))
        (mut cells) (view-layout-prefix! (mut builder) (load (field flow first-prefix)))
        text (load (field flow text))
        (mut at) 0
        count (slice-len [u8] text)]
    (loop (if (>= (load at) count)
              (break)
              (let [byte (cast i64 (slice-get [u8] text (load at)))]
                (cond (= byte 10)
                        (do
                          (frame-push-line! frame
                                            (sb-finish! (mut builder))
                                            (load cells)
                                            (load (field flow role)))
                          (store! cells
                                  (view-layout-prefix! (mut builder)
                                                       (load (field flow continuation-prefix))))
                          (store! at (+ (load at) 1)))
                      (= byte 9)
                        (let [spaces (- 4 (% (load cells) 4))
                              (mut i) 0]
                          (loop (if (>= (load i) spaces)
                                    (break)
                                    (do
                                      (when (>= (load cells) width)
                                        (frame-push-line! frame
                                                          (sb-finish! (mut builder))
                                                          (load cells)
                                                          (load (field flow role)))
                                        (store! cells
                                                (view-layout-prefix! (mut builder)
                                                                     (load (field flow continuation-prefix))))
                                        0)
                                      (sb-push-byte! (mut builder) (cast u8 32))
                                      (store! cells (+ (load cells) 1))
                                      (store! i (+ (load i) 1)))))
                          (store! at (+ (load at) 1)))
                      :else
                        (let [scalar (utf8-decode text (load at))]
                          (if (not (load (field scalar valid)))
                              (do
                                (when (> (+ (load cells) 1) width)
                                  (frame-push-line! frame
                                                    (sb-finish! (mut builder))
                                                    (load cells)
                                                    (load (field flow role)))
                                  (store! cells
                                          (view-layout-prefix! (mut builder)
                                                               (load (field flow continuation-prefix))))
                                  0)
                                (sb-push-str! (mut builder) "�")
                                (store! cells (+ (load cells) 1))
                                (store! at (+ (load at) 1)))
                              (let [scalar-width (unicode-cell-width (load (field scalar codepoint)))]
                                (if (< scalar-width 0)
                                    (do
                                      (when (> (+ (load cells) 4) width)
                                        (frame-push-line! frame
                                                          (sb-finish! (mut builder))
                                                          (load cells)
                                                          (load (field flow role)))
                                        (store! cells
                                                (view-layout-prefix! (mut builder)
                                                                     (load (field flow continuation-prefix))))
                                        0)
                                      (view-layout-control! (mut builder) byte)
                                      (store! cells (+ (load cells) 4))
                                      (store! at (+ (load at) 1)))
                                    (do
                                      (when (and (> scalar-width 0)
                                                 (> (+ (load cells) scalar-width) width))
                                        (frame-push-line! frame
                                                          (sb-finish! (mut builder))
                                                          (load cells)
                                                          (load (field flow role)))
                                        (store! cells
                                                (view-layout-prefix! (mut builder)
                                                                     (load (field flow continuation-prefix))))
                                        0)
                                      (sb-push-str! (mut builder)
                                                    (substr text
                                                            (load at)
                                                            (+ (load at)
                                                               (load (field scalar length)))))
                                      (store! cells (+ (load cells) scalar-width))
                                      (store! at
                                              (+ (load at)
                                                 (load (field scalar length)))))))))))))
    (frame-push-line! frame
                      (sb-finish! (mut builder))
                      (load cells)
                      (load (field flow role)))))

;; Code rows are laid out one source line per frame row, highlighted, and clipped
;; rather than wrapped. Wrapping code re-flows it into something that is no longer
;; the code that was written, and a half-line of a shell command is worse than a
;; visibly clipped one.
(defn view-layout-code! [(frame (ptr Frame))
                         (value (ptr ViewCode))
                         (width i64)] (-> i64)
  (let [allocator (load (field frame allocator))
        language (alloc/stack SyntaxLanguage)
        code (load (field value code))
        prefix (load (field value prefix))
        prefix-cells (view-menu-cells prefix)
        n (slice-len [u8] code)
        (mut start) 0
        (mut at) 0]
    (store! language (syntax-language (load (field value language))))
    (loop (if (> (load at) n)
              (break)
              (if (or (= (load at) n)
                      (= (slice-get [u8] code (load at)) (cast u8 10)))
                  (let [line (subslice [u8] code (load start) (load at))
                        room (- width prefix-cells)
                        shown (view-menu-truncate allocator line (if (< room 8) 8 room))
                        (mut spans) (al-new [FrameSpan] allocator)
                        (mut highlighted) (syntax-highlight-line allocator language shown)
                        count (al-len [FrameSpan] (load highlighted))
                        (mut i) 0]
                    (syntax-push-span! (mut spans) prefix (RoleMuted))
                    (loop (if (>= (load i) count)
                              (break)
                              (do
                                (al-push! [FrameSpan]
                                          (mut spans)
                                          (al-get [FrameSpan] (load highlighted) (load i)))
                                (store! i (+ (load i) 1)))))
                    (frame-push-spans! frame (mut spans))
                    (store! at (+ (load at) 1))
                    (store! start (load at)))
                  (store! at (+ (load at) 1)))))
    0))

(defn view-layout-node! [(frame (ptr Frame))
                         (node ViewNode)
                         (width i64)] (-> i64)
  (match node
    (ViewCodeNode [code]
                  (let [value (alloc/stack ViewCode)]
                    (store! value code)
                    (view-layout-code! frame value width)))
    (ViewFlowNode [flow]
                  (let [flow-value (alloc/stack ViewFlow)]
                    (store! flow-value flow)
                    (view-layout-flow! frame flow-value width)))
    (ViewDecoratedFlowNode [decorated]
                           (let [value (alloc/stack ViewDecoratedFlow)
                                 flow (alloc/stack ViewFlow)
                                 before
                                   (al-len [FrameLine]
                                           (load (field frame lines)))
                                 (mut text) (sb-new (load (field frame allocator)))]
                             (store! value decorated)
                             (sb-push-str! (mut text) (load (field value body)))
                             (sb-push-str! (mut text) (load (field value suffix)))
                             (store! (field flow role)
                                     (load (field value line-role)))
                             (store! (field flow first-prefix)
                                     (load (field value first-prefix)))
                             (store! (field flow continuation-prefix)
                                     (load (field value continuation-prefix)))
                             (store! (field flow text) (sb-finish! (mut text)))
                             (view-layout-flow! frame flow width)
                             (when (= (al-len [FrameLine]
                                              (load (field frame lines)))
                                      (+ before 1))
                               (let [(mut spans)
                                       (al-new [FrameSpan]
                                               (load (field frame allocator)))]
                                 (al-push! [FrameSpan]
                                           (mut spans)
                                           (frame-span (load (field value first-prefix))
                                                       (text-cell-width (load (field value first-prefix)))
                                                       (load (field value prefix-role))))
                                 (al-push! [FrameSpan]
                                           (mut spans)
                                           (frame-span (load (field value body))
                                                       (text-cell-width (load (field value body)))
                                                       (load (field value body-role))))
                                 (when (> (slice-len [u8]
                                                     (load (field value suffix)))
                                          0)
                                   (al-push! [FrameSpan]
                                             (mut spans)
                                             (frame-span (load (field value suffix))
                                                         (text-cell-width (load (field value suffix)))
                                                         (load (field value suffix-role))))
                                   0)
                                 (frame-set-line-spans! frame before spans))
                               0)
                             0))
    (ViewSpacerNode [rows]
                    (let [(mut i) 0]
                      (loop (if (>= (load i) rows)
                                (break)
                                (do
                                  (frame-push-line! frame "" 0 (RolePrimary))
                                  (store! i (+ (load i) 1)))))
                      0))
    (ViewTailNode [rows child]
                  (let [(mut full) (frame-new (load (field frame allocator)))]
                    (view-layout-node! (mut full) (load child) width)
                    (let [(mut bounded)
                            (frame-tail-bounded (load (field frame allocator))
                                                (load full)
                                                rows)
                          (mut at) 0
                          count
                            (al-len [FrameLine]
                                    (load (field bounded lines)))]
                      (loop (if (>= (load at) count)
                                (break)
                                (do
                                  (al-push! [FrameLine]
                                            (mut (field frame lines))
                                            (al-get [FrameLine]
                                                    (load (field bounded lines))
                                                    (load at)))
                                  (store! at (+ (load at) 1)))))
                      0)))
    (ViewStackNode [gap children]
                   (let [(mut at) 0
                         n (al-len [ViewNode] (load children))]
                     (loop (if (>= (load at) n)
                               (break)
                               (do
                                 (when (> (load at) 0)
                                   (view-layout-node! frame (ViewSpacerNode gap) width)
                                   0)
                                 (view-layout-node! frame
                                                    (al-get [ViewNode]
                                                            (load children)
                                                            (load at))
                                                    width)
                                 (store! at (+ (load at) 1)))))
                     0))
    (ViewInputNode [input]
                   (let [input-value (alloc/stack ViewInput)
                         flow (alloc/stack ViewFlow)]
                     (store! input-value input)
                     (store! (field flow role) (RolePrimary))
                     (store! (field flow first-prefix)
                             (load (field input-value prompt)))
                     (store! (field flow continuation-prefix) "  ")
                     (store! (field flow text) (load (field input-value text)))
                     (view-layout-flow! frame flow width)))))

(defn view-layout [(allocator (ptr Allocator))
                   (view (ref TerminalView))
                   (width i64)] (-> ViewLayout)
  (let [result (alloc/stack ViewLayout)
        (mut frame) (frame-new allocator)]
    (view-layout-node! (mut frame) (load (field view root)) width)
    (store! (field result frame) (load frame))
    (store! (field result cursor-present) false)
    (store! (field result cursor-row) 0)
    (store! (field result cursor-column) 0)
    (load result)))

(defn view-layout-bound-input [(allocator (ptr Allocator))
                               (full ViewLayout)
                               (row-budget i64)] (-> ViewLayout)
  (let [full-value (alloc/stack ViewLayout)
        source (alloc/stack Frame)]
    (store! full-value full)
    (store! source (load (field full-value frame)))
    (let [count (al-len [FrameLine] (load (field source lines)))
          limit (if (< row-budget 3) 3 row-budget)]
      (if (<= count limit)
          (load full-value)
          (let [result (alloc/stack ViewLayout)
                (mut frame) (frame-new allocator)
                cursor-row (load (field full-value cursor-row))
                start
                  (if (>= cursor-row (- limit 1))
                      (- cursor-row (- limit 2))
                      0)
                leading (if (> start 0) 1 0)
                available (- limit leading)
                tentative-end
                  (if (> (+ start available) count)
                      count
                      (+ start available))
                can-show-trailing
                  (and (< tentative-end count)
                       (< cursor-row (- tentative-end 1)))
                end (if can-show-trailing (- tentative-end 1) tentative-end)
                (mut at) start]
            (when (> leading 0)
              (frame-push-line! (mut frame)
                                "  … earlier input"
                                17
                                (RoleMuted))
              0)
            (loop (if (>= (load at) end)
                      (break)
                      (do
                        (let [line
                                (al-get [FrameLine]
                                        (load (field source lines))
                                        (load at))]
                          (frame-push-line! (mut frame)
                                            (load (field line text))
                                            (load (field line cells))
                                            (load (field line role)))
                          (let [slot
                                  (index (load (field (field frame lines) data))
                                         (- (al-len [FrameLine]
                                                    (load (field frame lines)))
                                            1))]
                            (store! (field slot spans)
                                    (load (field line spans))))
                          0)
                        (store! at (+ (load at) 1)))))
            (when can-show-trailing
              (frame-push-line! (mut frame) "  … more input" 14 (RoleMuted))
              0)
            (store! (field result frame) (load frame))
            (store! (field result cursor-present) true)
            (store! (field result cursor-row) (+ leading (- cursor-row start)))
            (store! (field result cursor-column)
                    (load (field full-value cursor-column)))
            (load result))))))

;; A suffix was selected before layout, so omitted input must be represented even
;; when that suffix happens to occupy fewer rows than the screen budget (for
;; example, a long run of zero-width combining marks).
(defn view-layout-omitted-tail [(allocator (ptr Allocator))
                                (source ViewLayout)
                                (row-budget i64)] (-> ViewLayout)
  (let [source-value (alloc/stack ViewLayout)
        result (alloc/stack ViewLayout)
        limit (if (< row-budget 3) 3 row-budget)]
    (store! source-value source)
    (let [source-frame (mut (field source-value frame))
          count (al-len [FrameLine] (load (field source-frame lines)))
          kept (if (> limit 1) (- limit 1) 0)
          start (if (> count kept) (- count kept) 0)
          (mut frame) (frame-new allocator)
          (mut at) start]
      (frame-push-line! (mut frame) "  … earlier input" 17 (RoleMuted))
      (loop (if (>= (load at) count)
                (break)
                (do
                  (let [line
                          (al-get [FrameLine]
                                  (load (field source-frame lines))
                                  (load at))]
                    (frame-push-line! (mut frame)
                                      (load (field line text))
                                      (load (field line cells))
                                      (load (field line role)))
                    (let [slot
                            (index (load (field (field frame lines) data))
                                   (- (al-len [FrameLine] (load (field frame lines))) 1))]
                      (store! (field slot spans) (load (field line spans))))
                    0)
                  (store! at (+ (load at) 1)))))
      (store! (field result frame) (load frame))
      (store! (field result cursor-present) true)
      (store! (field result cursor-row) (- count start))
      (store! (field result cursor-column) (load (field source-value cursor-column)))
      (load result))))

(defn view-layout-tail-start [(text (slice u8))
                              (width i64)
                              (row-budget i64)] (-> i64)
  (let [count (slice-len [u8] text)
        columns (if (< width 8) 8 width)
        rows (if (< row-budget 3) 3 row-budget)
        ;; Four bytes per cell covers every valid UTF-8 scalar. The extra two
        ;; rows absorb prompt/continuation differences before the final bound.
        maximum (* (* (+ rows 2) columns) 4)
        (mut start) (if (> count maximum) (- count maximum) 0)]
    (loop (if (or (>= (load start) count)
                  (not (utf8-continuation? (cast i64 (slice-get [u8] text (load start))))))
              (break)
              (store! start (+ (load start) 1))))
    (load start)))

;; ---------------------------------------------------------------------------
;; Completion menu
;;
;; Menu rows sit BELOW the composer rows, which is what keeps the prompt still.
;; Putting them above would push the prompt down by a row on every keystroke that
;; changed the match count -- the same class of motion the postmortem was written
;; about. Below, the cursor row is unaffected, so `cursor-row` needs no adjustment
;; and the input renderer's ownership arithmetic is untouched.
;; ---------------------------------------------------------------------------

(const VIEW_MENU_MAX_ROWS 8)

;; `text-cell-width` returns -1 for invalid UTF-8. A menu label is ours, not the
;; model's, but detail text could come from an extension later, so fall back to
;; the byte count rather than propagating a negative width into the arithmetic.
(defn view-menu-cells [(text (slice u8))] (-> i64)
  (let [width (text-cell-width text)]
    (if (< width 0) (slice-len [u8] text) width)))

;; Truncate to a cell budget on a scalar boundary, with an ellipsis when cut.
(defn view-menu-truncate [(allocator (ptr Allocator))
                          (text (slice u8))
                          (budget i64)] (-> (slice u8))
  (if (<= (view-menu-cells text) budget)
      text
      (let [(mut out) (sb-new allocator)
            (mut at) 0
            (mut used) 0
            (mut done) false
            count (slice-len [u8] text)
            room (- budget 1)]
        (loop (if (or (load done) (>= (load at) count))
                  (break)
                  (let [scalar (utf8-decode text (load at))
                        valid (load (field scalar valid))
                        cell-width
                          (if valid
                              (unicode-cell-width (load (field scalar codepoint)))
                              -1)]
                    (if (or (not valid)
                            (or (< cell-width 0)
                                (> (+ (load used) cell-width) room)))
                        (store! done true)
                        (do
                          (sb-push-str! (mut out)
                                        (subslice [u8]
                                                  text
                                                  (load at)
                                                  (+ (load at)
                                                     (load (field scalar length)))))
                          (store! used (+ (load used) cell-width))
                          (store! at (+ (load at) (load (field scalar length)))))))))
        (sb-push-str! (mut out) "…")
        (sb-finish! (mut out)))))

;; `int->str` is a comptime primitive, so a runtime count is formatted by hand.
(defn view-menu-decimal [(allocator (ptr Allocator)) (value i64)] (-> (slice u8))
  (if (<= value 0)
      "0"
      (let [(mut buffer) (sb-new allocator)
            (mut digits) (al-new [i64] allocator)
            (mut remaining) value]
        (loop (if (<= (load remaining) 0)
                  (break)
                  (do
                    (al-push! [i64] (mut digits) (% (load remaining) 10))
                    (store! remaining (/ (load remaining) 10)))))
        (let [n (al-len [i64] (load digits))
              (mut i) 0]
          (loop (if (>= (load i) n)
                    (break)
                    (do
                      (sb-push-byte! (mut buffer)
                                     (cast u8
                                           (+ 48
                                              (al-get [i64]
                                                      (load digits)
                                                      (- (- n 1) (load i))))))
                      (store! i (+ (load i) 1))))))
        (sb-finish! (mut buffer)))))

(defn view-menu-overflow-text [(allocator (ptr Allocator)) (overflow i64)] (-> (slice u8))
  (let [(mut out) (sb-new allocator)]
    (sb-push-str! (mut out) "  … ")
    (sb-push-str! (mut out) (view-menu-decimal allocator overflow))
    (sb-push-str! (mut out) " more")
    (sb-finish! (mut out))))

(defn view-menu-pad [(allocator (ptr Allocator))
                     (text (slice u8))
                     (target i64)] (-> (slice u8))
  (let [(mut out) (sb-new allocator)
        width (view-menu-cells text)
        (mut i) width]
    (sb-push-str! (mut out) text)
    (loop (if (>= (load i) target)
              (break)
              (do (sb-push-byte! (mut out) (cast u8 32)) (store! i (+ (load i) 1)))))
    (sb-finish! (mut out))))

;; Append the menu to a laid-out composer. The selected row is marked with a
;; pointer glyph AND a role change: colour alone would make the selection
;; invisible under NO_COLOR, which the layout contract forbids.
(defn view-layout-append-menu! [(allocator (ptr Allocator))
                                (layout (ptr ViewLayout))
                                (menu (ptr (ArrayList ViewMenuEntry)))
                                (overflow i64)
                                (width i64)] (-> i64)
  (if (= menu (cast (ptr (ArrayList ViewMenuEntry)) 0))
      0
      (let [count (al-len [ViewMenuEntry] (load menu))
            frame (field layout frame)
            (mut label-width) 0
            (mut at) 0]
        (loop (if (>= (load at) count)
                  (break)
                  (let [entry (al-get [ViewMenuEntry] (load menu) (load at))
                        cells (view-menu-cells (load (field entry label)))]
                    (when (> cells (load label-width)) (store! label-width cells) 0)
                    (store! at (+ (load at) 1)))))
        (store! at 0)
        (loop (if (>= (load at) count)
                  (break)
                  (let [entry (al-get [ViewMenuEntry] (load menu) (load at))
                        selected (load (field entry selected))
                        marker (if selected "❯ " "  ")
                        marker-cells 2
                        label
                          (view-menu-pad allocator
                                         (load (field entry label))
                                         (+ (load label-width) 2))
                        label-role (if selected (RolePrimary) (RoleMuted))
                        detail (load (field entry detail))
                        room (- width (+ marker-cells (view-menu-cells label)))
                        (mut spans) (al-new [FrameSpan] allocator)]
                    (al-push! [FrameSpan]
                              (mut spans)
                              (frame-span marker marker-cells label-role))
                    (al-push! [FrameSpan]
                              (mut spans)
                              (frame-span label (view-menu-cells label) label-role))
                    (when (and (> room 1) (> (slice-len [u8] detail) 0))
                      (let [shown (view-menu-truncate allocator detail room)]
                        (al-push! [FrameSpan]
                                  (mut spans)
                                  (frame-span shown (view-menu-cells shown) (RoleMuted))))
                      0)
                    (frame-push-spans! frame (mut spans))
                    (store! at (+ (load at) 1)))))
        (when (> overflow 0)
          (let [(mut spans) (al-new [FrameSpan] allocator)
                text (view-menu-overflow-text allocator overflow)]
            (al-push! [FrameSpan]
                      (mut spans)
                      (frame-span text (view-menu-cells text) (RoleMuted)))
            (frame-push-spans! frame (mut spans)))
          0)
        0)))

;; Resolve a semantic input anchor through the same flow algorithm as its text.
(defn view-layout-input [(allocator (ptr Allocator))
                         (input ViewInput)
                         (width i64)] (-> ViewLayout)
  (let [input-value (alloc/stack ViewInput)
        full-flow (alloc/stack ViewFlow)
        prefix-flow (alloc/stack ViewFlow)
        result (alloc/stack ViewLayout)
        (mut full-frame) (frame-new allocator)
        (mut prefix-frame) (frame-new allocator)]
    (store! input-value input)
    (let [text (load (field input-value text))
          cursor-offset (load (field input-value cursor-offset))
          cursor-at-end (= cursor-offset (slice-len [u8] text))
          tail-start
            (if cursor-at-end
                (view-layout-tail-start text
                                        width
                                        (load (field input-value row-budget)))
                0)
          visible-text (subslice [u8] text tail-start (slice-len [u8] text))]
      (store! (field full-flow role) (RolePrimary))
      (store! (field full-flow first-prefix) (load (field input-value prompt)))
      (store! (field full-flow continuation-prefix) "  ")
      (store! (field full-flow text) visible-text)
      (when (> tail-start 0)
        (store! (field full-flow first-prefix) "  ")
        0)
      (store! prefix-flow (load full-flow))
      (store! (field prefix-flow text)
              (subslice [u8]
                        visible-text
                        0
                        (- cursor-offset tail-start)))
      (view-layout-flow! (mut full-frame) full-flow width)
      ;; Appending at the end is overwhelmingly the common editing operation. The
      ;; full layout already contains that cursor position; laying out the entire
      ;; prefix again made each keystroke perform two complete passes over a long
      ;; buffer and allocate every wrapped row twice.
      (let [cursor-frame
              (if cursor-at-end
                  (mut full-frame)
                  (do
                    (view-layout-flow! (mut prefix-frame) prefix-flow width)
                    (mut prefix-frame)))
            prefix-count (al-len [FrameLine] (load (field cursor-frame lines)))
            cursor-line
              (al-get [FrameLine]
                      (load (field cursor-frame lines))
                      (- prefix-count 1))]
        (store! (field result frame) (load full-frame))
        (store! (field result cursor-present) true)
        (store! (field result cursor-row) (- prefix-count 1))
        (store! (field result cursor-column) (load (field cursor-line cells)))
        ;; The composer is bounded first, then the menu is appended. Bounding the
        ;; two together would let a long prompt scroll the menu out of the region
        ;; it is supposed to be attached to.
        (let [bounded (alloc/stack ViewLayout)]
          (store! bounded
                  (if (> tail-start 0)
                      (view-layout-omitted-tail allocator
                                                (load result)
                                                (load (field input-value row-budget)))
                      (view-layout-bound-input allocator
                                               (load result)
                                               (load (field input-value row-budget)))))
          (view-layout-append-menu! allocator
                                    bounded
                                    (load (field input-value menu))
                                    (load (field input-value menu-overflow))
                                    width)
          (load bounded))))))
