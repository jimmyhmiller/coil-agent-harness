(module harness-tui-frame)
(import "coil.primitive" :as primitive)

(import "coil.primitive" :as primitive)

(import "coil.alloc" :as alloc :use *)
(import "coil.arraylist" :use *)
(import "coil.str" :use *)

;;; Semantic roles, never colours. The first five describe conversation state; the
;;; last four describe code tokens and exist because a code block needs
;;; distinctions that "success" and "warning" cannot honestly carry. A profile
;;; without colour renders them all as plain text, which is why highlighting is
;;; never the only thing distinguishing a code block from prose -- the fence does
;;; that.
(defsum StyleRole
  (RolePrimary [])
  (RoleMuted [])
  (RoleSuccess [])
  (RoleWarning [])
  (RoleFailure [])
  (RoleCodeKeyword [])
  (RoleCodeString [])
  (RoleCodeComment [])
  (RoleCodeNumber []))

(defstruct FrameSpan
  [(text (slice u8))
   (cells i64)
   (role StyleRole)])

(defstruct FrameLine
  [(text (slice u8))
   (cells i64)
   (role StyleRole)
   (spans (ArrayList FrameSpan))])

(defstruct Frame
  [(allocator (dyn Allocator))
   (lines (ArrayList FrameLine))])

(defn frame-new [(allocator (dyn Allocator))] (-> Frame)
  (let [frame (primitive/alloc-stack Frame)]
    (set! (.allocator frame) allocator)
    (set! (.lines frame) (al-new [FrameLine] allocator))
    (load frame)))

(defn frame-push-line! [(frame (ptr Frame))
                        (text (slice u8))
                        (cells i64)
                        (role StyleRole)] (-> i64)
  (let [line (primitive/alloc-stack FrameLine)]
    (set! (.text line) text)
    (set! (.cells line) cells)
    (set! (.role line) role)
    (set! (.spans line) (al-new [FrameSpan] (load (field frame allocator))))
    (let [span (primitive/alloc-stack FrameSpan)]
      (set! (.text span) text)
      (set! (.cells span) cells)
      (set! (.role span) role)
      (al-push! [FrameSpan] (mut (.spans line)) (load span)))
    (al-push! [FrameLine] (mut (.lines frame)) (load line))
    (- (al-len [FrameLine] (.lines frame)) 1)))

(defn frame-push-spans! [(frame (ptr Frame))
                         (spans (ref (ArrayList FrameSpan)))] (-> i64)
  (let [(mut text) (sb-new (load (field frame allocator)))
        (mut cells) 0
        (mut at) 0
        count (al-len [FrameSpan] (load spans))]
    (loop (if (>= (load at) count)
              (break)
              (let [span (al-get [FrameSpan] (load spans) (load at))]
                (sb-push-str! (mut text) (.text span))
                (set! cells (+ (load cells) (.cells span)))
                (set! at (+ (load at) 1)))))
    (let [line (primitive/alloc-stack FrameLine)]
      (set! (.text line) (sb-finish! (mut text)))
      (set! (.cells line) (load cells))
      (set! (.role line) (RolePrimary))
      (set! (.spans line) (load spans))
      (al-push! [FrameLine] (mut (.lines frame)) (load line))
      (- (al-len [FrameLine] (.lines frame)) 1))))

(defn frame-span [(text (slice u8))
                  (cells i64)
                  (role StyleRole)] (-> FrameSpan)
  (let [span (primitive/alloc-stack FrameSpan)]
    (set! (.text span) text)
    (set! (.cells span) cells)
    (set! (.role span) role)
    (load span)))

(defn frame-set-line-spans! [(frame (ptr Frame))
                             (line-index i64)
                             (spans (ref (ArrayList FrameSpan)))] (-> i64)
  (let [line (al-elem [FrameLine] (field frame lines) line-index)
        (mut text) (sb-new (load (field frame allocator)))
        (mut cells) 0
        (mut at) 0
        count (al-len [FrameSpan] (load spans))]
    (loop (if (>= (load at) count)
              (break)
              (let [span (al-get [FrameSpan] (load spans) (load at))]
                (sb-push-str! (mut text) (.text span))
                (set! cells (+ (load cells) (.cells span)))
                (set! at (+ (load at) 1)))))
    (set! (.text line) (sb-finish! (mut text)))
    (set! (.cells line) (load cells))
    (set! (.spans line) (load spans))
    0))

;;; A copy of `source` holding only rows [start, end), spans preserved.
;;;
;;; The live region uses this to split a streamed block into the part that has
;;; scrolled out of the mutable window -- which is finished and can be committed
;;; -- and the tail that is still changing. Appending text to a flow only ever
;;; rewrites its last rows, so a leading row that has left the window will not
;;; change again and is safe to make permanent.
(defn frame-range [(allocator (dyn Allocator))
                   (source (ref Frame))
                   (start i64)
                   (end i64)] (-> Frame)
  (let [count (al-len [FrameLine] (.lines source))
        from (if (< start 0) 0 start)
        to (if (> end count) count end)
        (mut result) (frame-new allocator)
        (mut at) from]
    (loop (if (>= (load at) to)
              (break)
              (let [line (al-get [FrameLine] (.lines source) (load at))]
                (frame-push-line! (mut result)
                                  (.text line)
                                  (.cells line)
                                  (.role line))
                (let [slot (al-elem [FrameLine]
                                    (mut (.lines result))
                                    (- (al-len [FrameLine] (.lines result)) 1))]
                  (set! (.spans slot) (.spans line)))
                (set! at (+ (load at) 1)))))
    (load result)))

;;; Bound a mutable footer to rows the process can continue to address. Committed
;;; transcript frames are never passed through this projection.
(defn frame-tail-bounded [(allocator (dyn Allocator))
                          (source (ref Frame))
                          (maximum i64)] (-> Frame)
  (let [count (al-len [FrameLine] (.lines source))]
    (if (or (<= maximum 0) (<= count maximum))
        (load source)
        (let [(mut result) (frame-new allocator)
              kept (if (> maximum 1) (- maximum 1) 0)
              start (- count kept)
              (mut at) start]
          (frame-push-line! (mut result) "  … earlier live output" 23 (RoleMuted))
          (loop (if (>= (load at) count)
                    (break)
                    (do
                      (let [line
                              (al-get [FrameLine]
                                      (.lines source)
                                      (load at))]
                        (frame-push-line! (mut result)
                                          (.text line)
                                          (.cells line)
                                          (.role line))
                        ;; Preserve the source semantic spans in the bounded view.
                        (let [slot (al-elem [FrameLine]
                                           (mut (.lines result))
                                           (- (al-len [FrameLine] (.lines result)) 1))]
                          (set! (.spans slot) (.spans line)))
                        0)
                      (set! at (+ (load at) 1)))))
          (load result)))))
