(module async-tool-provider)

(import "coil.primitive" :as primitive)

;; A local provider that turns one durable agent run into one ordinary harness
;; tool call. This lets every registered tool use the same asynchronous run ID,
;; cancellation, event journal, and dependency machinery as subagents without
;; teaching each tool how to manage background threads.

(import "coil.alloc" :as alloc :use *)
(import "coil.arraylist" :use *)
(import "coil.match" :use *)
(import "coil.str" :use *)
(import "harness-event" :use *)
(import "harness-json" :use *)
(import "harness-model" :use *)
(import "harness-system" :use *)
(import "harness-tool" :use *)
(import "provider-common" :use *)

(defstruct AsyncToolProvider [(reserved u8)])

(defn async-tool-failure [(message (slice u8))] (-> ModelResult)
  (let [failure (primitive/alloc-stack ModelFailure)]
    (set! (.kind failure) (ConfigurationFailure))
    (set! (.provider failure) "async-tool")
    (set! (.status-code failure) 0)
    (set! (.message failure) message)
    (set! (.retryable failure) false)
    (ModelErr (load failure))))

(defn async-tool-event [(emitter (ptr EventEmitter))
                        (request (ptr ModelRequest))
                        (kind EventKind)
                        (payload Json)] (-> i64)
  (emit-event emitter
              (now-ms)
              kind
              (.run-id request)
              (.operation-id request)
              ""
              "async-tool"
              "async-tool"
              payload))

(defn async-tool-prompt [(request (ptr ModelRequest))] (-> (slice u8))
  (let [messages (load (field request messages))]
    (if (or (= messages (cast (ptr (ArrayList Message)) 0))
            (= (al-len [Message] (load messages)) 0))
        ""
        (let [message (al-get [Message] (load messages) 0)]
          (.content message)))))

(defn async-tool-first-response [(request (ptr ModelRequest))
                                 (allocator (dyn Allocator))] (-> ModelResult)
  (let [parsed (json-parse allocator (async-tool-prompt request))]
    (if (not (.ok parsed))
        (async-tool-failure "invalid asynchronous tool request")
        (let [spec (.value parsed)
              name
                (match (json-string-at spec "tool_name")
                  (Some [value] value)
                  (None [] ""))]
          (if (= (str-len name) 0)
              (async-tool-failure "asynchronous tool name is missing")
              (let [(mut response) (response-empty allocator)
                    (mut call) (zeroed ToolCall)]
                (set! (.provider response) "async-tool")
                (set! (.model response) "async-tool")
                (set! (.response-id response)
                      (concat-or-empty allocator
                                       "async-tool:"
                                       (.run-id request)))
                (set! (.id call)
                      (concat-or-empty allocator
                                       "async-call:"
                                       (.run-id request)))
                (set! (.name call) name)
                (set! (.arguments call) (json-clone allocator (json-get spec "arguments")))
                (set! (.raw-arguments call) (json-stringify allocator (json-get spec "arguments")))
                (al-push! [ToolCall]
                          (mut (.tool-calls response))
                          (load call))
                (ModelOk (load response))))))))

(defn async-tool-terminal-response [(request (ptr ModelRequest))
                                    (emitter (ptr EventEmitter))
                                    (allocator (dyn Allocator))] (-> ModelResult)
  (let [results (load (field (field request continuation) tool-results))
        result
          (if (or (= results (cast (ptr (ArrayList ToolResult)) 0))
                  (= (al-len [ToolResult] (load results)) 0))
              (tool-result-empty "async-tool" (ToolErrored))
              (al-get [ToolResult] (load results) 0))
        (mut payload) (json-object allocator)
        (mut response) (response-empty allocator)]
    (json-put-string! (mut payload)
                      "status"
                      (match (.status result)
                        (ToolSucceeded [] "completed")
                        (ToolErrored [] "failed")
                        (ToolDenied [] "denied")
                        (ToolUnknown [] "unknown")))
    (json-object-put! (mut payload)
                      "output"
                      (json-clone allocator (.output result)))
    (json-put-string! (mut payload) "error" (.error result))
    (let [text (json-stringify allocator (load payload))]
      (async-tool-event emitter request (ModelResponseDelta) (JsonString text))
      (set! (.provider response) "async-tool")
      (set! (.model response) "async-tool")
      (set! (.response-id response) (concat-or-empty allocator "async-tool:" (.run-id request)))
      (set! (.output-text response) text)
      (set! (.raw-output response) (load payload))
      (ModelOk (load response)))))

(impl ModelProvider AsyncToolProvider
  (provider-name [(self (ptr AsyncToolProvider))] (-> (slice u8)) "async-tool")
  (provider-capabilities [(self (ptr AsyncToolProvider))]
                         (-> ProviderCapabilities)
                         (provider-capabilities-for "async-tool"))
  (execute-model [(self (ptr AsyncToolProvider))
                  (request (ptr ModelRequest))
                  (emitter (ptr EventEmitter))
                  (allocator (dyn Allocator))]
                 (-> ModelResult)
                 (async-tool-event emitter request (ModelRequestStarted) (JsonNull))
                 (let [result
                         (if (.present (.continuation request))
                             (async-tool-terminal-response request emitter allocator)
                             (async-tool-first-response request allocator))]
                   (async-tool-event emitter
                                     request
                                     (ModelRequestCompleted)
                                     (JsonString (concat-or-empty allocator
                                                                  "async-tool:"
                                                                  (.run-id request))))
                   result)))
