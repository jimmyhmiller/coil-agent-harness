(module claude-agent)
(import "coil.primitive" :as primitive)

(import "coil.primitive" :as primitive)

(import "coil.alloc" :as alloc :use *)
(import "coil.slice" :use *)
(import "harness-event" :use *)
(import "harness-model" :use *)
(import "harness-subscription-auth" :as subscription)
(import "harness-http" :use *)
(import "deepseek-anthropic" :use *)
(import "provider-common" :use *)

;;; Anthropic subscription traffic uses the native Messages API and the same
;;; provider-neutral tool loop as every other HTTP adapter. Credentials are read
;;; directly from the provider's configured environment variables.
(defstruct ClaudeAnthropicContext [(messages DeepSeekAnthropicContext)])

(defn claude-login [(allocator (dyn Allocator))] (-> i64)
  (subscription/claude-login-native allocator))

(defn claude-logout [(allocator (dyn Allocator))] (-> i64)
  (subscription/claude-logout-native allocator))

(defn claude-anthropic-context-default [(allocator (dyn Allocator))] (-> ClaudeAnthropicContext)
  (let [context (primitive/alloc-stack ClaudeAnthropicContext)
        (mut messages) (deepseek-anthropic-context-default allocator)]
    (set! (.endpoint messages) "https://api.anthropic.com/v1/messages")
    (set! (.primary-env (.credential messages)) c"ANTHROPIC_OAUTH_TOKEN")
    (set! (.fallback-env (.credential messages)) c"ANTHROPIC_AUTH_TOKEN")
    (set! (.provider messages) "claude-anthropic")
    (set! (.credential-error messages) "ANTHROPIC_OAUTH_TOKEN or ANTHROPIC_AUTH_TOKEN is not set")
    (set! (.oauth messages) true)
    (set! (.messages context) (load messages))
    (load context)))

(impl ModelProvider ClaudeAnthropicContext
  (provider-name [(self (ptr ClaudeAnthropicContext))] (-> (slice u8)) "claude-anthropic")
  (provider-capabilities [(self (ptr ClaudeAnthropicContext))]
                         (-> ProviderCapabilities)
                         (provider-capabilities-for "claude-anthropic"))
  (execute-model [(self (ptr ClaudeAnthropicContext))
                  (request (ptr ModelRequest))
                  (emitter (ptr EventEmitter))
                  (allocator (dyn Allocator))]
                 (-> ModelResult)
                 (match (subscription/claude-load-native allocator)
                   (subscription/ClaudeCredentialsFailed [message]
                                                         (model-failure "claude-anthropic" 0 message))
                   (subscription/ClaudeCredentialsLoaded [loaded]
                                                         (let [credentials loaded]
                                                           (set! (.credential-value (.messages self))
                                                                 (.access-token credentials))
                                                           (deepseek-anthropic-execute-stream (field self messages)
                                                                                              request
                                                                                              emitter
                                                                                              allocator))))))
