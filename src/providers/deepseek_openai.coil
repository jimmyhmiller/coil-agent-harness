(module deepseek-openai)

(import "coil.primitive" :as primitive)

(import "coil.alloc" :as alloc :use *)
(import "coil.arraylist" :use *)
(import "coil.match" :use *)
(import "coil.result" :use *)
(import "coil.slice" :use *)
(import "coil.str" :use *)
(import "harness-event" :use *)
(import "harness-json" :use *)
(import "harness-model" :use *)
(import "harness-tool" :use *)
(import "harness-http" :use *)
(import "harness-sse" :use *)
(import "harness-system" :use *)
(import "provider-common" :use *)
(import "openai-chat-wire" :use *)

(defstruct DeepSeekOpenAIContext
  [(endpoint (slice u8))
   (strict-endpoint (slice u8))
   (credential ApiCredential)
   (transport (dyn StreamingHttpTransport))])

(defn deepseek-openai-context-default [(allocator (dyn Allocator))] (-> DeepSeekOpenAIContext)
  (let [context (primitive/alloc-stack DeepSeekOpenAIContext)]
    (set! (.endpoint context) "https://api.deepseek.com/chat/completions")
    (set! (.strict-endpoint context) "https://api.deepseek.com/beta/chat/completions")
    (set! (.primary-env (.credential context)) c"DEEPSEEK_API_KEY")
    (set! (.fallback-env (.credential context)) c"DEEPSEEK_KEY")
    (store! (field context transport)
            (box! allocator CurlStreamingHttpTransport (zeroed CurlStreamingHttpTransport)))
    (load context)))

(defn registry-needs-strict? [(registry (ptr ToolRegistry))] (-> bool)
  (let [definitions (field registry definitions)
        (mut i) 0
        n (al-len [ToolDefinition] (load definitions))
        (mut strict) false]
    (loop (if (>= (load i) n)
              (break)
              (let [definition (al-get [ToolDefinition] (load definitions) (load i))]
                (if (.strict (.spec definition))
                    (do (set! strict true) (break))
                    (set! i (+ (load i) 1))))))
    (load strict)))

(defn deepseek-openai-request-json [(allocator (dyn Allocator)) (request (ptr ModelRequest))] (-> Json)
  (let [(mut body) (json-object allocator)
        (mut thinking) (json-object allocator)]
    (json-put-string! (mut body) "model" (.model request))
    (json-object-put! (mut body)
                      "messages"
                      (chat-continuation-messages allocator request))
    (json-put-string! (mut thinking)
                      "type"
                      (if (= (.reasoning request) "none")
                          "disabled"
                          "enabled"))
    (json-object-put! (mut body) "thinking" (load thinking))
    (when (not (= (load (field request reasoning)) "none"))
      (json-put-string! (mut body)
                        "reasoning_effort"
                        (load (field request reasoning)))
      0)
    (when (> (load (field request max-output-tokens)) 0)
      (json-object-put! (mut body)
                        "max_tokens"
                        (json-integer allocator
                                      (load (field request max-output-tokens))))
      0)
    (chat-attach-tools! allocator (mut body) request)
    (chat-attach-stream-options! allocator (mut body))
    (load body)))

(defn deepseek-openai-event [(emitter (ptr EventEmitter))
                             (request (ptr ModelRequest))
                             (kind EventKind)
                             (payload Json)] (-> i64)
  (emit-event emitter
              (now-ms)
              kind
              (.run-id request)
              (.operation-id request)
              ""
              "deepseek-openai"
              (.model request)
              payload))

(defn deepseek-openai-execute [(context (ptr DeepSeekOpenAIContext))
                               (request (ptr ModelRequest))
                               (emitter (ptr EventEmitter))
                               (allocator (dyn Allocator))] (-> ModelResult)
  (let [key (api-key allocator (.credential context))]
    (if (= (slice-len [u8] key) 0)
        (model-failure "deepseek-openai" 0 "DEEPSEEK_API_KEY or DEEPSEEK_KEY is not set")
        (let [headers
                (box! allocator
                     (ArrayList (slice u8))
                     (al-new [(slice u8)] allocator))
              authorization (concat-or-empty allocator "Authorization: Bearer " key)
              endpoint
                (if (registry-needs-strict? (load (field request tools)))
                    (.strict-endpoint context)
                    (.endpoint context))]
          (al-push! [(slice u8)] headers "Content-Type: application/json")
          (al-push! [(slice u8)] headers authorization)
          (let [wire (deepseek-openai-request-json allocator request)
                body (json-stringify allocator wire)
                http-request (primitive/alloc-stack HttpRequest)]
            (set! (.url http-request) endpoint)
            (set! (.headers http-request) headers)
            (set! (.body http-request) body)
            (set! (.timeout-ms http-request) (model-request-remaining-ms request))
            (set! (.cancellation http-request) (load (field request cancellation)))
            (set! (.context (.chunks http-request)) (cast (ptr i8) 0))
            (set! (.consume (.chunks http-request)) (fnptr-of discard-http-chunk))
            (deepseek-openai-event emitter request (ModelRequestStarted) (JsonNull))
            (let [http (http-post allocator http-request)]
              (if (!= (.transport-code http) 0)
                  (do
                    (deepseek-openai-event emitter
                                           request
                                           (ModelRequestFailed)
                                           (JsonString (.error http)))
                    (model-failure "deepseek-openai" 0 (.error http)))
                  (let [parsed (json-parse allocator (.body http))]
                    (if (not (.ok parsed))
                        (do
                          (deepseek-openai-event emitter
                                                 request
                                                 (ModelRequestFailed)
                                                 (JsonString "DeepSeek returned invalid JSON"))
                          (model-failure "deepseek-openai"
                                         (.status-code http)
                                         "DeepSeek returned invalid JSON"))
                        (let [root (.value parsed)
                              status (.status-code http)]
                          (if (or (< status 200) (>= status 300))
                              (let [message (json-error-message root (.body http))]
                                (deepseek-openai-event emitter
                                                       request
                                                       (ModelRequestFailed)
                                                       (JsonString message))
                                (model-failure "deepseek-openai" status message))
                              (let [(mut response) (chat-parse-response allocator "deepseek-openai" root)]
                                (deepseek-openai-event emitter
                                                       request
                                                       (ModelRequestCompleted)
                                                       (model-completion-payload allocator request (mut response)))
                                (ModelOk (load response))))))))))))))

(defn deepseek-openai-execute-stream [(context (ptr DeepSeekOpenAIContext))
                                      (request (ptr ModelRequest))
                                      (emitter (ptr EventEmitter))
                                      (allocator (dyn Allocator))] (-> ModelResult)
  (let [key (api-key allocator (.credential context))]
    (if (= (slice-len [u8] key) 0)
        (model-failure "deepseek-openai" 0 "DEEPSEEK_API_KEY or DEEPSEEK_KEY is not set")
        (let [headers
                (box! allocator
                     (ArrayList (slice u8))
                     (al-new [(slice u8)] allocator))
              authorization (concat-or-empty allocator "Authorization: Bearer " key)
              endpoint
                (if (registry-needs-strict? (load (field request tools)))
                    (.strict-endpoint context)
                    (.endpoint context))
              state (primitive/alloc-stack OpenAIChatStreamState)
              decoder (primitive/alloc-stack SseDecoder)
              http-request (primitive/alloc-stack HttpRequest)]
          (al-push! [(slice u8)] headers "Content-Type: application/json")
          (al-push! [(slice u8)] headers "Accept: text/event-stream")
          (al-push! [(slice u8)] headers authorization)
          (openai-chat-stream-state-init! state allocator request emitter "deepseek-openai")
          (set! decoder (sse-decoder-new allocator state 1048576))
          (set! (.url http-request) endpoint)
          (set! (.headers http-request) headers)
          (set! (.body http-request)
                (json-stringify allocator
                                (deepseek-openai-request-json allocator request)))
          (set! (.timeout-ms http-request) (model-request-remaining-ms request))
          (set! (.cancellation http-request) (load (field request cancellation)))
          (set! (.context (.chunks http-request)) (cast (ptr i8) decoder))
          (set! (.consume (.chunks http-request)) (fnptr-of sse-http-chunk))
          (deepseek-openai-event emitter request (ModelRequestStarted) (JsonNull))
          (let [http
                  (streaming-http-send (.transport context)
                                       allocator
                                       http-request)
                status (.status-code http)]
            (sse-decoder-free! decoder)
            (if (or (!= (.transport-code http) 0)
                    (< status 200)
                    (>= status 300)
                    (.failed state)
                    (not (.completed state)))
                (let [message
                        (if (.failed state)
                            "DeepSeek stream failed"
                            (if (or (< status 200) (>= status 300))
                                "DeepSeek streaming request returned an error"
                                (.error http)))]
                  (deepseek-openai-event emitter
                                         request
                                         (ModelRequestFailed)
                                         (JsonString message))
                  (model-failure "deepseek-openai" status message))
                (let [(mut response) (openai-chat-stream-response state)]
                  (deepseek-openai-event emitter
                                         request
                                         (ModelRequestCompleted)
                                         (model-completion-payload allocator request (mut response)))
                  (ModelOk (load response)))))))))

(impl ModelProvider DeepSeekOpenAIContext
  (provider-name [(self (ptr DeepSeekOpenAIContext))]
                 (-> (slice u8))
                 "deepseek-openai")
  (provider-capabilities [(self (ptr DeepSeekOpenAIContext))]
                         (-> ProviderCapabilities)
                         (provider-capabilities-for "deepseek-openai"))

  (execute-model [(self (ptr DeepSeekOpenAIContext))
                  (request (ptr ModelRequest))
                  (emitter (ptr EventEmitter))
                  (allocator (dyn Allocator))]
                 (-> ModelResult)
                 (deepseek-openai-execute-stream self request emitter allocator)))
