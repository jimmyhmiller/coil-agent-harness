(module agent-sdk-provider)
(import "coil.primitive" :as primitive)

(import "coil.primitive" :as primitive)

(import "coil.alloc" :as alloc :use *)
(import "coil.arraylist" :use *)
(import "coil.match" :use *)
(import "coil.os" :as os)
(import "coil.result" :use *)
(import "coil.slice" :use *)
(import "coil.str" :use *)
(import "coil.subprocess" :as subprocess)
(import "codex-app-server" :use [codex-child-close codex-child-read codex-child-send codex-last-user-message CodexRead])
(import "harness-event" :use *)
(import "harness-json" :use *)
(import "harness-model" :use *)
(import "harness-system" :use *)
(import "harness-tool" :use *)
(import "harness-tool-executor" :use *)
(import "provider-common" :use *)

(defstruct AgentSdkContext [(cwd (slice u8)) (host (slice u8))])

(defn agent-sdk-string [(value Json) (key (slice u8))] (-> (slice u8))
  (match (json-string-at value key)
    (Some [text] text)
    (None [] "")))

(defn agent-sdk-context [(allocator (dyn Allocator)) (cwd (slice u8))] (-> AgentSdkContext)
  (let [context (primitive/alloc-stack AgentSdkContext)]
    (set! (.cwd context) cwd)
    (set! (.host context)
          (match (os/env-get allocator "HARNESS_AGENT_SDK_HOST")
            (Ok [found]
                (match found
                  (Some [owned] (os/owned-string-slice owned))
                  (None [] "agent-sdk/src/provider.ts")))
            (Err [failure] "agent-sdk/src/provider.ts")))
    (load context)))

(defn agent-sdk-event [(emitter (ptr EventEmitter))
                       (request (ptr ModelRequest))
                       (kind EventKind)
                       (payload Json)] (-> i64)
  (emit-event emitter (now-ms) kind
              (.run-id request)
              (.operation-id request)
              "" "agent-sdk" (.model request) payload))

(defn agent-sdk-tools [(allocator (dyn Allocator))
                       (registry (ptr ToolRegistry))] (-> Json)
  (let [(mut tools) (json-array allocator)
        definitions (field registry definitions)
        (mut i) 0
        n (al-len [ToolDefinition] (load definitions))]
    (loop (if (>= (load i) n)
              (break)
              (let [definition (al-get [ToolDefinition] (load definitions) (load i))
                    spec (.spec definition)
                    (mut tool) (json-object allocator)]
                (json-put-string! (mut tool) "name" (.name spec))
                (json-put-string! (mut tool) "description" (.description spec))
                (json-object-put! (mut tool) "input_schema" (.input-schema spec))
                (json-put-string! (mut tool) "effect" (tool-effect-name (.effect spec)))
                (json-put-bool! (mut tool) "idempotent" (.idempotent spec))
                (json-array-push! (mut tools) (load tool))
                (set! i (+ (load i) 1)))))
    (load tools)))

(defn agent-sdk-start [(context (ptr AgentSdkContext))
                       (request (ptr ModelRequest))
                       (allocator (dyn Allocator))] (-> Json)
  (let [(mut message) (json-object allocator)]
    (json-put-string! (mut message) "type" "start")
    (json-put-string! (mut message) "prompt" (codex-last-user-message request))
    (json-put-string! (mut message) "instructions" (.instructions request))
    (json-put-string! (mut message) "model" (.model request))
    (json-put-string! (mut message) "cwd" (.cwd context))
    (json-object-put! (mut message) "max_turns" (json-integer allocator 100))
    (json-object-put! (mut message) "tools"
                      (agent-sdk-tools allocator (load (field request tools))))
    (load message)))

(defn agent-sdk-run-tool [(allocator (dyn Allocator))
                          (process (ptr subprocess/Child))
                          (emitter (ptr EventEmitter))
                          (request (ptr ModelRequest))
                          (message Json)] (-> i64)
  (let [call (primitive/alloc-stack ToolCall)
        calls (box! allocator (ArrayList ToolCall) (al-new [ToolCall] allocator))
        execution (primitive/alloc-stack ToolExecutionRequest)]
    (set! (.id call) (agent-sdk-string message "id"))
    (set! (.name call) (agent-sdk-string message "name"))
    (set! (.arguments call) (json-get message "arguments"))
    (set! (.raw-arguments call) (json-stringify allocator (.arguments call)))
    (al-push! [ToolCall] calls (load call))
    (set! (.run-id execution) (.run-id request))
    (set! (.parent-operation-id execution) (.operation-id request))
    (set! (.provider execution) "agent-sdk")
    (set! (.model execution) (.model request))
    (set! (.registry execution) (load (field request tools)))
    (set! (.calls execution) calls)
    (set! (.emitter execution) emitter)
    (set! (.cancellation execution) (load (field request cancellation)))
    (set! (.run-deadline-monotonic-ms execution) (.deadline-monotonic-ms request))
    (set! (.max-parallel execution) 1)
    (let [batch (execute-tools-parallel allocator execution)
          result (al-get [ToolResult] (.results batch) 0)
          (mut reply) (json-object allocator)]
      (json-put-string! (mut reply) "type" "tool_result")
      (json-put-string! (mut reply) "id" (.call-id result))
      (json-put-string! (mut reply) "status" (tool-status-name (.status result)))
      (json-object-put! (mut reply) "output" (.output result))
      (json-put-string! (mut reply) "error" (.error result))
      (codex-child-send allocator process (load reply)))))

(defn agent-sdk-execute [(context (ptr AgentSdkContext))
                         (request (ptr ModelRequest))
                         (emitter (ptr EventEmitter))
                         (allocator (dyn Allocator))] (-> ModelResult)
  (let [child (primitive/alloc-stack subprocess/Child)
        args (primitive/alloc-stack (array (slice u8) 1))]
    (set! (index args 0) (.host context))
    (match (subprocess/spawn allocator child "node"
                             (slice-new [(slice u8)] (index args 0) 1)
                             (subprocess/pipe-stdio)
                             (subprocess/pipe-stdio)
                             (subprocess/inherit-stdio))
      (Err [failure] (model-failure "agent-sdk" 0 "could not start Agent SDK host"))
      (Ok [spawned]
          (do
            (agent-sdk-event emitter request (ModelRequestStarted) (JsonNull))
            (if (!= (codex-child-send allocator child (agent-sdk-start context request allocator)) 0)
                (do (codex-child-close child)
                    (model-failure "agent-sdk" 0 "could not initialize Agent SDK host"))
                (let [(mut done) false
                      (mut result) (model-failure "agent-sdk" 0 "Agent SDK host closed without a result")]
                  (loop (if (load done)
                            (break)
                            (let [read (codex-child-read allocator child (model-request-remaining-ms request))]
                              (if (not (.ok read))
                                  (do
                                    (set! result (model-failure "agent-sdk" 0 (.error read)))
                                    (set! done true))
                                  (let [message (.message read)
                                        kind (agent-sdk-string message "type")]
                                    (cond (= kind "tool_call")
                                            (when (!= (agent-sdk-run-tool allocator child emitter request message) 0)
                                              (store! result (model-failure "agent-sdk" 0 "could not return tool result"))
                                              (store! done true)
                                              0)
                                          (= kind "completed")
                                            (let [(mut response) (response-empty allocator)]
                                              (store! (field response provider) "agent-sdk")
                                              (store! (field response model) (load (field request model)))
                                              (store! (field response response-id) (load (field request run-id)))
                                              (store! (field response output-text) (agent-sdk-string message "text"))
                                              (store! result (ModelOk (load response)))
                                              (agent-sdk-event emitter request (ModelRequestCompleted)
                                                               (model-completion-payload allocator request (mut response)))
                                              (store! done true))
                                          (= kind "failed")
                                            (do (store! result (model-failure "agent-sdk" 0 (agent-sdk-string message "error")))
                                                (store! done true))
                                          :else 0))))))
                  (codex-child-close child)
                  (load result))))))))

(impl ModelProvider AgentSdkContext
  (provider-name [(self (ptr AgentSdkContext))] (-> (slice u8)) "agent-sdk")
  (provider-capabilities [(self (ptr AgentSdkContext))] (-> ProviderCapabilities)
                         (provider-capabilities-for "agent-sdk"))
  (execute-model [(self (ptr AgentSdkContext))
                  (request (ptr ModelRequest))
                  (emitter (ptr EventEmitter))
                  (allocator (dyn Allocator))] (-> ModelResult)
                 (agent-sdk-execute self request emitter allocator)))
