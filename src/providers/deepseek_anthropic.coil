(module deepseek-anthropic)

(import "coil.alloc" :as alloc :use *)
(import "coil.arraylist" :use *)
(import "coil.match" :use *)
(import "coil.result" :use *)
(import "coil.slice" :use *)
(import "coil.str" :use *)
(import "harness-event" :use *)
(import "harness-json" :use *)
(import "harness-model" :use *)
(import "harness-tool" :use *)
(import "harness-http" :use *)
(import "harness-sse" :use *)
(import "harness-system" :use *)
(import "provider-common" :use *)

(defstruct DeepSeekAnthropicContext
  [(endpoint (slice u8))
   (credential ApiCredential)
   (provider (slice u8))
   (credential-error (slice u8))
   (oauth bool)
   (transport (dyn StreamingHttpTransport))])

(defn deepseek-anthropic-context-default [(allocator (ptr Allocator))] (-> DeepSeekAnthropicContext)
  (let [context (alloc/stack DeepSeekAnthropicContext)]
    (store! (field context endpoint) "https://api.deepseek.com/anthropic/v1/messages")
    (store! (field (field context credential) primary-env) c"DEEPSEEK_API_KEY")
    (store! (field (field context credential) fallback-env) c"DEEPSEEK_KEY")
    (store! (field context provider) "deepseek-anthropic")
    (store! (field context credential-error) "DEEPSEEK_API_KEY or DEEPSEEK_KEY is not set")
    (store! (field context oauth) false)
    (store! (field context transport)
            (box allocator CurlStreamingHttpTransport (zeroed CurlStreamingHttpTransport)))
    (load context)))

(defn anthropic-base-messages [(allocator (ptr Allocator)) (messages (ptr (ArrayList Message)))] (-> Json)
  (let [(mut result) (json-array allocator)
        (mut i) 0
        n (al-len [Message] (load messages))]
    (loop (if (>= (load i) n)
              (break)
              (let [message (al-get [Message] (load messages) (load i))]
                (match (load (field message role))
                  (SystemRole [] 0)
                  (UserRole []
                            (do
                              (let [(mut wire) (json-object allocator)]
                                (json-put-string! (mut wire) "role" "user")
                                (json-put-string! (mut wire) "content" (load (field message content)))
                                (json-array-push! (mut result) (load wire)))
                              0))
                  (AssistantRole []
                                 (do
                                   (let [(mut wire) (json-object allocator)]
                                     (json-put-string! (mut wire) "role" "assistant")
                                     (json-put-string! (mut wire) "content" (load (field message content)))
                                     (json-array-push! (mut result) (load wire)))
                                   0)))
                (store! i (+ (load i) 1)))))
    (load result)))

(defn anthropic-tool-result-block [(allocator (ptr Allocator)) (result ToolResult)] (-> Json)
  (let [(mut block) (json-object allocator)
        output
          (match (load (field result status))
            (ToolSucceeded [] (json-stringify allocator (load (field result output))))
            (ToolErrored [] (load (field result error)))
            (ToolDenied [] (load (field result error)))
            (ToolUnknown [] (load (field result error))))]
    (json-put-string! (mut block) "type" "tool_result")
    (json-put-string! (mut block) "tool_use_id" (load (field result call-id)))
    (json-put-string! (mut block) "content" output)
    (load block)))

;; Preserve the previous Anthropic content block array verbatim. This retains
;; thinking blocks and signatures while adding all parallel tool results together.
(defn anthropic-messages [(allocator (ptr Allocator)) (request (ptr ModelRequest))] (-> Json)
  (let [(mut messages) (anthropic-base-messages allocator (load (field request messages)))
        continuation (field request continuation)]
    (when (load (field continuation present))
      (let [(mut assistant) (json-object allocator)]
        (json-put-string! (mut assistant) "role" "assistant")
        (json-object-put! (mut assistant)
                          "content"
                          (json-get (load (field continuation previous-output)) "content"))
        (json-array-push! (mut messages) (load assistant)))
      (let [(mut content) (json-array allocator)
            results (load (field continuation tool-results))
            (mut i) 0
            n (al-len [ToolResult] (load results))]
        (loop (if (>= (load i) n)
                  (break)
                  (do
                    (json-array-push! (mut content)
                                      (anthropic-tool-result-block allocator
                                                                   (al-get [ToolResult] (load results) (load i))))
                    (store! i (+ (load i) 1)))))
        (let [(mut user) (json-object allocator)]
          (json-put-string! (mut user) "role" "user")
          (json-object-put! (mut user) "content" (load content))
          (json-array-push! (mut messages) (load user))))
      0)
    (load messages)))

(defn anthropic-request-json [(allocator (ptr Allocator))
                              (request (ptr ModelRequest))
                              (oauth bool)] (-> Json)
  (let [(mut body) (json-object allocator)
        (mut thinking) (json-object allocator)]
    (json-put-string! (mut body) "model" (load (field request model)))
    (json-object-put! (mut body)
                      "max_tokens"
                      (json-integer allocator
                                    (if (> (load (field request max-output-tokens)) 0)
                                        (load (field request max-output-tokens))
                                        4096)))
    (if oauth
        (let [(mut system) (json-array allocator)
              (mut identity) (json-object allocator)]
          (json-put-string! (mut identity) "type" "text")
          (json-put-string! (mut identity)
                            "text"
                            "You are Claude Code, Anthropic's official CLI for Claude.")
          (json-array-push! (mut system) (load identity))
          (when (> (slice-len [u8] (load (field request instructions))) 0)
            (let [(mut instructions) (json-object allocator)]
              (json-put-string! (mut instructions) "type" "text")
              (json-put-string! (mut instructions)
                                "text"
                                (load (field request instructions)))
              (json-array-push! (mut system) (load instructions)))
            0)
          (json-object-put! (mut body) "system" (load system))
          0)
        (when (> (slice-len [u8] (load (field request instructions))) 0)
          (json-put-string! (mut body) "system" (load (field request instructions)))
          0))
    (json-object-put! (mut body)
                      "messages"
                      (anthropic-messages allocator request))
    (json-put-string! (mut thinking)
                      "type"
                      (match-else (load (field request reasoning))
                                  (ReasoningNone [] "disabled")
                                  (_ (if oauth "adaptive" "enabled"))))
    (when (not (match-else (load (field request reasoning))
                           (ReasoningNone [] true)
                           (_ false)))
      (when (not oauth)
        (json-object-put! (mut thinking) "budget_tokens" (json-integer allocator 1024))
        0)
      (let [(mut output-config) (json-object allocator)]
        (json-put-string! (mut output-config)
                          "effort"
                          (reasoning-effort-name (load (field request reasoning))))
        (json-object-put! (mut body) "output_config" (load output-config)))
      0)
    (json-object-put! (mut body) "thinking" (load thinking))
    (when (> (al-len [ToolDefinition]
                     (load (field (load (field request tools)) definitions)))
             0)
      (json-object-put! (mut body)
                        "tools"
                        (tool-registry-wire allocator
                                            (load (field request tools))
                                            TOOL_LAYOUT_ANTHROPIC))
      (json-object-put! (mut body)
                        "tool_choice"
                        (tool-choice-anthropic allocator
                                               (load (field request tool-choice))))
      0)
    (json-put-bool! (mut body) "stream" true)
    (load body)))

(defn deepseek-anthropic-request-json [(allocator (ptr Allocator))
                                       (request (ptr ModelRequest))] (-> Json)
  (anthropic-request-json allocator request false))

(defn deepseek-anthropic-usage [(root Json)] (-> ModelUsage)
  (let [usage (alloc/stack ModelUsage)
        wire (json-get root "usage")]
    (store! (field usage input-tokens)
            (json-number-i64 (json-get wire "input_tokens")))
    (store! (field usage output-tokens)
            (json-number-i64 (json-get wire "output_tokens")))
    (store! (field usage reasoning-tokens) 0)
    (store! (field usage cached-input-tokens)
            (json-number-i64 (json-get wire "cache_read_input_tokens")))
    (load usage)))

(defn anthropic-parse-response [(allocator (ptr Allocator))
                                (root Json)
                                (provider (slice u8))] (-> ModelResponse)
  (let [(mut response) (response-empty allocator)
        (mut text) (sb-new allocator)
        content (json-get root "content")
        (mut i) 0
        count (json-array-length content)]
    (store! (field response provider) provider)
    (store! (field response response-id)
            (match (json-string-at root "id") (Some [value] value) (None [] "")))
    (store! (field response model)
            (match (json-string-at root "model") (Some [value] value) (None [] "")))
    (loop (if (>= (load i) count)
              (break)
              (let [block (json-array-get content (load i))
                    kind
                      (match (json-string-at block "type")
                        (Some [value] value)
                        (None [] ""))]
                (cond (str-eq kind "text")
                        (match (json-string-at block "text")
                          (Some [value] (sb-push-str! (mut text) value))
                          (None [] 0))
                      (str-eq kind "tool_use")
                        (let [id
                                (match (json-string-at block "id")
                                  (Some [value] value)
                                  (None [] ""))
                              name
                                (match (json-string-at block "name")
                                  (Some [value] value)
                                  (None [] ""))
                              input (json-get block "input")
                              arguments (json-stringify allocator input)
                              call (alloc/stack ToolCall)]
                          (store! (field call id) id)
                          (store! (field call name) name)
                          (store! (field call arguments) input)
                          (store! (field call raw-arguments) arguments)
                          (al-push! [ToolCall] (mut (field response tool-calls)) (load call)))
                      :else 0)
                (store! i (+ (load i) 1)))))
    (store! (field response output-text) (sb-finish! (mut text)))
    (store! (field response usage) (deepseek-anthropic-usage root))
    (store! (field response raw-output) root)
    (load response)))

(defn deepseek-anthropic-parse-response [(allocator (ptr Allocator))
                                         (root Json)] (-> ModelResponse)
  (anthropic-parse-response allocator root "deepseek-anthropic"))

(defn anthropic-provider-event [(provider (slice u8))
                                (emitter (ptr EventEmitter))
                                (request (ptr ModelRequest))
                                (kind EventKind)
                                (payload Json)] (-> i64)
  (emit-event emitter
              (now-ms)
              kind
              (load (field request run-id))
              (load (field request operation-id))
              ""
              provider
              (load (field request model))
              payload))

(defn deepseek-anthropic-event [(emitter (ptr EventEmitter))
                                (request (ptr ModelRequest))
                                (kind EventKind)
                                (payload Json)] (-> i64)
  (anthropic-provider-event "deepseek-anthropic" emitter request kind payload))

(defstruct AnthropicStreamBlock
  [(kind (slice u8))
   (id (slice u8))
   (name (slice u8))
   (data StrBuf)
   (signature StrBuf)])

(defstruct DeepSeekAnthropicStreamState
  [(allocator (ptr Allocator))
   (request (ptr ModelRequest))
   (emitter (ptr EventEmitter))
   (provider (slice u8))
   (response-id (slice u8))
   (model (slice u8))
   (blocks (ArrayList AnthropicStreamBlock))
   (usage ModelUsage)
   (completed bool)
   (failed bool)])

(defn anthropic-stream-block! [(state (ptr DeepSeekAnthropicStreamState))
                               (index-value i64)] (-> (ptr AnthropicStreamBlock))
  (loop (if (> (al-len [AnthropicStreamBlock] (load (field state blocks)))
               index-value)
            (break)
            (let [block-slot (alloc/stack AnthropicStreamBlock)]
              (store! (field block-slot kind) "")
              (store! (field block-slot id) "")
              (store! (field block-slot name) "")
              (store! (field block-slot data)
                      (sb-new (load (field state allocator))))
              (store! (field block-slot signature)
                      (sb-new (load (field state allocator))))
              (al-push! [AnthropicStreamBlock]
                        (mut (field state blocks))
                        (load block-slot)))))
  (index (load (field (field state blocks) data)) index-value))

(defn anthropic-stream-start! [(state (ptr DeepSeekAnthropicStreamState))
                               (wire Json)] (-> i64)
  (let [block (json-get wire "content_block")
        slot
          (anthropic-stream-block! state
                                   (json-number-i64 (json-get wire "index")))]
    (match (json-string-at block "type")
      (Some [value]
            (store! (field slot kind)
                    (concat-or-empty (load (field state allocator)) "" value)))
      (None [] 0))
    (match (json-string-at block "id")
      (Some [value]
            (store! (field slot id)
                    (concat-or-empty (load (field state allocator)) "" value)))
      (None [] 0))
    (match (json-string-at block "name")
      (Some [value]
            (store! (field slot name)
                    (concat-or-empty (load (field state allocator)) "" value)))
      (None [] 0))
    0))

(defn anthropic-stream-delta! [(state (ptr DeepSeekAnthropicStreamState))
                               (wire Json)] (-> i64)
  (let [delta (json-get wire "delta")
        slot
          (anthropic-stream-block! state
                                   (json-number-i64 (json-get wire "index")))
        kind
          (match (json-string-at delta "type")
            (Some [value] value)
            (None [] ""))]
    (cond (str-eq kind "text_delta")
            (match (json-string-at delta "text")
              (Some [value]
                    (do
                      (sb-push-str! (mut (field slot data)) value)
                      (anthropic-provider-event (load (field state provider))
                                                (load (field state emitter))
                                                (load (field state request))
                                                (ModelResponseDelta)
                                                (JsonString value))))
              (None [] 0))
          (str-eq kind "thinking_delta")
            (match (json-string-at delta "thinking")
              (Some [value] (sb-push-str! (mut (field slot data)) value))
              (None [] 0))
          (str-eq kind "signature_delta")
            (match (json-string-at delta "signature")
              (Some [value]
                    (sb-push-str! (mut (field slot signature)) value))
              (None [] 0))
          (str-eq kind "input_json_delta")
            (match (json-string-at delta "partial_json")
              (Some [value] (sb-push-str! (mut (field slot data)) value))
              (None [] 0))
          :else 0)))

(defn anthropic-stream-usage! [(state (ptr DeepSeekAnthropicStreamState))
                               (usage Json)] (-> i64)
  (let [input (json-number-i64 (json-get usage "input_tokens"))
        output (json-number-i64 (json-get usage "output_tokens"))
        cached (json-number-i64 (json-get usage "cache_read_input_tokens"))]
    (when (> input 0) (store! (field (field state usage) input-tokens) input) 0)
    (when (> output 0) (store! (field (field state usage) output-tokens) output) 0)
    (when (> cached 0)
      (store! (field (field state usage) cached-input-tokens) cached)
      0)
    0))

(defn anthropic-stream-event! [(state (ptr DeepSeekAnthropicStreamState))
                               (wire Json)] (-> bool)
  (let [kind
          (match (json-string-at wire "type")
            (Some [value] value)
            (None [] ""))]
    (cond (str-eq kind "message_start")
            (let [message (json-get wire "message")]
              (match (json-string-at message "id")
                (Some [value]
                      (store! (field state response-id)
                              (concat-or-empty (load (field state allocator))
                                               ""
                                               value)))
                (None [] 0))
              (match (json-string-at message "model")
                (Some [value]
                      (store! (field state model)
                              (concat-or-empty (load (field state allocator))
                                               ""
                                               value)))
                (None [] 0))
              (anthropic-stream-usage! state (json-get message "usage")))
          (str-eq kind "content_block_start") (anthropic-stream-start! state wire)
          (str-eq kind "content_block_delta") (anthropic-stream-delta! state wire)
          (str-eq kind "message_delta") (anthropic-stream-usage! state (json-get wire "usage"))
          (str-eq kind "message_stop") (do (store! (field state completed) true) 0)
          (str-eq kind "error") (do (store! (field state failed) true) 0)
          :else 0)
    (not (load (field state failed)))))

(impl SseEventSink DeepSeekAnthropicStreamState
  (consume-sse-event [(self (ptr DeepSeekAnthropicStreamState))
                      (event-name (slice u8))
                      (data (slice u8))]
                     (-> bool)
                     (if (model-request-cancelled? (load (field self request)))
                         false
                         (let [parsed (json-parse (load (field self allocator)) data)]
                           (if (load (field parsed ok))
                               (anthropic-stream-event! self
                                                        (load (field parsed value)))
                               (do (store! (field self failed) true) false))))))

(defn anthropic-stream-response [(state (ptr DeepSeekAnthropicStreamState))] (-> ModelResponse)
  (let [allocator (load (field state allocator))
        (mut root) (json-object allocator)
        (mut content) (json-array allocator)
        (mut usage) (json-object allocator)
        (mut i) 0
        count (al-len [AnthropicStreamBlock] (load (field state blocks)))]
    (loop (if (>= (load i) count)
              (break)
              (let [source
                      (al-get [AnthropicStreamBlock]
                              (load (field state blocks))
                              (load i))
                    kind (load (field source kind))
                    (mut block) (json-object allocator)]
                (json-put-string! (mut block) "type" kind)
                (cond (str-eq kind "text")
                        (do
                          (json-put-string! (mut block)
                                            "text"
                                            (sb-str (load (field source data))))
                          0)
                      (str-eq kind "thinking")
                        (do
                          (json-put-string! (mut block)
                                            "thinking"
                                            (sb-str (load (field source data))))
                          (json-put-string! (mut block)
                                            "signature"
                                            (sb-str (load (field source signature))))
                          0)
                      (str-eq kind "tool_use")
                        (let [parsed
                                (json-parse allocator
                                            (sb-str (load (field source data))))]
                          (json-put-string! (mut block) "id" (load (field source id)))
                          (json-put-string! (mut block)
                                            "name"
                                            (load (field source name)))
                          (json-object-put! (mut block)
                                            "input"
                                            (if (load (field parsed ok))
                                                (load (field parsed value))
                                                (JsonNull)))
                          0)
                      :else 0)
                (json-array-push! (mut content) (load block))
                (store! i (+ (load i) 1)))))
    (json-put-string! (mut root) "id" (load (field state response-id)))
    (json-put-string! (mut root) "model" (load (field state model)))
    (json-object-put! (mut root) "content" (load content))
    (json-object-put! (mut usage)
                      "input_tokens"
                      (json-integer allocator
                                    (load (field (field state usage) input-tokens))))
    (json-object-put! (mut usage)
                      "output_tokens"
                      (json-integer allocator
                                    (load (field (field state usage) output-tokens))))
    (json-object-put! (mut usage)
                      "cache_read_input_tokens"
                      (json-integer allocator
                                    (load (field (field state usage)
                                                 cached-input-tokens))))
    (json-object-put! (mut root) "usage" (load usage))
    (anthropic-parse-response allocator
                              (load root)
                              (load (field state provider)))))

(defn deepseek-anthropic-execute [(context (ptr DeepSeekAnthropicContext))
                                  (request (ptr ModelRequest))
                                  (emitter (ptr EventEmitter))
                                  (allocator (ptr Allocator))] (-> ModelResult)
  (let [key (api-key allocator (load (field context credential)))]
    (if (= (slice-len [u8] key) 0)
        (model-failure "deepseek-anthropic" 0 "DEEPSEEK_API_KEY or DEEPSEEK_KEY is not set")
        (let [headers
                (box allocator
                     (ArrayList (slice u8))
                     (al-new [(slice u8)] allocator))
              api-header (concat-or-empty allocator "x-api-key: " key)]
          (al-push! [(slice u8)] headers "Content-Type: application/json")
          (al-push! [(slice u8)] headers "anthropic-version: 2023-06-01")
          (al-push! [(slice u8)] headers api-header)
          (let [wire (deepseek-anthropic-request-json allocator request)
                body (json-stringify allocator wire)
                http-request (alloc/stack HttpRequest)]
            (store! (field http-request url) (load (field context endpoint)))
            (store! (field http-request headers) headers)
            (store! (field http-request body) body)
            (store! (field http-request timeout-ms) (model-request-remaining-ms request))
            (store! (field (field http-request chunks) context) (cast (ptr i8) 0))
            (store! (field (field http-request chunks) consume) (fnptr-of discard-http-chunk))
            (deepseek-anthropic-event emitter request (ModelRequestStarted) (JsonNull))
            (let [http (http-post allocator http-request)]
              (if (!= (load (field http transport-code)) 0)
                  (do
                    (deepseek-anthropic-event emitter
                                              request
                                              (ModelRequestFailed)
                                              (JsonString (load (field http error))))
                    (model-failure "deepseek-anthropic" 0 (load (field http error))))
                  (let [parsed (json-parse allocator (load (field http body)))]
                    (if (not (load (field parsed ok)))
                        (do
                          (deepseek-anthropic-event emitter
                                                    request
                                                    (ModelRequestFailed)
                                                    (JsonString "DeepSeek returned invalid JSON"))
                          (model-failure "deepseek-anthropic"
                                         (load (field http status-code))
                                         "DeepSeek returned invalid JSON"))
                        (let [root (load (field parsed value))
                              status (load (field http status-code))]
                          (if (or (< status 200) (>= status 300))
                              (let [message (json-error-message root (load (field http body)))]
                                (deepseek-anthropic-event emitter
                                                          request
                                                          (ModelRequestFailed)
                                                          (JsonString message))
                                (model-failure "deepseek-anthropic" status message))
                              (let [response (deepseek-anthropic-parse-response allocator root)]
                                (deepseek-anthropic-event emitter
                                                          request
                                                          (ModelRequestCompleted)
                                                          (JsonString (load (field response response-id))))
                                (ModelOk response)))))))))))))

(defn anthropic-auth-header [(allocator (ptr Allocator))
                             (key (slice u8))
                             (oauth bool)] (-> (slice u8))
  (concat-or-empty allocator (if oauth "Authorization: Bearer " "x-api-key: ") key))

(defn deepseek-anthropic-execute-stream [(context (ptr DeepSeekAnthropicContext))
                                         (request (ptr ModelRequest))
                                         (emitter (ptr EventEmitter))
                                         (allocator (ptr Allocator))] (-> ModelResult)
  (let [key (api-key allocator (load (field context credential)))]
    (if (= (slice-len [u8] key) 0)
        (model-failure (load (field context provider))
                       0
                       (load (field context credential-error)))
        (let [headers
                (box allocator
                     (ArrayList (slice u8))
                     (al-new [(slice u8)] allocator))
              api-header
                (anthropic-auth-header allocator
                                       key
                                       (load (field context oauth)))
              state (alloc/stack DeepSeekAnthropicStreamState)
              decoder (alloc/stack SseDecoder)
              http-request (alloc/stack HttpRequest)]
          (al-push! [(slice u8)] headers "Content-Type: application/json")
          (al-push! [(slice u8)] headers "Accept: text/event-stream")
          (al-push! [(slice u8)] headers "anthropic-version: 2023-06-01")
          (when (load (field context oauth))
            (al-push! [(slice u8)]
                      headers
                      "anthropic-beta: claude-code-20250219,oauth-2025-04-20")
            (al-push! [(slice u8)] headers "anthropic-dangerous-direct-browser-access: true")
            (al-push! [(slice u8)] headers "user-agent: claude-cli/2.1.221")
            (al-push! [(slice u8)] headers "x-app: cli")
            0)
          (al-push! [(slice u8)] headers api-header)
          (store! (field state allocator) allocator)
          (store! (field state request) request)
          (store! (field state emitter) emitter)
          (store! (field state provider) (load (field context provider)))
          (store! (field state response-id) "")
          (store! (field state model) "")
          (store! (field state blocks) (al-new [AnthropicStreamBlock] allocator))
          (store! (field state usage) (zeroed ModelUsage))
          (store! (field state completed) false)
          (store! (field state failed) false)
          (store! decoder (sse-decoder-new allocator state 1048576))
          (store! (field http-request url) (load (field context endpoint)))
          (store! (field http-request headers) headers)
          (store! (field http-request body)
                  (json-stringify allocator
                                  (anthropic-request-json allocator
                                                          request
                                                          (load (field context oauth)))))
          (store! (field http-request timeout-ms) (model-request-remaining-ms request))
          (store! (field (field http-request chunks) context) (cast (ptr i8) decoder))
          (store! (field (field http-request chunks) consume) (fnptr-of sse-http-chunk))
          (anthropic-provider-event (load (field context provider))
                                    emitter
                                    request
                                    (ModelRequestStarted)
                                    (JsonNull))
          (let [http
                  (streaming-http-send (load (field context transport))
                                       allocator
                                       http-request)
                status (load (field http status-code))]
            (sse-decoder-free! decoder)
            (if (or (!= (load (field http transport-code)) 0)
                    (< status 200)
                    (>= status 300)
                    (load (field state failed))
                    (not (load (field state completed))))
                (let [message
                        (if (load (field state failed))
                            "DeepSeek Anthropic stream failed"
                            (if (or (< status 200) (>= status 300))
                                "DeepSeek Anthropic streaming request returned an error"
                                (load (field http error))))]
                  (anthropic-provider-event (load (field context provider))
                                            emitter
                                            request
                                            (ModelRequestFailed)
                                            (JsonString message))
                  (model-failure (load (field context provider)) status message))
                (let [response (anthropic-stream-response state)]
                  (anthropic-provider-event (load (field context provider))
                                            emitter
                                            request
                                            (ModelRequestCompleted)
                                            (JsonString (load (field response response-id))))
                  (ModelOk response))))))))

(impl ModelProvider DeepSeekAnthropicContext
  (provider-name [(self (ptr DeepSeekAnthropicContext))]
                 (-> (slice u8))
                 (load (field self provider)))
  
  (execute-model [(self (ptr DeepSeekAnthropicContext))
                  (request (ptr ModelRequest))
                  (emitter (ptr EventEmitter))
                  (allocator (ptr Allocator))]
                 (-> ModelResult)
                 (deepseek-anthropic-execute-stream self request emitter allocator)))
