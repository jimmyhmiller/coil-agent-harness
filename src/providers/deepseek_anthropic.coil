(module deepseek-anthropic)

(import "coil.primitive" :as primitive)

(import "coil.alloc" :as alloc :use *)
(import "coil.arraylist" :use *)
(import "coil.match" :use *)
(import "coil.result" :use *)
(import "coil.slice" :use *)
(import "coil.str" :use *)
(import "harness-event" :use *)
(import "harness-json" :use *)
(import "harness-model" :use *)
(import "harness-tool" :use *)
(import "harness-http" :use *)
(import "harness-sse" :use *)
(import "harness-system" :use *)
(import "provider-common" :use *)

(defstruct DeepSeekAnthropicContext
  [(endpoint (slice u8))
   (credential ApiCredential)
   (credential-value (slice u8))
   (provider (slice u8))
   (credential-error (slice u8))
   (oauth bool)
   (transport (dyn StreamingHttpTransport))])

(defn deepseek-anthropic-context-default [(allocator (dyn Allocator))] (-> DeepSeekAnthropicContext)
  (let [context (primitive/alloc-stack DeepSeekAnthropicContext)]
    (set! (.endpoint context) "https://api.deepseek.com/anthropic/v1/messages")
    (set! (.primary-env (.credential context)) c"DEEPSEEK_API_KEY")
    (set! (.fallback-env (.credential context)) c"DEEPSEEK_KEY")
    (set! (.provider context) "deepseek-anthropic")
    (set! (.credential-value context) "")
    (set! (.credential-error context) "DEEPSEEK_API_KEY or DEEPSEEK_KEY is not set")
    (set! (.oauth context) false)
    (store! (field context transport)
            (box! allocator CurlStreamingHttpTransport (zeroed CurlStreamingHttpTransport)))
    (load context)))

(defn anthropic-base-messages [(allocator (dyn Allocator)) (messages (ptr (ArrayList Message)))] (-> Json)
  (let [(mut result) (json-array allocator)
        (mut i) 0
        n (al-len [Message] (load messages))]
    (loop (if (>= (load i) n)
              (break)
              (let [message (al-get [Message] (load messages) (load i))]
                (match (.role message)
                  (SystemRole [] 0)
                  (UserRole []
                            (do
                              (let [(mut wire) (json-object allocator)]
                                (json-put-string! (mut wire) "role" "user")
                                (json-put-string! (mut wire) "content" (.content message))
                                (json-array-push! (mut result) (load wire)))
                              0))
                  (AssistantRole []
                                 (do
                                   (let [(mut wire) (json-object allocator)]
                                     (json-put-string! (mut wire) "role" "assistant")
                                     (json-put-string! (mut wire) "content" (.content message))
                                     (json-array-push! (mut result) (load wire)))
                                   0)))
                (set! i (+ (load i) 1)))))
    (load result)))

(defn anthropic-tool-result-block [(allocator (dyn Allocator)) (result ToolResult)] (-> Json)
  (let [(mut block) (json-object allocator)
        output
          (match (.status result)
            (ToolSucceeded [] (json-stringify allocator (.output result)))
            (ToolErrored [] (.error result))
            (ToolDenied [] (.error result))
            (ToolUnknown [] (.error result)))]
    (json-put-string! (mut block) "type" "tool_result")
    (json-put-string! (mut block) "tool_use_id" (.call-id result))
    (json-put-string! (mut block) "content" output)
    (load block)))

;; Preserve every prior Anthropic content block array verbatim. This retains
;; thinking blocks and signatures while adding each turn's tool results together.
;;
;; The whole transcript is resent because Anthropic Messages has no server-side
;; history: a request carries the conversation or the model does not have one. A
;; continuation that replayed only the last turn made the model re-derive
;; everything before it, which is an agent that reads the same file forever and
;; never gets to the work.
(defn anthropic-turn-messages! [(allocator (dyn Allocator))
                                (messages (mut Json))
                                (output Json)
                                (results (ptr (ArrayList ToolResult)))
                                (user-text (slice u8))] (-> i64)
  (when (not (match output (JsonNull [] true) (_ false)))
    (let [(mut assistant) (json-object allocator)]
      (json-put-string! (mut assistant) "role" "assistant")
      (json-object-put! (mut assistant) "content" (json-get output "content"))
      (json-array-push! (mut messages) (load assistant)))
    0)
  (let [(mut content) (json-array allocator)
        (mut i) 0
        n (if (= (cast i64 results) 0) 0 (al-len [ToolResult] (load results)))]
    ;; What a person said rides in the same user turn as the tool results it
    ;; interrupted, and comes first in it. Anthropic pairs a tool_use turn with
    ;; exactly one user turn carrying its results, so this is where a person's
    ;; words have to go -- and last place, after a block of machine output, is
    ;; where a sentence goes to be skimmed past.
    (when (> (slice-len [u8] user-text) 0)
      (let [(mut spoken) (json-object allocator)]
        (json-put-string! (mut spoken) "type" "text")
        (json-put-string! (mut spoken) "text" user-text)
        (json-array-push! (mut content) (load spoken)))
      0)
    (loop (if (>= (load i) n)
              (break)
              (do
                (json-array-push! (mut content)
                                  (anthropic-tool-result-block allocator
                                                               (al-get [ToolResult] (load results) (load i))))
                (store! i (+ (load i) 1)))))
    (when (> (json-array-length (load content)) 0)
      (let [(mut user) (json-object allocator)]
        (json-put-string! (mut user) "role" "user")
        (json-object-put! (mut user) "content" (load content))
        (json-array-push! (mut messages) (load user)))
      0))
  0)

(defn anthropic-messages [(allocator (dyn Allocator)) (request (ptr ModelRequest))] (-> Json)
  (let [(mut messages) (anthropic-base-messages allocator (load (field request messages)))
        continuation (field request continuation)
        turns (load (field continuation turns))]
    (when (load (field continuation present))
      (if (= (cast i64 turns) 0)
          ;; No transcript recorded: one turn, the way a directly-constructed
          ;; request supplies it.
          (anthropic-turn-messages! allocator
                                    (mut messages)
                                    (load (field continuation previous-output))
                                    (load (field continuation tool-results))
                                    "")
          (let [n (al-len [ContinuationTurn] (load turns))
                (mut i) 0]
            (loop (if (>= (load i) n)
                      (break)
                      (let [turn (al-get [ContinuationTurn] (load turns) (load i))]
                        (anthropic-turn-messages! allocator
                                                  (mut messages)
                                                  (.output turn)
                                                  (.results turn)
                                                  (.user-text turn))
                        (store! i (+ (load i) 1)))))
            0))
      0)
    (load messages)))

(defn anthropic-request-json [(allocator (dyn Allocator))
                              (request (ptr ModelRequest))
                              (oauth bool)] (-> Json)
  (let [(mut body) (json-object allocator)
        (mut thinking) (json-object allocator)]
    (json-put-string! (mut body) "model" (.model request))
    (json-object-put! (mut body)
                      "max_tokens"
                      (json-integer allocator
                                    (if (> (.max-output-tokens request) 0)
                                        (.max-output-tokens request)
                                        4096)))
    (if oauth
        (let [(mut system) (json-array allocator)
              (mut identity) (json-object allocator)]
          (json-put-string! (mut identity) "type" "text")
          (json-put-string! (mut identity)
                            "text"
                            "You are Claude Code, Anthropic's official CLI for Claude.")
          (json-array-push! (mut system) (load identity))
          (when (> (slice-len [u8] (load (field request instructions))) 0)
            (let [(mut instructions) (json-object allocator)]
              (json-put-string! (mut instructions) "type" "text")
              (json-put-string! (mut instructions)
                                "text"
                                (load (field request instructions)))
              (json-array-push! (mut system) (load instructions)))
            0)
          (json-object-put! (mut body) "system" (load system))
          0)
        (when (> (slice-len [u8] (load (field request instructions))) 0)
          (json-put-string! (mut body) "system" (load (field request instructions)))
          0))
    (json-object-put! (mut body)
                      "messages"
                      (anthropic-messages allocator request))
    (json-put-string! (mut thinking)
                      "type"
                      (if (= (.reasoning request) "none")
                          "disabled"
                          (if oauth "adaptive" "enabled")))
    (when (not (= (load (field request reasoning)) "none"))
      (when (not oauth)
        (json-object-put! (mut thinking) "budget_tokens" (json-integer allocator 1024))
        0)
      (let [(mut output-config) (json-object allocator)]
        (json-put-string! (mut output-config)
                          "effort"
                          (load (field request reasoning)))
        (json-object-put! (mut body) "output_config" (load output-config)))
      0)
    (json-object-put! (mut body) "thinking" (load thinking))
    (when (> (al-len [ToolDefinition]
                     (load (field (load (field request tools)) definitions)))
             0)
      (json-object-put! (mut body)
                        "tools"
                        (tool-registry-wire allocator
                                            (load (field request tools))
                                            TOOL_LAYOUT_ANTHROPIC))
      (json-object-put! (mut body)
                        "tool_choice"
                        (tool-choice-anthropic allocator
                                               (load (field request tool-choice))))
      0)
    (json-put-bool! (mut body) "stream" true)
    (load body)))

(defn deepseek-anthropic-request-json [(allocator (dyn Allocator))
                                       (request (ptr ModelRequest))] (-> Json)
  (anthropic-request-json allocator request false))

(defn deepseek-anthropic-usage [(root Json)] (-> ModelUsage)
  (let [usage (primitive/alloc-stack ModelUsage)
        wire (json-get root "usage")]
    (set! (.input-tokens usage) (json-number-i64 (json-get wire "input_tokens")))
    (set! (.output-tokens usage) (json-number-i64 (json-get wire "output_tokens")))
    (set! (.reasoning-tokens usage) 0)
    (set! (.cached-input-tokens usage) (json-number-i64 (json-get wire "cache_read_input_tokens")))
    (set! (.cache-write-tokens usage) 0)
    (load usage)))

(defn anthropic-parse-response [(allocator (dyn Allocator))
                                (root Json)
                                (provider (slice u8))] (-> ModelResponse)
  (let [(mut response) (response-empty allocator)
        (mut text) (sb-new allocator)
        content (json-get root "content")
        (mut i) 0
        count (json-array-length content)]
    (set! (.provider response) provider)
    (set! (.response-id response) (match (json-string-at root "id") (Some [value] value) (None [] "")))
    (set! (.model response) (match (json-string-at root "model") (Some [value] value) (None [] "")))
    (loop (if (>= (load i) count)
              (break)
              (let [block (json-array-get content (load i))
                    kind
                      (match (json-string-at block "type")
                        (Some [value] value)
                        (None [] ""))]
                (cond (= kind "text")
                        (match (json-string-at block "text")
                          (Some [value] (sb-push-str! (mut text) value))
                          (None [] 0))
                      (= kind "tool_use")
                        (let [id
                                (match (json-string-at block "id")
                                  (Some [value] value)
                                  (None [] ""))
                              name
                                (match (json-string-at block "name")
                                  (Some [value] value)
                                  (None [] ""))
                              input (json-get block "input")
                              arguments (json-stringify allocator input)
                              call (primitive/alloc-stack ToolCall)]
                          (store! (field call id) id)
                          (store! (field call name) name)
                          (store! (field call arguments) input)
                          (store! (field call raw-arguments) arguments)
                          (al-push! [ToolCall] (mut (field response tool-calls)) (load call)))
                      :else 0)
                (set! i (+ (load i) 1)))))
    (set! (.output-text response) (sb-finish! (mut text)))
    (set! (.usage response) (deepseek-anthropic-usage root))
    (set! (.raw-output response) root)
    (load response)))

(defn deepseek-anthropic-parse-response [(allocator (dyn Allocator))
                                         (root Json)] (-> ModelResponse)
  (anthropic-parse-response allocator root "deepseek-anthropic"))

(defn anthropic-provider-event [(provider (slice u8))
                                (emitter (ptr EventEmitter))
                                (request (ptr ModelRequest))
                                (kind EventKind)
                                (payload Json)] (-> i64)
  (emit-event emitter
              (now-ms)
              kind
              (.run-id request)
              (.operation-id request)
              ""
              provider
              (.model request)
              payload))

(defn deepseek-anthropic-event [(emitter (ptr EventEmitter))
                                (request (ptr ModelRequest))
                                (kind EventKind)
                                (payload Json)] (-> i64)
  (anthropic-provider-event "deepseek-anthropic" emitter request kind payload))

(defstruct AnthropicStreamBlock
  [(kind (slice u8))
   (id (slice u8))
   (name (slice u8))
   (data StrBuf)
   (signature StrBuf)])

(defstruct DeepSeekAnthropicStreamState
  [(allocator (dyn Allocator))
   (request (ptr ModelRequest))
   (emitter (ptr EventEmitter))
   (provider (slice u8))
   (response-id (slice u8))
   (model (slice u8))
   (blocks (ArrayList AnthropicStreamBlock))
   (usage ModelUsage)
   (completed bool)
   (failed bool)])

(defn anthropic-stream-block! [(state (ptr DeepSeekAnthropicStreamState))
                               (index-value i64)] (-> (ptr AnthropicStreamBlock))
  (loop (if (> (al-len [AnthropicStreamBlock] (.blocks state))
               index-value)
            (break)
            (let [block-slot (primitive/alloc-stack AnthropicStreamBlock)]
              (set! (.kind block-slot) "")
              (set! (.id block-slot) "")
              (set! (.name block-slot) "")
              (set! (.data block-slot) (sb-new (load (field state allocator))))
              (set! (.signature block-slot) (sb-new (load (field state allocator))))
              (al-push! [AnthropicStreamBlock]
                        (mut (.blocks state))
                        (load block-slot)))))
  (al-elem [AnthropicStreamBlock] (field state blocks) index-value))

(defn anthropic-stream-start! [(state (ptr DeepSeekAnthropicStreamState))
                               (wire Json)] (-> i64)
  (let [block (json-get wire "content_block")
        slot
          (anthropic-stream-block! state
                                   (json-number-i64 (json-get wire "index")))]
    (match (json-string-at block "type")
      (Some [value]
            (set! (.kind slot) (concat-or-empty (load (field state allocator)) "" value)))
      (None [] 0))
    (match (json-string-at block "id")
      (Some [value]
            (set! (.id slot) (concat-or-empty (load (field state allocator)) "" value)))
      (None [] 0))
    (match (json-string-at block "name")
      (Some [value]
            (set! (.name slot) (concat-or-empty (load (field state allocator)) "" value)))
      (None [] 0))
    0))

(defn anthropic-stream-delta! [(state (ptr DeepSeekAnthropicStreamState))
                               (wire Json)] (-> i64)
  (let [delta (json-get wire "delta")
        slot
          (anthropic-stream-block! state
                                   (json-number-i64 (json-get wire "index")))
        kind
          (match (json-string-at delta "type")
            (Some [value] value)
            (None [] ""))]
    (cond (= kind "text_delta")
            (match (json-string-at delta "text")
              (Some [value]
                    (do
                      (sb-push-str! (mut (field slot data)) value)
                      (anthropic-provider-event (load (field state provider))
                                                (load (field state emitter))
                                                (load (field state request))
                                                (ModelResponseDelta)
                                                (JsonString value))))
              (None [] 0))
          (= kind "thinking_delta")
            (match (json-string-at delta "thinking")
              (Some [value] (sb-push-str! (mut (field slot data)) value))
              (None [] 0))
          (= kind "signature_delta")
            (match (json-string-at delta "signature")
              (Some [value]
                    (sb-push-str! (mut (field slot signature)) value))
              (None [] 0))
          (= kind "input_json_delta")
            (match (json-string-at delta "partial_json")
              (Some [value] (sb-push-str! (mut (field slot data)) value))
              (None [] 0))
          :else 0)))

(defn anthropic-stream-usage! [(state (ptr DeepSeekAnthropicStreamState))
                               (usage Json)] (-> i64)
  (let [input (json-number-i64 (json-get usage "input_tokens"))
        output (json-number-i64 (json-get usage "output_tokens"))
        cached (json-number-i64 (json-get usage "cache_read_input_tokens"))]
    (when (> input 0) (store! (field (field state usage) input-tokens) input) 0)
    (when (> output 0) (store! (field (field state usage) output-tokens) output) 0)
    (when (> cached 0)
      (store! (field (field state usage) cached-input-tokens) cached)
      0)
    0))

(defn anthropic-stream-event! [(state (ptr DeepSeekAnthropicStreamState))
                               (wire Json)] (-> bool)
  (let [kind
          (match (json-string-at wire "type")
            (Some [value] value)
            (None [] ""))]
    (cond (= kind "message_start")
            (let [message (json-get wire "message")]
              (match (json-string-at message "id")
                (Some [value]
                      (store! (field state response-id)
                              (concat-or-empty (load (field state allocator))
                                               ""
                                               value)))
                (None [] 0))
              (match (json-string-at message "model")
                (Some [value]
                      (store! (field state model)
                              (concat-or-empty (load (field state allocator))
                                               ""
                                               value)))
                (None [] 0))
              (anthropic-stream-usage! state (json-get message "usage")))
          (= kind "content_block_start") (anthropic-stream-start! state wire)
          (= kind "content_block_delta") (anthropic-stream-delta! state wire)
          (= kind "message_delta") (anthropic-stream-usage! state (json-get wire "usage"))
          (= kind "message_stop") (do (store! (field state completed) true) 0)
          (= kind "error") (do (store! (field state failed) true) 0)
          :else 0)
    (not (.failed state))))

(impl SseEventSink DeepSeekAnthropicStreamState
  (consume-sse-event [(self (ptr DeepSeekAnthropicStreamState))
                      (event-name (slice u8))
                      (data (slice u8))]
                     (-> bool)
                     (if (model-request-cancelled? (load (field self request)))
                         false
                         (let [parsed (json-parse (load (field self allocator)) data)]
                           (if (.ok parsed)
                               (anthropic-stream-event! self
                                                        (.value parsed))
                               (do (set! (.failed self) true) false))))))

(defn anthropic-stream-response [(state (ptr DeepSeekAnthropicStreamState))] (-> ModelResponse)
  (let [allocator (load (field state allocator))
        (mut root) (json-object allocator)
        (mut content) (json-array allocator)
        (mut usage) (json-object allocator)
        (mut i) 0
        count (al-len [AnthropicStreamBlock] (.blocks state))]
    (loop (if (>= (load i) count)
              (break)
              (let [source
                      (al-get [AnthropicStreamBlock]
                              (.blocks state)
                              (load i))
                    kind (.kind source)
                    (mut block) (json-object allocator)]
                (json-put-string! (mut block) "type" kind)
                (cond (= kind "text")
                        (do
                          (json-put-string! (mut block)
                                            "text"
                                            (sb-str (load (field source data))))
                          0)
                      (= kind "thinking")
                        (do
                          (json-put-string! (mut block)
                                            "thinking"
                                            (sb-str (load (field source data))))
                          (json-put-string! (mut block)
                                            "signature"
                                            (sb-str (load (field source signature))))
                          0)
                      (= kind "tool_use")
                        (let [parsed
                                (json-parse allocator
                                            (sb-str (load (field source data))))]
                          (json-put-string! (mut block) "id" (load (field source id)))
                          (json-put-string! (mut block)
                                            "name"
                                            (load (field source name)))
                          (json-object-put! (mut block)
                                            "input"
                                            (if (load (field parsed ok))
                                                (load (field parsed value))
                                                (JsonNull)))
                          0)
                      :else 0)
                (json-array-push! (mut content) (load block))
                (set! i (+ (load i) 1)))))
    (json-put-string! (mut root) "id" (.response-id state))
    (json-put-string! (mut root) "model" (.model state))
    (json-object-put! (mut root) "content" (load content))
    (json-object-put! (mut usage)
                      "input_tokens"
                      (json-integer allocator
                                    (.input-tokens (.usage state))))
    (json-object-put! (mut usage)
                      "output_tokens"
                      (json-integer allocator
                                    (.output-tokens (.usage state))))
    (json-object-put! (mut usage)
                      "cache_read_input_tokens"
                      (json-integer allocator
                                    (.cached-input-tokens (.usage state))))
    (json-object-put! (mut root) "usage" (load usage))
    (anthropic-parse-response allocator
                              (load root)
                              (.provider state))))

(defn deepseek-anthropic-execute [(context (ptr DeepSeekAnthropicContext))
                                  (request (ptr ModelRequest))
                                  (emitter (ptr EventEmitter))
                                  (allocator (dyn Allocator))] (-> ModelResult)
  (let [configured (.credential-value context)
        key
          (if (> (slice-len [u8] configured) 0)
              configured
              (api-key allocator (.credential context)))]
    (if (= (slice-len [u8] key) 0)
        (model-failure "deepseek-anthropic" 0 "DEEPSEEK_API_KEY or DEEPSEEK_KEY is not set")
        (let [headers
                (box! allocator
                     (ArrayList (slice u8))
                     (al-new [(slice u8)] allocator))
              api-header (concat-or-empty allocator "x-api-key: " key)]
          (al-push! [(slice u8)] headers "Content-Type: application/json")
          (al-push! [(slice u8)] headers "anthropic-version: 2023-06-01")
          (al-push! [(slice u8)] headers api-header)
          (let [wire (deepseek-anthropic-request-json allocator request)
                body (json-stringify allocator wire)
                http-request (primitive/alloc-stack HttpRequest)]
            (set! (.url http-request) (.endpoint context))
            (set! (.headers http-request) headers)
            (set! (.body http-request) body)
            (set! (.timeout-ms http-request) (model-request-remaining-ms request))
            (set! (.cancellation http-request) (load (field request cancellation)))
            (set! (.context (.chunks http-request)) (cast (ptr i8) 0))
            (set! (.consume (.chunks http-request)) (fnptr-of discard-http-chunk))
            (deepseek-anthropic-event emitter request (ModelRequestStarted) (JsonNull))
            (let [http (http-post allocator http-request)]
              (if (!= (.transport-code http) 0)
                  (do
                    (deepseek-anthropic-event emitter
                                              request
                                              (ModelRequestFailed)
                                              (JsonString (.error http)))
                    (model-failure "deepseek-anthropic" 0 (.error http)))
                  (let [parsed (json-parse allocator (.body http))]
                    (if (not (.ok parsed))
                        (do
                          (deepseek-anthropic-event emitter
                                                    request
                                                    (ModelRequestFailed)
                                                    (JsonString "DeepSeek returned invalid JSON"))
                          (model-failure "deepseek-anthropic"
                                         (.status-code http)
                                         "DeepSeek returned invalid JSON"))
                        (let [root (.value parsed)
                              status (.status-code http)]
                          (if (or (< status 200) (>= status 300))
                              (let [message (json-error-message root (.body http))]
                                (deepseek-anthropic-event emitter
                                                          request
                                                          (ModelRequestFailed)
                                                          (JsonString message))
                                (model-failure "deepseek-anthropic" status message))
                              (let [(mut response) (deepseek-anthropic-parse-response allocator root)]
                                (deepseek-anthropic-event emitter
                                                          request
                                                          (ModelRequestCompleted)
                                                          (model-completion-payload allocator request (mut response)))
                                (ModelOk (load response))))))))))))))

(defn anthropic-auth-header [(allocator (dyn Allocator))
                             (key (slice u8))
                             (oauth bool)] (-> (slice u8))
  (concat-or-empty allocator (if oauth "Authorization: Bearer " "x-api-key: ") key))

(defn deepseek-anthropic-execute-stream [(context (ptr DeepSeekAnthropicContext))
                                         (request (ptr ModelRequest))
                                         (emitter (ptr EventEmitter))
                                         (allocator (dyn Allocator))] (-> ModelResult)
  (let [configured (.credential-value context)
        key
          (if (> (slice-len [u8] configured) 0)
              configured
              (api-key allocator (.credential context)))]
    (if (= (slice-len [u8] key) 0)
        (model-failure (.provider context)
                       0
                       (.credential-error context))
        (let [headers
                (box! allocator
                     (ArrayList (slice u8))
                     (al-new [(slice u8)] allocator))
              api-header
                (anthropic-auth-header allocator
                                       key
                                       (.oauth context))
              state (primitive/alloc-stack DeepSeekAnthropicStreamState)
              decoder (primitive/alloc-stack SseDecoder)
              http-request (primitive/alloc-stack HttpRequest)]
          (al-push! [(slice u8)] headers "Content-Type: application/json")
          (al-push! [(slice u8)] headers "Accept: text/event-stream")
          (al-push! [(slice u8)] headers "anthropic-version: 2023-06-01")
          (when (load (field context oauth))
            (al-push! [(slice u8)]
                      headers
                      "anthropic-beta: claude-code-20250219,oauth-2025-04-20")
            (al-push! [(slice u8)] headers "anthropic-dangerous-direct-browser-access: true")
            (al-push! [(slice u8)] headers "user-agent: claude-cli/2.1.221")
            (al-push! [(slice u8)] headers "x-app: cli")
            0)
          (al-push! [(slice u8)] headers api-header)
          (set! (.allocator state) allocator)
          (set! (.request state) request)
          (set! (.emitter state) emitter)
          (set! (.provider state) (.provider context))
          (set! (.response-id state) "")
          (set! (.model state) "")
          (set! (.blocks state) (al-new [AnthropicStreamBlock] allocator))
          (set! (.usage state) (zeroed ModelUsage))
          (set! (.completed state) false)
          (set! (.failed state) false)
          (set! decoder (sse-decoder-new allocator state 1048576))
          (set! (.url http-request) (.endpoint context))
          (set! (.headers http-request) headers)
          ;; Name the request tree so debugger frames and crash diagnostics retain
          ;; a distinct value at the serialization boundary. Its nested storage is
          ;; allocator-owned; naming this local is diagnostic, not an ownership fix.
          (let [wire
                  (anthropic-request-json allocator
                                          request
                                          (.oauth context))]
            (set! (.body http-request) (json-stringify allocator wire)))
          (set! (.timeout-ms http-request) (model-request-remaining-ms request))
          (set! (.cancellation http-request) (load (field request cancellation)))
          (set! (.context (.chunks http-request)) (cast (ptr i8) decoder))
          (set! (.consume (.chunks http-request)) (fnptr-of sse-http-chunk))
          (anthropic-provider-event (.provider context)
                                    emitter
                                    request
                                    (ModelRequestStarted)
                                    (JsonNull))
          (let [http
                  (streaming-http-send (.transport context)
                                       allocator
                                       http-request)
                status (.status-code http)]
            (sse-decoder-free! decoder)
            (if (or (!= (.transport-code http) 0)
                    (< status 200)
                    (>= status 300)
                    (.failed state)
                    (not (.completed state)))
                (let [message
                        (if (.failed state)
                            (concat-or-empty allocator
                                             (.provider context)
                                             " stream returned invalid SSE")
                            (if (!= (.transport-code http) 0)
                                (.error http)
                                (if (or (< status 200) (>= status 300))
                                    (let [parsed
                                            (json-parse allocator
                                                        (.body http))]
                                      (if (.ok parsed)
                                          (json-error-message (.value parsed)
                                                              (.body http))
                                          (if (> (slice-len [u8]
                                                            (.body http))
                                                 0)
                                              (.body http)
                                              "HTTP request returned no status or body")))
                                    "stream ended before completion")))]
                  (anthropic-provider-event (.provider context)
                                            emitter
                                            request
                                            (ModelRequestFailed)
                                            (JsonString message))
                  (model-failure (.provider context) status message))
                (let [(mut response) (anthropic-stream-response state)]
                  (anthropic-provider-event (.provider context)
                                            emitter
                                            request
                                            (ModelRequestCompleted)
                                            (model-completion-payload allocator request (mut response)))
                  (ModelOk (load response)))))))))

(impl ModelProvider DeepSeekAnthropicContext
  (provider-name [(self (ptr DeepSeekAnthropicContext))]
                 (-> (slice u8))
                 (.provider self))
  (provider-capabilities [(self (ptr DeepSeekAnthropicContext))]
                         (-> ProviderCapabilities)
                         (provider-capabilities-for (.provider self)))

  (execute-model [(self (ptr DeepSeekAnthropicContext))
                  (request (ptr ModelRequest))
                  (emitter (ptr EventEmitter))
                  (allocator (dyn Allocator))]
                 (-> ModelResult)
                 (deepseek-anthropic-execute-stream self request emitter allocator)))
