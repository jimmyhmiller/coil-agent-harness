(module provider-common)

(import "coil.alloc" :as alloc :use *)
(import "coil.arraylist" :use *)
(import "coil.match" :use *)
(import "coil.os" :as os)
(import "coil.result" :use *)
(import "coil.slice" :use *)
(import "coil.str" :use *)
(import "harness-json" :use *)
(import "harness-model" :use *)
(import "harness-system" :use *)
(import "harness-tool" :use *)

(const TOOL_LAYOUT_RESPONSES 0)
(const TOOL_LAYOUT_CHAT 1)
(const TOOL_LAYOUT_ANTHROPIC 2)

(defn model-request-remaining-ms [(request (ptr ModelRequest))] (-> i64)
  (deadline-remaining-ms (load (field request deadline-monotonic-ms))
                         (load (field request timeout-ms))))

(defstruct ApiCredential
  [(primary-env (ptr i8))
   (fallback-env (ptr i8))])

;; Return an allocator-owned credential value, trying the primary name first.
(defn api-key [(allocator (ptr Allocator)) (credential ApiCredential)] (-> (slice u8))
  (match (os/env-get allocator (cstr->str (load (field credential primary-env))))
    (Ok [primary]
        (match primary
          (Some [value] (os/owned-string-slice value))
          (None []
                (match (os/env-get allocator (cstr->str (load (field credential fallback-env))))
                  (Ok [fallback]
                      (match fallback
                        (Some [value] (os/owned-string-slice value))
                        (None [] "")))
                  (Err [failure] "")))))
    (Err [failure] "")))

(defn json-put-string! [(object (mut Json)) (key (slice u8)) (value (slice u8))] (-> bool)
  (json-object-put! (mut object) key (JsonString value)))

(defn json-put-bool! [(object (mut Json)) (key (slice u8)) (value bool)] (-> bool)
  (json-object-put! (mut object) key (JsonBool value)))

(defn concat-or-empty [(allocator (ptr Allocator)) (left (slice u8)) (right (slice u8))] (-> (slice u8))
  (match (str-concat allocator left right)
    (Some [value] value)
    (None [] "")))

(defn tool-spec-wire [(allocator (ptr Allocator)) (spec ToolSpec) (layout i64)] (-> Json)
  (let [(mut function) (json-object allocator)]
    (json-put-string! (mut function) "name" (load (field spec name)))
    (json-put-string! (mut function) "description" (load (field spec description)))
    (json-object-put! (mut function)
                      (if (= layout TOOL_LAYOUT_ANTHROPIC)
                          "input_schema"
                          "parameters")
                      (load (field spec input-schema)))
    (when (!= layout TOOL_LAYOUT_ANTHROPIC)
      (json-put-bool! (mut function) "strict" (load (field spec strict)))
      0)
    (if (= layout TOOL_LAYOUT_CHAT)
        (let [(mut wrapper) (json-object allocator)]
          (json-put-string! (mut wrapper) "type" "function")
          (json-object-put! (mut wrapper) "function" (load function))
          (load wrapper))
        (do
          (when (= layout TOOL_LAYOUT_RESPONSES)
            (json-put-string! (mut function) "type" "function")
            0)
          (load function)))))

(defn tool-registry-wire [(allocator (ptr Allocator)) (registry (ptr ToolRegistry)) (layout i64)] (-> Json)
  (let [(mut tools) (json-array allocator)
        definitions (field registry definitions)
        (mut i) 0
        n (al-len [ToolDefinition] (load definitions))]
    (loop (if (>= (load i) n)
              (break)
              (let [definition (al-get [ToolDefinition] (load definitions) (load i))]
                (json-array-push! (mut tools)
                                  (tool-spec-wire allocator
                                                  (load (field definition spec))
                                                  layout))
                (store! i (+ (load i) 1)))))
    (load tools)))

(defn messages-wire [(allocator (ptr Allocator)) (messages (ptr (ArrayList Message)))] (-> Json)
  (let [(mut result) (json-array allocator)
        (mut i) 0
        n (al-len [Message] (load messages))]
    (loop (if (>= (load i) n)
              (break)
              (let [message (al-get [Message] (load messages) (load i))
                    (mut object) (json-object allocator)]
                (json-put-string! (mut object)
                                  "role"
                                  (message-role-name (load (field message role))))
                (json-put-string! (mut object)
                                  "content"
                                  (load (field message content)))
                (json-array-push! (mut result) (load object))
                (store! i (+ (load i) 1)))))
    (load result)))

(defn tool-choice-responses [(allocator (ptr Allocator)) (choice ModelToolChoice)] (-> Json)
  (match choice
    (ToolsAuto [] (JsonString "auto"))
    (ToolsNone [] (JsonString "none"))
    (ToolsRequired [] (JsonString "required"))
    (ToolForced [name]
                (let [(mut value) (json-object allocator)]
                  (json-put-string! (mut value) "type" "function")
                  (json-put-string! (mut value) "name" name)
                  (load value)))))

(defn tool-choice-chat [(allocator (ptr Allocator)) (choice ModelToolChoice)] (-> Json)
  (match choice
    (ToolsAuto [] (JsonString "auto"))
    (ToolsNone [] (JsonString "none"))
    (ToolsRequired [] (JsonString "required"))
    (ToolForced [name]
                (let [(mut function) (json-object allocator)
                      (mut value) (json-object allocator)]
                  (json-put-string! (mut function) "name" name)
                  (json-put-string! (mut value) "type" "function")
                  (json-object-put! (mut value) "function" (load function))
                  (load value)))))

(defn tool-choice-anthropic [(allocator (ptr Allocator)) (choice ModelToolChoice)] (-> Json)
  (let [(mut value) (json-object allocator)]
    (match choice
      (ToolsAuto [] (json-put-string! (mut value) "type" "auto"))
      (ToolsNone [] (json-put-string! (mut value) "type" "none"))
      (ToolsRequired [] (json-put-string! (mut value) "type" "any"))
      (ToolForced [name]
                  (do
                    (json-put-string! (mut value) "type" "tool")
                    (json-put-string! (mut value) "name" name))))
    (load value)))

(defn json-number-i64 [(value Json)] (-> i64)
  (match-else value
              (JsonNumber [raw]
                          (match (str-parse-int raw)
                            (Some [number] number)
                            (None [] 0)))
              (_ 0)))

(defn usage-empty [] (-> ModelUsage)
  (zeroed ModelUsage))

(defn response-empty [(allocator (ptr Allocator))] (-> ModelResponse)
  (let [response (alloc/stack ModelResponse)]
    (store! (field response provider) "")
    (store! (field response model) "")
    (store! (field response response-id) "")
    (store! (field response provider-session-id) "")
    (store! (field response output-text) "")
    (store! (field response tool-calls) (al-new [ToolCall] allocator))
    (store! (field response usage) (usage-empty))
    (store! (field response raw-output) (JsonNull))
    (load response)))

(defn model-completion-payload [(allocator (ptr Allocator))
                                (request (ptr ModelRequest))
                                (response (ptr ModelResponse))] (-> Json)
  (let [(mut usage) (json-object allocator)
        (mut payload) (json-object allocator)]
    (json-put-string! (mut payload) "response_id" (load (field response response-id)))
    (json-put-string! (mut payload)
                      "provider_session_id"
                      (load (field response provider-session-id)))
    (json-put-string! (mut payload) "cache_key" (load (field request cache-key)))
    (json-object-put! (mut usage)
                      "input_tokens"
                      (json-integer allocator (load (field (field response usage) input-tokens))))
    (json-object-put! (mut usage)
                      "output_tokens"
                      (json-integer allocator (load (field (field response usage) output-tokens))))
    (json-object-put! (mut usage)
                      "reasoning_tokens"
                      (json-integer allocator (load (field (field response usage) reasoning-tokens))))
    (json-object-put! (mut usage)
                      "cached_input_tokens"
                      (json-integer allocator
                                    (load (field (field response usage) cached-input-tokens))))
    (json-object-put! (mut usage)
                      "cache_write_tokens"
                      (json-integer allocator
                                    (load (field (field response usage) cache-write-tokens))))
    (json-object-put! (mut payload) "usage" (load usage))
    (load payload)))

(defn model-failure [(provider (slice u8))
                     (status i64)
                     (message (slice u8))] (-> ModelResult)
  (let [failure (alloc/stack ModelFailure)]
    (store! (field failure kind)
            (cond (= status 0) (TransportFailure)
                  (or (= status 401) (= status 403)) (AuthenticationFailure)
                  (= status 429) (RateLimitFailure)
                  :else (ProviderFailure)))
    (store! (field failure provider) provider)
    (store! (field failure status-code) status)
    (store! (field failure message) message)
    (store! (field failure retryable)
            (or (= status 0)
                (or (= status 408)
                    (or (= status 429) (>= status 500)))))
    (ModelErr (load failure))))

(defn json-error-message [(root Json) (fallback (slice u8))] (-> (slice u8))
  (match (json-string-at (json-get root "error") "message")
    (Some [message] message)
    (None [] fallback)))

(defn parsed-tool-call [(allocator (ptr Allocator))
                        (id (slice u8))
                        (name (slice u8))
                        (raw-arguments (slice u8))] (-> ToolCall)
  (let [call (alloc/stack ToolCall)
        parsed (json-parse allocator raw-arguments)]
    (store! (field call id) id)
    (store! (field call name) name)
    (store! (field call raw-arguments) raw-arguments)
    (store! (field call arguments)
            (if (load (field parsed ok))
                (load (field parsed value))
                (JsonNull)))
    (load call)))

;; `int->str` is a comptime primitive, so a runtime status code is formatted by
;; hand. Lives here because every provider needs it to describe a failure.
(defn model-decimal [(allocator (ptr Allocator)) (value i64)] (-> (slice u8))
  (if (<= value 0)
      "0"
      (let [(mut buffer) (sb-new allocator)
            (mut digits) (al-new [i64] allocator)
            (mut remaining) value]
        (loop (if (<= (load remaining) 0)
                  (break)
                  (do
                    (al-push! [i64] (mut digits) (% (load remaining) 10))
                    (store! remaining (/ (load remaining) 10)))))
        (let [n (al-len [i64] (load digits))
              (mut i) 0]
          (loop (if (>= (load i) n)
                    (break)
                    (do
                      (sb-push-byte! (mut buffer)
                                     (cast u8 (+ 48 (al-get [i64] (load digits) (- (- n 1) (load i))))))
                      (store! i (+ (load i) 1))))))
        (sb-finish! (mut buffer)))))
