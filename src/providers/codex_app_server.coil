(module codex-app-server)

(import "coil.alloc" :as alloc :use *)
(import "coil.arraylist" :use *)
(import "coil.io" :as io)
(import "coil.match" :use *)
(import "coil.result" :use *)
(import "coil.selectors" :as selectors)
(import "coil.slice" :use *)
(import "coil.str" :use *)
(import "coil.subprocess" :as subprocess)
(import "coil.time" :as time)
(import "coil.try" :use *)
(import "harness-event" :use *)
(import "harness-json" :use *)
(import "harness-model" :use *)
(import "harness-http" :use *)
(import "harness-system" :use *)
(import "provider-common" :use *)

(defstruct CodexAppServerContext
  [(cwd (slice u8))
   (sandbox (slice u8))
   (approval-policy (slice u8))])

(defn codex-context [(cwd (slice u8))] (-> CodexAppServerContext)
  (let [context (alloc/stack CodexAppServerContext)]
    (store! (field context cwd) cwd)
    (store! (field context sandbox) "workspace-write")
    (store! (field context approval-policy) "never")
    (load context)))

(defstruct CodexRead
  [(ok bool)
   (eof bool)
   (message Json)
   (error (slice u8))])

(defstruct CodexWait
  [(ok bool)
   (message Json)
   (error (slice u8))])

(defstruct CodexSpawnResult
  [(code i64)
   (process subprocess/Child)
   (error (slice u8))])

;; The protocol depends on newline-delimited JSON, not on subprocess mechanics.
;; Tests can supply an in-memory transport while the production implementation
;; delegates to Coil's hosted child-process and I/O libraries.
(deftrait CodexTransport [Self]
  (codex-transport-send [(self (ptr Self))
                         (allocator (ptr Allocator))
                         (message (ptr Json))]
                        (-> i64))
  (codex-transport-read [(self (ptr Self))
                         (allocator (ptr Allocator))
                         (timeout-ms i64)
                         (result (mut CodexRead))]
                        (-> i64))
  (codex-transport-close [(self (ptr Self))] (-> i64)))

(defstruct CodexConnection [(transport (dyn CodexTransport))])

(defn codex-spawn [(allocator (ptr Allocator))] (-> CodexSpawnResult)
  (let [result (alloc/stack CodexSpawnResult)
        child (alloc/stack subprocess/Child)
        args (alloc/stack (array (slice u8) 3))]
    (store! (field result code) 0)
    (store! (field result error) "")
    (store! (index args 0) "app-server")
    (store! (index args 1) "--listen")
    (store! (index args 2) "stdio://")
    (match (subprocess/spawn allocator
                             child
                             "codex"
                             (slice-new [(slice u8)] (index args 0) 3)
                             (subprocess/pipe-stdio)
                             (subprocess/pipe-stdio)
                             (subprocess/inherit-stdio))
      (Ok [spawned] (store! (field result process) (load child)))
      (Err [failure]
           (do
             (store! (field result code) -1)
             (store! (field result error) "could not spawn Codex app-server"))))
    (load result)))

(defn codex-child-close [(process (ptr subprocess/Child))] (-> i64)
  (subprocess/child-close-stdin process)
  (match (subprocess/child-try-wait process)
    (Ok [status]
        (match status
          (Some [finished] 0)
          (None []
                (do
                  (subprocess/child-terminate process)
                  (subprocess/child-wait process)
                  0))))
    (Err [failure]
         (do
           (subprocess/child-kill-and-wait process)
           0)))
  (match (subprocess/child-close process)
    (Ok [value] value)
    (Err [failure] -1)))

(defn codex-rpc-request [(allocator (ptr Allocator)) (id i64) (method (slice u8)) (params Json)] (-> Json)
  (let [(mut request) (json-object allocator)]
    (json-object-put! (mut request) "id" (json-integer allocator id))
    (json-put-string! (mut request) "method" method)
    (json-object-put! (mut request) "params" params)
    (load request)))

(defn codex-initialize-request [(allocator (ptr Allocator))] (-> Json)
  (let [(mut client) (json-object allocator)
        (mut capabilities) (json-object allocator)
        (mut params) (json-object allocator)]
    (json-put-string! (mut client) "name" "coil-agent-harness")
    (json-put-string! (mut client) "title" "COIL Agent Harness")
    (json-put-string! (mut client) "version" "0.1.0")
    (json-put-bool! (mut capabilities) "experimentalApi" false)
    (json-object-put! (mut params) "clientInfo" (load client))
    (json-object-put! (mut params) "capabilities" (load capabilities))
    (codex-rpc-request allocator 1 "initialize" (load params))))

(defn codex-initialized-notification [(allocator (ptr Allocator))] (-> Json)
  (let [(mut notification) (json-object allocator)]
    (json-put-string! (mut notification) "method" "initialized")
    (json-object-put! (mut notification) "params" (json-object allocator))
    (load notification)))

(defn codex-thread-start-request [(allocator (ptr Allocator))
                                  (context (ptr CodexAppServerContext))
                                  (request (ptr ModelRequest))] (-> Json)
  (let [(mut params) (json-object allocator)]
    (json-put-string! (mut params) "model" (load (field request model)))
    (json-put-string! (mut params) "cwd" (load (field context cwd)))
    (json-put-string! (mut params) "sandbox" (load (field context sandbox)))
    (json-put-string! (mut params)
                      "approvalPolicy"
                      (load (field context approval-policy)))
    (when (> (slice-len [u8] (load (field request instructions))) 0)
      (json-put-string! (mut params)
                        "developerInstructions"
                        (load (field request instructions)))
      0)
    (codex-rpc-request allocator 2 "thread/start" (load params))))

(defn codex-last-user-message [(request (ptr ModelRequest))] (-> (slice u8))
  (let [messages (load (field request messages))
        (mut i) (al-len [Message] (load messages))
        (mut result) ""]
    (loop (if (<= (load i) 0)
              (break)
              (do
                (store! i (- (load i) 1))
                (let [message (al-get [Message] (load messages) (load i))]
                  (match (load (field message role))
                    (UserRole []
                              (do (store! result (load (field message content))) (break)))
                    (SystemRole [] 0)
                    (AssistantRole [] 0))))))
    (load result)))

(defn codex-turn-start-request [(allocator (ptr Allocator))
                                (thread-id (slice u8))
                                (request (ptr ModelRequest))] (-> Json)
  (let [(mut input-item) (json-object allocator)
        (mut input) (json-array allocator)
        (mut params) (json-object allocator)]
    (json-put-string! (mut input-item) "type" "text")
    (json-put-string! (mut input-item) "text" (codex-last-user-message request))
    (json-array-push! (mut input) (load input-item))
    (json-put-string! (mut params) "threadId" thread-id)
    (json-object-put! (mut params) "input" (load input))
    (json-put-string! (mut params)
                      "effort"
                      (reasoning-effort-name (load (field request reasoning))))
    (codex-rpc-request allocator 3 "turn/start" (load params))))

(defn codex-child-send [(allocator (ptr Allocator))
                        (process (ptr subprocess/Child))
                        (message Json)] (-> i64)
  (let [line (json-stringify allocator message)
        writer (alloc/stack io/Writer)]
    (match (subprocess/child-stdin-writer writer process)
      (None [] -1)
      (Some [output]
            (match (io/write-line output line)
              (Ok [written] 0)
              (Err [failure] -1))))))

(defn codex-child-read [(allocator (ptr Allocator))
                        (process (ptr subprocess/Child))
                        (timeout-ms i64)] (-> CodexRead)
  (let [result (alloc/stack CodexRead)
        reader (alloc/stack io/Reader)]
    (store! (field result ok) false)
    (store! (field result eof) false)
    (store! (field result message) (JsonNull))
    (store! (field result error) "")
    (match (time/duration-millis timeout-ms)
      (Err [failure]
           (store! (field result error) "invalid Codex app-server timeout"))
      (Ok [duration]
          (match (selectors/wait-fd-for (load (field process stdout-fd))
                                        (selectors/interest-readable)
                                        duration)
            (Err [failure]
                 (store! (field result error) "Codex app-server read timed out or failed"))
            (Ok [ready]
                (match (subprocess/child-stdout-reader reader process)
                  (None [] (store! (field result eof) true))
                  (Some [input]
                        (match (io/read-line-alloc allocator input 16777216)
                          (Err [failure]
                               (match failure
                                 (io/Eof [] (store! (field result eof) true))
                                 (io/Errno [code]
                                           (store! (field result error) "Codex app-server read failed"))
                                 (io/LineTooLong []
                                                 (store! (field result error) "Codex app-server line was too long"))
                                 (io/OutOfMemory []
                                                 (store! (field result error) "Codex app-server allocation failed"))
                                 (io/InvalidLimit []
                                                  (store! (field result error) "invalid Codex app-server line limit"))))
                          (Ok [owned]
                              (let [parsed (json-parse allocator (io/owned-bytes-slice owned))]
                                (if (load (field parsed ok))
                                    (do
                                      (store! (field result ok) true)
                                      (store! (field result message) (load (field parsed value)))
                                      0)
                                    (store! (field result error)
                                            "Codex app-server returned invalid JSON")))))))))))
    (load result)))

(impl CodexTransport subprocess/Child
  (codex-transport-send [(self (ptr subprocess/Child))
                         (allocator (ptr Allocator))
                         (message (ptr Json))]
                        (-> i64)
                        (codex-child-send allocator self (load message)))
  (codex-transport-read [(self (ptr subprocess/Child))
                         (allocator (ptr Allocator))
                         (timeout-ms i64)
                         (result (mut CodexRead))]
                        (-> i64)
                        (do
                          (store! result (codex-child-read allocator self timeout-ms))
                          0))
  (codex-transport-close [(self (ptr subprocess/Child))]
                         (-> i64)
                         (codex-child-close self)))

(defn codex-send [(allocator (ptr Allocator))
                  (connection (ptr CodexConnection))
                  (message Json)] (-> i64)
  (let [message-ref (alloc/stack Json)]
    (store! message-ref message)
    (codex-transport-send (load (field connection transport)) allocator message-ref)))

(defn codex-read [(allocator (ptr Allocator))
                  (connection (ptr CodexConnection))
                  (timeout-ms i64)] (-> CodexRead)
  (let [result (alloc/stack CodexRead)]
    (codex-transport-read (load (field connection transport))
                          allocator
                          timeout-ms
                          (mut result))
    (load result)))

(defn codex-close [(connection (ptr CodexConnection))] (-> i64)
  (codex-transport-close (load (field connection transport))))

(defn codex-emit [(emitter (ptr EventEmitter))
                  (request (ptr ModelRequest))
                  (kind EventKind)
                  (payload Json)] (-> i64)
  (emit-event emitter
              (now-ms)
              kind
              (load (field request run-id))
              (load (field request operation-id))
              ""
              "codex-app-server"
              (load (field request model))
              payload))

(defn codex-reject-server-request [(allocator (ptr Allocator))
                                   (process (ptr CodexConnection))
                                   (message Json)] (-> i64)
  (let [(mut error) (json-object allocator)
        (mut response) (json-object allocator)]
    (json-object-put! (mut error) "code" (json-integer allocator -32601))
    (json-put-string! (mut error)
                      "message"
                      "Interactive server request is unsupported by this headless client")
    (json-object-put! (mut response) "id" (json-get message "id"))
    (json-object-put! (mut response) "error" (load error))
    (codex-send allocator process (load response))))

(defn codex-observe-message [(allocator (ptr Allocator))
                             (process (ptr CodexConnection))
                             (emitter (ptr EventEmitter))
                             (request (ptr ModelRequest))
                             (message Json)] (-> i64)
  (match (json-string-at message "method")
    (Some [method]
          (do
            (codex-emit emitter request (CodexNotification) (JsonString method))
            (when (str-eq method "item/agentMessage/delta")
              (match (json-string-at (json-get message "params") "delta")
                (Some [delta]
                      (codex-emit emitter request (ModelResponseDelta) (JsonString delta)))
                (None [] 0))
              0)
            (match-else (json-get message "id")
                        (JsonNull [] 0)
                        (_ (codex-reject-server-request allocator process message)))
            0))
    (None [] 0)))

(defn codex-wait-response [(allocator (ptr Allocator))
                           (process (ptr CodexConnection))
                           (emitter (ptr EventEmitter))
                           (request (ptr ModelRequest))
                           (wanted-id i64)] (-> CodexWait)
  (let [result (alloc/stack CodexWait)
        (mut done) false]
    (store! (field result ok) false)
    (store! (field result message) (JsonNull))
    (store! (field result error) "")
    (loop (if (load done)
              (break)
              (let [read-result (codex-read allocator process (model-request-remaining-ms request))]
                (if (not (load (field read-result ok)))
                    (do
                      (store! (field result error)
                              (if (load (field read-result eof))
                                  "Codex app-server closed its output"
                                  (load (field read-result error))))
                      (break))
                    (let [message (load (field read-result message))]
                      (codex-observe-message allocator process emitter request message)
                      (when (= (json-number-i64 (json-get message "id")) wanted-id)
                        (if (match-else (json-get message "error")
                                        (JsonNull [] false)
                                        (_ true))
                            (store! (field result error)
                                    (json-error-message message "Codex app-server request failed"))
                            (do
                              (store! (field result ok) true)
                              (store! (field result message) message)
                              0))
                        (store! done true)
                        0))))))
    (load result)))

(defn codex-turn-loop [(allocator (ptr Allocator))
                       (process (ptr CodexConnection))
                       (emitter (ptr EventEmitter))
                       (request (ptr ModelRequest))
                       (thread-id (slice u8))] (-> ModelResult)
  (let [(mut text) (sb-new allocator)
        (mut final) (JsonNull)
        (mut completed) false
        (mut failure) ""]
    (loop (if (or (load completed) (> (slice-len [u8] (load failure)) 0))
              (break)
              (let [read-result (codex-read allocator process (model-request-remaining-ms request))]
                (if (not (load (field read-result ok)))
                    (store! failure
                            (if (load (field read-result eof))
                                "Codex app-server closed before turn completion"
                                (load (field read-result error))))
                    (let [message (load (field read-result message))
                          method
                            (match (json-string-at message "method")
                              (Some [value] value)
                              (None [] ""))]
                      (codex-observe-message allocator process emitter request message)
                      (when (str-eq method "item/agentMessage/delta")
                        (match (json-string-at (json-get message "params") "delta")
                          (Some [delta] (sb-push-str! (mut text) delta))
                          (None [] 0))
                        0)
                      (when (str-eq method "turn/completed")
                        (store! final (json-get message "params"))
                        (let [turn (json-get (load final) "turn")
                              status
                                (match (json-string-at turn "status")
                                  (Some [value] value)
                                  (None [] "failed"))]
                          (if (str-eq status "completed")
                              (store! completed true)
                              (store! failure
                                      (match (json-string-at (json-get turn "error") "message")
                                        (Some [value] value)
                                        (None [] status))))
                          0)))))))
    (if (> (slice-len [u8] (load failure)) 0)
        (model-failure "codex-app-server" 0 (load failure))
        (let [(mut response) (response-empty allocator)]
          (store! (field response provider) "codex-app-server")
          (store! (field response model) (load (field request model)))
          (store! (field response response-id)
                  (match (json-string-at (json-get (load final) "turn") "id")
                    (Some [turn-id] turn-id)
                    (None [] thread-id)))
          (store! (field response output-text) (sb-finish! (mut text)))
          (store! (field response raw-output) (load final))
          (ModelOk (load response))))))

(defn codex-start-and-run-turn [(allocator (ptr Allocator))
                                (process (ptr CodexConnection))
                                (emitter (ptr EventEmitter))
                                (request (ptr ModelRequest))
                                (thread-id (slice u8))] (-> ModelResult)
  (if (!= (codex-send allocator
                      process
                      (codex-turn-start-request allocator thread-id request))
          0)
      (model-failure "codex-app-server" 0 "could not send turn/start")
      (let [started (codex-wait-response allocator process emitter request 3)]
        (if (not (load (field started ok)))
            (model-failure "codex-app-server" 0 (load (field started error)))
            (codex-turn-loop allocator process emitter request thread-id)))))

;; Send one request and wait for its matching response. Keeping write and read
;; failure together prevents a failed write from surfacing later as a read timeout.
(defn codex-call [(allocator (ptr Allocator))
                  (process (ptr CodexConnection))
                  (emitter (ptr EventEmitter))
                  (request (ptr ModelRequest))
                  (message Json)
                  (wanted-id i64)
                  (send-error (slice u8))] (-> (Result Json (slice u8)))
  (if (!= (codex-send allocator process message) 0)
      (Err send-error)
      (let [response (codex-wait-response allocator process emitter request wanted-id)]
        (if (load (field response ok))
            (Ok (load (field response message)))
            (Err (load (field response error)))))))

(defn codex-notify-initialized [(allocator (ptr Allocator))
                                (process (ptr CodexConnection))] (-> (Result i64 (slice u8)))
  (if (= (codex-send allocator
                     process
                     (codex-initialized-notification allocator))
         0)
      (Ok 0)
      (Err "could not send initialized notification")))

(defn codex-thread-id [(message Json)] (-> (Result (slice u8) (slice u8)))
  (let [thread-id
          (match (json-string-at (json-get (json-get message "result") "thread") "id")
            (Some [value] value)
            (None [] ""))]
    (if (> (slice-len [u8] thread-id) 0)
        (Ok thread-id)
        (Err "thread/start omitted thread id"))))

;; The fixed App Server handshake is intentionally linear. Each failed operation
;; short-circuits with the message for that operation; process ownership stays with
;; codex-execute, which closes it exactly once.
(defn codex-open-thread [(context (ptr CodexAppServerContext))
                         (request (ptr ModelRequest))
                         (emitter (ptr EventEmitter))
                         (allocator (ptr Allocator))
                         (process (ptr CodexConnection))] (-> (Result (slice u8) (slice u8)))
  (try (try! (codex-call allocator
                         process
                         emitter
                         request
                         (codex-initialize-request allocator)
                         1
                         "could not initialize Codex app-server"))
       (try! (codex-notify-initialized allocator process))
       (let [started
               (try! (codex-call allocator
                                 process
                                 emitter
                                 request
                                 (codex-thread-start-request allocator context request)
                                 2
                                 "could not send thread/start"))]
         (codex-thread-id started))))

(defn codex-run-session [(context (ptr CodexAppServerContext))
                         (request (ptr ModelRequest))
                         (emitter (ptr EventEmitter))
                         (allocator (ptr Allocator))
                         (process (ptr CodexConnection))] (-> ModelResult)
  (match (codex-open-thread context request emitter allocator process)
    (Err [message] (model-failure "codex-app-server" 0 message))
    (Ok [thread-id]
        (codex-start-and-run-turn allocator process emitter request thread-id))))

;; Translate the terminal result into exactly one request lifecycle event.
(defn codex-finish [(emitter (ptr EventEmitter))
                    (request (ptr ModelRequest))
                    (result ModelResult)] (-> ModelResult)
  (match result
    (ModelOk [response]
             (let [completed response]
               (codex-emit emitter
                           request
                           (ModelRequestCompleted)
                           (JsonString (load (field completed response-id))))
               (ModelOk completed)))
    (ModelErr [failure]
              (let [failed failure]
                (codex-emit emitter
                            request
                            (ModelRequestFailed)
                            (JsonString (load (field failed message))))
                (ModelErr failed)))))

;; Own one connected transport for exactly one model request. This seam keeps spawn
;; policy outside protocol tests while making close and terminal-event invariants
;; deterministic under an in-memory transport.
(defn codex-execute-connection [(context (ptr CodexAppServerContext))
                                (request (ptr ModelRequest))
                                (emitter (ptr EventEmitter))
                                (allocator (ptr Allocator))
                                (connection (ptr CodexConnection))] (-> ModelResult)
  (codex-emit emitter request (ModelRequestStarted) (JsonNull))
  (let [result (codex-run-session context request emitter allocator connection)]
    (codex-close connection)
    (codex-finish emitter request result)))

(defn codex-execute [(context (ptr CodexAppServerContext))
                     (request (ptr ModelRequest))
                     (emitter (ptr EventEmitter))
                     (allocator (ptr Allocator))] (-> ModelResult)
  (let [spawn-result (codex-spawn allocator)]
    (if (!= (load (field spawn-result code)) 0)
        (model-failure "codex-app-server" 0 (load (field spawn-result error)))
        (let [process
                (box allocator
                     subprocess/Child
                     (load (field spawn-result process)))
              connection (box allocator CodexConnection (zeroed CodexConnection))]
          (store! (field connection transport) process)
          (codex-execute-connection context
                                    request
                                    emitter
                                    allocator
                                    connection)))))

(impl ModelProvider CodexAppServerContext
  (provider-name [(self (ptr CodexAppServerContext))]
                 (-> (slice u8))
                 "codex-app-server")
  
  (execute-model [(self (ptr CodexAppServerContext))
                  (request (ptr ModelRequest))
                  (emitter (ptr EventEmitter))
                  (allocator (ptr Allocator))]
                 (-> ModelResult)
                 (codex-execute self request emitter allocator)))

;; Build a request that appends input to an active turn without starting a new turn.
(defn codex-steer-request [(allocator (ptr Allocator))
                           (id i64)
                           (thread-id (slice u8))
                           (turn-id (slice u8))
                           (text (slice u8))] (-> Json)
  (let [(mut item) (json-object allocator)
        (mut input) (json-array allocator)
        (mut params) (json-object allocator)]
    (json-put-string! (mut item) "type" "text")
    (json-put-string! (mut item) "text" text)
    (json-array-push! (mut input) (load item))
    (json-put-string! (mut params) "threadId" thread-id)
    (json-put-string! (mut params) "expectedTurnId" turn-id)
    (json-object-put! (mut params) "input" (load input))
    (codex-rpc-request allocator id "turn/steer" (load params))))

;; Build a cancellation request. A successful response only acknowledges the request;
;; callers confirm cancellation from the later interrupted turn/completed event.
(defn codex-interrupt-request [(allocator (ptr Allocator))
                               (id i64)
                               (thread-id (slice u8))
                               (turn-id (slice u8))] (-> Json)
  (let [(mut params) (json-object allocator)]
    (json-put-string! (mut params) "threadId" thread-id)
    (json-put-string! (mut params) "turnId" turn-id)
    (codex-rpc-request allocator id "turn/interrupt" (load params))))
