(module codex-app-server)
(import "coil.primitive" :as primitive)

(import "coil.alloc" :as alloc :use *)
(import "coil.arraylist" :use *)
(import "coil.io" :as io)
(import "coil.match" :use *)
(import "coil.result" :use *)
(import "coil.selectors" :as selectors)
(import "coil.slice" :use *)
(import "coil.str" :use *)
(import "coil.subprocess" :as subprocess)
(import "coil.sync" :as sync)
(import "coil.time" :as time)
(import "coil.try" :use *)
(import "harness-event" :use *)
(import "harness-json" :use *)
(import "harness-model" :use *)
(import "harness-http" :use *)
(import "harness-system" :use *)
(import "harness-tool" :use *)
(import "harness-tool-executor" :use *)
(import "provider-common" :use *)

(defstruct CodexAppServerContext
  [(cwd (slice u8))
   (sandbox (slice u8))
   (approval-policy (slice u8))
   (owner (dyn Allocator))
   (connection (ptr i8))
   (mutex sync/Mutex)
   (persistent bool)
   (initialized bool)])

(defn codex-context [(cwd (slice u8))] (-> CodexAppServerContext)
  (let [context (primitive/alloc-stack CodexAppServerContext)]
    (set! (.cwd context) cwd)
    (set! (.sandbox context) "workspace-write")
    (set! (.approval-policy context) "never")
    (set! (.connection context) (cast (ptr i8) 0))
    (set! (.persistent context) false)
    (set! (.initialized context) false)
    (load context)))

;; Codex is a provider capability; App Server and direct subscription HTTP are
;; interchangeable execution strategies behind this lifecycle boundary.
(deftrait CodexExecutionStrategy [Self]
  (codex-strategy-name [(self (ptr Self))] (-> (slice u8)))
  (codex-strategy-prepare! [(self (ptr Self)) (allocator (dyn Allocator))] (-> i64))
  (codex-strategy-execute [(self (ptr Self))
                           (request (ptr ModelRequest))
                           (emitter (ptr EventEmitter))
                           (allocator (dyn Allocator))]
                          (-> ModelResult))
  (codex-strategy-close! [(self (ptr Self))] (-> i64)))

(defstruct CodexProvider [(strategy (ptr (dyn CodexExecutionStrategy)))])

(defstruct CodexRead
  [(ok bool)
   (eof bool)
   (message Json)
   (error (slice u8))])

(defstruct CodexWait
  [(ok bool)
   (message Json)
   (error (slice u8))])

(defstruct CodexSpawnResult
  [(code i64)
   (process subprocess/Child)
   (error (slice u8))])

;; The protocol depends on newline-delimited JSON, not on subprocess mechanics.
;; Tests can supply an in-memory transport while the production implementation
;; delegates to Coil's hosted child-process and I/O libraries.
(deftrait CodexTransport [Self]
  (codex-transport-send [(self (ptr Self))
                         (allocator (dyn Allocator))
                         (message (ptr Json))]
                        (-> i64))
  (codex-transport-read [(self (ptr Self))
                         (allocator (dyn Allocator))
                         (timeout-ms i64)
                         (result (mut CodexRead))]
                        (-> i64))
  (codex-transport-close [(self (ptr Self))] (-> i64)))

(defstruct CodexConnection [(transport (dyn CodexTransport))])

;; A service-owned context keeps one initialized app-server process for all Codex
;; turns. The mutex serializes the current fixed-ID JSON-RPC client over its single
;; stdio stream.
(defn codex-context-init-persistent! [(context (ptr CodexAppServerContext))
                                      (owner (dyn Allocator))
                                      (cwd (slice u8))] (-> i64)
  (set! context (codex-context cwd))
  (set! (.owner context) owner)
  (match (sync/mutex-init-with-allocator (field context mutex) owner)
    (Err [failure] -1)
    (Ok [mutex]
        (do
          (set! (.persistent context) true)
          0))))

(defn codex-context-close! [(context (ptr CodexAppServerContext))] (-> i64)
  (when (load (field context persistent))
    (sync/mutex-lock! (field context mutex))
    (let [opaque (load (field context connection))]
      (when (!= opaque (cast (ptr i8) 0))
        (codex-close (cast (ptr CodexConnection) opaque))
        (store! (field context connection) (cast (ptr i8) 0))
        (store! (field context initialized) false)
        0))
    (sync/mutex-unlock! (field context mutex))
    (sync/mutex-destroy! (field context mutex))
    (store! (field context persistent) false)
    0)
  0)

(defn codex-spawn [(allocator (dyn Allocator))] (-> CodexSpawnResult)
  (let [result (primitive/alloc-stack CodexSpawnResult)
        child (primitive/alloc-stack subprocess/Child)
        args (primitive/alloc-stack (array (slice u8) 3))]
    (set! (.code result) 0)
    (set! (.error result) "")
    (set! (index args 0) "app-server")
    (set! (index args 1) "--listen")
    (set! (index args 2) "stdio://")
    (match (subprocess/spawn allocator
                             child
                             "codex"
                             (slice-new [(slice u8)] (index args 0) 3)
                             (subprocess/pipe-stdio)
                             (subprocess/pipe-stdio)
                             (subprocess/inherit-stdio))
      (Ok [spawned] (set! (.process result) (load child)))
      (Err [failure]
           (do
             (set! (.code result) -1)
             (set! (.error result) "could not spawn Codex app-server"))))
    (load result)))

(defn codex-child-close [(process (ptr subprocess/Child))] (-> i64)
  (subprocess/child-close-stdin process)
  (match (subprocess/child-try-wait process)
    (Ok [status]
        (match status
          (Some [finished] 0)
          (None []
                (do
                  (subprocess/child-terminate process)
                  (subprocess/child-wait process)
                  0))))
    (Err [failure]
         (do
           (subprocess/child-kill-and-wait process)
           0)))
  (match (subprocess/child-close process)
    (Ok [value] value)
    (Err [failure] -1)))

(defn codex-rpc-request [(allocator (dyn Allocator)) (id i64) (method (slice u8)) (params Json)] (-> Json)
  (let [(mut request) (json-object allocator)]
    (json-object-put! (mut request) "id" (json-integer allocator id))
    (json-put-string! (mut request) "method" method)
    (json-object-put! (mut request) "params" params)
    (load request)))

(defn codex-initialize-request [(allocator (dyn Allocator))] (-> Json)
  (let [(mut client) (json-object allocator)
        (mut capabilities) (json-object allocator)
        (mut params) (json-object allocator)]
    (json-put-string! (mut client) "name" "coil-agent-harness")
    (json-put-string! (mut client) "title" "COIL Agent Harness")
    (json-put-string! (mut client) "version" "0.1.0")
    (json-put-bool! (mut capabilities) "experimentalApi" true)
    (json-object-put! (mut params) "clientInfo" (load client))
    (json-object-put! (mut params) "capabilities" (load capabilities))
    (codex-rpc-request allocator 1 "initialize" (load params))))

(defn codex-initialized-notification [(allocator (dyn Allocator))] (-> Json)
  (let [(mut notification) (json-object allocator)]
    (json-put-string! (mut notification) "method" "initialized")
    (json-object-put! (mut notification) "params" (json-object allocator))
    (load notification)))

(defn codex-thread-start-request [(allocator (dyn Allocator))
                                  (context (ptr CodexAppServerContext))
                                  (request (ptr ModelRequest))] (-> Json)
  (let [(mut params) (json-object allocator)]
    (json-put-string! (mut params) "model" (.model request))
    (json-put-string! (mut params) "cwd" (.cwd context))
    (json-put-string! (mut params) "sandbox" (.sandbox context))
    (json-put-string! (mut params)
                      "approvalPolicy"
                      (.approval-policy context))
    (when (> (slice-len [u8] (load (field request instructions))) 0)
      (json-put-string! (mut params)
                        "developerInstructions"
                        (load (field request instructions)))
      0)
    (let [(mut tools) (json-array allocator)
          definitions (field (load (field request tools)) definitions)
          (mut i) 0
          n (al-len [ToolDefinition] (load definitions))]
      (loop (if (>= (load i) n)
                (break)
                (let [definition (al-get [ToolDefinition] (load definitions) (load i))
                      ;; Keep a value, not a reference into the temporary returned
                      ;; by al-get. Building `tool` allocates and may reuse that
                      ;; temporary's stack storage before the schema is read.
                      spec (.spec definition)
                      (mut tool) (json-object allocator)]
                  (json-put-string! (mut tool) "type" "function")
                  (json-put-string! (mut tool) "name" (.name spec))
                  (json-put-string! (mut tool) "description" (.description spec))
                  (json-object-put! (mut tool)
                                    "inputSchema"
                                    (json-clone allocator
                                                (.input-schema spec)))
                  (json-array-push! (mut tools) (load tool))
                  (set! i (+ (load i) 1)))))
      (json-object-put! (mut params) "dynamicTools" (load tools)))
    (codex-rpc-request allocator 2 "thread/start" (load params))))

(defn codex-last-user-message [(request (ptr ModelRequest))] (-> (slice u8))
  (let [messages (load (field request messages))
        (mut i) (al-len [Message] (load messages))
        (mut result) ""]
    (loop (if (<= (load i) 0)
              (break)
              (do
                (set! i (- (load i) 1))
                (let [message (al-get [Message] (load messages) (load i))]
                  (match (.role message)
                    (UserRole []
                              (do (set! result (.content message)) (break)))
                    (SystemRole [] 0)
                    (AssistantRole [] 0))))))
    (load result)))

(defn codex-conversation-input [(allocator (dyn Allocator))
                                (request (ptr ModelRequest))] (-> (slice u8))
  ;; Codex owns history in its durable thread. Replaying a flattened transcript
  ;; creates a second, divergent history and defeats native prefix caching.
  (codex-last-user-message request))

(defn codex-thread-resume-request [(allocator (dyn Allocator))
                                   (thread-id (slice u8))] (-> Json)
  (let [(mut params) (json-object allocator)]
    (json-put-string! (mut params) "threadId" thread-id)
    (codex-rpc-request allocator 2 "thread/resume" (load params))))

(defn codex-turn-start-request [(allocator (dyn Allocator))
                                (thread-id (slice u8))
                                (request (ptr ModelRequest))] (-> Json)
  (let [(mut input-item) (json-object allocator)
        (mut input) (json-array allocator)
        (mut params) (json-object allocator)]
    (json-put-string! (mut input-item) "type" "text")
    (json-put-string! (mut input-item) "text" (codex-conversation-input allocator request))
    (json-array-push! (mut input) (load input-item))
    (json-put-string! (mut params) "threadId" thread-id)
    (json-object-put! (mut params) "input" (load input))
    (json-put-string! (mut params)
                      "effort"
                      (.reasoning request))
    (codex-rpc-request allocator 3 "turn/start" (load params))))

(defn codex-child-send [(allocator (dyn Allocator))
                        (process (ptr subprocess/Child))
                        (message Json)] (-> i64)
  (let [line (json-stringify allocator message)
        writer (primitive/alloc-stack io/Writer)]
    (match (subprocess/child-stdin-writer writer process)
      (None [] -1)
      (Some [output]
            (match (io/write-line output line)
              (Ok [written] 0)
              (Err [failure] -1))))))

(defn codex-child-read [(allocator (dyn Allocator))
                        (process (ptr subprocess/Child))
                        (timeout-ms i64)] (-> CodexRead)
  (let [result (primitive/alloc-stack CodexRead)
        reader (primitive/alloc-stack io/Reader)]
    (set! (.ok result) false)
    (set! (.eof result) false)
    (set! (.message result) (JsonNull))
    (set! (.error result) "")
    (match (time/duration-millis timeout-ms)
      (Err [failure]
           (set! (.error result) "invalid Codex app-server timeout"))
      (Ok [duration]
          (match (selectors/wait-fd-for (.stdout-fd process)
                                        (selectors/interest-readable)
                                        duration)
            (Err [failure]
                 (set! (.error result) "Codex app-server read timed out or failed"))
            (Ok [ready]
                (match (subprocess/child-stdout-reader reader process)
                  (None [] (set! (.eof result) true))
                  (Some [input]
                        (match (io/read-line-alloc allocator input 16777216)
                          (Err [failure]
                               (match failure
                                 (io/Eof [] (set! (.eof result) true))
                                 (io/Errno [code]
                                           (set! (.error result) "Codex app-server read failed"))
                                 (io/LineTooLong []
                                                 (set! (.error result) "Codex app-server line was too long"))
                                 (io/OutOfMemory []
                                                 (set! (.error result) "Codex app-server allocation failed"))
                                 (io/InvalidLimit []
                                                  (set! (.error result) "invalid Codex app-server line limit"))))
                          (Ok [owned]
                              (let [parsed (json-parse allocator (io/owned-bytes-slice owned))]
                                (if (.ok parsed)
                                    (do
                                      (set! (.ok result) true)
                                      (set! (.message result) (.value parsed))
                                      0)
                                    (set! (.error result) "Codex app-server returned invalid JSON")))))))))))
    (load result)))

(impl CodexTransport subprocess/Child
  (codex-transport-send [(self (ptr subprocess/Child))
                         (allocator (dyn Allocator))
                         (message (ptr Json))]
                        (-> i64)
                        (codex-child-send allocator self (load message)))
  (codex-transport-read [(self (ptr subprocess/Child))
                         (allocator (dyn Allocator))
                         (timeout-ms i64)
                         (result (mut CodexRead))]
                        (-> i64)
                        (do
                          (set! result (codex-child-read allocator self timeout-ms))
                          0))
  (codex-transport-close [(self (ptr subprocess/Child))]
                         (-> i64)
                         (codex-child-close self)))

(defn codex-send [(allocator (dyn Allocator))
                  (connection (ptr CodexConnection))
                  (message Json)] (-> i64)
  (let [message-ref (primitive/alloc-stack Json)]
    (set! message-ref message)
    (codex-transport-send (.transport connection) allocator message-ref)))

(defn codex-read [(allocator (dyn Allocator))
                  (connection (ptr CodexConnection))
                  (timeout-ms i64)] (-> CodexRead)
  (let [result (primitive/alloc-stack CodexRead)]
    (codex-transport-read (.transport connection)
                          allocator
                          timeout-ms
                          (mut result))
    (load result)))

(defn codex-close [(connection (ptr CodexConnection))] (-> i64)
  (codex-transport-close (.transport connection)))

(defn codex-bootstrap-wait [(allocator (dyn Allocator))
                            (connection (ptr CodexConnection))
                            (wanted-id i64)] (-> i64)
  (let [(mut done) false
        (mut result) -1]
    (loop (if (load done)
              (break)
              (let [read-result (codex-read allocator connection 120000)]
                (if (not (.ok read-result))
                    (set! done true)
                    (let [message (.message read-result)]
                      (when (= (json-number-i64 (json-get message "id")) wanted-id)
                        (store! result
                                (if (match (json-get message "error") (JsonNull [] false) (_ true))
                                    -1
                                    0))
                        (store! done true)
                        0))))))
    (load result)))

(defn codex-bootstrap-initialize! [(allocator (dyn Allocator))
                                   (connection (ptr CodexConnection))] (-> i64)
  (if (!= (codex-send allocator connection (codex-initialize-request allocator)) 0)
      -1
      (if (!= (codex-bootstrap-wait allocator connection 1) 0)
          -1
          (match (codex-notify-initialized allocator connection)
            (Ok [value] 0)
            (Err [message] -1)))))

(defn codex-emit [(emitter (ptr EventEmitter))
                  (request (ptr ModelRequest))
                  (kind EventKind)
                  (payload Json)] (-> i64)
  (emit-event emitter
              (now-ms)
              kind
              (.run-id request)
              (.operation-id request)
              ""
              "codex-app-server"
              (.model request)
              payload))

(defn codex-reject-server-request [(allocator (dyn Allocator))
                                   (process (ptr CodexConnection))
                                   (message Json)] (-> i64)
  (let [(mut error) (json-object allocator)
        (mut response) (json-object allocator)]
    (json-object-put! (mut error) "code" (json-integer allocator -32601))
    (json-put-string! (mut error)
                      "message"
                      "Interactive server request is unsupported by this headless client")
    (json-object-put! (mut response) "id" (json-get message "id"))
    (json-object-put! (mut response) "error" (load error))
    (codex-send allocator process (load response))))

(defn codex-dynamic-tool-response [(allocator (dyn Allocator))
                                   (process (ptr CodexConnection))
                                   (message Json)
                                   (result ToolResult)] (-> i64)
  (let [success
          (match (.status result) (ToolSucceeded [] true) (_ false))
        text
          (if success
              (json-stringify allocator (.output result))
              (.error result))
        (mut content) (json-object allocator)
        (mut content-items) (json-array allocator)
        (mut payload) (json-object allocator)
        (mut response) (json-object allocator)]
    (json-put-string! (mut content) "type" "inputText")
    (json-put-string! (mut content) "text" text)
    (json-array-push! (mut content-items) (load content))
    (json-object-put! (mut payload) "contentItems" (load content-items))
    (json-put-bool! (mut payload) "success" success)
    (json-object-put! (mut response) "id" (json-get message "id"))
    (json-object-put! (mut response) "result" (load payload))
    (codex-send allocator process (load response))))

(defn codex-execute-dynamic-tool [(allocator (dyn Allocator))
                                  (process (ptr CodexConnection))
                                  (emitter (ptr EventEmitter))
                                  (request (ptr ModelRequest))
                                  (message Json)] (-> i64)
  (let [params (json-get message "params")
        call (primitive/alloc-stack ToolCall)
        calls (box! allocator (ArrayList ToolCall) (al-new [ToolCall] allocator))
        execution (primitive/alloc-stack ToolExecutionRequest)]
    (set! (.id call)
          (match (json-string-at params "callId")
            (Some [value] value)
            (None [] "codex-dynamic-tool")))
    (set! (.name call)
          (match (json-string-at params "tool")
            (Some [value] value)
            (None [] "")))
    (set! (.arguments call) (json-get params "arguments"))
    (set! (.raw-arguments call) (json-stringify allocator (.arguments call)))
    (al-push! [ToolCall] calls (load call))
    (set! (.run-id execution) (.run-id request))
    (set! (.parent-operation-id execution) (.operation-id request))
    (set! (.provider execution) "codex-app-server")
    (set! (.model execution) (.model request))
    (set! (.registry execution) (load (field request tools)))
    (set! (.calls execution) calls)
    (set! (.emitter execution) emitter)
    (set! (.cancellation execution) (load (field request cancellation)))
    (set! (.run-deadline-monotonic-ms execution) (.deadline-monotonic-ms request))
    (set! (.max-parallel execution) 1)
    (let [batch (execute-tools-parallel allocator execution)
          result (al-get [ToolResult] (.results batch) 0)]
      (codex-dynamic-tool-response allocator process message result))))

(defn codex-observe-message [(allocator (dyn Allocator))
                             (process (ptr CodexConnection))
                             (emitter (ptr EventEmitter))
                             (request (ptr ModelRequest))
                             (message Json)] (-> i64)
  (match (json-string-at message "method")
    (Some [method]
          (do
            ;; App-server notifications are transport diagnostics, not durable
            ;; domain facts. Semantic events below remain journaled.
            (when (= method "item/agentMessage/delta")
              (match (json-string-at (json-get message "params") "delta")
                (Some [delta]
                      (codex-emit emitter request (ModelResponseDelta) (JsonString delta)))
                (None [] 0))
              0)
            (match (json-get message "id")
                   (JsonNull [] 0)
                   (_ (if (= method "item/tool/call")
                          (codex-execute-dynamic-tool allocator
                                                      process
                                                      emitter
                                                      request
                                                      message)
                          (codex-reject-server-request allocator process message))))
            0))
    (None [] 0)))

(defn codex-wait-response [(allocator (dyn Allocator))
                           (process (ptr CodexConnection))
                           (emitter (ptr EventEmitter))
                           (request (ptr ModelRequest))
                           (wanted-id i64)] (-> CodexWait)
  (let [result (primitive/alloc-stack CodexWait)
        (mut done) false]
    (set! (.ok result) false)
    (set! (.message result) (JsonNull))
    (set! (.error result) "")
    (loop (if (load done)
              (break)
              (let [read-result (codex-read allocator process (model-request-remaining-ms request))]
                (if (not (.ok read-result))
                    (do
                      (set! (.error result)
                            (if (.eof read-result)
                                "Codex app-server closed its output"
                                (.error read-result)))
                      (break))
                    (let [message (.message read-result)]
                      (codex-observe-message allocator process emitter request message)
                      (when (= (json-number-i64 (json-get message "id")) wanted-id)
                        (if (match (json-get message "error") (JsonNull [] false) (_ true))
                            (store! (field result error)
                                    (json-error-message message "Codex app-server request failed"))
                            (do
                              (store! (field result ok) true)
                              (store! (field result message) message)
                              0))
                        (store! done true)
                        0))))))
    (load result)))

(defn codex-turn-loop [(allocator (dyn Allocator))
                       (process (ptr CodexConnection))
                       (emitter (ptr EventEmitter))
                       (request (ptr ModelRequest))
                       (thread-id (slice u8))] (-> ModelResult)
  (let [(mut text) (sb-new allocator)
        (mut final) (JsonNull)
        (mut completed) false
        (mut failure) ""
        (mut usage) (zeroed ModelUsage)]
    (loop (if (or (load completed) (> (slice-len [u8] (load failure)) 0))
              (break)
              (let [read-result (codex-read allocator process (model-request-remaining-ms request))]
                (if (not (.ok read-result))
                    (set! failure
                          (if (.eof read-result)
                              "Codex app-server closed before turn completion"
                              (.error read-result)))
                    (let [message (.message read-result)
                          method
                            (match (json-string-at message "method")
                              (Some [value] value)
                              (None [] ""))]
                      (codex-observe-message allocator process emitter request message)
                      (when (= method "item/agentMessage/delta")
                        (match (json-string-at (json-get message "params") "delta")
                          (Some [delta] (sb-push-str! (mut text) delta))
                          (None [] 0))
                        0)
                      (when (= method "thread/tokenUsage/updated")
                        (let [last (json-get (json-get message "params") "tokenUsage")
                              breakdown (json-get last "last")]
                          (store! (field usage input-tokens)
                                  (json-number-i64 (json-get breakdown "inputTokens")))
                          (store! (field usage output-tokens)
                                  (json-number-i64 (json-get breakdown "outputTokens")))
                          (store! (field usage reasoning-tokens)
                                  (json-number-i64 (json-get breakdown "reasoningOutputTokens")))
                          (store! (field usage cached-input-tokens)
                                  (json-number-i64 (json-get breakdown "cachedInputTokens"))))
                        0)
                      (when (= method "turn/completed")
                        (store! final (json-get message "params"))
                        (let [turn (json-get (load final) "turn")
                              status
                                (match (json-string-at turn "status")
                                  (Some [value] value)
                                  (None [] "failed"))]
                          (if (= status "completed")
                              (store! completed true)
                              (store! failure
                                      (match (json-string-at (json-get turn "error") "message")
                                        (Some [value] value)
                                        (None [] status))))
                          0)))))))
    (if (> (slice-len [u8] (load failure)) 0)
        (model-failure "codex-app-server" 0 (load failure))
        (let [(mut response) (response-empty allocator)]
          (set! (.provider response) "codex-app-server")
          (set! (.model response) (.model request))
          (set! (.response-id response)
                (match (json-string-at (json-get (load final) "turn") "id")
                  (Some [turn-id] turn-id)
                  (None [] thread-id)))
          (set! (.output-text response) (sb-finish! (mut text)))
          (set! (.provider-session-id response) thread-id)
          (set! (.usage response) (load usage))
          (set! (.raw-output response) (load final))
          (ModelOk (load response))))))

(defn codex-start-and-run-turn [(allocator (dyn Allocator))
                                (process (ptr CodexConnection))
                                (emitter (ptr EventEmitter))
                                (request (ptr ModelRequest))
                                (thread-id (slice u8))] (-> ModelResult)
  (if (!= (codex-send allocator
                      process
                      (codex-turn-start-request allocator thread-id request))
          0)
      (model-failure "codex-app-server" 0 "could not send turn/start")
      (let [started (codex-wait-response allocator process emitter request 3)]
        (if (not (.ok started))
            (model-failure "codex-app-server" 0 (.error started))
            (codex-turn-loop allocator process emitter request thread-id)))))

;; Send one request and wait for its matching response. Keeping write and read
;; failure together prevents a failed write from surfacing later as a read timeout.
(defn codex-call [(allocator (dyn Allocator))
                  (process (ptr CodexConnection))
                  (emitter (ptr EventEmitter))
                  (request (ptr ModelRequest))
                  (message Json)
                  (wanted-id i64)
                  (send-error (slice u8))] (-> (Result Json (slice u8)))
  (if (!= (codex-send allocator process message) 0)
      (Err send-error)
      (let [response (codex-wait-response allocator process emitter request wanted-id)]
        (if (.ok response)
            (Ok (.message response))
            (Err (.error response))))))

(defn codex-notify-initialized [(allocator (dyn Allocator))
                                (process (ptr CodexConnection))] (-> (Result i64 (slice u8)))
  (if (= (codex-send allocator
                     process
                     (codex-initialized-notification allocator))
         0)
      (Ok 0)
      (Err "could not send initialized notification")))

(defn codex-thread-id [(message Json)] (-> (Result (slice u8) (slice u8)))
  (let [thread-id
          (match (json-string-at (json-get (json-get message "result") "thread") "id")
            (Some [value] value)
            (None [] ""))]
    (if (> (slice-len [u8] thread-id) 0)
        (Ok thread-id)
        (Err "thread/start omitted thread id"))))

;; The fixed App Server handshake is intentionally linear. Each failed operation
;; short-circuits with the message for that operation; process ownership stays with
;; codex-execute, which closes it exactly once.
(defn codex-initialize-connection [(request (ptr ModelRequest))
                                   (emitter (ptr EventEmitter))
                                   (allocator (dyn Allocator))
                                   (process (ptr CodexConnection))] (-> (Result i64 (slice u8)))
  (try (try! (codex-call allocator
                         process
                         emitter
                         request
                         (codex-initialize-request allocator)
                         1
                         "could not initialize Codex app-server"))
       (codex-notify-initialized allocator process)))

(defn codex-open-thread [(context (ptr CodexAppServerContext))
                         (request (ptr ModelRequest))
                         (emitter (ptr EventEmitter))
                         (allocator (dyn Allocator))
                         (process (ptr CodexConnection))] (-> (Result (slice u8) (slice u8)))
  (try (let [session-id (load (field (field request continuation) provider-session-id))
             started
               (try! (codex-call allocator
                                 process
                                 emitter
                                 request
                                 (if (> (slice-len [u8] session-id) 0)
                                     (codex-thread-resume-request allocator session-id)
                                     (codex-thread-start-request allocator context request))
                                 2
                                 (if (> (slice-len [u8] session-id) 0)
                                     "could not send thread/resume"
                                     "could not send thread/start")))]
         (codex-thread-id started))))

(defn codex-run-session [(context (ptr CodexAppServerContext))
                         (request (ptr ModelRequest))
                         (emitter (ptr EventEmitter))
                         (allocator (dyn Allocator))
                         (process (ptr CodexConnection))] (-> ModelResult)
  (match (codex-open-thread context request emitter allocator process)
    (Err [message] (model-failure "codex-app-server" 0 message))
    (Ok [thread-id]
        (codex-start-and-run-turn allocator process emitter request thread-id))))

;; Translate the terminal result into exactly one request lifecycle event.
(defn codex-finish [(emitter (ptr EventEmitter))
                    (request (ptr ModelRequest))
                    (allocator (dyn Allocator))
                    (result ModelResult)] (-> ModelResult)
  (match result
    (ModelOk [response]
             (let [completed response]
               (let [(mut usage) (json-object allocator)
                     (mut payload) (json-object allocator)]
                 (json-put-string! (mut payload)
                                   "response_id"
                                   (.response-id completed))
                 (json-put-string! (mut payload)
                                   "provider_session_id"
                                   (.provider-session-id completed))
                 (json-put-string! (mut payload)
                                   "cache_key"
                                   (.cache-key request))
                 (json-object-put! (mut usage)
                                   "input_tokens"
                                   (json-integer allocator
                                                 (.input-tokens (.usage completed))))
                 (json-object-put! (mut usage)
                                   "output_tokens"
                                   (json-integer allocator
                                                 (.output-tokens (.usage completed))))
                 (json-object-put! (mut usage)
                                   "reasoning_tokens"
                                   (json-integer allocator
                                                 (.reasoning-tokens (.usage completed))))
                 (json-object-put! (mut usage)
                                   "cached_input_tokens"
                                   (json-integer allocator
                                                 (.cached-input-tokens (.usage completed))))
                 (json-object-put! (mut payload) "usage" (load usage))
                 (codex-emit emitter request (ModelRequestCompleted) (load payload)))
               (ModelOk completed)))
    (ModelErr [failure]
              (let [failed failure]
                (codex-emit emitter
                            request
                            (ModelRequestFailed)
                            (JsonString (.message failed)))
                (ModelErr failed)))))

;; Own one connected transport for exactly one model request. This seam keeps spawn
;; policy outside protocol tests while making close and terminal-event invariants
;; deterministic under an in-memory transport.
(defn codex-execute-connection [(context (ptr CodexAppServerContext))
                                (request (ptr ModelRequest))
                                (emitter (ptr EventEmitter))
                                (allocator (dyn Allocator))
                                (connection (ptr CodexConnection))] (-> ModelResult)
  (codex-emit emitter request (ModelRequestStarted) (JsonNull))
  (let [result
          (match (codex-initialize-connection request emitter allocator connection)
            (Err [message] (model-failure "codex-app-server" 0 message))
            (Ok [value] (codex-run-session context request emitter allocator connection)))]
    (codex-close connection)
    (codex-finish emitter request allocator result)))

(defn codex-open-persistent! [(context (ptr CodexAppServerContext))
                              (request (ptr ModelRequest))
                              (emitter (ptr EventEmitter))
                              (allocator (dyn Allocator))] (-> (Result (ptr CodexConnection) (slice u8)))
  (let [existing (load (field context connection))]
    (if (and (!= existing (cast (ptr i8) 0))
             (.initialized context))
        (Ok (cast (ptr CodexConnection) existing))
        (if (!= existing (cast (ptr i8) 0))
            (let [connection (cast (ptr CodexConnection) existing)]
              (match (codex-initialize-connection request emitter allocator connection)
                (Err [message] (Err message))
                (Ok [value]
                    (do
                      (set! (.initialized context) true)
                      (Ok connection)))))
            (let [spawn-result (codex-spawn (load (field context owner)))]
              (if (!= (.code spawn-result) 0)
                  (Err (.error spawn-result))
                  (let [process
                          (box! (load (field context owner))
                               subprocess/Child
                               (load (field spawn-result process)))
                        connection
                          (box! (load (field context owner))
                               CodexConnection
                               (zeroed CodexConnection))]
                    (set! (.transport connection) process)
                    (match (codex-initialize-connection request emitter allocator connection)
                      (Err [message]
                           (do
                             (codex-close connection)
                             (Err message)))
                      (Ok [value]
                          (do
                            (set! (.connection context) (cast (ptr i8) connection))
                            (set! (.initialized context) true)
                            (Ok connection)))))))))))

(defn codex-context-prepare-persistent! [(context (ptr CodexAppServerContext))
                                         (allocator (dyn Allocator))] (-> i64)
  (match (sync/mutex-lock! (field context mutex))
    (Err [failure] -1)
    (Ok [locked]
        (let [existing (load (field context connection))
              (mut result) 0]
          (when (= existing (cast (ptr i8) 0))
            (let [spawn-result (codex-spawn (load (field context owner)))]
              (if (!= (load (field spawn-result code)) 0)
                  (store! result -1)
                  (let [process
                          (box! (load (field context owner))
                               subprocess/Child
                               (load (field spawn-result process)))
                        connection
                          (box! (load (field context owner))
                               CodexConnection
                               (zeroed CodexConnection))]
                    (store! (field connection transport) process)
                    (if (= (codex-bootstrap-initialize! allocator connection) 0)
                        (do
                          (store! (field context connection) (cast (ptr i8) connection))
                          (store! (field context initialized) true))
                        (do
                          (codex-close connection)
                          (store! result -1)))))))
          (sync/mutex-unlock! (field context mutex))
          (load result)))))

(defn codex-execute-persistent [(context (ptr CodexAppServerContext))
                                (request (ptr ModelRequest))
                                (emitter (ptr EventEmitter))
                                (allocator (dyn Allocator))] (-> ModelResult)
  (match (sync/mutex-lock! (field context mutex))
    (Err [failure] (model-failure "codex-app-server" 0 "could not lock Codex app-server"))
    (Ok [locked]
        (let [result
                (do
                  (codex-emit emitter request (ModelRequestStarted) (JsonNull))
                  (match (codex-open-persistent! context request emitter allocator)
                    (Err [message] (model-failure "codex-app-server" 0 message))
                    (Ok [connection]
                        (codex-run-session context request emitter allocator connection))))]
          (match result
            (ModelOk [response] 0)
            (ModelErr [failure]
                      (let [opaque (load (field context connection))]
                        (when (!= opaque (cast (ptr i8) 0))
                          (codex-close (cast (ptr CodexConnection) opaque))
                          (store! (field context connection) (cast (ptr i8) 0))
                          (store! (field context initialized) false)
                          0)
                        0)))
          (sync/mutex-unlock! (field context mutex))
          (codex-finish emitter request allocator result)))))

(defn codex-execute [(context (ptr CodexAppServerContext))
                     (request (ptr ModelRequest))
                     (emitter (ptr EventEmitter))
                     (allocator (dyn Allocator))] (-> ModelResult)
  (let [spawn-result (codex-spawn allocator)]
    (if (!= (.code spawn-result) 0)
        (model-failure "codex-app-server" 0 (.error spawn-result))
        (let [process
                (box! allocator
                     subprocess/Child
                     (load (field spawn-result process)))
              connection (box! allocator CodexConnection (zeroed CodexConnection))]
          (set! (.transport connection) process)
          (codex-execute-connection context
                                    request
                                    emitter
                                    allocator
                                    connection)))))

(impl ModelProvider CodexAppServerContext
  (provider-name [(self (ptr CodexAppServerContext))]
                 (-> (slice u8))
                 "codex-app-server")
  (provider-capabilities [(self (ptr CodexAppServerContext))]
                         (-> ProviderCapabilities)
                         (provider-capabilities-for "codex-app-server"))

  (execute-model [(self (ptr CodexAppServerContext))
                  (request (ptr ModelRequest))
                  (emitter (ptr EventEmitter))
                  (allocator (dyn Allocator))]
                 (-> ModelResult)
                 (if (.persistent self)
                     (codex-execute-persistent self request emitter allocator)
                     (codex-execute self request emitter allocator))))

(impl CodexExecutionStrategy CodexAppServerContext
  (codex-strategy-name [(self (ptr CodexAppServerContext))]
                       (-> (slice u8))
                       "codex-app-server")
  (codex-strategy-prepare! [(self (ptr CodexAppServerContext))
                            (allocator (dyn Allocator))]
                           (-> i64)
                           (codex-context-prepare-persistent! self allocator))
  (codex-strategy-execute [(self (ptr CodexAppServerContext))
                           (request (ptr ModelRequest))
                           (emitter (ptr EventEmitter))
                           (allocator (dyn Allocator))]
                          (-> ModelResult)
                          (codex-execute-persistent self request emitter allocator))
  (codex-strategy-close! [(self (ptr CodexAppServerContext))]
                         (-> i64)
                         (codex-context-close! self)))

(impl ModelProvider CodexProvider
  (provider-name [(self (ptr CodexProvider))]
                 (-> (slice u8))
                 (codex-strategy-name (load (load (field self strategy)))))
  (provider-capabilities [(self (ptr CodexProvider))]
                         (-> ProviderCapabilities)
                         (provider-capabilities-for "codex-app-server"))
  (execute-model [(self (ptr CodexProvider))
                  (request (ptr ModelRequest))
                  (emitter (ptr EventEmitter))
                  (allocator (dyn Allocator))]
                 (-> ModelResult)
                 (codex-strategy-execute (load (load (field self strategy)))
                                         request
                                         emitter
                                         allocator)))

;; Build a request that appends input to an active turn without starting a new turn.
(defn codex-steer-request [(allocator (dyn Allocator))
                           (id i64)
                           (thread-id (slice u8))
                           (turn-id (slice u8))
                           (text (slice u8))] (-> Json)
  (let [(mut item) (json-object allocator)
        (mut input) (json-array allocator)
        (mut params) (json-object allocator)]
    (json-put-string! (mut item) "type" "text")
    (json-put-string! (mut item) "text" text)
    (json-array-push! (mut input) (load item))
    (json-put-string! (mut params) "threadId" thread-id)
    (json-put-string! (mut params) "expectedTurnId" turn-id)
    (json-object-put! (mut params) "input" (load input))
    (codex-rpc-request allocator id "turn/steer" (load params))))

;; Build a cancellation request. A successful response only acknowledges the request;
;; callers confirm cancellation from the later interrupted turn/completed event.
(defn codex-interrupt-request [(allocator (dyn Allocator))
                               (id i64)
                               (thread-id (slice u8))
                               (turn-id (slice u8))] (-> Json)
  (let [(mut params) (json-object allocator)]
    (json-put-string! (mut params) "threadId" thread-id)
    (json-put-string! (mut params) "turnId" turn-id)
    (codex-rpc-request allocator id "turn/interrupt" (load params))))
