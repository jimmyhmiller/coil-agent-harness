(module harness-interactive-authorizer)

(import "coil.alloc" :as alloc :use *)
(import "coil.arraylist" :use *)
(import "coil.match" :use *)
(import "coil.slice" :use *)
(import "coil.str" :use *)
(import "harness-event" :use *)
(import "harness-event-journal" :use *)
(import "harness-authorization-mailbox" :use *)
(import "harness-json" :use *)
(import "harness-system" :use *)
(import "harness-tool" :use *)
(import "provider-common" :use *)

(defsum DurableAuthorizationDecision
  (AuthorizationPending [])
  (AuthorizationAllowed [])
  (AuthorizationRejected [(reason (slice u8))]))

;; One authorizer belongs to one live run. Tool call IDs are operation IDs within
;; that run and therefore serve as stable authorization IDs across reconnection.
(defstruct InteractiveAuthorizer
  [(allocator (ptr Allocator))
   (journal-path (slice u8))
   (emitter (ptr EventEmitter))
   (run-id (slice u8))
   (parent-operation-id (slice u8))
   (provider (slice u8))
   (model (slice u8))
   (cancellation (ptr CancellationToken))
   (mailbox (ptr AuthorizationMailbox))
   (run-deadline-monotonic-ms i64)
   (authorization-timeout-ms i64)])

(defn authorization-event? [(event Json)
                            (run-id (slice u8))
                            (authorization-id (slice u8))
                            (kind (slice u8))] (-> bool)
  (and (match (json-string-at event "run_id")
         (Some [value] (str-eq value run-id))
         (None [] false))
       (and (match (json-string-at event "operation_id")
              (Some [value] (str-eq value authorization-id))
              (None [] false))
            (match (json-string-at event "event")
              (Some [value] (str-eq value kind))
              (None [] false)))))

(defn authorization-request-sequence [(events (ref (ArrayList Json)))
                                      (run-id (slice u8))
                                      (authorization-id (slice u8))] (-> i64)
  (let [(mut found) 0
        (mut i) 0
        n (al-len [Json] (load events))]
    (loop (if (>= (load i) n)
              (break)
              (let [event (al-get [Json] (load events) (load i))]
                (when (authorization-event? event
                                            run-id
                                            authorization-id
                                            "authorization.requested")
                  (store! found (json-number-i64 (json-get event "sequence")))
                  0)
                (store! i (+ (load i) 1)))))
    (load found)))

(defn authorization-decision [(events (ref (ArrayList Json)))
                              (run-id (slice u8))
                              (authorization-id (slice u8))] (-> DurableAuthorizationDecision)
  (let [(mut i) 0
        n (al-len [Json] (load events))
        (mut decided) false
        (mut allowed) false
        (mut reason) "authorization rejected"]
    (loop (if (>= (load i) n)
              (break)
              (let [event (al-get [Json] (load events) (load i))]
                (if (authorization-event? event
                                          run-id
                                          authorization-id
                                          "authorization.decided")
                    (let [payload (json-get event "payload")]
                      (store! decided true)
                      (store! allowed
                              (match (json-string-at payload "decision")
                                (Some [value] (str-eq value "allow"))
                                (None [] false)))
                      (store! reason
                              (match (json-string-at payload "reason")
                                (Some [value] value)
                                (None [] "authorization rejected")))
                      0)
                    (when (authorization-event? event
                                                run-id
                                                authorization-id
                                                "authorization.expired")
                      (store! decided true)
                      (store! allowed false)
                      (store! reason
                              (match-else (json-get event "payload")
                                          (JsonString [value] value)
                                          (_ "authorization expired")))
                      0))
                (if (load decided)
                    (break)
                    (store! i (+ (load i) 1))))))
    (if (not (load decided))
        (AuthorizationPending)
        (if (load allowed)
            (AuthorizationAllowed)
            (AuthorizationRejected (load reason))))))

(defn authorization-request-payload [(allocator (ptr Allocator))
                                     (spec (ptr ToolSpec))
                                     (call (ptr ToolCall))] (-> Json)
  (let [(mut payload) (json-object allocator)]
    (json-put-string! (mut payload) "authorization_id" (load (field call id)))
    (json-put-string! (mut payload) "tool" (load (field call name)))
    (json-put-string! (mut payload)
                      "effect"
                      (tool-effect-name (load (field spec effect))))
    (json-put-bool! (mut payload) "idempotent" (load (field spec idempotent)))
    (json-object-put! (mut payload) "arguments" (load (field call arguments)))
    (load payload)))

(defn interactive-authorization-deadline [(self (ptr InteractiveAuthorizer))] (-> i64)
  (let [authorization-deadline (deadline-from-timeout (load (field self authorization-timeout-ms)))
        run-deadline (load (field self run-deadline-monotonic-ms))]
    (if (and (> run-deadline 0)
             (or (= authorization-deadline 0)
                 (< run-deadline authorization-deadline)))
        run-deadline
        authorization-deadline)))

(defn interactive-expire! [(self (ptr InteractiveAuthorizer))
                           (authorization-id (slice u8))
                           (reason (slice u8))] (-> AuthorizationDecision)
  (let [mailbox (load (field self mailbox))
        allocator (load (field self allocator))
        (mut result) (Reject reason)
        (mut expired) false]
    (authorization-mailbox-lock! mailbox)
    (let [recovery
            (event-journal-recover allocator
                                   (load (field self journal-path)))]
      (if (not (load (field recovery ok)))
          (store! result (Reject "authorization journal unavailable"))
          (match (authorization-decision (field recovery events)
                                         (load (field self run-id))
                                         authorization-id)
            (AuthorizationAllowed [] (store! result (Authorize)))
            (AuthorizationRejected [decision-reason]
                                   (store! result (Reject decision-reason)))
            (AuthorizationPending []
                                  (do
                                    (emit-event (load (field self emitter))
                                                (now-ms)
                                                (AuthorizationExpired)
                                                (load (field self run-id))
                                                authorization-id
                                                (load (field self parent-operation-id))
                                                (load (field self provider))
                                                (load (field self model))
                                                (JsonString reason))
                                    (store! expired true))))))
    (authorization-mailbox-unlock! mailbox)
    (when (load expired) (authorization-mailbox-notify! mailbox) 0)
    (load result)))

(defn interactive-wait-timeout [(deadline i64)] (-> i64)
  (if (> deadline 0)
      (deadline-remaining-ms deadline 0)
      60000))

(defn interactive-authorize [(self (ptr InteractiveAuthorizer))
                             (spec (ptr ToolSpec))
                             (call (ptr ToolCall))] (-> AuthorizationDecision)
  (let [allocator (load (field self allocator))
        run-id (load (field self run-id))
        authorization-id (load (field call id))
        initial (event-journal-recover allocator (load (field self journal-path)))
        deadline (interactive-authorization-deadline self)]
    (if (not (load (field initial ok)))
        (Reject "authorization journal unavailable")
        (do
          (when (= (authorization-request-sequence (field initial events)
                                                   run-id
                                                   authorization-id)
                   0)
            (emit-event (load (field self emitter))
                        (now-ms)
                        (AuthorizationRequested)
                        run-id
                        authorization-id
                        (load (field self parent-operation-id))
                        (load (field self provider))
                        (load (field self model))
                        (authorization-request-payload allocator spec call))
            0)
          (block :decision
                 (loop (let [mailbox (load (field self mailbox))]
                         (when (= mailbox (cast (ptr AuthorizationMailbox) 0))
                           (return-from :decision
                                        (Reject "authorization mailbox unavailable")))
                         (let [observed (authorization-mailbox-generation mailbox)
                               recovery
                                 (event-journal-recover allocator
                                                        (load (field self journal-path)))]
                           (when (not (load (field recovery ok)))
                             (return-from :decision
                                          (Reject "authorization journal unavailable")))
                           (match (authorization-decision (field recovery events)
                                                          run-id
                                                          authorization-id)
                             (AuthorizationAllowed []
                                                   (return-from :decision (Authorize)))
                             (AuthorizationRejected [reason]
                                                    (return-from :decision (Reject reason)))
                             (AuthorizationPending [] 0))
                           (when (cancellation-requested? (load (field self cancellation)))
                             (return-from :decision
                                          (interactive-expire! self
                                                               authorization-id
                                                               "authorization cancelled")))
                           (let [wait-ms (interactive-wait-timeout deadline)]
                             (when (= wait-ms 0)
                               (return-from :decision
                                            (interactive-expire! self
                                                                 authorization-id
                                                                 "authorization timed out")))
                             (authorization-mailbox-wait mailbox observed wait-ms))))))))))

(impl ToolAuthorizer InteractiveAuthorizer
  (authorize-tool [(self (ptr InteractiveAuthorizer))
                   (spec (ptr ToolSpec))
                   (call (ptr ToolCall))]
                  (-> AuthorizationDecision)
                  (interactive-authorize self spec call)))
