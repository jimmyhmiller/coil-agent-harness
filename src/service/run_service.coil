(module harness-run-service)

(import "coil.alloc" :as alloc :use *)
(import "coil.arraylist" :use *)
(import "coil.match" :use *)
(import "coil.slice" :use *)
(import "coil.str" :use *)
(import "harness-event" :use *)
(import "harness-event-journal" :use *)
(import "harness-json" :use *)
(import "harness-model-router" :use *)
(import "harness-run-state" :use *)
(import "harness-system" :use *)
(import "provider-common" :use *)

(defsum RunCancellationResult
  (RunCancellationAccepted [])
  (RunCancellationTerminalOrMissing [])
  (RunCancellationFailed []))

(deftrait RunController [Self]
  (prepare-durable-provider [(self (ptr Self)) (provider-name (slice u8))] (-> i64))
  (start-durable-run [(self (ptr Self)) (command (ptr Json))] (-> i64))
  ;; Enqueue control-plane cancellation without journal I/O on the caller's
  ;; input path. The controller remains responsible for durable-first ordering.
  (request-cancel-durable-run [(self (ptr Self)) (command (ptr Json))] (-> i64))
  (cancel-durable-run [(self (ptr Self)) (command (ptr Json))] (-> RunCancellationResult))
  (describe-tools [(self (ptr Self))
                   (allocator (ptr Allocator))
                   (out (ptr Json))] (-> i64))
  (authorize-tool-call [(self (ptr Self))
                        (command (ptr Json))
                        (allocator (ptr Allocator))
                        (out (ptr Json))] (-> i64))
  (invoke-tool [(self (ptr Self))
                (command (ptr Json))
                (allocator (ptr Allocator))
                (out (ptr Json))] (-> i64)))

(defstruct RunService
  [(allocator (ptr Allocator))
   (journal-path (slice u8))
   (journal (ptr EventJournal))
   (emitter (ptr EventEmitter))
   (controller (dyn RunController))])

(defstruct ServiceResponse [(status i64) (body Json)])
(defstruct ServiceHttpRequest
  [(method (slice u8))
   (target (slice u8))
   (body (slice u8))
   (principal (slice u8))
   (can-observe bool)
   (can-control bool)])

(defn service-prepare-provider! [(service (ptr RunService))
                                 (provider-name (slice u8))] (-> i64)
  (prepare-durable-provider (load (field service controller)) provider-name))

;; Dynamic calls use pointers for aggregate JSON values. Passing a sum aggregate
;; by value through a trait object is not ABI-stable across Coil backends.
(defn service-start-durable-run [(service (ptr RunService)) (command Json)] (-> i64)
  (let [command-ref (alloc/stack Json)]
    (store! command-ref command)
    (start-durable-run (load (field service controller)) command-ref)))

(defn service-cancel-durable-run [(service (ptr RunService))
                                  (command Json)] (-> RunCancellationResult)
  (let [command-ref (alloc/stack Json)]
    (store! command-ref command)
    (cancel-durable-run (load (field service controller)) command-ref)))

(defn service-request-cancel-durable-run [(service (ptr RunService))
                                          (command Json)] (-> i64)
  (let [command-ref (alloc/stack Json)]
    (store! command-ref command)
    (request-cancel-durable-run (load (field service controller)) command-ref)))

(defn service-response [(status i64) (body Json)] (-> ServiceResponse)
  (let [response (alloc/stack ServiceResponse)]
    (store! (field response status) status)
    (store! (field response body) body)
    (load response)))

(defn service-error [(allocator (ptr Allocator))
                     (status i64)
                     (code (slice u8))
                     (message (slice u8))] (-> ServiceResponse)
  (let [(mut body) (json-object allocator)]
    (json-object-put! (mut body) "version" (json-integer allocator 1))
    (json-put-string! (mut body) "error" code)
    (json-put-string! (mut body) "message" message)
    (service-response status (load body))))

(defn service-forbidden [(allocator (ptr Allocator))] (-> ServiceResponse)
  (service-error allocator
                 403
                 "forbidden"
                 "authenticated principal lacks the required capability"))

(defn service-command-actor! [(command (mut Json))
                              (principal (slice u8))] (-> i64)
  (if (json-put-string! (mut command) "actor" principal) 0 -1))

(defn service-command-agent! [(allocator (ptr Allocator))
                              (command (mut Json))] (-> i64)
  ;; Snapshot every borrowed command string before mutating the object. JSON
  ;; strings are slices, so retaining views into a mutable aggregate across
  ;; object insertions makes their lifetime and aliasing optimizer-dependent.
  (let [run-id (json-copy-string allocator (command-string (load command) "run_id"))
        parent-run-id
          (json-copy-string allocator
                            (command-string (load command) "parent_run_id"))
        actor (json-copy-string allocator (command-string (load command) "actor"))
        command-id
          (json-copy-string allocator
                            (command-string (load command) "command_id"))
        prompt (json-copy-string allocator (command-string (load command) "prompt"))
        (mut message) (json-object allocator)]
    (json-object-put! (mut message) "version" (json-integer allocator 1))
    (json-put-string! (mut message) "message_id" command-id)
    (json-put-string! (mut message)
                      "kind"
                      (if (> (slice-len [u8] parent-run-id) 0)
                          "delegation"
                          "instruction"))
    (json-put-string! (mut message)
                      "from"
                      (if (> (slice-len [u8] parent-run-id) 0) parent-run-id actor))
    (json-put-string! (mut message) "to" run-id)
    (json-put-string! (mut message) "content" prompt)
    ;; Keep command mutation as a write-only phase after all reads and message
    ;; construction are complete.
    (json-put-string! (mut command) "agent_id" run-id)
    (when (> (slice-len [u8] parent-run-id) 0)
      (json-put-string! (mut command) "parent_agent_id" parent-run-id)
      0)
    (json-object-put! (mut command) "message" (load message))
    0))

(defn command-string [(command Json) (key (slice u8))] (-> (slice u8))
  (match (json-string-at command key)
    (Some [value] value)
    (None [] "")))

(defn command-envelope-valid? [(command Json)] (-> bool)
  (and (= (json-number-i64 (json-get command "version")) 1)
       (and (> (slice-len [u8] (command-string command "command_id")) 0)
            (> (slice-len [u8] (command-string command "run_id")) 0))))

(defn create-command-valid? [(command Json)] (-> bool)
  (and (command-envelope-valid? command)
       (and (> (slice-len [u8] (command-string command "provider")) 0)
            (> (slice-len [u8] (command-string command "model")) 0))))

(defn workflow-event-run-id [(events (ref (ArrayList Json)))
                             (run-id (slice u8))
                             (workflow-id (slice u8))] (-> bool)
  (let [(mut found) false
        (mut i) 0
        n (al-len [Json] (load events))]
    (loop (if (>= (load i) n)
              (break)
              (let [event (al-get [Json] (load events) (load i))
                    payload (json-get event "payload")]
                (when (and (str-eq (command-string event "event") "run.created")
                           (and (str-eq (command-string event "run_id") run-id)
                                (str-eq (command-string payload "workflow_id") workflow-id)))
                  (store! found true)
                  (break))
                (store! i (+ (load i) 1)))))
    (load found)))

(defn workflow-dependencies-valid? [(events (ref (ArrayList Json)))
                                    (command Json)
                                    (workflow-id (slice u8))] (-> bool)
  (match (json-array-items (json-get command "depends_on"))
    (None [] false)
    (Some [items]
          (let [(mut valid) true
                (mut i) 0
                n (al-len [Json] (load items))
                run-id (command-string command "run_id")
                external
                  (match (json-bool-value (json-get command "allow_external_dependencies"))
                    (Some [enabled] enabled)
                    (None [] false))]
            (loop (if (or (>= (load i) n) (not (load valid)))
                      (break)
                      (do
                        (match-else (al-get [Json] (load items) (load i))
                                    (JsonString [dependency]
                                                (if (or (str-eq dependency run-id)
                                                        (and (not external)
                                                             (not (workflow-event-run-id events
                                                                                         dependency
                                                                                         workflow-id))))
                                                    (store! valid false)
                                                    0))
                                    (_ (store! valid false)))
                        (store! i (+ (load i) 1)))))
            (load valid)))))

(defn workflow-command-valid? [(events (ref (ArrayList Json)))
                               (command Json)] (-> bool)
  (let [workflow-id (command-string command "workflow_id")]
    (if (= (slice-len [u8] workflow-id) 0)
        (match (json-array-items (json-get command "depends_on"))
          (Some [items] false)
          (None [] true))
        (and (= (json-number-i64 (json-get command "workflow_version")) 1)
             (and (> (slice-len [u8] (command-string command "node_id")) 0)
                  (workflow-dependencies-valid? events command workflow-id))))))

(defn service-recover-into [(service (ptr RunService))
                            (allocator (ptr Allocator))] (-> JournalRecovery)
  (event-journal-recover-synchronized (load (field service journal))
                                      allocator
                                      (load (field service journal-path))))

(defn service-run-response [(service (ptr RunService))
                            (events (ref (ArrayList Json)))
                            (run-id (slice u8))
                            (status i64)] (-> ServiceResponse)
  (let [view (project-run events run-id)]
    (service-response status
                      (run-view-json (load (field service allocator)) view))))

(defn service-create-run [(service (ptr RunService))
                          (command Json)] (-> ServiceResponse)
  (let [allocator (load (field service allocator))]
    (if (not (create-command-valid? command))
        (service-error allocator 400 "invalid_command" "expected a versioned create command")
        (let [recovery (service-recover-into service allocator)
              command-id (command-string command "command_id")
              run-id (command-string command "run_id")]
          (if (not (load (field recovery ok)))
              (service-error allocator 500 "journal_recovery_failed" (load (field recovery error)))
              (if (> (journal-command-sequence (field recovery events) command-id) 0)
                  (service-run-response service (field recovery events) run-id 200)
                  (if (not (workflow-command-valid? (field recovery events) command))
                      (service-error allocator
                                     400
                                     "invalid_workflow_node"
                                     "workflow nodes require version 1, a node ID, and already-created dependencies in the same workflow")
                      (let [view (project-run (field recovery events) run-id)]
                        (match-else (load (field view status))
                                    (RunNotFound []
                                                 (let [provider (command-string command "provider")
                                                       model (command-string command "model")
                                                       parent-run-id (command-string command "parent_run_id")
                                                       parent-agent-id (command-string command "parent_agent_id")
                                                       parent-view
                                                         (project-run (field recovery events)
                                                                      parent-run-id)]
                                                   (if (and (> (slice-len [u8] parent-run-id) 0)
                                                            (match-else (load (field parent-view status))
                                                                        (RunNotFound [] true)
                                                                        (_ false)))
                                                       (service-error allocator
                                                                      404
                                                                      "parent_run_not_found"
                                                                      "delegation parent run does not exist")
                                                       (do
                                                         (emit-event (load (field service emitter))
                                                                     (now-ms)
                                                                     (RunCreated)
                                                                     run-id
                                                                     run-id
                                                                     ""
                                                                     provider
                                                                     model
                                                                     command)
                                                         (when (> (slice-len [u8] parent-run-id) 0)
                                                           (emit-event-for-agent (load (field service emitter))
                                                                                 (now-ms)
                                                                                 (AgentDelegated)
                                                                                 parent-run-id
                                                                                 parent-agent-id
                                                                                 run-id
                                                                                 parent-agent-id
                                                                                 provider
                                                                                 model
                                                                                 command)
                                                           0)
                                                         (emit-event-for-agent (load (field service emitter))
                                                                               (now-ms)
                                                                               (AgentCreated)
                                                                               run-id
                                                                               run-id
                                                                               run-id
                                                                               parent-agent-id
                                                                               provider
                                                                               model
                                                                               command)
                                                         (when (> (slice-len [u8]
                                                                             (command-string command
                                                                                             "workflow_id"))
                                                                  0)
                                                           (emit-event-for-agent (load (field service emitter))
                                                                                 (now-ms)
                                                                                 (WorkflowNodeCreated)
                                                                                 run-id
                                                                                 run-id
                                                                                 (command-string command "node_id")
                                                                                 (command-string command "workflow_id")
                                                                                 provider
                                                                                 model
                                                                                 command)
                                                           0)
                                                         (if (event-journal-failed? (load (field service journal)))
                                                             (service-error allocator
                                                                            500
                                                                            "journal_write_failed"
                                                                            "create command was not durable")
                                                             (let [remote-worker
                                                                     (str-eq (command-string command "execution_target")
                                                                             "worker")
                                                                   start-code
                                                                     (if remote-worker
                                                                         0
                                                                         (service-start-durable-run service command))
                                                                   refreshed (service-recover-into service allocator)]
                                                               (if (!= start-code 0)
                                                                   (service-error allocator
                                                                                  503
                                                                                  "run_start_failed"
                                                                                  "run was durably queued but could not start")
                                                                   (service-run-response service
                                                                                         (field refreshed events)
                                                                                         run-id
                                                                                         202))))))))
                                    (_ (service-error allocator
                                                      409
                                                      "run_exists"
                                                      "run_id already exists")))))))))))

;; Rebuild a semantic conversation from durable events. The service, rather than
;; a particular client, owns history and provider continuation handles. This also
;; makes an explicit conversation_id resumable after a process restart.
(defn service-enrich-conversation! [(service (ptr RunService))
                                    (command (mut Json))] (-> i64)
  (let [allocator (load (field service allocator))
        conversation-id (command-string (load command) "conversation_id")]
    (if (= (slice-len [u8] conversation-id) 0)
        0
        (let [recovery (service-recover-into service allocator)]
          (if (not (load (field recovery ok)))
              -1
              (let [(mut messages) (json-array allocator)
                    (mut run-ids) (zeroed (array (slice u8) 128))
                    (mut assistant-text) (zeroed (array (slice u8) 128))
                    (mut run-count) 0
                    (mut previous-response-id) ""
                    (mut provider-session-id) ""
                    (mut continuation-provider) ""
                    (mut continuation-model) ""
                    (mut continuation-cache-key) ""
                    events (field recovery events)
                    (mut i) 0
                    n (al-len [Json] (load events))]
                (loop (if (>= (load i) n)
                          (break)
                          (let [event (al-get [Json] (load events) (load i))
                                kind (command-string event "event")
                                run-id (command-string event "run_id")
                                payload (json-get event "payload")]
                            (when (and (str-eq kind "run.created")
                                       (and (str-eq (command-string payload "conversation_id")
                                                    conversation-id)
                                            (< (load run-count) 128)))
                              (let [(mut item) (json-object allocator)]
                                (json-put-string! (mut item) "role" "user")
                                (json-put-string! (mut item)
                                                  "content"
                                                  (command-string payload "prompt"))
                                (json-array-push! (mut messages) (load item)))
                              (store! (index run-ids (load run-count))
                                      (json-copy-string allocator run-id))
                              (store! (index assistant-text (load run-count)) "")
                              (store! run-count (+ (load run-count) 1))
                              0)
                            (let [(mut slot) 0
                                  (mut matched) -1]
                              (loop (if (>= (load slot) (load run-count))
                                        (break)
                                        (do
                                          (when (str-eq (load (index run-ids (load slot))) run-id)
                                            (store! matched (load slot))
                                            (break))
                                          (store! slot (+ (load slot) 1)))))
                              (when (>= (load matched) 0)
                                ;; Child completions are addressed agent messages,
                                ;; not tool polling results. Preserve them in the
                                ;; conversation as user-role input so any resumed
                                ;; parent turn receives the child identity, status,
                                ;; and output in chronological order.
                                (when (str-eq kind "agent.message.received")
                                  (let [(mut item) (json-object allocator)
                                        (mut content) (sb-new allocator)]
                                    (sb-push-str! (mut content) "<subagent-completion from=\"")
                                    (sb-push-str! (mut content) (command-string payload "from"))
                                    (sb-push-str! (mut content) "\" status=\"")
                                    (sb-push-str! (mut content) (command-string payload "status"))
                                    (sb-push-str! (mut content) "\">\n")
                                    (sb-push-str! (mut content) (command-string payload "content"))
                                    (sb-push-str! (mut content) "\n</subagent-completion>")
                                    (json-put-string! (mut item) "role" "user")
                                    (json-put-string! (mut item) "content" (sb-finish! (mut content)))
                                    (json-array-push! (mut messages) (load item)))
                                  0)
                                (when (str-eq kind "model.response.delta")
                                  (match-else payload
                                              (JsonString [text]
                                                          (store! (index assistant-text (load matched))
                                                                  (concat-or-empty allocator
                                                                                   (load (index assistant-text
                                                                                                (load matched)))
                                                                                   text)))
                                              (_ 0))
                                  0)
                                (when (or (str-eq kind "tool.call.proposed")
                                          (or (str-eq kind "tool.call.completed")
                                              (str-eq kind "tool.call.failed")))
                                  (store! (index assistant-text (load matched))
                                          (concat-or-empty allocator
                                                           (load (index assistant-text (load matched)))
                                                           (concat-or-empty allocator
                                                                            "\n[harness "
                                                                            (concat-or-empty allocator
                                                                                             kind
                                                                                             (concat-or-empty allocator
                                                                                                              " "
                                                                                                              (concat-or-empty allocator
                                                                                                                               (command-string event
                                                                                                                                               "operation_id")
                                                                                                                               (concat-or-empty allocator
                                                                                                                                                "] "
                                                                                                                                                (json-stringify allocator
                                                                                                                                                                payload))))))))
                                  0)
                                (when (str-eq kind "model.request.completed")
                                  (store! continuation-provider
                                          (json-copy-string allocator
                                                            (command-string event "provider")))
                                  (store! continuation-model
                                          (json-copy-string allocator
                                                            (command-string event "model")))
                                  (match-else payload
                                              (JsonString [response-id]
                                                          (store! previous-response-id
                                                                  (json-copy-string allocator response-id)))
                                              (_ (do
                                                   (store! continuation-cache-key
                                                           (json-copy-string allocator
                                                                             (command-string payload "cache_key")))
                                                   (store! previous-response-id
                                                           (json-copy-string allocator
                                                                             (command-string payload "response_id")))
                                                   (let [session-id
                                                           (command-string payload
                                                                           "provider_session_id")]
                                                     (when (> (slice-len [u8] session-id) 0)
                                                       (store! provider-session-id
                                                               (json-copy-string allocator session-id))
                                                       0)))))
                                  0)
                                (when (or (str-eq kind "run.completed")
                                          (or (str-eq kind "run.failed")
                                              (str-eq kind "run.cancelled")))
                                  (let [text (load (index assistant-text (load matched)))]
                                    (when (> (slice-len [u8] text) 0)
                                      (let [(mut item) (json-object allocator)]
                                        (json-put-string! (mut item) "role" "assistant")
                                        (json-put-string! (mut item) "content" text)
                                        (json-array-push! (mut messages) (load item)))
                                      0))
                                  0)))
                            (store! i (+ (load i) 1)))))
                (let [(mut current) (json-object allocator)]
                  (json-put-string! (mut current) "role" "user")
                  (json-put-string! (mut current)
                                    "content"
                                    (command-string (load command) "prompt"))
                  (json-array-push! (mut messages) (load current)))
                (json-object-put! (mut command) "messages" (load messages))
                (when (and (str-eq (command-string (load command) "provider") "openai")
                           (and (str-eq (load continuation-provider) "openai-responses")
                                (and (str-eq (load continuation-model)
                                             (command-string (load command) "model"))
                                     (> (slice-len [u8] (load previous-response-id)) 0))))
                  (json-put-string! (mut command)
                                    "previous_response_id"
                                    (load previous-response-id))
                  0)
                (when (and (str-eq (command-string (load command) "provider") "codex")
                           (and (str-eq (load continuation-provider) "codex-app-server")
                                (and (str-eq (load continuation-model)
                                             (command-string (load command) "model"))
                                     (> (slice-len [u8] (load provider-session-id)) 0))))
                  (json-put-string! (mut command)
                                    "provider_session_id"
                                    (load provider-session-id))
                  0)
                (when (or (> (slice-len [u8]
                                        (command-string (load command)
                                                        "previous_response_id"))
                             0)
                          (> (slice-len [u8]
                                        (command-string (load command)
                                                        "provider_session_id"))
                             0))
                  (json-put-string! (mut command)
                                    "continuation_cache_key"
                                    (load continuation-cache-key))
                  0)
                0))))))

;; Transport-neutral run submission shared by HTTP, the TUI, and orchestration
;; tools. Every caller receives the same actor, agent, routing, and admission rules.
(defn service-inherit-parent-route! [(service (ptr RunService))
                                     (command (mut Json))] (-> i64)
  (let [allocator (load (field service allocator))
        parent-run-id (command-string (load command) "parent_run_id")]
    (if (= (slice-len [u8] parent-run-id) 0)
        0
        (let [recovery (service-recover-into service allocator)]
          (if (not (load (field recovery ok)))
              -1
              (let [events (field recovery events)
                    requested-provider (command-string (load command) "provider")
                    requested-model (command-string (load command) "model")
                    inherit-provider
                      (or (= (slice-len [u8] requested-provider) 0)
                          (str-eq requested-provider "auto"))
                    inherit-model
                      (or (= (slice-len [u8] requested-model) 0)
                          (str-eq requested-model "auto"))
                    (mut i) (al-len [Json] (load events))
                    (mut found) false]
                (loop (if (<= (load i) 0)
                          (break)
                          (do
                            (store! i (- (load i) 1))
                            (let [event (al-get [Json] (load events) (load i))]
                              (when (and (str-eq (command-string event "event") "run.created")
                                         (str-eq (command-string event "run_id") parent-run-id))
                                (let [parent (json-get event "payload")]
                                  (when inherit-provider
                                    (json-put-string! (mut command)
                                                      "provider"
                                                      (command-string parent "provider"))
                                    0)
                                  (when inherit-model
                                    (json-put-string! (mut command)
                                                      "model"
                                                      (if (or inherit-provider
                                                              (str-eq requested-provider
                                                                      (command-string parent "provider")))
                                                          (command-string parent "model")
                                                          (route-default-model requested-provider)))
                                    0)
                                  (json-put-string! (mut command)
                                                    "routing_profile"
                                                    (command-string parent "routing_profile"))
                                  ;; Delegation inherits routing, never conversational
                                  ;; identity. A child is a clean-slate agent whose
                                  ;; conversation persists independently of its parent
                                  ;; and siblings. Retain the parent's identity only as
                                  ;; an explicit address for completion notification.
                                  (json-put-string! (mut command)
                                                    "parent_conversation_id"
                                                    (command-string parent "conversation_id"))
                                  (json-put-string! (mut command)
                                                    "conversation_id"
                                                    (concat-or-empty allocator
                                                                     "agent:"
                                                                     (command-string (load command)
                                                                                     "run_id")))
                                  (store! found true)
                                  (break)))))))
                0))))))

(defn service-submit-run [(service (ptr RunService))
                          (command (mut Json))
                          (actor (slice u8))] (-> ServiceResponse)
  (let [allocator (load (field service allocator))
        ;; Commands cross a lifetime boundary here. Keep the caller's request or
        ;; TUI arena out of the durable service object graph.
        (mut owned-command) (json-clone allocator (load command))]
    (service-command-actor! (mut owned-command) actor)
    (service-command-agent! allocator (mut owned-command))
    (service-inherit-parent-route! service (mut owned-command))
    (match (model-route-command! allocator (mut owned-command))
      (ModelRouteSelected []
                          (do
                            (service-enrich-conversation! service (mut owned-command))
                            (service-create-run service (load owned-command))))
      (ModelRouteRejected [message]
                          (service-error allocator 400 "routing_rejected" message)))))

(defn service-cancel-run [(service (ptr RunService))
                          (command Json)] (-> ServiceResponse)
  (let [allocator (load (field service allocator))]
    (if (not (command-envelope-valid? command))
        (service-error allocator 400 "invalid_command" "expected a versioned cancellation command")
        (let [recovery (service-recover-into service allocator)
              command-id (command-string command "command_id")
              run-id (command-string command "run_id")]
          (if (not (load (field recovery ok)))
              (service-error allocator 500 "journal_recovery_failed" (load (field recovery error)))
              (if (> (journal-command-sequence (field recovery events) command-id) 0)
                  (service-run-response service (field recovery events) run-id 200)
                  (let [view (project-run (field recovery events) run-id)]
                    (match-else (load (field view status))
                                (RunNotFound []
                                             (service-error allocator 404 "run_not_found" "run does not exist"))
                                (RunSucceeded []
                                              (service-error allocator 409 "run_terminal" "run is already terminal"))
                                (RunErrored []
                                            (service-error allocator 409 "run_terminal" "run is already terminal"))
                                (RunCancelledStatus []
                                                    (service-error allocator
                                                                   409
                                                                   "run_terminal"
                                                                   "run is already terminal"))
                                (_ (match (service-cancel-durable-run service command)
                                     (RunCancellationAccepted []
                                                              (let [refreshed (service-recover-into service allocator)]
                                                                (service-run-response service
                                                                                      (field refreshed events)
                                                                                      run-id
                                                                                      202)))
                                     (RunCancellationTerminalOrMissing []
                                                                       (let [refreshed
                                                                               (service-recover-into service allocator)
                                                                             refreshed-view
                                                                               (project-run (field refreshed events)
                                                                                            run-id)]
                                                                         (if (load (field refreshed-view terminal))
                                                                             (service-error allocator
                                                                                            409
                                                                                            "run_terminal"
                                                                                            "run is already terminal")
                                                                             (service-error allocator
                                                                                            503
                                                                                            "run_not_active"
                                                                                            "run has no active controller state"))))
                                     (RunCancellationFailed []
                                                            (service-error allocator
                                                                           500
                                                                           "journal_write_failed"
                                                                           "cancellation command was not durable"))))))))))))

(defn service-query-run [(service (ptr RunService))
                         (run-id (slice u8))] (-> ServiceResponse)
  (let [allocator (load (field service allocator))
        recovery (service-recover-into service allocator)]
    (if (not (load (field recovery ok)))
        (service-error allocator 500 "journal_recovery_failed" (load (field recovery error)))
        (let [view (project-run (field recovery events) run-id)]
          (match-else (load (field view status))
                      (RunNotFound []
                                   (service-error allocator 404 "run_not_found" "run does not exist"))
                      (_ (service-response 200 (run-view-json allocator view))))))))

(defn service-query-events [(service (ptr RunService))
                            (run-id (slice u8))
                            (after-sequence i64)] (-> ServiceResponse)
  (let [allocator (load (field service allocator))
        recovery (service-recover-into service allocator)]
    (if (not (load (field recovery ok)))
        (service-error allocator 500 "journal_recovery_failed" (load (field recovery error)))
        (let [(mut result) (json-object allocator)
              (mut events) (json-array allocator)
              source (field recovery events)
              (mut i) 0
              n (al-len [Json] (load source))]
          (loop (if (>= (load i) n)
                    (break)
                    (let [event (al-get [Json] (load source) (load i))]
                      (when (and (run-event? event run-id)
                                 (> (json-number-i64 (json-get event "sequence"))
                                    after-sequence))
                        (json-array-push! (mut events) event)
                        0)
                      (store! i (+ (load i) 1)))))
          (json-object-put! (mut result) "version" (json-integer allocator 1))
          (json-put-string! (mut result) "run_id" run-id)
          (json-object-put! (mut result) "events" (load events))
          (json-object-put! (mut result)
                            "next_cursor"
                            (json-integer allocator
                                          (load (field recovery last-sequence))))
          (service-response 200 (load result))))))

(defn service-query-workflow [(service (ptr RunService))
                              (workflow-id (slice u8))] (-> ServiceResponse)
  (let [allocator (load (field service allocator))
        recovery (service-recover-into service allocator)]
    (if (not (load (field recovery ok)))
        (service-error allocator 500 "journal_recovery_failed" (load (field recovery error)))
        (let [(mut result) (json-object allocator)
              (mut nodes) (json-array allocator)
              events (field recovery events)
              (mut i) 0
              n (al-len [Json] (load events))]
          (loop (if (>= (load i) n)
                    (break)
                    (let [event (al-get [Json] (load events) (load i))
                          payload (json-get event "payload")]
                      (when (and (str-eq (command-string event "event") "run.created")
                                 (str-eq (command-string payload "workflow_id") workflow-id))
                        (let [run-id (command-string event "run_id")
                              (mut node) (run-view-json allocator (project-run events run-id))]
                          (json-put-string! (mut node) "node_id" (command-string payload "node_id"))
                          (json-object-put! (mut node)
                                            "depends_on"
                                            (json-clone allocator (json-get payload "depends_on")))
                          (json-array-push! (mut nodes) (load node)))
                        0)
                      (store! i (+ (load i) 1)))))
          (if (= (json-array-length (load nodes)) 0)
              (service-error allocator 404 "workflow_not_found" "workflow does not exist")
              (do
                (json-object-put! (mut result) "version" (json-integer allocator 1))
                (json-put-string! (mut result) "workflow_id" workflow-id)
                (json-object-put! (mut result) "nodes" (load nodes))
                (service-response 200 (load result))))))))

(defn supervisor-command-valid? [(command Json) (field-name (slice u8))] (-> bool)
  (and (= (json-number-i64 (json-get command "version")) 1)
       (and (> (slice-len [u8] (command-string command "command_id")) 0)
            (and (> (slice-len [u8] (command-string command "run_id")) 0)
                 (> (slice-len [u8] (command-string command field-name)) 0)))))

;; Zero means unseen, one requested, two applied, and three rejected. Intervention
;; idempotency is based on the completed state, not merely the first audit record.
(defn supervisor-intervention-state [(events (ref (ArrayList Json)))
                                     (command-id (slice u8))] (-> i64)
  (let [(mut state) 0
        (mut i) 0
        n (al-len [Json] (load events))]
    (loop (if (>= (load i) n)
              (break)
              (let [event (al-get [Json] (load events) (load i))
                    payload (json-get event "payload")]
                (when (str-eq (command-string payload "command_id") command-id)
                  (let [kind (command-string event "event")]
                    (cond (str-eq kind "supervisor.intervention.applied") (store! state 2)
                          (str-eq kind "supervisor.intervention.rejected") (store! state 3)
                          (and (= (load state) 0)
                               (str-eq kind "supervisor.intervention.requested"))
                            (store! state 1)
                          :else 0))
                  0)
                (store! i (+ (load i) 1)))))
    (load state)))

(defn service-emit-intervention-result [(service (ptr RunService))
                                        (command Json)
                                        (view (ref DurableRunView))
                                        (kind EventKind)] (-> i64)
  (emit-event (load (field service emitter))
              (now-ms)
              kind
              (command-string command "run_id")
              (command-string command "command_id")
              ""
              (load (field view provider))
              (load (field view model))
              command))

(defn service-apply-intervention [(service (ptr RunService))
                                  (command Json)
                                  (events (ref (ArrayList Json)))
                                  (intervention-state i64)] (-> ServiceResponse)
  (let [allocator (load (field service allocator))
        run-id (command-string command "run_id")
        view (project-run events run-id)]
    (match-else (load (field view status))
                (RunNotFound [] (service-error allocator 404 "run_not_found" "run does not exist"))
                (RunSucceeded [] (service-error allocator 409 "run_terminal" "run is already terminal"))
                (RunErrored [] (service-error allocator 409 "run_terminal" "run is already terminal"))
                (RunCancelledStatus [] (service-error allocator 409 "run_terminal" "run is already terminal"))
                (_ (let [requested
                           (if (= intervention-state 1)
                               1
                               (service-emit-intervention-result service
                                                                 command
                                                                 view
                                                                 (SupervisorInterventionRequested)))]
                     (if (< requested 0)
                         (service-error allocator
                                        500
                                        "intervention_failed"
                                        "intervention request was not durable")
                         (match (service-cancel-durable-run service command)
                           (RunCancellationAccepted []
                                                    (if (< (service-emit-intervention-result service
                                                                                             command
                                                                                             view
                                                                                             (SupervisorInterventionApplied))
                                                           0)
                                                        (service-error allocator
                                                                       500
                                                                       "intervention_failed"
                                                                       "intervention result was not durable")
                                                        (let [refreshed (service-recover-into service allocator)]
                                                          (service-run-response service
                                                                                (field refreshed events)
                                                                                run-id
                                                                                202))))
                           (RunCancellationTerminalOrMissing []
                                                             (if (< (service-emit-intervention-result service
                                                                                                      command
                                                                                                      view
                                                                                                      (SupervisorInterventionRejected))
                                                                    0)
                                                                 (service-error allocator
                                                                                500
                                                                                "intervention_failed"
                                                                                "intervention result was not durable")
                                                                 (service-error allocator
                                                                                409
                                                                                "intervention_rejected"
                                                                                "run could not be cancelled")))
                           (RunCancellationFailed []
                                                  (service-error allocator
                                                                 500
                                                                 "intervention_failed"
                                                                 "intervention was not durable")))))))))

(defn service-record-assessment [(service (ptr RunService))
                                 (command Json)] (-> ServiceResponse)
  (let [allocator (load (field service allocator))
        recovery (service-recover-into service allocator)
        run-id (command-string command "run_id")]
    (if (not (supervisor-command-valid? command "verdict"))
        (service-error allocator 400 "invalid_assessment" "assessment requires a verdict")
        (if (not (load (field recovery ok)))
            (service-error allocator 500 "journal_recovery_failed" (load (field recovery error)))
            (if (> (journal-command-sequence (field recovery events)
                                             (command-string command "command_id"))
                   0)
                (service-query-events service run-id 0)
                (let [view (project-run (field recovery events) run-id)]
                  (match-else (load (field view status))
                              (RunNotFound []
                                           (service-error allocator 404 "run_not_found" "run does not exist"))
                              (_ (if (< (emit-event (load (field service emitter))
                                                    (now-ms)
                                                    (SupervisorAssessmentRecorded)
                                                    run-id
                                                    (command-string command "command_id")
                                                    ""
                                                    (load (field view provider))
                                                    (load (field view model))
                                                    command)
                                        0)
                                     (service-error allocator
                                                    500
                                                    "journal_write_failed"
                                                    "assessment was not durable")
                                     (service-response 202 command))))))))))

(defn service-request-intervention [(service (ptr RunService))
                                    (command Json)] (-> ServiceResponse)
  (let [allocator (load (field service allocator))
        recovery (service-recover-into service allocator)
        run-id (command-string command "run_id")
        command-id (command-string command "command_id")]
    (if (or (not (supervisor-command-valid? command "action"))
            (not (str-eq (command-string command "action") "cancel")))
        (service-error allocator 400 "invalid_intervention" "supported intervention action is cancel")
        (if (not (load (field recovery ok)))
            (service-error allocator 500 "journal_recovery_failed" (load (field recovery error)))
            (let [intervention-state (supervisor-intervention-state (field recovery events) command-id)]
              (if (= intervention-state 2)
                  (service-run-response service (field recovery events) run-id 200)
                  (if (= intervention-state 3)
                      (service-error allocator
                                     409
                                     "intervention_rejected"
                                     "run could not be cancelled")
                      (service-apply-intervention service
                                                  command
                                                  (field recovery events)
                                                  intervention-state))))))))

(defn run-created-before? [(events (ref (ArrayList Json)))
                           (before i64)
                           (run-id (slice u8))] (-> bool)
  (let [(mut i) 0
        (mut found) false]
    (loop (if (>= (load i) before)
              (break)
              (let [event (al-get [Json] (load events) (load i))]
                (when (and (run-event? event run-id)
                           (match (json-string-at event "event")
                             (Some [kind] (str-eq kind "run.created"))
                             (None [] false)))
                  (store! found true)
                  0)
                (if (load found)
                    (break)
                    (store! i (+ (load i) 1))))))
    (load found)))

;; Recover all durable runs once at service startup. Queued work is safe to launch
;; because no run.started fact exists. In-flight work is never replayed blindly.
(defn service-recover-runs! [(service (ptr RunService))] (-> i64)
  (let [allocator (load (field service allocator))
        recovery (service-recover-into service allocator)]
    (if (not (load (field recovery ok)))
        -1
        (let [events (field recovery events)
              (mut i) 0
              n (al-len [Json] (load events))
              (mut recovered) 0]
          (loop (if (>= (load i) n)
                    (break)
                    (let [event (al-get [Json] (load events) (load i))
                          kind
                            (match (json-string-at event "event")
                              (Some [value] value)
                              (None [] ""))
                          run-id
                            (match (json-string-at event "run_id")
                              (Some [value] value)
                              (None [] ""))]
                      (when (and (str-eq kind "run.created")
                                 (not (run-created-before? events (load i) run-id)))
                        (let [view (project-run events run-id)]
                          (match-else (load (field view status))
                                      (RunQueued []
                                                 (let [created (json-get event "payload")]
                                                   (if (str-eq (command-string created "execution_target")
                                                               "worker")
                                                       0
                                                       (let [start-code (service-start-durable-run service created)]
                                                         (if (= start-code 0)
                                                             (store! recovered (+ (load recovered) 1))
                                                             (emit-event (load (field service emitter))
                                                                         (now-ms)
                                                                         (RunFailed)
                                                                         run-id
                                                                         run-id
                                                                         ""
                                                                         (load (field view provider))
                                                                         (load (field view model))
                                                                         (JsonString "queued run could not restart")))))))
                                      (RunRunning []
                                                  (let [created (json-get event "payload")]
                                                    (if (str-eq (command-string created "execution_target")
                                                                "worker")
                                                        (service-worker-recovery-required! service
                                                                                           run-id
                                                                                           (worker-latest-claim events
                                                                                                                run-id))
                                                        (emit-event (load (field service emitter))
                                                                    (now-ms)
                                                                    (RunFailed)
                                                                    run-id
                                                                    run-id
                                                                    ""
                                                                    (load (field view provider))
                                                                    (load (field view model))
                                                                    (JsonString "service restarted while run was in flight")))))
                                      (RunCancelling []
                                                     (emit-event (load (field service emitter))
                                                                 (now-ms)
                                                                 (RunCancelled)
                                                                 run-id
                                                                 run-id
                                                                 ""
                                                                 (load (field view provider))
                                                                 (load (field view model))
                                                                 (JsonString "cancellation confirmed by service restart")))
                                      (_ 0)))
                        0)
                      (store! i (+ (load i) 1)))))
          (if (event-journal-failed? (load (field service journal)))
              -1
              (load recovered))))))

(defn service-parse-command [(service (ptr RunService))
                             (body (slice u8))] (-> JsonParseResult)
  (json-parse (load (field service allocator)) body))

(defn service-target-parts [(target (slice u8))] (-> (slice u8))
  (subslice [u8] target 9 (slice-len [u8] target)))

(defn service-events-run-id [(rest (slice u8))] (-> (slice u8))
  (match (str-find rest "/events")
    (Some [position] (subslice [u8] rest 0 position))
    (None [] "")))

(defn service-events-cursor [(target (slice u8))] (-> i64)
  (match (str-find target "?after=")
    (None [] 0)
    (Some [position]
          (match (str-parse-int (subslice [u8] target (+ position 7) (slice-len [u8] target)))
            (Some [value] value)
            (None [] 0)))))

(defn service-cancel-run-id [(rest (slice u8))] (-> (slice u8))
  (match (str-find rest "/cancel")
    (Some [position]
          (if (= (+ position 7) (slice-len [u8] rest))
              (subslice [u8] rest 0 position)
              ""))
    (None [] "")))

(defn service-suffixed-run-id [(rest (slice u8))
                               (suffix (slice u8))] (-> (slice u8))
  (match (str-find rest suffix)
    (Some [position]
          (if (= (+ position (slice-len [u8] suffix)) (slice-len [u8] rest))
              (subslice [u8] rest 0 position)
              ""))
    (None [] "")))

(defn worker-event-for-run? [(event Json)
                             (kind (slice u8))
                             (run-id (slice u8))] (-> bool)
  (and (str-eq (command-string event "event") kind)
       (str-eq (command-string event "run_id") run-id)))

(defn worker-latest-claim [(events (ref (ArrayList Json)))
                           (run-id (slice u8))] (-> Json)
  (let [(mut result) (JsonNull)
        (mut i) 0
        n (al-len [Json] (load events))]
    (loop (if (>= (load i) n)
              (break)
              (let [event (al-get [Json] (load events) (load i))]
                (when (or (worker-event-for-run? event "worker.assignment.claimed" run-id)
                          (worker-event-for-run? event "worker.lease.renewed" run-id))
                  (store! result (json-get event "payload"))
                  0)
                (store! i (+ (load i) 1)))))
    (load result)))

(defn worker-run-finished? [(events (ref (ArrayList Json)))
                            (run-id (slice u8))] (-> bool)
  (let [(mut finished) false
        (mut i) 0
        n (al-len [Json] (load events))]
    (loop (if (or (>= (load i) n) (load finished))
              (break)
              (let [event (al-get [Json] (load events) (load i))
                    kind (command-string event "event")]
                (when (and (str-eq (command-string event "run_id") run-id)
                           (or (str-eq kind "run.completed")
                               (or (str-eq kind "run.failed")
                                   (str-eq kind "run.cancelled"))))
                  (store! finished true)
                  0)
                (store! i (+ (load i) 1)))))
    (load finished)))

(defn service-worker-recovery-required! [(service (ptr RunService))
                                         (run-id (slice u8))
                                         (lease Json)] (-> i64)
  (let [provider (command-string lease "provider")
        model (command-string lease "model")]
    (emit-event (load (field service emitter))
                (now-ms)
                (WorkerAssignmentRecoveryRequired)
                run-id
                run-id
                ""
                provider
                model
                lease)
    (emit-event (load (field service emitter))
                (now-ms)
                (RunFailed)
                run-id
                run-id
                ""
                provider
                model
                lease)
    0))

(defn service-register-worker [(service (ptr RunService))
                               (command Json)] (-> ServiceResponse)
  (let [allocator (load (field service allocator))
        worker-id (command-string command "worker_id")]
    (if (or (!= (json-number-i64 (json-get command "version")) 1)
            (= (slice-len [u8] worker-id) 0))
        (service-error allocator 400 "invalid_worker" "worker_id and version 1 are required")
        (do
          (emit-event (load (field service emitter))
                      (now-ms)
                      (WorkerRegistered)
                      worker-id
                      worker-id
                      ""
                      ""
                      ""
                      command)
          (let [(mut body) (json-object allocator)]
            (json-object-put! (mut body) "version" (json-integer allocator 1))
            (json-put-string! (mut body) "worker_id" worker-id)
            (json-put-string! (mut body) "status" "registered")
            (service-response 200 (load body)))))))

(defn worker-registered-for-agent-process? [(events (ref (ArrayList Json)))
                                            (worker-id (slice u8))] (-> bool)
  (let [(mut registered) false
        (mut i) 0
        n (al-len [Json] (load events))]
    (loop (if (>= (load i) n)
              (break)
              (let [event (al-get [Json] (load events) (load i))
                    payload (json-get event "payload")]
                (when (and (worker-event-for-run? event "worker.registered" worker-id)
                           (match (json-bool-value (json-get (json-get payload "capabilities")
                                                             "agent_process"))
                             (Some [enabled] enabled)
                             (None [] false)))
                  (store! registered true)
                  0)
                (store! i (+ (load i) 1)))))
    (load registered)))

(defn service-claim-worker-assignment [(service (ptr RunService))
                                       (command Json)] (-> ServiceResponse)
  (let [allocator (load (field service allocator))
        worker-id (command-string command "worker_id")
        command-id (command-string command "command_id")
        requested-lease-ms (json-number-i64 (json-get command "lease_ms"))
        lease-ms (if (> requested-lease-ms 0) requested-lease-ms 30000)
        recovery (service-recover-into service allocator)]
    (if (or (= (slice-len [u8] worker-id) 0)
            (= (slice-len [u8] command-id) 0))
        (service-error allocator 400 "invalid_claim" "worker_id and command_id are required")
        (if (not (load (field recovery ok)))
            (service-error allocator 500 "journal_recovery_failed" (load (field recovery error)))
            (if (not (worker-registered-for-agent-process? (field recovery events) worker-id))
                (service-error allocator
                               409
                               "worker_not_registered"
                               "worker must register the agent_process capability before claiming")
                (let [events (field recovery events)
                      (mut assignment) (JsonNull)
                      (mut replay-lease) (JsonNull)
                      (mut run-id) ""
                      (mut i) 0
                      n (al-len [Json] (load events))]
                  (loop (if (>= (load i) n)
                            (break)
                            (let [event (al-get [Json] (load events) (load i))
                                  payload (json-get event "payload")
                                  candidate (command-string event "run_id")]
                              (when (and (str-eq (command-string event "event") "run.created")
                                         (and (str-eq (command-string payload "execution_target") "worker")
                                              (not (worker-run-finished? events candidate))))
                                (let [lease (worker-latest-claim events candidate)
                                      lease-id (command-string lease "lease_id")]
                                  (if (and (str-eq lease-id command-id)
                                           (str-eq (command-string lease "worker_id") worker-id))
                                      (do
                                        (store! assignment payload)
                                        (store! replay-lease lease)
                                        (store! run-id candidate)
                                        (break))
                                      (if (= (slice-len [u8] lease-id) 0)
                                          (do
                                            (store! assignment payload)
                                            (store! run-id candidate)
                                            (break))
                                          (when (<= (json-number-i64 (json-get lease "lease_expires_at_ms"))
                                                    (now-ms))
                                            (service-worker-recovery-required! service candidate lease)
                                            0))))
                                0)
                              (store! i (+ (load i) 1)))))
                  (if (= (slice-len [u8] (load run-id)) 0)
                      (let [(mut body) (json-object allocator)]
                        (json-object-put! (mut body) "version" (json-integer allocator 1))
                        (json-put-string! (mut body) "status" "empty")
                        (service-response 200 (load body)))
                      (let [replayed (> (slice-len [u8] (command-string (load replay-lease) "lease_id")) 0)
                            lease-id command-id
                            expires-at (+ (now-ms) lease-ms)
                            (mut claim)
                              (if replayed
                                  (json-clone allocator (load replay-lease))
                                  (json-object allocator))]
                        (when (not replayed)
                          (json-object-put! (mut claim) "version" (json-integer allocator 1))
                          (json-put-string! (mut claim) "worker_id" worker-id)
                          (json-put-string! (mut claim) "lease_id" lease-id)
                          (json-put-string! (mut claim) "provider" (command-string (load assignment) "provider"))
                          (json-put-string! (mut claim) "model" (command-string (load assignment) "model"))
                          (json-object-put! (mut claim) "lease_expires_at_ms" (json-integer allocator expires-at))
                          (emit-event (load (field service emitter))
                                      (now-ms)
                                      (WorkerAssignmentClaimed)
                                      (load run-id)
                                      (load run-id)
                                      ""
                                      (command-string (load assignment) "provider")
                                      (command-string (load assignment) "model")
                                      (load claim))
                          (emit-event (load (field service emitter))
                                      (now-ms)
                                      (RunStarted)
                                      (load run-id)
                                      (load run-id)
                                      ""
                                      (command-string (load assignment) "provider")
                                      (command-string (load assignment) "model")
                                      (load claim))
                          0)
                        (json-object-put! (mut claim) "assignment" (load assignment))
                        (json-put-string! (mut claim) "run_id" (load run-id))
                        (json-put-string! (mut claim) "status" "claimed")
                        (service-response 200 (load claim))))))))))

(defn service-worker-heartbeat [(service (ptr RunService))
                                (command Json)] (-> ServiceResponse)
  (let [allocator (load (field service allocator))
        run-id (command-string command "run_id")
        worker-id (command-string command "worker_id")
        lease-id (command-string command "lease_id")
        requested-lease-ms (json-number-i64 (json-get command "lease_ms"))
        lease-ms (if (> requested-lease-ms 0) requested-lease-ms 30000)
        recovery (service-recover-into service allocator)]
    (if (not (load (field recovery ok)))
        (service-error allocator 500 "journal_recovery_failed" (load (field recovery error)))
        (let [lease (worker-latest-claim (field recovery events) run-id)]
          (if (or (not (str-eq worker-id (command-string lease "worker_id")))
                  (not (str-eq lease-id (command-string lease "lease_id"))))
              (service-error allocator 409 "lease_mismatch" "heartbeat requires the current worker lease")
              (if (<= (json-number-i64 (json-get lease "lease_expires_at_ms")) (now-ms))
                  (do
                    (service-worker-recovery-required! service run-id lease)
                    (service-error allocator 409 "lease_expired" "worker lease has expired"))
                  (let [(mut renewed) (json-object allocator)]
                    (json-object-put! (mut renewed) "version" (json-integer allocator 1))
                    (json-put-string! (mut renewed) "worker_id" worker-id)
                    (json-put-string! (mut renewed) "lease_id" lease-id)
                    (json-put-string! (mut renewed) "provider" (command-string lease "provider"))
                    (json-put-string! (mut renewed) "model" (command-string lease "model"))
                    (json-object-put! (mut renewed)
                                      "lease_expires_at_ms"
                                      (json-integer allocator (+ (now-ms) lease-ms)))
                    (emit-event (load (field service emitter))
                                (now-ms)
                                (WorkerLeaseRenewed)
                                run-id
                                run-id
                                ""
                                (command-string lease "provider")
                                (command-string lease "model")
                                (load renewed))
                    (json-put-string! (mut renewed) "status" "renewed")
                    (service-response 200 (load renewed)))))))))

(defn service-worker-complete [(service (ptr RunService))
                               (command Json)] (-> ServiceResponse)
  (let [allocator (load (field service allocator))
        run-id (command-string command "run_id")
        worker-id (command-string command "worker_id")
        lease-id (command-string command "lease_id")
        outcome (command-string command "outcome")
        recovery (service-recover-into service allocator)]
    (if (not (load (field recovery ok)))
        (service-error allocator 500 "journal_recovery_failed" (load (field recovery error)))
        (let [claim (worker-latest-claim (field recovery events) run-id)]
          (if (or (= (slice-len [u8] run-id) 0)
                  (or (not (str-eq worker-id (command-string claim "worker_id")))
                      (not (str-eq lease-id (command-string claim "lease_id")))))
              (service-error allocator 409 "lease_mismatch" "completion requires the current worker lease")
              (if (<= (json-number-i64 (json-get claim "lease_expires_at_ms")) (now-ms))
                  (do
                    (service-worker-recovery-required! service run-id claim)
                    (service-error allocator 409 "lease_expired" "worker lease has expired"))
                  (if (worker-run-finished? (field recovery events) run-id)
                      (service-run-response service (field recovery events) run-id 200)
                      (do
                        (emit-event (load (field service emitter))
                                    (now-ms)
                                    (WorkerAssignmentCompleted)
                                    run-id
                                    run-id
                                    ""
                                    (command-string command "provider")
                                    (command-string command "model")
                                    command)
                        (emit-event (load (field service emitter))
                                    (now-ms)
                                    (if (str-eq outcome "succeeded") (RunCompleted) (RunFailed))
                                    run-id
                                    run-id
                                    ""
                                    (command-string command "provider")
                                    (command-string command "model")
                                    command)
                        (let [refreshed (service-recover-into service allocator)]
                          (service-run-response service (field refreshed events) run-id 200))))))))))

(defn worker-progress-kind [(name (slice u8))] (-> EventKind)
  (cond (str-eq name "model.request.started") (ModelRequestStarted)
        (str-eq name "model.response.delta") (ModelResponseDelta)
        (str-eq name "model.request.completed") (ModelRequestCompleted)
        (str-eq name "model.request.failed") (ModelRequestFailed)
        (str-eq name "model.request.retry_scheduled") (ModelRequestRetryScheduled)
        (str-eq name "tool.call.proposed") (ToolCallProposed)
        (str-eq name "tool.call.rejected") (ToolCallRejected)
        (str-eq name "tool.call.started") (ToolCallStarted)
        (str-eq name "tool.call.completed") (ToolCallCompleted)
        (str-eq name "tool.call.failed") (ToolCallFailed)
        (str-eq name "codex.notification") (CodexNotification)
        :else (WorkerProgress)))

(defn service-worker-progress [(service (ptr RunService))
                               (command Json)] (-> ServiceResponse)
  (let [allocator (load (field service allocator))
        run-id (command-string command "run_id")
        worker-id (command-string command "worker_id")
        lease-id (command-string command "lease_id")
        recovery (service-recover-into service allocator)]
    (if (not (load (field recovery ok)))
        (service-error allocator 500 "journal_recovery_failed" (load (field recovery error)))
        (let [lease (worker-latest-claim (field recovery events) run-id)]
          (if (or (not (str-eq worker-id (command-string lease "worker_id")))
                  (not (str-eq lease-id (command-string lease "lease_id"))))
              (service-error allocator 409 "lease_mismatch" "progress requires the current worker lease")
              (if (<= (json-number-i64 (json-get lease "lease_expires_at_ms")) (now-ms))
                  (service-error allocator 409 "lease_expired" "worker lease has expired")
                  (let [remote-event (json-get command "event")
                        remote-kind (command-string remote-event "event")
                        kind (worker-progress-kind remote-kind)
                        semantic (not (str-eq (event-kind-name kind) "worker.progress"))]
                    (emit-event-for-agent (load (field service emitter))
                                          (now-ms)
                                          kind
                                          run-id
                                          run-id
                                          (if semantic
                                              (command-string remote-event "operation_id")
                                              run-id)
                                          (if semantic
                                              (command-string remote-event "parent_operation_id")
                                              "")
                                          (command-string lease "provider")
                                          (command-string lease "model")
                                          (if semantic (json-get remote-event "payload") command))
                    (let [(mut body) (json-object allocator)]
                      (json-object-put! (mut body) "version" (json-integer allocator 1))
                      (json-put-string! (mut body) "status" "recorded")
                      (service-response 202 (load body))))))))))

;; Versioned transport-neutral HTTP routing. A socket server only needs to parse one
;; request into this value and serialize the returned status/body.
(defn service-tool-plane-unavailable [(allocator (ptr Allocator))] (-> ServiceResponse)
  (service-error allocator 501 "tool_plane_unavailable"
                 "this service is not backed by a tool registry"))

(defn service-list-tools [(service (ptr RunService))] (-> ServiceResponse)
  (let [allocator (load (field service allocator))
        out (alloc/stack Json)]
    (if (< (describe-tools (load (field service controller)) allocator out) 0)
        (service-tool-plane-unavailable allocator)
        (service-response 200 (load out)))))

(defn service-authorize-tool [(service (ptr RunService)) (command Json)] (-> ServiceResponse)
  (let [allocator (load (field service allocator))
        command-ref (alloc/stack Json)
        out (alloc/stack Json)]
    (store! command-ref command)
    (if (= (slice-len [u8] (command-string command "name")) 0)
        (service-error allocator 400 "invalid_command" "a tool name is required")
        (if (< (authorize-tool-call (load (field service controller)) command-ref allocator out) 0)
            (service-tool-plane-unavailable allocator)
            (service-response 200 (load out))))))

(defn service-call-tool [(service (ptr RunService)) (command Json)] (-> ServiceResponse)
  (let [allocator (load (field service allocator))
        command-ref (alloc/stack Json)
        out (alloc/stack Json)]
    (store! command-ref command)
    (if (= (slice-len [u8] (command-string command "name")) 0)
        (service-error allocator 400 "invalid_command" "a tool name is required")
        (if (< (invoke-tool (load (field service controller)) command-ref allocator out) 0)
            (service-tool-plane-unavailable allocator)
            (service-response 200 (load out))))))

(defn service-handle-http [(service (ptr RunService))
                           (request (ptr ServiceHttpRequest))] (-> ServiceResponse)
  (let [allocator (load (field service allocator))
        method (load (field request method))
        target (load (field request target))
        principal (load (field request principal))
        can-observe (load (field request can-observe))
        can-control (load (field request can-control))]
    (cond (and (str-eq method "GET") (str-eq target "/v1/tools"))
            (if (not can-observe) (service-forbidden allocator) (service-list-tools service))
          (and (str-eq method "POST") (str-eq target "/v1/tools/authorize"))
            (if (not can-control)
                (service-forbidden allocator)
                (let [parsed (service-parse-command service (load (field request body)))]
                  (if (load (field parsed ok))
                      (service-authorize-tool service (load (field parsed value)))
                      (service-error allocator 400 "invalid_json" "request body is not valid JSON"))))
          (and (str-eq method "POST") (str-eq target "/v1/tools/call"))
            (if (not can-control)
                (service-forbidden allocator)
                (let [parsed (service-parse-command service (load (field request body)))]
                  (if (load (field parsed ok))
                      (service-call-tool service (load (field parsed value)))
                      (service-error allocator 400 "invalid_json" "request body is not valid JSON"))))
          (and (str-eq method "POST") (str-eq target "/v1/workers/register"))
            (if (not can-control)
                (service-forbidden allocator)
                (let [parsed (service-parse-command service (load (field request body)))]
                  (if (load (field parsed ok))
                      (service-register-worker service (load (field parsed value)))
                      (service-error allocator 400 "invalid_json" "request body is not valid JSON"))))
          (and (str-eq method "POST") (str-eq target "/v1/workers/claim"))
            (if (not can-control)
                (service-forbidden allocator)
                (let [parsed (service-parse-command service (load (field request body)))]
                  (if (load (field parsed ok))
                      (service-claim-worker-assignment service (load (field parsed value)))
                      (service-error allocator 400 "invalid_json" "request body is not valid JSON"))))
          (and (str-eq method "POST") (str-eq target "/v1/workers/complete"))
            (if (not can-control)
                (service-forbidden allocator)
                (let [parsed (service-parse-command service (load (field request body)))]
                  (if (load (field parsed ok))
                      (service-worker-complete service (load (field parsed value)))
                      (service-error allocator 400 "invalid_json" "request body is not valid JSON"))))
          (and (str-eq method "POST") (str-eq target "/v1/workers/heartbeat"))
            (if (not can-control)
                (service-forbidden allocator)
                (let [parsed (service-parse-command service (load (field request body)))]
                  (if (load (field parsed ok))
                      (service-worker-heartbeat service (load (field parsed value)))
                      (service-error allocator 400 "invalid_json" "request body is not valid JSON"))))
          (and (str-eq method "POST") (str-eq target "/v1/workers/progress"))
            (if (not can-control)
                (service-forbidden allocator)
                (let [parsed (service-parse-command service (load (field request body)))]
                  (if (load (field parsed ok))
                      (service-worker-progress service (load (field parsed value)))
                      (service-error allocator 400 "invalid_json" "request body is not valid JSON"))))
          (and (str-eq method "POST") (str-eq target "/v1/runs"))
            (if (not can-control)
                (service-forbidden allocator)
                (let [parsed (service-parse-command service (load (field request body)))]
                  (if (load (field parsed ok))
                      (let [(mut command) (load (field parsed value))]
                        (service-submit-run service (mut command) principal))
                      (service-error allocator 400 "invalid_json" "request body is not valid JSON"))))
          (starts-with target "/v1/workflows/")
            (if (not can-observe)
                (service-forbidden allocator)
                (if (str-eq method "GET")
                    (service-query-workflow service
                                            (subslice [u8] target 14 (slice-len [u8] target)))
                    (service-error allocator 404 "not_found" "route does not exist")))
          (starts-with target "/v1/runs/")
            (let [rest (service-target-parts target)
                  cancel-run-id (service-cancel-run-id rest)
                  events-run-id (service-events-run-id rest)
                  assessment-run-id (service-suffixed-run-id rest "/assessments")
                  intervention-run-id (service-suffixed-run-id rest "/interventions")]
              (cond (and (str-eq method "POST")
                         (> (slice-len [u8] assessment-run-id) 0))
                      (if (not can-control)
                          (service-forbidden allocator)
                          (let [parsed (service-parse-command service (load (field request body)))]
                            (if (not (load (field parsed ok)))
                                (service-error allocator 400 "invalid_json" "request body is not valid JSON")
                                (let [(mut command) (load (field parsed value))]
                                  (service-command-actor! (mut command) principal)
                                  (if (not (str-eq (command-string (load command) "run_id")
                                                   assessment-run-id))
                                      (service-error allocator
                                                     409
                                                     "run_id_mismatch"
                                                     "path and command run IDs differ")
                                      (service-record-assessment service (load command)))))))
                    (and (str-eq method "POST")
                         (> (slice-len [u8] intervention-run-id) 0))
                      (if (not can-control)
                          (service-forbidden allocator)
                          (let [parsed (service-parse-command service (load (field request body)))]
                            (if (not (load (field parsed ok)))
                                (service-error allocator 400 "invalid_json" "request body is not valid JSON")
                                (let [(mut command) (load (field parsed value))]
                                  (service-command-actor! (mut command) principal)
                                  (if (not (str-eq (command-string (load command) "run_id")
                                                   intervention-run-id))
                                      (service-error allocator
                                                     409
                                                     "run_id_mismatch"
                                                     "path and command run IDs differ")
                                      (service-request-intervention service (load command)))))))
                    (and (str-eq method "POST")
                         (> (slice-len [u8] cancel-run-id) 0))
                      (if (not can-control)
                          (service-forbidden allocator)
                          (let [parsed
                                  (service-parse-command service
                                                         (load (field request body)))]
                            (if (not (load (field parsed ok)))
                                (service-error allocator
                                               400
                                               "invalid_json"
                                               "request body is not valid JSON")
                                (let [(mut command) (load (field parsed value))]
                                  (service-command-actor! (mut command) principal)
                                  (if (not (str-eq (command-string (load command) "run_id")
                                                   cancel-run-id))
                                      (service-error allocator
                                                     409
                                                     "run_id_mismatch"
                                                     "path and command run IDs differ")
                                      (service-cancel-run service (load command)))))))
                    (and (str-eq method "GET")
                         (> (slice-len [u8] events-run-id) 0))
                      (if can-observe
                          (service-query-events service
                                                events-run-id
                                                (service-events-cursor target))
                          (service-forbidden allocator))
                    (str-eq method "GET")
                      (if can-observe
                          (service-query-run service rest)
                          (service-forbidden allocator))
                    :else (service-error allocator 405 "method_not_allowed" "method is not supported")))
          :else (service-error allocator 404 "not_found" "route does not exist"))))
