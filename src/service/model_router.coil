(module harness-model-router)

(import "coil.alloc" :as alloc :use *)
(import "coil.match" :use *)
(import "coil.slice" :use *)
(import "coil.str" :use *)
(import "harness-json" :use *)
(import "harness-model" :use *)
(import "harness-provider-config" :use *)
(import "provider-common" :use *)

(defsum ModelRouteResult
  (ModelRouteSelected [])
  (ModelRouteRejected [(message (slice u8))]))

(defn route-command-string [(command Json) (key (slice u8))] (-> (slice u8))
  (match (json-string-at command key)
    (Some [value] value)
    (None [] "")))

(defn route-command-bool [(command Json) (key (slice u8))] (-> bool)
  (match (json-bool-value (json-get command key))
    (Some [value] value)
    (None [] false)))

;; A provider is routable when the harness resolves it itself or when the operator
;; declared it. Configuration is consulted rather than assumed absent, so a declared
;; provider is a first-class routing target and not a special case bolted on after
;; the decision has already been made.
(defn route-known-provider? [(provider (slice u8))
                             (config (ptr ProviderConfig))] (-> bool)
  (if (provider-config-has? config provider)
      true
      (let [capabilities (provider-capabilities-for provider)]
        (> (.cost-tier capabilities) 0))))

;; Capabilities for either kind of provider. A declared provider describes itself;
;; a built-in one is described by the capability table.
(defn route-capabilities [(provider (slice u8))
                          (config (ptr ProviderConfig))] (-> ProviderCapabilities)
  (let [at (provider-config-find config provider)]
    (if (>= at 0)
        (configured-provider-capabilities (provider-config-at config at))
        (provider-capabilities-for provider))))

;; The model to use when a provider was pinned without one. A declared provider
;; supplies its own, which is what lets an operator pin the provider alone.
(defn route-default-model [(provider (slice u8))
                           (config (ptr ProviderConfig))] (-> (slice u8))
  (let [at (provider-config-find config provider)]
    (if (>= at 0)
        (load (field (provider-config-at config at) default-model))
        (route-builtin-default-model provider))))

(defn route-builtin-default-model [(provider (slice u8))] (-> (slice u8))
  (cond (= provider "openai") "gpt-5.6-terra"
        (= provider "openrouter") "stealth/ox-alpha"
        (= provider "deepseek-openai") "deepseek-v4-flash"
        (= provider "deepseek-anthropic") "deepseek-v4-flash"
        (= provider "codex") "gpt-5.6-terra"
        (= provider "claude") "claude-sonnet-4-6"
        :else ""))

(defn route-profile-provider [(profile (slice u8))
                              (requires-subscription bool)] (-> (slice u8))
  (cond (= profile "low-cost") (if requires-subscription "claude" "deepseek-openai")
        (= profile "quality") (if requires-subscription "claude" "openai")
        (= profile "subscription") "claude"
        (= profile "external-agent") "codex"
        (= profile "balanced") "codex"
        :else ""))

(defn route-profile-reason [(profile (slice u8))] (-> (slice u8))
  (cond (= profile "low-cost") "selected the lowest relative cost tier satisfying requirements"
        (= profile "quality") "selected the quality-preferred direct provider satisfying requirements"
        (= profile "subscription") "selected native harness tools with subscription authentication"
        (= profile "external-agent") "selected the external Codex agent capability"
        :else "selected the balanced Codex subscription policy"))

(defn route-capabilities-json [(allocator (dyn Allocator))
                               (capabilities ProviderCapabilities)] (-> Json)
  (let [(mut value) (json-object allocator)]
    (json-put-bool! (mut value) "streaming" (.streaming capabilities))
    (json-put-bool! (mut value) "harness_tools" (.harness-tools capabilities))
    (json-put-bool! (mut value) "parallel_tools" (.parallel-tools capabilities))
    (json-put-bool! (mut value) "reasoning" (.reasoning capabilities))
    (json-put-bool! (mut value) "subscription_auth" (.subscription-auth capabilities))
    (json-object-put! (mut value)
                      "cost_tier"
                      (json-integer allocator (.cost-tier capabilities)))
    (load value)))

(defn model-route-command! [(allocator (dyn Allocator))
                            (command (mut Json))
                            (config (ptr ProviderConfig))] (-> ModelRouteResult)
  (let [requested-provider (route-command-string (load command) "provider")
        requested-model (route-command-string (load command) "model")
        automatic
          (or (= (slice-len [u8] requested-provider) 0)
              (= requested-provider "auto"))
        profile-value (route-command-string (load command) "routing_profile")
        profile (if (= (slice-len [u8] profile-value) 0) "balanced" profile-value)
        requires-tools (route-command-bool (load command) "requires_harness_tools")
        requires-subscription (route-command-bool (load command) "requires_subscription")
        selected-provider
          (if automatic
              (route-profile-provider profile requires-subscription)
              requested-provider)
        selected-model
          (if automatic
              (route-default-model selected-provider config)
              requested-model)
        capabilities (route-capabilities selected-provider config)]
    (cond (= (slice-len [u8] selected-provider) 0) (ModelRouteRejected "unknown routing profile")
          (and automatic
               (and (> (slice-len [u8] requested-model) 0)
                    (not (= requested-model "auto"))))
            (ModelRouteRejected "automatic provider selection requires model to be omitted or auto")
          (and (not automatic)
               (and (not (route-known-provider? selected-provider config))
                    (or requires-tools requires-subscription)))
            (ModelRouteRejected "custom provider capabilities are unavailable for requested constraints")
          (or (= (slice-len [u8] selected-model) 0)
              (= selected-model "auto"))
            (ModelRouteRejected "model must be set when provider is pinned")
          (and requires-tools (not (load (field capabilities harness-tools))))
            (ModelRouteRejected "selected provider does not support harness-native tools")
          (and requires-subscription
               (not (load (field capabilities subscription-auth))))
            (ModelRouteRejected "selected provider does not support subscription authentication")
          :else
            (let [(mut routing) (json-object allocator)]
              (json-put-string! (mut routing) "policy" (if automatic profile "pinned"))
              (json-put-string! (mut routing) "requested_provider" requested-provider)
              (json-put-string! (mut routing) "requested_model" requested-model)
              (json-put-string! (mut routing) "selected_provider" selected-provider)
              (json-put-string! (mut routing) "selected_model" selected-model)
              (json-put-string! (mut routing)
                                "reason"
                                (if automatic
                                    (route-profile-reason profile)
                                    "caller pinned provider and model"))
              (json-object-put! (mut routing)
                                "capabilities"
                                (route-capabilities-json allocator capabilities))
              (json-put-string! (mut command) "provider" selected-provider)
              (json-put-string! (mut command) "model" selected-model)
              (json-object-put! (mut command) "routing" (load routing))
              (ModelRouteSelected)))))
