(module harness-api-description)

;;; This is the machine-readable source of truth for the public Gatekeeper
;;; surface. The route root returns it when JSON is requested, and Gatekeeper's
;;; catalog reads the same document through gk_describe.
(defn harness-api-description-json [] (-> (slice u8))
  "{\"name\":\"coil-agent-harness\",\"version\":1,\"summary\":\"Create and observe durable agent runs, invoke harness tools, or execute queued runs with an external worker.\",\"discovery\":{\"text\":\"GET /agents\",\"json\":\"GET /agents?format=json\"},\"conventions\":{\"content_type\":\"application/json for request and buffered response bodies\",\"mutation_version\":1,\"idempotency\":\"Reuse the same command_id when retrying a mutation that accepts command_id.\",\"errors\":{\"shape\":{\"error\":\"machine_readable_code\",\"message\":\"human-readable explanation\"},\"common_statuses\":[400,404,409,500,501,503]},\"events\":{\"poll_cursor\":\"Pass ?after=<sequence>; next_cursor is the durable resume position.\",\"sse_cursor\":\"Pass ?after=<sequence> or Last-Event-ID. Each event has an id; the stream closes when the run is terminal.\"}},\"quickstarts\":{\"list_tools\":{\"method\":\"GET\",\"methods\":[\"GET\"],\"path\":\"/agents/v1/tools\"},\"call_tool\":{\"method\":\"POST\",\"methods\":[\"POST\"],\"path\":\"/agents/v1/tools/call\",\"body\":{\"name\":\"echo\",\"arguments\":{\"text\":\"hello\"}}},\"create_run\":{\"method\":\"POST\",\"methods\":[\"POST\"],\"path\":\"/agents/v1/runs\",\"body\":{\"version\":1,\"command_id\":\"create-unique-id\",\"run_id\":\"run-unique-id\",\"provider\":\"codex\",\"model\":\"gpt-5.6-terra\",\"prompt\":\"Inspect the workspace and report what you find.\"}},\"create_worker_run\":{\"method\":\"POST\",\"methods\":[\"POST\"],\"path\":\"/agents/v1/runs\",\"body\":{\"version\":1,\"command_id\":\"create-worker-unique-id\",\"run_id\":\"worker-run-unique-id\",\"provider\":\"external\",\"model\":\"agent\",\"prompt\":\"Do the assigned work.\",\"execution_target\":\"worker\"}},\"inspect_run\":{\"method\":\"GET\",\"methods\":[\"GET\"],\"path\":\"/agents/v1/runs/{run_id}\"},\"poll_events\":{\"method\":\"GET\",\"methods\":[\"GET\"],\"path\":\"/agents/v1/runs/{run_id}/events?after=0\"},\"stream_events\":{\"method\":\"GET\",\"methods\":[\"GET\"],\"path\":\"/agents/v1/runs/{run_id}/events/stream?after=0\",\"response\":\"text/event-stream\"}},\"endpoints\":[{\"method\":\"GET\",\"methods\":[\"GET\"],\"path\":\"/v1/tools\",\"purpose\":\"List available tools with their descriptions, argument schemas, and effects.\"},{\"method\":\"POST\",\"methods\":[\"POST\"],\"path\":\"/v1/tools/authorize\",\"purpose\":\"Check whether a tool call is authorized without invoking it.\",\"body\":{\"required\":[\"name\"],\"optional\":[\"arguments\"]}},{\"method\":\"POST\",\"methods\":[\"POST\"],\"path\":\"/v1/tools/call\",\"purpose\":\"Invoke a registered tool. Read GET /v1/tools first for the selected tool's argument schema.\",\"body\":{\"required\":[\"name\"],\"optional\":[\"arguments\"]}},{\"method\":\"POST\",\"methods\":[\"POST\"],\"path\":\"/v1/runs\",\"purpose\":\"Create a durable run. Returns 202 for a new run and 200 for an idempotent replay.\",\"body\":{\"required\":[\"version=1\",\"command_id\",\"run_id\",\"provider\",\"model\"],\"optional\":[\"prompt\",\"execution_target=worker\",\"parent_run_id\",\"parent_agent_id\",\"conversation_id\",\"routing_profile\",\"workflow_id\",\"workflow_version=1\",\"node_id\",\"depends_on\",\"allow_external_dependencies\"]}},{\"method\":\"GET\",\"methods\":[\"GET\"],\"path\":\"/v1/runs/{run_id}\",\"purpose\":\"Return the projected durable state of a run, including status and terminal.\"},{\"method\":\"POST\",\"methods\":[\"POST\"],\"path\":\"/v1/runs/{run_id}/cancel\",\"purpose\":\"Cancel a non-terminal run. The body run_id must match the path.\",\"body\":{\"required\":[\"version=1\",\"command_id\",\"run_id\"]}},{\"method\":\"GET\",\"methods\":[\"GET\"],\"path\":\"/v1/runs/{run_id}/events\",\"purpose\":\"Read durable events after an optional numeric ?after= cursor.\",\"response\":{\"fields\":[\"version\",\"run_id\",\"events\",\"next_cursor\"]}},{\"method\":\"GET\",\"methods\":[\"GET\"],\"path\":\"/v1/runs/{run_id}/events/stream\",\"purpose\":\"Stream new durable events as SSE and close at terminal state. Resume with ?after= or Last-Event-ID.\"},{\"method\":\"POST\",\"methods\":[\"POST\"],\"path\":\"/v1/runs/{run_id}/assessments\",\"purpose\":\"Record an idempotent supervisor assessment. The body run_id must match the path.\",\"body\":{\"required\":[\"version=1\",\"command_id\",\"run_id\",\"verdict\"],\"optional\":[\"score\",\"rationale\"]}},{\"method\":\"POST\",\"methods\":[\"POST\"],\"path\":\"/v1/runs/{run_id}/interventions\",\"purpose\":\"Request an idempotent supervisor intervention; currently action must be cancel.\",\"body\":{\"required\":[\"version=1\",\"command_id\",\"run_id\",\"action=cancel\"],\"optional\":[\"reason\"]}},{\"method\":\"GET\",\"methods\":[\"GET\"],\"path\":\"/v1/workflows/{workflow_id}\",\"purpose\":\"Return the durable workflow graph projected from its runs.\"},{\"method\":\"POST\",\"methods\":[\"POST\"],\"path\":\"/v1/workers/register\",\"purpose\":\"Register an external worker before claiming runs.\",\"body\":{\"required\":[\"version=1\",\"worker_id\",\"capabilities.agent_process=true\"]}},{\"method\":\"POST\",\"methods\":[\"POST\"],\"path\":\"/v1/workers/claim\",\"purpose\":\"Claim the next queued worker run. The command_id becomes the lease_id; an empty queue returns status empty.\",\"body\":{\"required\":[\"version=1\",\"command_id\",\"worker_id\"],\"optional\":[\"lease_ms; default 30000\"]}},{\"method\":\"POST\",\"methods\":[\"POST\"],\"path\":\"/v1/workers/heartbeat\",\"purpose\":\"Renew the current unexpired lease.\",\"body\":{\"required\":[\"version=1\",\"command_id\",\"run_id\",\"worker_id\",\"lease_id\"],\"optional\":[\"lease_ms; default 30000\"]}},{\"method\":\"POST\",\"methods\":[\"POST\"],\"path\":\"/v1/workers/progress\",\"purpose\":\"Append progress from the current lease holder.\",\"body\":{\"required\":[\"version=1\",\"command_id\",\"run_id\",\"worker_id\",\"lease_id\",\"event\"]}},{\"method\":\"POST\",\"methods\":[\"POST\"],\"path\":\"/v1/workers/complete\",\"purpose\":\"Finish the current leased run. outcome=succeeded completes it; any other outcome fails it.\",\"body\":{\"required\":[\"version=1\",\"run_id\",\"worker_id\",\"lease_id\",\"outcome\"],\"optional\":[\"output\",\"provider\",\"model\"]}}],\"worker_protocol\":[\"POST /v1/workers/register with agent_process=true\",\"POST /v1/workers/claim using a fresh command_id\",\"Execute the returned assignment while renewing the lease before lease_expires_at_ms\",\"POST progress events as useful\",\"POST complete before the lease expires\"]}")

;;; The default representation is deliberately written for an agent arriving
;;; with no other project context. Paths are rooted at /agents so examples can
;;; be copied directly from the URL that supplied this guide.
(defn harness-api-description-text [] (-> (slice u8))
  "COIL AGENT HARNESS API v1\n\nThis service creates durable agent runs, exposes harness tools, and lets external workers execute queued runs. All examples below are relative to this origin and use the /agents route. Send JSON bodies with Content-Type: application/json.\n\nSTART HERE\n1. Discover the tools that are actually installed:\n   GET /agents/v1/tools\n2. Invoke one using the argument schema returned above:\n   POST /agents/v1/tools/call\n   {\"name\":\"echo\",\"arguments\":{\"text\":\"hello\"}}\n3. Create a durable run:\n   POST /agents/v1/runs\n   {\"version\":1,\"command_id\":\"create-unique-id\",\"run_id\":\"run-unique-id\",\"provider\":\"codex\",\"model\":\"gpt-5.6-terra\",\"prompt\":\"Inspect the workspace and report what you find.\"}\n4. Inspect it and follow its events:\n   GET /agents/v1/runs/{run_id}\n   GET /agents/v1/runs/{run_id}/events?after=0\n   GET /agents/v1/runs/{run_id}/events/stream?after=0\n\nRUNS\nPOST /agents/v1/runs requires version=1, unique command_id, unique run_id, provider, and model. prompt is optional. A new run returns 202; retrying the same command_id is idempotent and returns the existing run. Set execution_target to worker to queue it for an external worker instead of starting it in this process. Optional hierarchy/workflow fields are parent_run_id, parent_agent_id, conversation_id, routing_profile, workflow_id, workflow_version=1, node_id, depends_on, and allow_external_dependencies.\n\nGET /agents/v1/runs/{run_id} returns projected durable state. POST /agents/v1/runs/{run_id}/cancel takes {\"version\":1,\"command_id\":\"cancel-unique-id\",\"run_id\":\"the-same-path-id\"}.\n\nEVENTS\nThe polling endpoint returns version, run_id, events, and next_cursor. Resume with ?after=<next_cursor>. The SSE endpoint emits durable sequence values as id and event batches as data, accepts ?after=<sequence> or Last-Event-ID, sends keep-alives while idle, and closes after terminal state.\n\nWORKERS\nTo execute runs created with execution_target=worker:\n1. POST /agents/v1/workers/register\n   {\"version\":1,\"worker_id\":\"worker-unique-id\",\"capabilities\":{\"agent_process\":true}}\n2. POST /agents/v1/workers/claim\n   {\"version\":1,\"command_id\":\"lease-unique-id\",\"worker_id\":\"worker-unique-id\",\"lease_ms\":30000}\n   status=empty means there is no queued work. When claimed, command_id becomes lease_id and assignment contains the run request.\n3. Before lease_expires_at_ms, renew with POST /agents/v1/workers/heartbeat using version, a fresh command_id, run_id, worker_id, lease_id, and optional lease_ms.\n4. Report events with POST /agents/v1/workers/progress using version, a fresh command_id, run_id, worker_id, lease_id, and event.\n5. Finish with POST /agents/v1/workers/complete using version, run_id, worker_id, lease_id, outcome, and optional output. outcome=succeeded completes the run; other outcomes fail it.\n\nSUPERVISION AND WORKFLOWS\nPOST /agents/v1/runs/{run_id}/assessments requires version=1, command_id, matching run_id, and verdict; score and rationale are optional. POST /agents/v1/runs/{run_id}/interventions requires version=1, command_id, matching run_id, and action=cancel; reason is optional. GET /agents/v1/workflows/{workflow_id} returns the projected workflow graph.\n\nERRORS\nBuffered errors are JSON with error and message. Expect 400 for malformed commands, 404 for missing routes/resources, 409 for conflicts or invalid leases, 501 when no tool plane exists, and 500/503 for persistence or startup failures. Reuse command_id only when retrying the same intended mutation.\n\nMACHINE-READABLE GUIDE\nGET /agents?format=json or send Accept: application/json.\n")
