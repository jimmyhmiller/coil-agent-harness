;; The models a person can actually pick.
;;
;; `model_router.coil` answers "is this provider/model pair legal" — a predicate
;; over anything the user types. This answers a different question: "what should
;; I offer them". A router that accepts any string cannot produce a menu, and a
;; menu that listed every legal string would be useless.
;;
;; Keeping the two separate matters for one specific reason: pinning a model the
;; catalog does not list stays legal. The catalog is a curated shortlist for the
;; picker, not an allowlist, so a new model works the moment the provider serves
;; it -- you just have to type it.
(module harness-model-catalog)

(import "coil.primitive" :as primitive)

(import "coil.alloc" :as alloc :use *)
(import "coil.arraylist" :use *)
(import "coil.match" :use *)
(import "coil.slice" :use *)
(import "coil.str" :use *)
(import "harness-model" :use *)
(import "harness-provider-config" :use *)

;; Whether a model takes a reasoning-effort setting, and what it costs to get it
;; wrong. Sending `effort` to a model that does not accept it is an API error on
;; some providers, so this is a real capability flag rather than a display hint.
;;
;; `default-effort` is meaningful only when `effort` is true; every row that
;; cannot take one carries `none`, so the pair is never contradictory
;; even though the picker would ignore the field either way.
(defstruct ModelChoice
  [(provider (slice u8))
   (model (slice u8))
   (label (slice u8))
   (summary (slice u8))
   (effort bool)
   (default-effort (slice u8))])

(defstruct ModelCatalog [(choices (ArrayList ModelChoice))])

(defn model-choice [(provider (slice u8))
                    (model (slice u8))
                    (label (slice u8))
                    (summary (slice u8))
                    (effort bool)
                    (default-effort (slice u8))] (-> ModelChoice)
  (let [choice (primitive/alloc-stack ModelChoice)]
    (set! (.provider choice) provider)
    (set! (.model choice) model)
    (set! (.label choice) label)
    (set! (.summary choice) summary)
    (set! (.effort choice) effort)
    (set! (.default-effort choice) default-effort)
    (load choice)))

(defn model-catalog-new [(allocator (dyn Allocator))] (-> ModelCatalog)
  (let [catalog (primitive/alloc-stack ModelCatalog)]
    (set! (.choices catalog) (al-new [ModelChoice] allocator))
    (load catalog)))

(defn model-catalog-add! [(catalog (ptr ModelCatalog)) (choice ModelChoice)] (-> i64)
  (al-push! [ModelChoice] (mut (.choices catalog)) choice)
  0)

(defn model-catalog-count [(catalog (ptr ModelCatalog))] (-> i64)
  (al-len [ModelChoice] (.choices catalog)))

(defn model-catalog-at [(catalog (ptr ModelCatalog)) (at i64)] (-> (ptr ModelChoice))
  (al-elem [ModelChoice] (mut (.choices catalog)) at))

;; Registration order is menu order, so the list reads newest-and-strongest
;; first rather than alphabetically.
(defn model-catalog-default [(allocator (dyn Allocator))] (-> ModelCatalog)
  (let [(mut catalog) (model-catalog-new allocator)]
    (model-catalog-add! (mut catalog)
                        (model-choice "auto"
                                      "auto"
                                      "auto"
                                      "route by profile"
                                      false
                                      "none"))
    (model-catalog-add! (mut catalog)
                        (model-choice "openrouter"
                                      "stealth/ox-alpha"
                                      "OpenRouter · Ox Alpha"
                                      "free preview · agentic coding"
                                      true
                                      "max"))
    ;; Claude. Effort is `low`..`max` on the 5-series; Haiku 4.5 rejects the
    ;; parameter outright, which is why it carries effort=false rather than a
    ;; low default.
    (model-catalog-add! (mut catalog)
                        (model-choice "claude"
                                      "claude-opus-5"
                                      "Claude Opus 5"
                                      "agentic coding and long-horizon work"
                                      true
                                      "high"))
    (model-catalog-add! (mut catalog)
                        (model-choice "claude"
                                      "claude-fable-5"
                                      "Claude Fable 5"
                                      "most capable; thinking always on"
                                      true
                                      "high"))
    (model-catalog-add! (mut catalog)
                        (model-choice "claude"
                                      "claude-sonnet-5"
                                      "Claude Sonnet 5"
                                      "near-Opus quality at Sonnet cost"
                                      true
                                      "high"))
    (model-catalog-add! (mut catalog)
                        (model-choice "claude"
                                      "claude-opus-4-8"
                                      "Claude Opus 4.8"
                                      "previous Opus"
                                      true
                                      "high"))
    (model-catalog-add! (mut catalog)
                        (model-choice "claude"
                                      "claude-haiku-4-5"
                                      "Claude Haiku 4.5"
                                      "fastest; no effort setting"
                                      false
                                      "none"))
    ;; The GPT models are offered only through Codex, over the local ChatGPT
    ;; subscription. The direct OpenAI provider is deliberately absent from the
    ;; menu: it needs OPENAI_API_KEY, and offering a row that fails at request
    ;; time with an error naming an unset environment variable is worse than not
    ;; offering it. Pinning `openai` through the HTTP API still works -- the
    ;; catalog is a shortlist, not an allowlist.
    (model-catalog-add! (mut catalog)
                        (model-choice "codex"
                                      "gpt-5.6-sol"
                                      "Codex · sol"
                                      "largest"
                                      true
                                      "high"))
    (model-catalog-add! (mut catalog)
                        (model-choice "codex"
                                      "gpt-5.6-terra"
                                      "Codex · terra"
                                      "balanced"
                                      true
                                      "medium"))
    (model-catalog-add! (mut catalog)
                        (model-choice "codex"
                                      "gpt-5.6-luna"
                                      "Codex · luna"
                                      "fastest"
                                      true
                                      "low"))
    ;; DeepSeek. v4-pro is a reasoning model; v4-flash is not, so offering it an
    ;; effort level would be a control that does nothing.
    (model-catalog-add! (mut catalog)
                        (model-choice "deepseek-openai"
                                      "deepseek-v4-pro"
                                      "DeepSeek v4 pro"
                                      "reasoning · needs DEEPSEEK_API_KEY"
                                      true
                                      "medium"))
    (model-catalog-add! (mut catalog)
                        (model-choice "deepseek-openai"
                                      "deepseek-v4-flash"
                                      "DeepSeek v4 flash"
                                      "non-reasoning · needs DEEPSEEK_API_KEY"
                                      false
                                      "none"))
    (load catalog)))

;; Index of the entry matching a provider/model pair, or -1 when the current
;; selection was typed rather than picked. The picker uses this to open on
;; whatever is already selected instead of always at the top.
(defn model-catalog-find [(catalog (ptr ModelCatalog))
                          (provider (slice u8))
                          (model (slice u8))] (-> i64)
  (let [n (model-catalog-count catalog)
        (mut i) 0
        (mut found) -1]
    (loop (if (or (>= (load i) n) (>= (load found) 0))
              (break)
              (let [choice (model-catalog-at catalog (load i))]
                (when (and (= (load (field choice provider)) provider)
                           (= (load (field choice model)) model))
                  (store! found (load i))
                  0)
                (set! i (+ (load i) 1)))))
    (load found)))

;; ---------------------------------------------------------------------------
;; Effort levels
;; ---------------------------------------------------------------------------

(defstruct EffortChoice
  [(effort (slice u8))
   (label (slice u8))
   (summary (slice u8))])

(defn effort-choice [(effort (slice u8))
                     (label (slice u8))
                     (summary (slice u8))] (-> EffortChoice)
  (let [choice (primitive/alloc-stack EffortChoice)]
    (set! (.effort choice) effort)
    (set! (.label choice) label)
    (set! (.summary choice) summary)
    (load choice)))

(const EFFORT_CHOICE_COUNT 5)

;; The ladder, cheapest first. `none` is deliberately absent: turning thinking
;; off is a different decision from turning it down, it is rejected outright on
;; some models and degrades tool calling on others, and a menu row is too easy a
;; way to reach it by accident.
(defn effort-choice-at [(at i64)] (-> EffortChoice)
  (cond (= at 0) (effort-choice "low" "low" "short, scoped, latency-sensitive")
        (= at 1) (effort-choice "medium" "medium" "cost-sensitive balance")
        (= at 2) (effort-choice "high" "high" "default for most work")
        (= at 3) (effort-choice "xhigh" "xhigh" "coding and agentic work")
        :else (effort-choice "max" "max" "correctness over cost")))

(defn effort-index [(effort (slice u8))] (-> i64)
  (cond (= effort "low") 0
        (= effort "medium") 1
        (= effort "high") 2
        (= effort "xhigh") 3
        (= effort "max") 4
        :else -1))

(defn effort-from-name [(name (slice u8))] (-> (slice u8))
  (if (= (slice-len [u8] name) 0) "medium" name))

;; ---------------------------------------------------------------------------
;; Declared providers
;; ---------------------------------------------------------------------------

;; Append a row for every provider the operator declared.
;;
;; They come after the built-ins because the menu is ordered by how often a choice
;; is wanted, not by where it came from -- but they are in the menu at all, which is
;; the difference between a provider you can pick and one you have to remember the
;; name of. A declared provider with no default model is skipped rather than listed:
;; a row that cannot be selected into a working request is worse than no row.
(defn model-catalog-add-declared! [(catalog (ptr ModelCatalog))
                                   (config (ptr ProviderConfig))] (-> i64)
  (let [count (provider-config-count config)
        (mut i) 0]
    (loop (if (>= (load i) count)
              (break)
              (let [provider (provider-config-at config (load i))
                    model (load (field provider default-model))]
                (when (> (slice-len [u8] model) 0)
                  (model-catalog-add! catalog
                                      (model-choice (load (field provider name))
                                                    model
                                                    (load (field provider label))
                                                    (load (field provider summary))
                                                    ;; Effort is offered only when the
                                                    ;; entry declared a dialect that can
                                                    ;; carry it; otherwise the control
                                                    ;; would do nothing.
                                                    (not (= (load (field provider reasoning-dialect))
                                                            PROVIDER_REASONING_NONE))
                                                    (load (field provider default-effort))))
                  0)
                (set! i (+ (load i) 1))))))
  0)

;; The menu an operator actually sees: the built-in shortlist plus whatever they
;; declared.
(defn model-catalog-with-declared [(allocator (dyn Allocator))
                                   (config (ptr ProviderConfig))] (-> ModelCatalog)
  (let [(mut catalog) (model-catalog-default allocator)]
    (model-catalog-add-declared! (mut catalog) config)
    (load catalog)))
