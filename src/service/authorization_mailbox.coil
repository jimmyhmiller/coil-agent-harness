(module harness-authorization-mailbox)

(import "coil.alloc" :as alloc :use *)
(import "coil.match" :use *)
(import "coil.sync" :as sync)
(import "coil.time" :as time)

(defstruct AuthorizationMailbox [(event sync/Event)])

(defsum AuthorizationMailboxOpenResult
  (AuthorizationMailboxOpened [(mailbox AuthorizationMailbox)])
  (AuthorizationMailboxOpenFailed [(message (slice u8))]))

(defn authorization-mailbox-open [(allocator (ptr Allocator))] (-> AuthorizationMailboxOpenResult)
  (let [mailbox (alloc/stack AuthorizationMailbox)]
    (match (sync/event-init-with-allocator (field mailbox event) allocator)
      (Err [failure]
           (AuthorizationMailboxOpenFailed "could not initialize authorization mailbox"))
      (Ok [opened] (AuthorizationMailboxOpened (load mailbox))))))

(defn authorization-mailbox-generation [(mailbox (ptr AuthorizationMailbox))] (-> i64)
  (match (sync/event-generation (field mailbox event))
    (Err [failure] -1)
    (Ok [generation] generation)))

(defn authorization-mailbox-notify! [(mailbox (ptr AuthorizationMailbox))] (-> i64)
  (match (sync/event-notify-all! (field mailbox event))
    (Err [failure] -1)
    (Ok [generation] 0)))

(defn authorization-mailbox-wait [(mailbox (ptr AuthorizationMailbox))
                                  (observed-generation i64)
                                  (timeout-ms i64)] (-> bool)
  (match (time/duration-millis timeout-ms)
    (Err [failure] false)
    (Ok [duration]
        (match (sync/event-wait-for! (field mailbox event)
                                     observed-generation
                                     duration)
          (Err [failure] false)
          (Ok [result]
              (match result
                (sync/Notified [generation] true)
                (sync/Timeout [] false)))))))

;; Authorization decisions mutate journal state while holding the Event's mutex so
;; the subsequent generation bump cannot race a waiter between observation and sleep.
(defn authorization-mailbox-lock! [(mailbox (ptr AuthorizationMailbox))] (-> i64)
  (match (sync/mutex-lock! (field (field mailbox event) mutex))
    (Err [failure] -1)
    (Ok [value] 0)))

(defn authorization-mailbox-unlock! [(mailbox (ptr AuthorizationMailbox))] (-> i64)
  (match (sync/mutex-unlock! (field (field mailbox event) mutex))
    (Err [failure] -1)
    (Ok [value] 0)))

(defn authorization-mailbox-close! [(allocator (ptr Allocator))
                                    (mailbox (ptr AuthorizationMailbox))] (-> i64)
  (match (sync/event-destroy! (field mailbox event))
    (Err [failure] -1)
    (Ok [value] 0)))
