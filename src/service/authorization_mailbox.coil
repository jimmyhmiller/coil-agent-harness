(module harness-authorization-mailbox)

(import "coil.alloc" :as alloc :use *)

(extern harness_mailbox_open :cc c [] (-> (ptr i8)))
(extern harness_mailbox_generation :cc c [(ptr i8)] (-> i64))
(extern harness_mailbox_notify :cc c [(ptr i8)] (-> i64))
(extern harness_mailbox_wait :cc c [(ptr i8) i64 i64] (-> i64))
(extern harness_mailbox_lock :cc c [(ptr i8)] (-> i64))
(extern harness_mailbox_unlock :cc c [(ptr i8)] (-> i64))
(extern harness_mailbox_close :cc c [(ptr i8)] (-> i64))

(defstruct AuthorizationMailbox
  [(handle (ptr i8))])

(defsum AuthorizationMailboxOpenResult
  (AuthorizationMailboxOpened [(mailbox AuthorizationMailbox)])
  (AuthorizationMailboxOpenFailed [(message (slice u8))]))

(defn authorization-mailbox-open [(allocator (ptr Allocator))] (-> AuthorizationMailboxOpenResult)
  (let [handle (harness_mailbox_open)]
    (if (= handle (cast (ptr i8) 0))
        (AuthorizationMailboxOpenFailed "could not initialize authorization mailbox")
        (let [mailbox (alloc/stack AuthorizationMailbox)]
          (store! (field mailbox handle) handle)
          (AuthorizationMailboxOpened (load mailbox))))))

(defn authorization-mailbox-generation [(mailbox (ptr AuthorizationMailbox))] (-> i64)
  (harness_mailbox_generation (load (field mailbox handle))))

(defn authorization-mailbox-notify! [(mailbox (ptr AuthorizationMailbox))] (-> i64)
  (harness_mailbox_notify (load (field mailbox handle))))

(defn authorization-mailbox-wait [(mailbox (ptr AuthorizationMailbox))
                                  (observed-generation i64)
                                  (timeout-ms i64)] (-> bool)
  (= (harness_mailbox_wait (load (field mailbox handle))
                           observed-generation
                           timeout-ms)
     1))

(defn authorization-mailbox-lock! [(mailbox (ptr AuthorizationMailbox))] (-> i64)
  (harness_mailbox_lock (load (field mailbox handle))))

(defn authorization-mailbox-unlock! [(mailbox (ptr AuthorizationMailbox))] (-> i64)
  (harness_mailbox_unlock (load (field mailbox handle))))

(defn authorization-mailbox-close! [(allocator (ptr Allocator))
                                    (mailbox (ptr AuthorizationMailbox))] (-> i64)
  (let [handle (load (field mailbox handle))]
    (if (= handle (cast (ptr i8) 0))
        0
        (do
          (store! (field mailbox handle) (cast (ptr i8) 0))
          (harness_mailbox_close handle)))))
