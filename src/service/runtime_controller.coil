(defstruct ActiveRuntimeRun
  [(run-id (slice u8))
   (command Json)
   (handle AgentRunHandle)
   (allocation-domain (ptr AllocationDomain))])

(defstruct PendingRuntimeRun
  [(command Json)
   (allocation-domain (ptr AllocationDomain))
   (workflow i64)])

(defstruct PendingCancellation
  [(command Json)
   (allocation-domain (ptr AllocationDomain))])

(defsum RuntimeDependencyState
  (RuntimeDependenciesReady [])
  (RuntimeDependenciesWaiting [])
  (RuntimeDependenciesFailed []))

(deftrait RuntimeProviderFactory [Self]
  (prepare-runtime-provider [(self (ptr Self))
                             (allocator (dyn Allocator))
                             (provider-name (slice u8))]
                            (-> i64))
  (resolve-runtime-provider [(self (ptr Self))
                             (allocator (dyn Allocator))
                             (provider-name (slice u8))]
                            (-> (Option (dyn ModelProvider)))))

;; Declared providers are held for the life of the factory, in the same way the
;; Codex provider is, because each owns an ssh tunnel. Building one per request
;; would open and tear down a connection every turn.
(defstruct DefaultRuntimeProviderFactory
  [(tui-fixture (ptr TuiFixtureProvider))
   (codex (ptr CodexProvider))
   (agent-sdk (ptr AgentSdkContext))
   (openrouter (ptr OpenAIChatContext))
   (codex-strategy (ptr (dyn CodexExecutionStrategy)))
   (configured (ArrayList (ptr OpenAIChatContext)))
   (config ProviderConfig)
   ;; Why the declared providers could not be loaded, for the caller that owns the
   ;; process's error output. The controller does not write to a terminal itself.
   (config-error (slice u8))])

(defn default-codex-direct? [(allocator (dyn Allocator))] (-> bool)
  (match (os/env-get allocator "HARNESS_CODEX_STRATEGY")
    (Ok [found]
        (match found
          ;; Direct subscription HTTP is the product default. App Server remains
          ;; an explicit compatibility fallback.
          (Some [value] (not (= (os/owned-string-slice value) "app-server")))
          (None [] true)))
    (Err [failure] true)))

(defn default-codex-strategy [(allocator (dyn Allocator))
                              (cwd (slice u8))] (-> (ptr (dyn CodexExecutionStrategy)))
  (if (default-codex-direct? allocator)
      (let [context (box! allocator CodexDirectContext (codex-direct-context allocator))]
        (box! allocator (dyn CodexExecutionStrategy) context))
      (let [context (box! allocator CodexAppServerContext (zeroed CodexAppServerContext))]
        (codex-context-init-persistent! context allocator cwd)
        (box! allocator (dyn CodexExecutionStrategy) context))))

(defn default-runtime-provider-factory-init! [(factory (ptr DefaultRuntimeProviderFactory))
                                              (allocator (dyn Allocator))] (-> i64)
  (let [cwd-result (os/current-dir allocator)
        cwd
          (match cwd-result
            (Ok [owned] (os/owned-string-slice owned))
            (Err [failure] "."))
        strategy (default-codex-strategy allocator cwd)
        provider (box! allocator CodexProvider (zeroed CodexProvider))
        openrouter (box! allocator OpenAIChatContext
                         (openai-chat-context allocator (openrouter-config)))
        sdk-provider (box! allocator AgentSdkContext (agent-sdk-context allocator cwd))]
    (set! (.strategy provider) strategy)
    (set! (.codex-strategy factory) strategy)
    (set! (.codex factory) provider)
    (set! (.agent-sdk factory) sdk-provider)
    (set! (.openrouter factory) openrouter)
    (default-runtime-provider-factory-configure! factory allocator)))

;; Load the operator's declared providers and build a context for each.
;;
;; A malformed configuration is deliberately fatal rather than ignored: the operator
;; asked for work to run somewhere specific, and starting with those providers
;; silently missing would send it somewhere else instead.
(defn default-runtime-provider-factory-configure! [(factory (ptr DefaultRuntimeProviderFactory))
                                                   (allocator (dyn Allocator))] (-> i64)
  (set! (.configured factory) (al-new [(ptr OpenAIChatContext)] allocator))
  (set! (.config-error factory) "")
  (match (provider-config-load allocator)
    (ProviderConfigInvalid [message]
                           (do
                             (set! (.config-error factory) message)
                             -1))
    (ProviderConfigLoaded [loaded]
      (do
        (set! (.config factory) loaded)
        (let [count (provider-config-count (field factory config))
              (mut i) 0]
          (loop (if (>= (load i) count)
                    (break)
                    (do
                      (al-push! [(ptr OpenAIChatContext)]
                                (mut (.configured factory))
                                (box! allocator
                                     OpenAIChatContext
                                     (openai-chat-context allocator
                                                          (load (provider-config-at (field factory config)
                                                                                    (load i))))))
                      (set! i (+ (load i) 1)))))
        0))))
  0)

;; The declared providers, for callers that route or present them.
(defn default-runtime-provider-factory-config [(factory (ptr DefaultRuntimeProviderFactory))] (-> (ptr ProviderConfig))
  (field factory config))

;; The reason initialization failed, or "" when it did not.
(defn default-runtime-provider-factory-error [(factory (ptr DefaultRuntimeProviderFactory))] (-> (slice u8))
  (load (field factory config-error)))

(defn default-runtime-provider-factory-configured [(factory (ptr DefaultRuntimeProviderFactory))
                                                   (provider-name (slice u8))] (-> (Option (dyn ModelProvider)))
  (let [count (al-len [(ptr OpenAIChatContext)] (.configured factory))
        (mut i) 0
        (mut found) (None [(dyn ModelProvider)])]
    (loop (if (>= (load i) count)
              (break)
              (let [context (al-get [(ptr OpenAIChatContext)] (.configured factory) (load i))]
                (if (str-eq (openai-chat-name context) provider-name)
                    (do
                      (set! found (Some context))
                      (break))
                    (set! i (+ (load i) 1))))))
    (load found)))

(defn default-runtime-provider-factory-prepare! [(factory (ptr DefaultRuntimeProviderFactory))
                                                 (provider-name (slice u8))
                                                 (allocator (dyn Allocator))] (-> i64)
  (if (= provider-name "codex")
      (let [strategy (load (field factory codex-strategy))]
        (if (= strategy (cast (ptr (dyn CodexExecutionStrategy)) 0))
            -1
            (codex-strategy-prepare! (load strategy) allocator)))
      0))

(defn default-runtime-provider-factory-close! [(factory (ptr DefaultRuntimeProviderFactory))] (-> i64)
  ;; Every declared provider may be holding an ssh child; shutting the factory down
  ;; without releasing them would leave orphaned connections behind.
  (let [count (al-len [(ptr OpenAIChatContext)] (.configured factory))
        (mut i) 0]
    (loop (if (>= (load i) count)
              (break)
              (do
                (openai-chat-close! (al-get [(ptr OpenAIChatContext)] (.configured factory) (load i)))
                (set! i (+ (load i) 1))))))
  (let [strategy (load (field factory codex-strategy))]
    (when (!= strategy (cast (ptr (dyn CodexExecutionStrategy)) 0))
      (codex-strategy-close! (load strategy))
      0)
    0)
  (let [openrouter (load (field factory openrouter))]
    (when (!= openrouter (cast (ptr OpenAIChatContext) 0))
      (openai-chat-close! openrouter)
      0)
    0))

(impl RuntimeProviderFactory DefaultRuntimeProviderFactory
  (prepare-runtime-provider [(self (ptr DefaultRuntimeProviderFactory))
                             (allocator (dyn Allocator))
                             (provider-name (slice u8))]
                            (-> i64)
                            (default-runtime-provider-factory-prepare! self
                                                                       provider-name
                                                                       allocator))
  (resolve-runtime-provider [(self (ptr DefaultRuntimeProviderFactory))
                             (allocator (dyn Allocator))
                             (provider-name (slice u8))]
                            (-> (Option (dyn ModelProvider)))
                            (cond (str-eq provider-name "openai")
                                    (Some (box! allocator
                                               OpenAIResponsesContext
                                               (openai-context-default allocator)))
                                  (str-eq provider-name "openrouter")
                                    (Some (load (field self openrouter)))
                                  (str-eq provider-name "deepseek-openai")
                                    (Some (box! allocator
                                               DeepSeekOpenAIContext
                                               (deepseek-openai-context-default allocator)))
                                  (str-eq provider-name "deepseek-anthropic")
                                    (Some (box! allocator
                                               DeepSeekAnthropicContext
                                               (deepseek-anthropic-context-default allocator)))
                                  (str-eq provider-name "codex")
                                    (let [provider (load (field self codex))]
                                      (if (= provider (cast (ptr CodexProvider) 0))
                                          (None [(dyn ModelProvider)])
                                          (Some provider)))
                                  (str-eq provider-name "claude")
                                    (Some (box! allocator
                                               ClaudeAnthropicContext
                                               (claude-anthropic-context-default allocator)))
                                  (str-eq provider-name "agent-sdk")
                                    (Some (load (field self agent-sdk)))
                                  (str-eq provider-name "tui-fixture")
                                    (match (os/env-get allocator "HARNESS_TUI_TEST_PROVIDER")
                                      (Ok [found]
                                          (match found
                                            (Some [owned]
                                                  (let [(mut value) owned
                                                        enabled
                                                          (str-eq (os/owned-string-slice (load value))
                                                                  "1")]
                                                    (os/owned-string-free allocator value)
                                                    (if enabled
                                                        (Some (load (field self tui-fixture)))
                                                        (None [(dyn ModelProvider)]))))
                                            (None [] (None [(dyn ModelProvider)]))))
                                      (Err [failure] (None [(dyn ModelProvider)])))
                                  (>= (provider-config-find (field self config) provider-name) 0)
                                    (default-runtime-provider-factory-configured self provider-name)
                                  (str-eq provider-name "async-tool")
                                    (Some (box! allocator
                                               AsyncToolProvider
                                               (zeroed AsyncToolProvider)))
                                  :else (None [(dyn ModelProvider)]))))

(defstruct RuntimeRunController
  [(allocator (dyn Allocator))
   (registry (ptr ToolRegistry))
   (provider-factory (dyn RuntimeProviderFactory))
   (emitter (ptr EventEmitter))
   (journal (ptr EventJournal))
   (journal-path (slice u8))
   (runs (ArrayList ActiveRuntimeRun))
   (pending (ArrayList PendingRuntimeRun))
   (cancellations (ArrayList PendingCancellation))
   (pending-next i64)
   (state-lock (ptr i64))
   (stopping (ptr i64))
   (scheduler Thread)
   (scheduler-started bool)
   (policy AgentRunPolicy)
   (max-active-runs i64)])

(defn runtime-controller-new [(allocator (dyn Allocator))
                              (registry (ptr ToolRegistry))
                              (provider-factory (dyn RuntimeProviderFactory))
                              (emitter (ptr EventEmitter))
                              (journal (ptr EventJournal))
                              (journal-path (slice u8))] (-> RuntimeRunController)
  (let [controller (primitive/alloc-stack RuntimeRunController)]
    (set! (.allocator controller) allocator)
    (set! (.registry controller) registry)
    (set! (.provider-factory controller) provider-factory)
    (set! (.emitter controller) emitter)
    (set! (.journal controller) journal)
    (set! (.journal-path controller) journal-path)
    (set! (.runs controller) (al-new [ActiveRuntimeRun] allocator))
    (set! (.pending controller) (al-new [PendingRuntimeRun] allocator))
    (set! (.cancellations controller) (al-new [PendingCancellation] allocator))
    (set! (.pending-next controller) 0)
    (store! (field controller state-lock) (box! allocator i64 0))
    (store! (field controller stopping) (box! allocator i64 0))
    (set! (.scheduler-started controller) false)
    ;; Runs continue until completion, cancellation, a provider failure, or an
    ;; explicit deadline. Zero is the runner's unlimited-turn policy.
    (set! (.max-model-turns (.policy controller)) 0)
    (set! (.max-parallel-tools (.policy controller)) 8)
    (set! (.max-active-runs controller) 32)
    (load controller)))

(defn runtime-controller-lock! [(controller (ptr RuntimeRunController))] (-> i64)
  (let [lock (load (field controller state-lock))]
    (loop (if (= (atomic-cas lock 0 1) 0) (break) 0)))
  0)

(defn runtime-controller-unlock! [(controller (ptr RuntimeRunController))] (-> i64)
  (atomic-store (load (field controller state-lock)) 0))

;; Three unrelated things used to share one clamped number, and only one of them
;; was ever a real failure mode.
;;
;;   transport timeout  a single HTTP request to the provider. A dead socket
;;                      really can hang forever, so this one is always set.
;;   tool deadline      one tool call. Already per-tool: see the `timeout-ms`
;;                      on each ToolSpec (bash carries its own).
;;   run deadline       the whole task. NOT a failure mode -- a task taking
;;                      forty minutes is a task taking forty minutes.
;;
;; Deriving all three from one two-minute constant is why a long run looked like
;; a broken filesystem: once the run clock expired the tool executor rejected
;; every later call before running it, so a `read_text_file` that never touched
;; the disk reported a deadline error, and `spawn_subagents` handed each child
;; whatever scraps of the parent's clock remained.
;;
;; So the runtime no longer manufactures a run deadline. It is a policy the
;; caller sets per command, and absent means unlimited.
(const RUNTIME_TRANSPORT_TIMEOUT_MS 600000)

;; Monotonic deadline for the run, or 0 for none. `timeout_ms` is honoured
;; exactly as given -- no default, no ceiling. A caller that wants a bounded
;; run asks for one; nothing else imposes it.
(defn runtime-command-deadline [(command Json)] (-> i64)
  (let [value (json-number-i64 (json-get command "timeout_ms"))]
    (if (<= value 0) 0 (deadline-from-timeout value))))

(defn runtime-command-instructions [(command Json)] (-> (slice u8))
  (let [value (command-string command "instructions")]
    (if (> (str-len value) 0)
        value
        "Be concise. Use tools when they are required by the request. When starting multiple independent asynchronous operations, emit all start calls together in one response with distinct run IDs, never retry a successful start, and register exactly one notify_async call containing the complete handle set.")))

(defn runtime-command-cache-scope [(command Json)] (-> (slice u8))
  (let [conversation-id (command-string command "conversation_id")]
    (if (> (str-len conversation-id) 0)
        conversation-id
        (command-string command "run_id"))))

(defn runtime-model-request [(controller (ptr RuntimeRunController))
                             (command Json)
                             (allocator (dyn Allocator))] (-> (ptr ModelRequest))
  (let [request (box! allocator ModelRequest (zeroed ModelRequest))
        messages (box! allocator (ArrayList Message) (al-new [Message] allocator))]
    ;; Commands carry semantic messages as data. Keep the legacy prompt fallback
    ;; for non-conversation clients, but never flatten roles into prompt prose.
    (match (json-array-items (json-get command "messages"))
      (Some [items]
            (let [(mut i) 0
                  n (al-len [Json] (load items))]
              (loop (if (>= (load i) n)
                        (break)
                        (let [item (al-get [Json] (load items) (load i))
                              role (command-string item "role")
                              content (command-string item "content")
                              message (primitive/alloc-stack Message)]
                          (store! (field message role)
                                  (cond (= role "assistant") (AssistantRole)
                                        (= role "system") (SystemRole)
                                        :else (UserRole)))
                          (set! (.content message) content)
                          (al-push! [Message] messages (load message))
                          (set! i (+ (load i) 1)))))))
      (None []
            (let [message (primitive/alloc-stack Message)]
              (set! (.role message) (UserRole))
              (set! (.content message) (command-string command "prompt"))
              (al-push! [Message] messages (load message)))))
    (set! (.run-id request) (command-string command "run_id"))
    ;; A service run is watchable too, so it is speakable to: same inbox, keyed
    ;; by the run's own id.
    (set! (.inbox request) (inbox-path allocator (command-string command "run_id")))
    (set! (.operation-id request) "model-1")
    (set! (.model request) (command-string command "model"))
    (set! (.instructions request) (runtime-command-instructions command))
    (set! (.messages request) messages)
    (set! (.tools request) (load (field controller registry)))
    (set! (.tool-choice request) (ToolsAuto))
    (set! (.parallel-tool-calls request) true)
    ;; The command carries the effort the caller picked. It was hardcoded to
    ;; medium, which made the ladder unreachable from any client; an absent or
    ;; unrecognised value still lands on medium, so an older command is
    ;; unaffected. The cache key below already includes the effort name, so
    ;; changing it correctly misses the provider prompt cache.
    (set! (.reasoning request) (effort-from-name (command-string command "effort")))
    (let [(mut cache) (json-object allocator)]
      (json-object-put! (mut cache) "version" (json-integer allocator 1))
      (json-put-string! (mut cache) "provider" (command-string command "provider"))
      (json-put-string! (mut cache) "model" (.model request))
      ;; Cache routing is conversation-scoped. Sharing a provider prompt-cache
      ;; key between unrelated chats reduces prefix locality and can couple
      ;; continuation validation to the wrong conversation.
      (json-put-string! (mut cache) "conversation_id" (runtime-command-cache-scope command))
      (json-put-string! (mut cache) "instructions" (.instructions request))
      (json-put-string! (mut cache)
                        "reasoning"
                        (.reasoning request))
      (set! (.cache-key request) (json-stringify allocator (load cache))))
    (set! (.prompt-cache-key request)
          (concat-or-empty allocator
                           (command-string command "provider")
                           (concat-or-empty allocator
                                            "/"
                                            (concat-or-empty allocator
                                                             (.model request)
                                                             (concat-or-empty allocator
                                                                              "/"
                                                                              (runtime-command-cache-scope command))))))
    (set! (.max-output-tokens request) 4096)
    ;; The transport timeout bounds one HTTP request. It is deliberately not the
    ;; run's deadline: when the run has none, `model-request-remaining-ms` falls
    ;; back to this, and when it has one, the remaining run time wins.
    (set! (.timeout-ms request) RUNTIME_TRANSPORT_TIMEOUT_MS)
    (set! (.deadline-monotonic-ms request) (runtime-command-deadline command))
    (set! (.cancellation request) (cancellation-token-new allocator))
    (set! (.present (.continuation request))
          (and (= (.cache-key request) (command-string command "continuation_cache_key"))
               (or (> (str-len (command-string command "previous_response_id")) 0)
                   (> (str-len (command-string command "provider_session_id")) 0))))
    (set! (.previous-response-id (.continuation request)) (command-string command "previous_response_id"))
    (set! (.provider-session-id (.continuation request)) (command-string command "provider_session_id"))
    (set! (.previous-output (.continuation request)) (JsonNull))
    (set! (.tool-results (.continuation request)) (cast (ptr (ArrayList ToolResult)) 0))
    request))

(defn runtime-controller-notify-parent-locked! [(controller (ptr RuntimeRunController))
                                                (child-command Json)
                                                (status (slice u8))
                                                (content (slice u8))] (-> i64)
  (let [allocator (load (field controller allocator))
        child-run-id (command-string child-command "run_id")
        parent-run-id (command-string child-command "parent_run_id")
        notification-run-id (concat-or-empty allocator "notification:" child-run-id)
        (mut prompt) (sb-new allocator)
        (mut command) (json-object allocator)]
    (sb-push-str! (mut prompt)
                  "A subagent completion message was delivered. Respond to the user in context; include or synthesize the result as appropriate, and do not ask them to poll.")
    (json-object-put! (mut command) "version" (json-integer allocator 1))
    (json-put-string! (mut command)
                      "command_id"
                      (concat-or-empty allocator "notify:" child-run-id))
    (json-put-string! (mut command) "run_id" notification-run-id)
    (json-put-string! (mut command) "provider" (command-string child-command "provider"))
    (json-put-string! (mut command) "model" (command-string child-command "model"))
    (json-put-string! (mut command)
                      "conversation_id"
                      (command-string child-command "parent_conversation_id"))
    (json-put-string! (mut command) "notification_parent_run_id" parent-run-id)
    (json-put-string! (mut command) "notification_child_run_id" child-run-id)
    (json-put-string! (mut command) "actor" "agent-notification")
    (json-put-string! (mut command) "prompt" (sb-finish! (mut prompt)))
    ;; Do not race a completion continuation against the parent's current turn.
    ;; The scheduler launches this internal workflow node only after the parent
    ;; is terminal; conversation enrichment then sees the parent's final reply.
    (json-put-string! (mut command)
                      "workflow_id"
                      (concat-or-empty allocator "notifications:" parent-run-id))
    (json-object-put! (mut command) "workflow_version" (json-integer allocator 1))
    (json-put-string! (mut command) "node_id" child-run-id)
    (let [(mut dependencies) (json-array allocator)]
      (json-array-push! (mut dependencies) (JsonString parent-run-id))
      (json-object-put! (mut command) "depends_on" (load dependencies)))
    (emit-event (load (field controller emitter))
                (now-ms)
                (RunCreated)
                notification-run-id
                notification-run-id
                ""
                (command-string child-command "provider")
                (command-string child-command "model")
                (load command))
    (runtime-controller-enqueue-locked! controller (load command))))

(defn runtime-controller-reap! [(controller (ptr RuntimeRunController))] (-> i64)
  (let [(mut i) 0]
    (loop (if (>= (load i)
                  (al-len [ActiveRuntimeRun]
                          (.runs controller)))
              (break)
              (let [slot (al-elem [ActiveRuntimeRun]
                                  (field controller runs)
                                  (load i))]
                (if (agent-run-finished? (field slot handle))
                    (let [last-index
                            (- (al-len [ActiveRuntimeRun]
                                       (.runs controller))
                               1)]
                      (let [result (agent-run-join (mut (.handle slot)))
                            command (.command slot)
                            parent-run-id (command-string command "parent_run_id")]
                        (when (and (> (slice-len [u8] parent-run-id) 0)
                                   (match (json-bool-value (json-get command "notify_parent"))
                                     (Some [enabled] enabled)
                                     (None [] false)))
                          (let [(mut message) (json-object (load (field controller allocator)))]
                            (json-object-put! (mut message)
                                              "version"
                                              (json-integer (load (field controller allocator)) 1))
                            (json-put-string! (mut message) "kind" "subagent_completion")
                            (json-put-string! (mut message) "from" (load (field slot run-id)))
                            (json-put-string! (mut message) "to" parent-run-id)
                            (match result
                              (ModelOk [response]
                                       (let [response-value response]
                                         (json-put-string! (mut message) "status" "completed")
                                         (json-put-string! (mut message)
                                                           "content"
                                                           (load (field response-value output-text)))))
                              (ModelErr [failure]
                                        (let [failure-value failure]
                                          (json-put-string! (mut message) "status" "failed")
                                          (json-put-string! (mut message)
                                                            "content"
                                                            (load (field failure-value message))))))
                            (emit-event-for-agent (load (field controller emitter))
                                                  (now-ms)
                                                  (AgentMessageReceived)
                                                  parent-run-id
                                                  parent-run-id
                                                  (load (field slot run-id))
                                                  (load (field slot run-id))
                                                  (command-string command "provider")
                                                  (command-string command "model")
                                                  (load message))
                            (runtime-controller-notify-parent-locked! controller
                                                                      command
                                                                      (command-string (load message) "status")
                                                                      (command-string (load message) "content"))
                            0))
                        0)
                      (allocation-domain-close! (load (field controller allocator))
                                                (load (field slot allocation-domain)))
                      (when (!= (load i) last-index)
                        (store! slot
                                (al-get [ActiveRuntimeRun]
                                        (load (field controller runs))
                                        last-index))
                        0)
                      (al-pop! [ActiveRuntimeRun] (mut (.runs controller)))
                      0)
                    (set! i (+ (load i) 1))))))
    0))

(defn runtime-controller-active? [(controller (ptr RuntimeRunController))
                                  (run-id (slice u8))] (-> bool)
  (let [(mut i) 0
        n (al-len [ActiveRuntimeRun] (.runs controller))
        (mut found) false]
    (loop (if (>= (load i) n)
              (break)
              (let [active
                      (al-get [ActiveRuntimeRun]
                              (.runs controller)
                              (load i))]
                (if (= (.run-id active) run-id)
                    (do (set! found true) (break))
                    (set! i (+ (load i) 1))))))
    (load found)))

(defn runtime-controller-start-provider! [(controller (ptr RuntimeRunController))
                                          (command Json)
                                          (provider (dyn ModelProvider))] (-> i64)
  (let [domain (allocation-domain-open (load (field controller allocator)))]
    (if (not (allocation-domain-valid? domain))
        (do
          (allocation-domain-close! (load (field controller allocator)) domain)
          -1)
        (let [result
                (runtime-controller-start-provider-in-domain! controller
                                                              command
                                                              provider
                                                              domain)]
          (when (!= result 0)
            (allocation-domain-close! (load (field controller allocator)) domain)
            0)
          result))))

(defn runtime-controller-start-provider-in-domain! [(controller (ptr RuntimeRunController))
                                                    (command Json)
                                                    (provider (dyn ModelProvider))
                                                    (domain (ptr AllocationDomain))] (-> i64)
  (if (runtime-controller-active? controller (command-string command "run_id"))
      (do
        (allocation-domain-close! (load (field controller allocator)) domain)
        0)
      (if (>= (al-len [ActiveRuntimeRun] (.runs controller))
              (.max-active-runs controller))
          -1
          (let [run-allocator (allocation-domain-allocator domain)
                request (runtime-model-request controller command run-allocator)
                handle
                  (run-agent-background run-allocator
                                        provider
                                        request
                                        (load (field controller emitter))
                                        (.policy controller))]
            (if (not (.spawned handle))
                -1
                (let [active (primitive/alloc-stack ActiveRuntimeRun)]
                  (set! (.run-id active) (.run-id request))
                  (set! (.command active) command)
                  (set! (.handle active) handle)
                  (set! (.allocation-domain active) domain)
                  (al-push! [ActiveRuntimeRun]
                            (mut (.runs controller))
                            (load active))
                  0))))))

(defn runtime-controller-launch-domain! [(controller (ptr RuntimeRunController))
                                         (command Json)
                                         (domain (ptr AllocationDomain))] (-> i64)
  (let [owner (load (field controller allocator))
        allocator (allocation-domain-allocator domain)
        provider-name (command-string command "provider")]
    (if (not (allocation-domain-valid? domain))
        -1
        (let [(mut launch-command) (json-clone allocator command)]
          (when (= (command-string (load launch-command) "actor") "agent-notification")
            (let [temporary (primitive/alloc-stack RunService)]
              (store! (field temporary allocator) (load (field controller allocator)))
              (store! (field temporary journal-path) (load (field controller journal-path)))
              (store! (field temporary journal) (load (field controller journal)))
              (store! (field temporary emitter) (load (field controller emitter)))
              (store! (field temporary controller) controller)
              (service-enrich-conversation! temporary (mut launch-command)))
            0)
          (match (resolve-runtime-provider (.provider-factory controller)
                                           allocator
                                           provider-name)
            (Some [provider]
                  (runtime-controller-start-provider-in-domain! controller
                                                                (load launch-command)
                                                                provider
                                                                domain))
            (None [] -1))))))

(defn runtime-dependency-view-state [(view DurableRunView)
                                     (terminal-policy bool)] (-> RuntimeDependencyState)
  (match (.status view)
         (RunSucceeded [] (RuntimeDependenciesReady))
         (RunErrored []
                     (if terminal-policy
                         (RuntimeDependenciesReady)
                         (RuntimeDependenciesFailed)))
         (RunCancelledStatus []
                             (if terminal-policy
                                 (RuntimeDependenciesReady)
                                 (RuntimeDependenciesFailed)))
         (_ (RuntimeDependenciesWaiting))))

(defn runtime-command-dependency-state [(controller (ptr RuntimeRunController))
                                        (command Json)] (-> RuntimeDependencyState)
  (match (json-array-items (json-get command "depends_on"))
    (None [] (RuntimeDependenciesReady))
    (Some [items]
          (let [owner (load (field controller allocator))
                domain (allocation-domain-open owner)]
            (if (not (allocation-domain-valid? domain))
                (do
                  (allocation-domain-close! owner domain)
                  (RuntimeDependenciesWaiting))
                (let [recovery
                        (event-journal-recover (allocation-domain-allocator domain)
                                               (.journal-path controller))
                      (mut state) (RuntimeDependenciesReady)
                      terminal-policy (= (command-string command "dependency_policy") "terminal")
                      (mut i) 0
                      n (al-len [Json] (load items))]
                  (if (not (.ok recovery))
                      (set! state (RuntimeDependenciesWaiting))
                      (loop (if (>= (load i) n)
                                (break)
                                (do
                                  (match (al-get [Json] (load items) (load i))
                                         (JsonString [dependency-run-id]
                                                     (match (runtime-dependency-view-state (project-run (field recovery
                                                                                                               events)
                                                                                                        dependency-run-id)
                                                                                           terminal-policy)
                                                       (RuntimeDependenciesReady [] 0)
                                                       (RuntimeDependenciesWaiting []
                                                                                   (set! state
                                                                                         (RuntimeDependenciesWaiting)))
                                                       (RuntimeDependenciesFailed []
                                                                                  (do
                                                                                    (set! state
                                                                                          (RuntimeDependenciesFailed))
                                                                                    (break)))))
                                         (_ (do
                                              (set! state (RuntimeDependenciesFailed))
                                              (break))))
                                  (set! i (+ (load i) 1))))))
                  (let [result (load state)]
                    (allocation-domain-close! owner domain)
                    result)))))))

(defn runtime-controller-launch! [(controller (ptr RuntimeRunController))
                                  (command Json)] (-> i64)
  (runtime-controller-reap! controller)
  (let [domain (allocation-domain-open (load (field controller allocator)))
        result (runtime-controller-launch-domain! controller command domain)]
    (when (!= result 0)
      (allocation-domain-close! (load (field controller allocator)) domain)
      0)
    result))

(defn runtime-controller-pending? [(controller (ptr RuntimeRunController))
                                   (run-id (slice u8))] (-> bool)
  (let [(mut i) (.pending-next controller)
        n (al-len [PendingRuntimeRun] (.pending controller))
        (mut found) false]
    (loop (if (>= (load i) n)
              (break)
              (let [pending
                      (al-get [PendingRuntimeRun]
                              (.pending controller)
                              (load i))]
                (if (= (command-string (.command pending) "run_id") run-id)
                    (do (set! found true) (break))
                    (set! i (+ (load i) 1))))))
    (load found)))

(defn runtime-controller-enqueue-locked! [(controller (ptr RuntimeRunController))
                                          (command Json)] (-> i64)
  (let [run-id (command-string command "run_id")]
    (if (or (runtime-controller-active? controller run-id)
            (runtime-controller-pending? controller run-id))
        0
        (let [domain (allocation-domain-open (load (field controller allocator)))]
          (if (not (allocation-domain-valid? domain))
              (do
                (allocation-domain-close! (load (field controller allocator)) domain)
                -1)
              (let [pending (primitive/alloc-stack PendingRuntimeRun)]
                (set! (.command pending) (json-clone (allocation-domain-allocator domain) command))
                (set! (.allocation-domain pending) domain)
                (set! (.workflow pending) (if (> (str-len (command-string command "workflow_id")) 0) 1 0))
                (al-push! [PendingRuntimeRun]
                          (mut (.pending controller))
                          (load pending))
                0))))))

(defn runtime-controller-fail-launch! [(controller (ptr RuntimeRunController))
                                       (command Json)] (-> i64)
  (emit-event (load (field controller emitter))
              (now-ms)
              (RunFailed)
              (command-string command "run_id")
              (command-string command "run_id")
              ""
              (command-string command "provider")
              (command-string command "model")
              (JsonString "queued run could not start")))

;; Returns one only when the head node must remain queued for its predecessors.
(defn runtime-controller-process-pending! [(controller (ptr RuntimeRunController))
                                           (pending PendingRuntimeRun)] (-> i64)
  (let [command (.command pending)
        domain (load (field pending allocation-domain))]
    (match (runtime-command-dependency-state controller command)
      (RuntimeDependenciesWaiting [] 1)
      (RuntimeDependenciesFailed []
                                 (do
                                   (emit-event-for-agent (load (field controller emitter))
                                                         (now-ms)
                                                         (WorkflowNodeSkipped)
                                                         (command-string command "run_id")
                                                         (command-string command "run_id")
                                                         (command-string command "node_id")
                                                         (command-string command "workflow_id")
                                                         (command-string command "provider")
                                                         (command-string command "model")
                                                         (JsonString "workflow dependency did not succeed"))
                                   (emit-event (load (field controller emitter))
                                               (now-ms)
                                               (RunFailed)
                                               (command-string command "run_id")
                                               (command-string command "run_id")
                                               ""
                                               (command-string command "provider")
                                               (command-string command "model")
                                               (JsonString "workflow dependency did not succeed"))
                                   (allocation-domain-close! (load (field controller allocator)) domain)
                                   0))
      (RuntimeDependenciesReady []
                                (do
                                  (emit-event-for-agent (load (field controller emitter))
                                                        (now-ms)
                                                        (WorkflowNodeReady)
                                                        (command-string command "run_id")
                                                        (command-string command "run_id")
                                                        (command-string command "node_id")
                                                        (command-string command "workflow_id")
                                                        (command-string command "provider")
                                                        (command-string command "model")
                                                        command)
                                  (when (!= (runtime-controller-launch-domain! controller command domain) 0)
                                    (runtime-controller-fail-launch! controller command)
                                    (allocation-domain-close! (load (field controller allocator)) domain)
                                    0)
                                  0)))))

;; A dependency-blocked node must not reserve the queue head. Launch or terminalize
;; one later runnable entry and leave a tombstone so the head can be reconsidered.
(defn runtime-controller-process-later! [(controller (ptr RuntimeRunController))
                                         (start i64)
                                         (count i64)] (-> bool)
  (let [(mut i) start
        (mut processed) false]
    (loop (if (or (>= (load i) count) (load processed))
              (break)
              (let [pending
                      (al-get [PendingRuntimeRun]
                              (.pending controller)
                              (load i))
                    command (.command pending)]
                (if (= (str-len (command-string command "run_id")) 0)
                    (set! i (+ (load i) 1))
                    (do
                      (if (= (.workflow pending) 0)
                          (do
                            (when (!= (runtime-controller-launch-domain! controller
                                                                         command
                                                                         (load (field pending allocation-domain)))
                                      0)
                              (runtime-controller-fail-launch! controller command)
                              (allocation-domain-close! (load (field controller allocator))
                                                        (load (field pending allocation-domain)))
                              0)
                            (set! processed true))
                          (match (runtime-command-dependency-state controller command)
                            (RuntimeDependenciesWaiting [] (set! i (+ (load i) 1)))
                            (RuntimeDependenciesReady []
                                                      (do
                                                        (runtime-controller-process-pending! controller pending)
                                                        (set! processed true)))
                            (RuntimeDependenciesFailed []
                                                       (do
                                                         (runtime-controller-process-pending! controller pending)
                                                         (set! processed true)))))
                      (when (load processed)
                        (let [removed (primitive/alloc-stack PendingRuntimeRun)]
                          (store! (field removed command) (JsonNull))
                          (store! (field removed allocation-domain)
                                  (cast (ptr AllocationDomain) 0))
                          (store! (field removed workflow) 0)
                          (al-set! [PendingRuntimeRun]
                                   (mut (field controller pending))
                                   (load i)
                                   (load removed)))
                        0))))))
    (load processed)))

(defn runtime-controller-drain-locked! [(controller (ptr RuntimeRunController))] (-> i64)
  (runtime-controller-reap! controller)
  (let [count (al-len [PendingRuntimeRun] (.pending controller))]
    (loop (if (or (>= (.pending-next controller) count)
                  (>= (al-len [ActiveRuntimeRun] (.runs controller))
                      (.max-active-runs controller)))
              (break)
              (let [index (.pending-next controller)
                    pending
                      (al-get [PendingRuntimeRun]
                              (.pending controller)
                              index)
                    command (.command pending)]
                (if (> (str-len (command-string command "run_id")) 0)
                    (if (= (.workflow pending) 0)
                        (do
                          (set! (.pending-next controller) (+ index 1))
                          (when (!= (runtime-controller-launch-domain! controller
                                                                       command
                                                                       (load (field pending allocation-domain)))
                                    0)
                            (runtime-controller-fail-launch! controller command)
                            (allocation-domain-close! (load (field controller allocator))
                                                      (load (field pending allocation-domain)))
                            0))
                        (if (= (runtime-controller-process-pending! controller pending) 1)
                            (when (not (runtime-controller-process-later! controller
                                                                          (+ index 1)
                                                                          count))
                              (break)
                              0)
                            (set! (.pending-next controller) (+ index 1))))
                    (set! (.pending-next controller) (+ index 1))))))
    (when (>= (load (field controller pending-next)) count)
      (al-clear! [PendingRuntimeRun] (mut (field controller pending)))
      (store! (field controller pending-next) 0)
      0)
    0))

(defn runtime-controller-cancel-pending-locked! [(controller (ptr RuntimeRunController))
                                                 (run-id (slice u8))] (-> bool)
  (let [(mut i) (.pending-next controller)
        n (al-len [PendingRuntimeRun] (.pending controller))
        (mut cancelled) false]
    (loop (if (>= (load i) n)
              (break)
              (let [pending
                      (al-get [PendingRuntimeRun]
                              (.pending controller)
                              (load i))
                    command (.command pending)]
                (if (= (command-string command "run_id") run-id)
                    (do
                      (allocation-domain-close! (load (field controller allocator))
                                                (load (field pending allocation-domain)))
                      (let [removed (primitive/alloc-stack PendingRuntimeRun)]
                        (set! (.command removed) (JsonNull))
                        (set! (.allocation-domain removed) (cast (ptr AllocationDomain) 0))
                        (set! (.workflow removed) 0)
                        (al-set! [PendingRuntimeRun]
                                 (mut (.pending controller))
                                 (load i)
                                 (load removed)))
                      (set! cancelled true)
                      (break))
                    (set! i (+ (load i) 1))))))
    (load cancelled)))

(defn runtime-controller-cancel-active-locked! [(controller (ptr RuntimeRunController))] (-> i64)
  (let [(mut i) 0
        n (al-len [ActiveRuntimeRun] (.runs controller))]
    (loop (if (>= (load i) n)
              (break)
              (let [slot (al-elem [ActiveRuntimeRun]
                                  (field controller runs)
                                  (load i))]
                (agent-run-cancel! (field slot handle))
                (set! i (+ (load i) 1)))))
    0))

(defn runtime-controller-close-pending-locked! [(controller (ptr RuntimeRunController))] (-> i64)
  (let [(mut i) (.pending-next controller)
        n (al-len [PendingRuntimeRun] (.pending controller))]
    (loop (if (>= (load i) n)
              (break)
              (let [pending
                      (al-get [PendingRuntimeRun]
                              (.pending controller)
                              (load i))
                    domain (load (field pending allocation-domain))]
                (when (!= domain (cast (ptr AllocationDomain) 0))
                  (allocation-domain-close! (load (field controller allocator))
                                            domain)
                  0)
                (set! i (+ (load i) 1)))))
    (al-clear! [PendingRuntimeRun] (mut (.pending controller)))
    (set! (.pending-next controller) 0)
    0))

(defn runtime-controller-scheduler-worker [(opaque (ptr i8))] (-> (ptr i8))
  (let [controller (cast (ptr RuntimeRunController) opaque)
        (mut done) false]
    (loop (if (load done)
              (break)
              (do
                (runtime-controller-lock! controller)
                (if (= (atomic-load (load (field controller stopping))) 1)
                    (do
                      (runtime-controller-cancel-active-locked! controller)
                      (runtime-controller-close-pending-locked! controller)
                      (runtime-controller-reap! controller)
                      (when (= (al-len [ActiveRuntimeRun]
                                       (load (field controller runs)))
                               0)
                        (store! done true)
                        0))
                    (do
                      (runtime-controller-drain-cancellations-locked! controller)
                      (runtime-controller-drain-locked! controller)))
                (runtime-controller-unlock! controller)
                (when (not (load done)) (sleep-ms 10) 0))))
    (cast (ptr i8) 0)))

(defn runtime-controller-start-scheduler! [(controller (ptr RuntimeRunController))] (-> i64)
  (runtime-controller-lock! controller)
  (let [result
          (if (.scheduler-started controller)
              0
              (let [spawn-code
                      (thread-spawn (field controller scheduler)
                                    (fnptr-of runtime-controller-scheduler-worker)
                                    (cast (ptr i8) controller))]
                (if (= (cast i64 spawn-code) 0)
                    (do
                      (set! (.scheduler-started controller) true)
                      0)
                    -1)))]
    (runtime-controller-unlock! controller)
    result))

(defn runtime-controller-enqueue! [(controller (ptr RuntimeRunController))
                                   (command Json)] (-> i64)
  (if (= (atomic-load (load (field controller stopping))) 1)
      -1
      (if (!= (runtime-controller-start-scheduler! controller) 0)
          -1
          (do
            (runtime-controller-lock! controller)
            (let [result (runtime-controller-enqueue-locked! controller command)]
              (runtime-controller-unlock! controller)
              result)))))

(defn runtime-controller-cancel-locked! [(controller (ptr RuntimeRunController))
                                         (command Json)] (-> RunCancellationResult)
  (runtime-controller-reap! controller)
  (let [run-id (command-string command "run_id")
        (mut i) 0
        n (al-len [ActiveRuntimeRun] (.runs controller))
        (mut result) (RunCancellationTerminalOrMissing)]
    (loop (if (>= (load i) n)
              (break)
              (let [slot (al-elem [ActiveRuntimeRun]
                                  (field controller runs)
                                  (load i))]
                (if (= (.run-id slot) run-id)
                    (let [reserve-code (agent-run-reserve-cancellation! (field slot handle))]
                      (cond (= reserve-code 0)
                              (if (< (emit-event (load (field controller emitter))
                                                 (now-ms)
                                                 (RunCancellationRequested)
                                                 run-id
                                                 run-id
                                                 ""
                                                 (command-string command "provider")
                                                 (command-string command "model")
                                                 command)
                                     0)
                                  (do
                                    (agent-run-abort-cancellation! (field slot handle))
                                    (store! result (RunCancellationFailed)))
                                  (do
                                    (agent-run-confirm-cancellation! (field slot handle))
                                    (store! result (RunCancellationAccepted))))
                            (= reserve-code 1) (store! result (RunCancellationAccepted))
                            :else (store! result (RunCancellationTerminalOrMissing)))
                      (break))
                    (set! i (+ (load i) 1))))))
    (when (match (load result)
            (RunCancellationTerminalOrMissing [] true)
            (RunCancellationAccepted [] false)
            (RunCancellationFailed [] false))
      (when (runtime-controller-pending? controller run-id)
        (let [requested
                (emit-event (load (field controller emitter))
                            (now-ms)
                            (RunCancellationRequested)
                            run-id
                            run-id
                            ""
                            (command-string command "provider")
                            (command-string command "model")
                            command)]
          (if (< requested 0)
              (store! result (RunCancellationFailed))
              (let [cancelled
                      (emit-event (load (field controller emitter))
                                  (now-ms)
                                  (RunCancelled)
                                  run-id
                                  run-id
                                  ""
                                  (command-string command "provider")
                                  (command-string command "model")
                                  (JsonString "queued run cancelled"))]
                (if (< cancelled 0)
                    (store! result (RunCancellationFailed))
                    (do
                      (runtime-controller-cancel-pending-locked! controller run-id)
                      (store! result (RunCancellationAccepted)))))))
        0))
    (load result)))

(defn runtime-controller-cancel! [(controller (ptr RuntimeRunController))
                                  (command Json)] (-> RunCancellationResult)
  (runtime-controller-lock! controller)
  (let [result (runtime-controller-cancel-locked! controller command)]
    (runtime-controller-unlock! controller)
    result))

(defn runtime-controller-request-cancel! [(controller (ptr RuntimeRunController))
                                          (command Json)] (-> i64)
  (let [domain (allocation-domain-open (load (field controller allocator)))]
    (if (not (allocation-domain-valid? domain))
        -1
        (let [pending (primitive/alloc-stack PendingCancellation)]
          (set! (.command pending) (json-clone (allocation-domain-allocator domain) command))
          (set! (.allocation-domain pending) domain)
          (runtime-controller-lock! controller)
          (al-push! [PendingCancellation]
                    (mut (.cancellations controller))
                    (load pending))
          (runtime-controller-unlock! controller)
          0))))

(defn runtime-controller-drain-cancellations-locked! [(controller (ptr RuntimeRunController))] (-> i64)
  (let [(mut i) 0
        n (al-len [PendingCancellation] (.cancellations controller))]
    (loop (if (>= (load i) n)
              (break)
              (let [pending
                      (al-get [PendingCancellation]
                              (.cancellations controller)
                              (load i))]
                (runtime-controller-cancel-locked! controller
                                                   (.command pending))
                (allocation-domain-close! (load (field controller allocator))
                                          (load (field pending allocation-domain)))
                (set! i (+ (load i) 1)))))
    (al-clear! [PendingCancellation] (mut (.cancellations controller)))
    0))

(defn runtime-controller-join-all! [(controller (ptr RuntimeRunController))] (-> i64)
  (atomic-store (load (field controller stopping)) 1)
  (if (.scheduler-started controller)
      (cast i64 (thread-join (field controller scheduler)))
      (do
        (runtime-controller-lock! controller)
        (runtime-controller-cancel-active-locked! controller)
        (let [(mut i) 0
              n (al-len [ActiveRuntimeRun] (.runs controller))]
          (loop (if (>= (load i) n)
                    (break)
                    (let [slot (al-elem [ActiveRuntimeRun]
                                        (field controller runs)
                                        (load i))]
                      (agent-run-join (mut (.handle slot)))
                      (allocation-domain-close! (load (field controller allocator))
                                                (load (field slot allocation-domain)))
                      (set! i (+ (load i) 1)))))
          (al-clear! [ActiveRuntimeRun] (mut (.runs controller))))
        (runtime-controller-unlock! controller)))
  0)

;; A bridged call belongs to the caller's session, not to a harness run: the
;; external loop owns its own lifecycle and never tells us when it ends, so the
;; harness does not manufacture a run around it. The session ID is still the run
;; ID on every journaled tool event, which is what makes those calls readable
;; through the existing events endpoint.
(defn runtime-tool-session-id [(command Json)] (-> (slice u8))
  (let [value (command-string command "session_id")]
    (if (> (slice-len [u8] value) 0) value "agent-sdk")))

(defn runtime-tool-call-id [(command Json)] (-> (slice u8))
  (let [value (command-string command "call_id")]
    (if (> (slice-len [u8] value) 0) value (command-string command "name"))))

;; The registry's own view, not a provider dialect. The caller needs what the
;; harness knows about each tool -- schema, effect, idempotence -- because it is
;; the loop deciding how to present and parallelize the call.
(defn runtime-controller-tools-json [(controller (ptr RuntimeRunController))
                                     (allocator (dyn Allocator))] (-> Json)
  (let [registry (load (field controller registry))
        definitions (field registry definitions)
        (mut body) (json-object allocator)
        (mut tools) (json-array allocator)
        (mut i) 0
        n (al-len [ToolDefinition] (load definitions))]
    (loop (if (>= (load i) n)
              (break)
              (let [definition (al-get [ToolDefinition] (load definitions) (load i))
                    spec (field definition spec)
                    (mut entry) (json-object allocator)]
                (json-put-string! (mut entry) "name" (.name spec))
                (json-put-string! (mut entry) "description" (.description spec))
                (json-object-put! (mut entry) "input_schema" (.input-schema spec))
                (json-put-string! (mut entry) "effect" (tool-effect-name (.effect spec)))
                (json-put-bool! (mut entry) "idempotent" (.idempotent spec))
                (json-object-put! (mut entry)
                                  "timeout_ms"
                                  (json-integer allocator (.timeout-ms spec)))
                (json-array-push! (mut tools) (load entry))
                (set! i (+ (load i) 1)))))
    (json-object-put! (mut body) "version" (json-integer allocator 1))
    (json-object-put! (mut body) "tools" (load tools))
    (load body)))

;; Registration is the gate. A registered tool whose arguments satisfy its own
;; schema is authorized and nothing else is; effect is reported for display, not
;; consulted, because the harness has no effect policy to apply. A caller that
;; wants one denies on the effect it reads here.
(defn runtime-controller-authorize-tool [(controller (ptr RuntimeRunController))
                                         (command Json)
                                         (allocator (dyn Allocator))] (-> Json)
  (let [name (command-string command "name")
        (mut body) (json-object allocator)]
    (json-object-put! (mut body) "version" (json-integer allocator 1))
    (json-put-string! (mut body) "name" name)
    (match (tool-find (load (load (field controller registry))) name)
      (None []
            (do
              (json-put-bool! (mut body) "authorized" false)
              (json-put-string! (mut body) "reason" "unknown tool")))
      (Some [definition]
            (let [selected definition
                  validation
                    (json-schema-validate allocator
                                          (.input-schema (.spec selected))
                                          (json-get command "arguments"))]
              (json-put-string! (mut body)
                                "effect"
                                (tool-effect-name (.effect (.spec selected))))
              (if (.ok validation)
                  (do
                    (json-put-bool! (mut body) "authorized" true)
                    (json-put-string! (mut body) "reason" ""))
                  (do
                    (json-put-bool! (mut body) "authorized" false)
                    (json-put-string! (mut body)
                                      "reason"
                                      (concat-or-empty allocator
                                                       "tool arguments do not satisfy input schema: "
                                                       (.message validation))))))))
    (load body)))

(defn runtime-controller-invoke-tool [(controller (ptr RuntimeRunController))
                                      (command Json)
                                      (allocator (dyn Allocator))] (-> Json)
  (let [call (primitive/alloc-stack ToolCall)
        calls (box! allocator (ArrayList ToolCall) (al-new [ToolCall] allocator))
        execution (primitive/alloc-stack ToolExecutionRequest)
        session-id (runtime-tool-session-id command)]
    (set! (.id call) (runtime-tool-call-id command))
    (set! (.name call) (command-string command "name"))
    (set! (.arguments call) (json-get command "arguments"))
    (set! (.raw-arguments call) (json-stringify allocator (.arguments call)))
    (al-push! [ToolCall] calls (load call))
    (set! (.run-id execution) session-id)
    (set! (.parent-operation-id execution) "")
    (set! (.provider execution) "agent-sdk")
    (set! (.model execution) (command-string command "model"))
    (set! (.registry execution) (load (field controller registry)))
    (set! (.calls execution) calls)
    (set! (.emitter execution) (load (field controller emitter)))
    ;; Cancellation and the run clock belong to the loop that owns the task. The
    ;; caller's HTTP timeout bounds the request; each tool still carries its own
    ;; deadline from its spec.
    (set! (.cancellation execution) (cast (ptr CancellationToken) 0))
    (set! (.run-deadline-monotonic-ms execution) 0)
    (set! (.max-parallel execution) 1)
    (let [batch (execute-tools-parallel allocator execution)
          result (al-get [ToolResult] (.results batch) 0)
          (mut body) (json-object allocator)]
      (json-object-put! (mut body) "version" (json-integer allocator 1))
      (json-put-string! (mut body) "status" (tool-status-name (.status result)))
      (json-put-string! (mut body) "call_id" (.call-id result))
      (json-put-string! (mut body) "session_id" session-id)
      (json-object-put! (mut body) "output" (.output result))
      (json-put-string! (mut body) "error" (.error result))
      (json-object-put! (mut body)
                        "started_at_ms"
                        (json-integer allocator (.started-at-ms result)))
      (json-object-put! (mut body)
                        "finished_at_ms"
                        (json-integer allocator (.finished-at-ms result)))
      (load body))))

(impl RunController RuntimeRunController
  (prepare-durable-provider [(self (ptr RuntimeRunController))
                             (provider-name (slice u8))]
                            (-> i64)
                            (prepare-runtime-provider (.provider-factory self)
                                                      (load (field self allocator))
                                                      provider-name))
  (start-durable-run [(self (ptr RuntimeRunController)) (command (ptr Json))]
                     (-> i64)
                     (runtime-controller-enqueue! self (load command)))
  (request-cancel-durable-run [(self (ptr RuntimeRunController))
                               (command (ptr Json))]
                              (-> i64)
                              (runtime-controller-request-cancel! self (load command)))
  (cancel-durable-run [(self (ptr RuntimeRunController))
                       (command (ptr Json))]
                      (-> RunCancellationResult)
                      (runtime-controller-cancel! self (load command)))
  (describe-tools [(self (ptr RuntimeRunController))
                   (allocator (dyn Allocator))
                   (out (ptr Json))]
                  (-> i64)
                  (do
                    (set! out (runtime-controller-tools-json self allocator))
                    0))
  (authorize-tool-call [(self (ptr RuntimeRunController))
                        (command (ptr Json))
                        (allocator (dyn Allocator))
                        (out (ptr Json))]
                       (-> i64)
                       (do
                         (set! out
                               (runtime-controller-authorize-tool self
                                                                  (load command)
                                                                  allocator))
                         0))
  (invoke-tool [(self (ptr RuntimeRunController))
                (command (ptr Json))
                (allocator (dyn Allocator))
                (out (ptr Json))]
               (-> i64)
               (do
                 (set! out (runtime-controller-invoke-tool self (load command) allocator))
                 0)))
