(module harness-event-journal)

(import "coil.alloc" :as alloc :use *)
(import "coil.arraylist" :use *)
(import "coil.atomic" :use *)
(import "coil.fs" :as fs)
(import "coil.io" :as io)
(import "coil.match" :use *)
(import "coil.os" :as os)
(import "coil.primitive" :as primitive)
(import "coil.result" :use *)
(import "coil.region" :as region)
(import "coil.slice" :use *)
(import "coil.str" :use *)
(import "harness-event" :use *)
(import "harness-allocation-domain" :use *)
(import "harness-json" :use *)
(import "provider-common" :use *)

(extern fsync :cc c [i32] (-> i32))

(defn journal-os-pick [(linux Code) (darwin Code)] (-> Code)
  (if (primitive/code-eq (primitive/target-os) `linux) linux darwin))
;;; hygiene: these platform constants intentionally enter this module's public
;;; namespace -- the code below refers to them by hand, so the generator publishes
;;; the bare name explicitly rather than leaving it in its own template context.
(defn journal--public-name [(name Code)] (-> Code)
  (primitive/syntax->datum name))
(defn journal-open-constants [] (-> Code)
  `(do
     (const ~(journal--public-name `JOURNAL_O_APPEND) ~(journal-os-pick `1024 `8))
     (const ~(journal--public-name `JOURNAL_O_CREAT) ~(journal-os-pick `64 `512))
     (const ~(journal--public-name `JOURNAL_O_CLOEXEC) ~(journal-os-pick `524288 `16777216))))
(meta (journal-open-constants))
(const JOURNAL_O_WRONLY 1)
(const JOURNAL_FILE_MODE 420)

(defstruct EventJournal
  [(allocator (dyn Allocator))
   (fd i64)
   (lock (ptr i64))
   (failed (ptr i64))
   (scratch-domain (ptr AllocationDomain))
   (path (slice u8))
   (sync-each-event bool)])

(defsum JournalOpenResult
  (JournalOpened [(journal EventJournal)])
  (JournalOpenFailed [(message (slice u8))]))

(defstruct JournalRecovery
  [(ok bool)
   (events (ArrayList Json))
   (backing-bytes (slice u8))
   (last-sequence i64)
   (ignored-torn-tail bool)
   (error (slice u8))])

(defn journal-lock! [(cell (ptr i64))] (-> i64)
  (loop (if (= (atomic-cas cell 0 1) 0) (break) 0))
  0)

(defn journal-unlock! [(cell (ptr i64))] (-> i64)
  (atomic-store cell 0))

(defn event-journal-open [(allocator (dyn Allocator))
                          (path (slice u8))
                          (sync-each-event bool)] (-> JournalOpenResult)
  (let [c-path (str->cstr allocator path)
        fd
          (os/open c-path
                   (cast i32
                         (| JOURNAL_O_WRONLY
                            (| JOURNAL_O_CLOEXEC
                               (| JOURNAL_O_CREAT JOURNAL_O_APPEND))))
                   JOURNAL_FILE_MODE)]
    (free-bytes allocator
                (slice-new (cast (ptr u8) c-path) (+ (slice-len [u8] path) 1))
                1)
    (if (< fd (cast i32 0))
        (JournalOpenFailed "could not open event journal")
        (let [journal (primitive/alloc-stack EventJournal)]
          (set! (.allocator journal) allocator)
          (set! (.fd journal) (cast i64 fd))
          (store! (field journal lock) (box! allocator i64 0))
          (store! (field journal failed) (box! allocator i64 0))
          (set! (.scratch-domain journal) (allocation-domain-open allocator))
          (set! (.path journal) (json-copy-string allocator path))
          (set! (.sync-each-event journal) sync-each-event)
          (JournalOpened (load journal))))))

(defn event-journal-append-bytes! [(allocator (dyn Allocator))
                                   (path (slice u8))
                                   (bytes (slice u8))] (-> i64)
  (let [c-path (str->cstr allocator path)
        fd
          (os/open c-path
                   (cast i32
                         (| JOURNAL_O_WRONLY
                            (| JOURNAL_O_CLOEXEC
                               (| JOURNAL_O_CREAT JOURNAL_O_APPEND))))
                   JOURNAL_FILE_MODE)
        writer (primitive/alloc-stack io/Writer)]
    (free-bytes allocator
                (slice-new (cast (ptr u8) c-path) (+ (slice-len [u8] path) 1))
                1)
    (if (< fd (cast i32 0))
        -1
        (let [result
                (match (io/print-str (io/fd-writer writer (cast i64 fd)) bytes)
                  (Ok [count] count)
                  (Err [failure] -1))]
          (os/close fd)
          result))))

(defn event-journal-close! [(journal (ptr EventJournal))] (-> i64)
  (journal-lock! (load (field journal lock)))
  (let [fd (.fd journal)]
    (when (>= fd 0)
      (os/close (cast i32 fd))
      (store! (field journal fd) -1)
      0))
  (journal-unlock! (load (field journal lock)))
  (allocation-domain-close! (load (field journal allocator))
                            (load (field journal scratch-domain))))

(defn event-journal-failed? [(journal (ptr EventJournal))] (-> bool)
  (= (atomic-load (load (field journal failed))) 1))

(defn event-journal-publish [(journal (ptr EventJournal)) (event (ptr Event))] (-> i64)
  (let [cycle (primitive/alloc-stack region/Region)]
    (region/region-init cycle
                        (allocation-domain-allocator (load (field journal scratch-domain))))
    (let [allocator (region/region-allocator cycle)]
      (journal-lock! (load (field journal lock)))
      (let [writer (primitive/alloc-stack io/Writer)
            fd (.fd journal)
            (mut result) -1]
        (if (< fd 0)
            (atomic-store (load (field journal failed)) 1)
            (let [encoded (json-stringify allocator (event-to-json allocator event))]
              (match (io/write-line (io/fd-writer writer fd) encoded)
                (Err [failure]
                     (atomic-store (load (field journal failed)) 1))
                (Ok [written]
                    (if (and (.sync-each-event journal)
                             (!= (cast i64 (fsync (cast i32 fd))) 0))
                        (atomic-store (load (field journal failed)) 1)
                        (set! result 0))))))
        (journal-unlock! (load (field journal lock)))
        (region/region-close! cycle)
        (load result)))))

(impl EventSink EventJournal
  (publish-event [(self (ptr EventJournal)) (event (ptr Event))]
                 (-> i64)
                 (event-journal-publish self event)))

(defn journal-ends-in-newline? [(bytes (slice u8))] (-> bool)
  (and (> (slice-len [u8] bytes) 0)
       (= (cast i64 (slice-get [u8] bytes (- (slice-len [u8] bytes) 1))) 10)))

(defn journal-recovery-empty [(allocator (dyn Allocator))] (-> JournalRecovery)
  (let [recovery (primitive/alloc-stack JournalRecovery)]
    (set! (.ok recovery) true)
    (set! (.events recovery) (al-new [Json] allocator))
    (set! (.backing-bytes recovery) "")
    (set! (.last-sequence recovery) 0)
    (set! (.ignored-torn-tail recovery) false)
    (set! (.error recovery) "")
    (load recovery)))

(defn event-journal-recover [(allocator (dyn Allocator))
                             (path (slice u8))] (-> JournalRecovery)
  (let [(mut recovery) (journal-recovery-empty allocator)]
    (match (fs/read-file allocator path)
      (Err [failure]
           (do
             (set! (.ok recovery) false)
             (set! (.error recovery) "could not read event journal")))
      (Ok [bytes]
          (do
            (set! (.backing-bytes recovery) bytes)
            (let [(mut lines) (str-split allocator bytes "\n")
                  count (al-len [(slice u8)] (load lines))
                  complete-count (if (journal-ends-in-newline? bytes) (- count 1) (- count 1))
                  (mut i) 0]
              (al-reserve! [Json] (mut (.events recovery)) complete-count)
              (when (and (> count 0) (not (journal-ends-in-newline? bytes)))
                (store! (field recovery ignored-torn-tail) true)
                0)
              (loop (if (or (>= (load i) complete-count)
                            (not (.ok recovery)))
                        (break)
                        (let [line (al-get [(slice u8)] (load lines) (load i))
                              parsed (json-parse allocator line)]
                          (if (not (.ok parsed))
                              (do
                                (set! (.ok recovery) false)
                                (set! (.error recovery) "event journal contains invalid JSON"))
                              (let [event (.value parsed)
                                    version (json-number-i64 (json-get event "version"))
                                    sequence (json-number-i64 (json-get event "sequence"))]
                                (if (or (!= version 1)
                                        (<= sequence (.last-sequence recovery)))
                                    (do
                                      (set! (.ok recovery) false)
                                      (set! (.error recovery) "event journal violates version or ordering"))
                                    (do
                                      (al-push! [Json]
                                                (mut (.events recovery))
                                                event)
                                      (set! (.last-sequence recovery) sequence)))))
                          (set! i (+ (load i) 1)))))
              (al-free! [(slice u8)] (mut lines))))))
    (load recovery)))

;;; Readers in one process must not observe an append between the file read and
;;; JSON projection. TUI sessions use process-scoped journals.
(defn event-journal-recover-synchronized [(journal (ptr EventJournal))
                                          (allocator (dyn Allocator))
                                          (path (slice u8))] (-> JournalRecovery)
  (journal-lock! (load (field journal lock)))
  (let [recovery (event-journal-recover allocator path)]
    (journal-unlock! (load (field journal lock)))
    recovery))
