(module harness-filesystem-tools)

(import "coil.primitive" :as primitive)

(import "coil.alloc" :as alloc :use *)
(import "coil.arraylist" :use *)
(import "coil.fs" :as fs)
(import "coil.io" :as io)
(import "coil.match" :use *)
(import "coil.os" :as os)
(import "coil.slice" :use *)
(import "coil.str" :use *)
(import "harness-json" :use *)
(import "harness-tool" :use *)
(import "provider-common" :use *)

(const FILE_TOOL_MAX_BYTES 1048576)
(const FILE_TOOL_DIRECTORY_MODE 493)
(const FILE_TOOL_DEFAULT_READ_LINES 120)
(const FILE_TOOL_MAX_READ_LINES 500)

(extern mkdir :cc c [(ptr i8) i32] (-> i32))
(extern unlink :cc c [(ptr i8)] (-> i32))
(extern rmdir :cc c [(ptr i8)] (-> i32))

(defstruct ReadTextFileTool [(root (slice u8))])
(defstruct WriteTextFileTool [(root (slice u8))])
(defstruct EditTextFileTool [(root (slice u8))])
(defstruct CreateDirectoryTool [(root (slice u8))])
(defstruct DeleteFileTool [(root (slice u8))])
(defstruct RemoveDirectoryTool [(root (slice u8))])

(defsum BoundedReadResult
  (BoundedReadOk [(bytes (slice u8)) (truncated bool)])
  (BoundedReadFailed [(message (slice u8))]))

(defstruct LineWindow
  [(content (slice u8))
   (total-lines i64)
   (start-line i64)
   (end-line i64)
   (next-start-line i64)])

(defn file-line-window [(bytes (slice u8))
                        (requested-start i64)
                        (requested-count i64)] (-> LineWindow)
  (let [n (slice-len [u8] bytes)
        start-line (if (> requested-start 0) requested-start 1)
        count (if (> requested-count 0)
                  (if (> requested-count FILE_TOOL_MAX_READ_LINES)
                      FILE_TOOL_MAX_READ_LINES
                      requested-count)
                  FILE_TOOL_DEFAULT_READ_LINES)
        wanted-end (- (+ start-line count) 1)
        (mut current-line) 1
        (mut start-byte) (if (= start-line 1) 0 -1)
        (mut end-byte) n
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do
                (when (= (slice-get [u8] bytes (load i)) (cast u8 10))
                  (when (= (load current-line) wanted-end)
                    (store! end-byte (+ (load i) 1))
                    0)
                  (store! current-line (+ (load current-line) 1))
                  (when (and (< (load start-byte) 0)
                             (= (load current-line) start-line))
                    (store! start-byte (+ (load i) 1))
                    0)
                  0)
                (set! i (+ (load i) 1)))))
    (let [total-lines
            (if (= n 0)
                0
                (if (= (slice-get [u8] bytes (- n 1)) (cast u8 10))
                    (- (load current-line) 1)
                    (load current-line)))
          actual-start (if (< (load start-byte) 0) n (load start-byte))
          actual-end (if (< (load end-byte) actual-start) actual-start (load end-byte))
          end-line (if (or (= total-lines 0) (> start-line total-lines))
                       0
                       (if (> wanted-end total-lines) total-lines wanted-end))
          next-line (if (< end-line total-lines) (+ end-line 1) 0)
          result (primitive/alloc-stack LineWindow)]
      (set! (.content result) (subslice [u8] bytes actual-start actual-end))
      (set! (.total-lines result) total-lines)
      (set! (.start-line result) start-line)
      (set! (.end-line result) end-line)
      (set! (.next-start-line result) next-line)
      (load result))))

(defn file-tool-path-safe? [(path (slice u8))] (-> bool)
  (and (> (slice-len [u8] path) 0)
       (and (not (os/slice-has-byte? path (cast u8 0)))
            (and (!= (cast i64 (slice-get [u8] path 0)) 47)
                 (and (not (= path ".."))
                      (and (match (str-find path "../")
                             (Some [position] false)
                             (None [] true))
                           (match (str-find path "/..")
                             (Some [position] false)
                             (None [] true))))))))

(defn file-tool-path [(allocator (dyn Allocator))
                      (root (slice u8))
                      (path (slice u8))] (-> (slice u8))
  (let [prefix (concat-or-empty allocator root "/")]
    (concat-or-empty allocator prefix path)))

;;; A NUL anywhere in the first bytes means this is not text. Scanning the whole
;;; buffer would be equally correct but this is enough: every binary format puts
;;; one near the front, and a text file never does.
(defn file-tool-binary? [(bytes (slice u8))] (-> bool)
  (let [n (slice-len [u8] bytes)
        limit (if (> n 8192) 8192 n)
        (mut i) 0
        (mut binary) false]
    (loop (if (or (load binary) (>= (load i) limit))
              (break)
              (do
                (when (= (slice-get [u8] bytes (load i)) (cast u8 0))
                  (store! binary true)
                  0)
                (set! i (+ (load i) 1)))))
    (load binary)))

(defn bounded-read-file [(allocator (dyn Allocator))
                         (path (slice u8))] (-> BoundedReadResult)
  (let [c-path (str->cstr allocator path)
        fd
          (if (= (cast i64 c-path) 0)
              (cast i32 -1)
              (os/open c-path (cast i32 0) 0))]
    (when (!= (cast i64 c-path) 0)
      (free-bytes allocator
                  (slice-new (cast (ptr u8) c-path) (+ (slice-len [u8] path) 1))
                  1)
      0)
    (if (< fd (cast i32 0))
        (BoundedReadFailed "could not open file")
        (let [(mut bytes) (al-new [u8] allocator)
              buffer (primitive/alloc-stack (array u8 4096))
              (mut failed) false
              (mut truncated) false]
          (block :done
                   (loop (let [current (al-len [u8] (load bytes))
                               remaining (- (+ FILE_TOOL_MAX_BYTES 1) current)
                               requested (if (< remaining 4096) remaining 4096)]
                           (if (<= requested 0)
                               (do (store! truncated true) (break))
                               (let [count
                                       (cast i64
                                             (io/read fd
                                                      (cast (ptr i8) (index buffer 0))
                                                      (cast isize requested)))]
                                 (if (< count 0)
                                     (do (store! failed true) (break))
                                     (if (= count 0)
                                         (break)
                                         (al-extend! [u8]
                                                     (mut bytes)
                                                     (cast (ptr u8) (index buffer 0))
                                                     count))))))))
          (os/close fd)
          (if (load failed)
              (BoundedReadFailed "could not read file")
              (let [captured (al-into-slice [u8] (mut bytes))]
                (if (> (slice-len [u8] captured) FILE_TOOL_MAX_BYTES)
                    (BoundedReadOk (subslice [u8] captured 0 FILE_TOOL_MAX_BYTES)
                                   true)
                    (BoundedReadOk captured (load truncated)))))))))

(defn file-tool-error [(call (ptr ToolCall))
                       (message (slice u8))] (-> ToolResult)
  (let [(mut result) (tool-result-empty (.id call) (ToolErrored))]
    (set! (.error result) message)
    (load result)))

(defn file-tool-path-result [(allocator (dyn Allocator))
                             (call (ptr ToolCall))
                             (key (slice u8))
                             (path (slice u8))] (-> ToolResult)
  (let [(mut output) (json-object allocator)
        (mut result) (tool-result-empty (.id call) (ToolSucceeded))]
    (json-put-string! (mut output) key path)
    (set! (.output result) (load output))
    (load result)))

(defn file-tool-relative-path [(call (ptr ToolCall))] (-> (slice u8))
  (match (json-string-at (.arguments call) "path")
    (Some [value] value)
    (None [] "")))

(defn execute-read-text-file [(self (ptr ReadTextFileTool))
                              (call (ptr ToolCall))
                              (context (ptr ToolExecutionContext))
                              (allocator (dyn Allocator))] (-> ToolResult)
  (let [arguments (.arguments call)
        relative
          (match (json-string-at arguments "path")
            (Some [value] value)
            (None [] ""))
        requested-start (json-number-i64 (json-get arguments "start_line"))
        requested-count (json-number-i64 (json-get arguments "line_count"))]
    (if (cancellation-requested? (load (field context cancellation)))
        (file-tool-error call "read cancelled")
        (if (not (file-tool-path-safe? relative))
            (file-tool-error call "path must be workspace-relative without parent traversal")
            (match (bounded-read-file allocator
                                      (file-tool-path allocator
                                                      (.root self)
                                                      relative))
              (BoundedReadFailed [message] (file-tool-error call message))
              (BoundedReadOk [bytes truncated]
                             ;; `read_text_file` means text. A NUL byte is the
                             ;; cheap, reliable signal that it is not -- and
                             ;; without this guard a compiled binary reads back
                             ;; as up to a MiB of junk that goes straight into
                             ;; the conversation and never leaves it, blowing
                             ;; the model's limit on this request and every
                             ;; later one in the same conversation.
                             (if (file-tool-binary? bytes)
                                 (file-tool-error call
                                                  "file is not text (contains NUL bytes); read_text_file only handles text")
                                 (let [window
                                         (file-line-window bytes
                                                           requested-start
                                                           requested-count)
                                       (mut output) (json-object allocator)
                                       (mut result)
                                         (tool-result-empty (.id call)
                                                            (ToolSucceeded))]
                                   (json-put-string! (mut output)
                                                     "content"
                                                     (.content window))
                                   (json-put-bool! (mut output)
                                                   "truncated"
                                                   (or truncated
                                                       (> (.next-start-line window) 0)))
                                   (json-object-put! (mut output)
                                                     "bytes"
                                                     (json-integer allocator
                                                                   (slice-len [u8]
                                                                     (.content window))))
                                   (json-object-put! (mut output) "total_lines"
                                                     (json-integer allocator
                                                       (.total-lines window)))
                                   (json-object-put! (mut output) "start_line"
                                                     (json-integer allocator
                                                       (.start-line window)))
                                   (json-object-put! (mut output) "end_line"
                                                     (json-integer allocator
                                                       (.end-line window)))
                                   (json-object-put! (mut output) "next_start_line"
                                                     (json-integer allocator
                                                       (.next-start-line window)))
                                   (set! (.output result) (load output))
                                   (load result)))))))))

(defn execute-write-text-file [(self (ptr WriteTextFileTool))
                               (call (ptr ToolCall))
                               (context (ptr ToolExecutionContext))
                               (allocator (dyn Allocator))] (-> ToolResult)
  (let [arguments (.arguments call)
        relative
          (match (json-string-at arguments "path")
            (Some [value] value)
            (None [] ""))
        content
          (match (json-string-at arguments "content")
            (Some [value] value)
            (None [] ""))]
    (cond (cancellation-requested? (load (field context cancellation))) (file-tool-error call "write cancelled")
          (not (file-tool-path-safe? relative))
            (file-tool-error call "path must be workspace-relative without parent traversal")
          (> (slice-len [u8] content) FILE_TOOL_MAX_BYTES) (file-tool-error call "write exceeds one MiB limit")
          :else
            (match (fs/write-file allocator
                                  (file-tool-path allocator
                                                  (load (field self root))
                                                  relative)
                                  content)
              (Err [failure] (file-tool-error call "could not write file"))
              (Ok [written]
                  (let [(mut output) (json-object allocator)
                        (mut result)
                          (tool-result-empty (load (field call id))
                                             (ToolSucceeded))]
                    (json-object-put! (mut output)
                                      "bytes_written"
                                      (json-integer allocator written))
                    (store! (field result output) (load output))
                    (load result)))))))

(defn execute-edit-text-file [(self (ptr EditTextFileTool))
                              (call (ptr ToolCall))
                              (context (ptr ToolExecutionContext))
                              (allocator (dyn Allocator))] (-> ToolResult)
  (let [arguments (.arguments call)
        relative
          (match (json-string-at arguments "path")
            (Some [value] value)
            (None [] ""))
        old-text
          (match (json-string-at arguments "old_text")
            (Some [value] value)
            (None [] ""))
        new-text
          (match (json-string-at arguments "new_text")
            (Some [value] value)
            (None [] ""))]
    (cond (cancellation-requested? (load (field context cancellation)))
            (file-tool-error call "edit cancelled")
          (not (file-tool-path-safe? relative))
            (file-tool-error call "path must be workspace-relative without parent traversal")
          (= (slice-len [u8] old-text) 0)
            (file-tool-error call "old_text must not be empty")
          :else
            (let [path (file-tool-path allocator (load (field self root)) relative)]
              (match (bounded-read-file allocator path)
                (BoundedReadFailed [message] (file-tool-error call message))
                (BoundedReadOk [content truncated]
                  (if truncated
                      (file-tool-error call "file exceeds one MiB edit limit")
                      (if (file-tool-binary? content)
                          (file-tool-error call "file is not text")
                          (match (str-find content old-text)
                            (None [] (file-tool-error call "old_text was not found"))
                            (Some [position]
                              (let [after-position (+ position (slice-len [u8] old-text))
                                    suffix (subslice [u8]
                                                     content
                                                     after-position
                                                     (slice-len [u8] content))]
                                (match (str-find suffix old-text)
                                  (Some [again]
                                    (file-tool-error call "old_text occurs more than once; provide more context"))
                                  (None []
                                    (let [prefix (subslice [u8] content 0 position)
                                          updated
                                            (concat-or-empty allocator
                                                             prefix
                                                             (concat-or-empty allocator new-text suffix))]
                                      (if (> (slice-len [u8] updated) FILE_TOOL_MAX_BYTES)
                                          (file-tool-error call "edited file exceeds one MiB limit")
                                          (match (fs/write-file allocator path updated)
                                            (Err [failure] (file-tool-error call "could not write edited file"))
                                            (Ok [written]
                                              (let [(mut output) (json-object allocator)
                                                    (mut result)
                                                      (tool-result-empty
                                                        (load (field call id))
                                                        (ToolSucceeded))]
                                                (json-put-string! (mut output) "edited" relative)
                                                (json-object-put! (mut output)
                                                                  "bytes_written"
                                                                  (json-integer allocator written))
                                                (store! (field result output) (load output))
                                                (load result)))))))))))))))))))

(defn execute-create-directory [(self (ptr CreateDirectoryTool))
                                (call (ptr ToolCall))
                                (context (ptr ToolExecutionContext))
                                (allocator (dyn Allocator))] (-> ToolResult)
  (let [relative (file-tool-relative-path call)]
    (cond (cancellation-requested? (load (field context cancellation)))
            (file-tool-error call "directory creation cancelled")
          (not (file-tool-path-safe? relative))
            (file-tool-error call "path must be workspace-relative without parent traversal")
          :else
            (let [path (file-tool-path allocator (load (field self root)) relative)
                  c-path (str->cstr allocator path)
                  code
                    (if (= (cast i64 c-path) 0)
                        -1
                        (cast i64 (mkdir c-path (cast i32 FILE_TOOL_DIRECTORY_MODE))))]
              (when (!= (cast i64 c-path) 0)
                (free-bytes allocator
                            (slice-new (cast (ptr u8) c-path) (+ (slice-len [u8] path) 1))
                            1)
                0)
              (if (= code 0)
                  (file-tool-path-result allocator call "created" relative)
                  (file-tool-error call "could not create directory"))))))

(defn execute-delete-file [(self (ptr DeleteFileTool))
                           (call (ptr ToolCall))
                           (context (ptr ToolExecutionContext))
                           (allocator (dyn Allocator))] (-> ToolResult)
  (let [relative (file-tool-relative-path call)]
    (cond (cancellation-requested? (load (field context cancellation))) (file-tool-error call "file deletion cancelled")
          (not (file-tool-path-safe? relative))
            (file-tool-error call "path must be workspace-relative without parent traversal")
          :else
            (let [path (file-tool-path allocator (load (field self root)) relative)
                  c-path (str->cstr allocator path)
                  code (if (= (cast i64 c-path) 0) -1 (cast i64 (unlink c-path)))]
              (when (!= (cast i64 c-path) 0)
                (free-bytes allocator
                            (slice-new (cast (ptr u8) c-path) (+ (slice-len [u8] path) 1))
                            1)
                0)
              (if (= code 0)
                  (file-tool-path-result allocator call "deleted" relative)
                  (file-tool-error call "could not delete file"))))))

(defn execute-remove-directory [(self (ptr RemoveDirectoryTool))
                                (call (ptr ToolCall))
                                (context (ptr ToolExecutionContext))
                                (allocator (dyn Allocator))] (-> ToolResult)
  (let [relative (file-tool-relative-path call)]
    (cond (cancellation-requested? (load (field context cancellation)))
            (file-tool-error call "directory removal cancelled")
          (not (file-tool-path-safe? relative))
            (file-tool-error call "path must be workspace-relative without parent traversal")
          :else
            (let [path (file-tool-path allocator (load (field self root)) relative)
                  c-path (str->cstr allocator path)
                  code (if (= (cast i64 c-path) 0) -1 (cast i64 (rmdir c-path)))]
              (when (!= (cast i64 c-path) 0)
                (free-bytes allocator
                            (slice-new (cast (ptr u8) c-path) (+ (slice-len [u8] path) 1))
                            1)
                0)
              (if (= code 0)
                  (file-tool-path-result allocator call "removed" relative)
                  (file-tool-error call "could not remove empty directory"))))))

(impl ToolImplementation ReadTextFileTool
  (execute-tool [(self (ptr ReadTextFileTool))
                 (call (ptr ToolCall))
                 (context (ptr ToolExecutionContext))
                 (allocator (dyn Allocator))]
                (-> ToolResult)
                (execute-read-text-file self call context allocator)))

(impl ToolImplementation WriteTextFileTool
  (execute-tool [(self (ptr WriteTextFileTool))
                 (call (ptr ToolCall))
                 (context (ptr ToolExecutionContext))
                 (allocator (dyn Allocator))]
                (-> ToolResult)
                (execute-write-text-file self call context allocator)))

(impl ToolImplementation EditTextFileTool
  (execute-tool [(self (ptr EditTextFileTool))
                 (call (ptr ToolCall))
                 (context (ptr ToolExecutionContext))
                 (allocator (dyn Allocator))]
                (-> ToolResult)
                (execute-edit-text-file self call context allocator)))

(impl ToolImplementation CreateDirectoryTool
  (execute-tool [(self (ptr CreateDirectoryTool))
                 (call (ptr ToolCall))
                 (context (ptr ToolExecutionContext))
                 (allocator (dyn Allocator))]
                (-> ToolResult)
                (execute-create-directory self call context allocator)))

(impl ToolImplementation DeleteFileTool
  (execute-tool [(self (ptr DeleteFileTool))
                 (call (ptr ToolCall))
                 (context (ptr ToolExecutionContext))
                 (allocator (dyn Allocator))]
                (-> ToolResult)
                (execute-delete-file self call context allocator)))

(impl ToolImplementation RemoveDirectoryTool
  (execute-tool [(self (ptr RemoveDirectoryTool))
                 (call (ptr ToolCall))
                 (context (ptr ToolExecutionContext))
                 (allocator (dyn Allocator))]
                (-> ToolResult)
                (execute-remove-directory self call context allocator)))

(defn file-tool-schema [(allocator (dyn Allocator))
                        (include-content bool)] (-> Json)
  (let [(mut path) (json-object allocator)
        (mut content) (json-object allocator)
        (mut properties) (json-object allocator)
        (mut required) (json-array allocator)
        (mut schema) (json-object allocator)]
    (json-put-string! (mut path) "type" "string")
    (json-put-string! (mut content) "type" "string")
    (json-object-put! (mut properties) "path" (load path))
    (json-array-push! (mut required) (JsonString "path"))
    (when include-content
      (json-object-put! (mut properties) "content" (load content))
      (json-array-push! (mut required) (JsonString "content"))
      0)
    (json-put-string! (mut schema) "type" "object")
    (json-object-put! (mut schema) "properties" (load properties))
    (json-object-put! (mut schema) "required" (load required))
    (json-put-bool! (mut schema) "additionalProperties" false)
    (load schema)))

(defn read-text-file-schema [(allocator (dyn Allocator))] (-> Json)
  (let [(mut path) (json-object allocator)
        (mut start-line) (json-object allocator)
        (mut line-count) (json-object allocator)
        (mut properties) (json-object allocator)
        (mut required) (json-array allocator)
        (mut schema) (json-object allocator)]
    (json-put-string! (mut path) "type" "string")
    (json-put-string! (mut start-line) "type" "integer")
    (json-object-put! (mut start-line) "minimum" (json-integer allocator 1))
    (json-put-string! (mut line-count) "type" "integer")
    (json-object-put! (mut line-count) "minimum" (json-integer allocator 1))
    (json-object-put! (mut line-count) "maximum"
                      (json-integer allocator FILE_TOOL_MAX_READ_LINES))
    (json-object-put! (mut properties) "path" (load path))
    (json-object-put! (mut properties) "start_line" (load start-line))
    (json-object-put! (mut properties) "line_count" (load line-count))
    (json-array-push! (mut required) (JsonString "path"))
    (json-array-push! (mut required) (JsonString "start_line"))
    (json-array-push! (mut required) (JsonString "line_count"))
    (json-put-string! (mut schema) "type" "object")
    (json-object-put! (mut schema) "properties" (load properties))
    (json-object-put! (mut schema) "required" (load required))
    (json-put-bool! (mut schema) "additionalProperties" false)
    (load schema)))

(defn read-text-file-definition [(allocator (dyn Allocator))
                                 (root (slice u8))] (-> ToolDefinition)
  (let [definition (primitive/alloc-stack ToolDefinition)
        implementation (box! allocator ReadTextFileTool (zeroed ReadTextFileTool))]
    (set! (.root implementation) root)
    (set! (.name (.spec definition)) "read_text_file")
    (set! (.description (.spec definition))
          "Read a bounded line range from a workspace-relative text file. Defaults to 120 lines; use start_line and line_count to continue without rereading prior content.")
    (set! (.input-schema (.spec definition)) (read-text-file-schema allocator))
    (set! (.strict (.spec definition)) true)
    (set! (.effect (.spec definition)) (ReadOnly))
    (set! (.idempotent (.spec definition)) true)
    (set! (.timeout-ms (.spec definition)) 10000)
    (set! (.implementation definition) implementation)
    (load definition)))

(defn write-text-file-definition [(allocator (dyn Allocator))
                                  (root (slice u8))] (-> ToolDefinition)
  (let [definition (primitive/alloc-stack ToolDefinition)
        implementation (box! allocator WriteTextFileTool (zeroed WriteTextFileTool))]
    (set! (.root implementation) root)
    (set! (.name (.spec definition)) "write_text_file")
    (set! (.description (.spec definition)) "Create or replace a workspace-relative text file, up to one MiB.")
    (set! (.input-schema (.spec definition)) (file-tool-schema allocator true))
    (set! (.strict (.spec definition)) true)
    (set! (.effect (.spec definition)) (Destructive))
    (set! (.idempotent (.spec definition)) true)
    (set! (.timeout-ms (.spec definition)) 10000)
    (set! (.implementation definition) implementation)
    (load definition)))

(defn edit-text-file-schema [(allocator (dyn Allocator))] (-> Json)
  (let [(mut path) (json-object allocator)
        (mut old-text) (json-object allocator)
        (mut new-text) (json-object allocator)
        (mut properties) (json-object allocator)
        (mut required) (json-array allocator)
        (mut schema) (json-object allocator)]
    (json-put-string! (mut path) "type" "string")
    (json-put-string! (mut old-text) "type" "string")
    (json-put-string! (mut new-text) "type" "string")
    (json-object-put! (mut properties) "path" (load path))
    (json-object-put! (mut properties) "old_text" (load old-text))
    (json-object-put! (mut properties) "new_text" (load new-text))
    (json-array-push! (mut required) (JsonString "path"))
    (json-array-push! (mut required) (JsonString "old_text"))
    (json-array-push! (mut required) (JsonString "new_text"))
    (json-put-string! (mut schema) "type" "object")
    (json-object-put! (mut schema) "properties" (load properties))
    (json-object-put! (mut schema) "required" (load required))
    (json-put-bool! (mut schema) "additionalProperties" false)
    (load schema)))

(defn edit-text-file-definition [(allocator (dyn Allocator))
                                 (root (slice u8))] (-> ToolDefinition)
  (let [definition (primitive/alloc-stack ToolDefinition)
        implementation (box! allocator EditTextFileTool (zeroed EditTextFileTool))]
    (set! (.root implementation) root)
    (set! (.name (.spec definition)) "edit_text_file")
    (set! (.description (.spec definition))
          "Replace one exact, unique text block in an existing workspace-relative file. Prefer this over rewriting the whole file.")
    (set! (.input-schema (.spec definition)) (edit-text-file-schema allocator))
    (set! (.strict (.spec definition)) true)
    (set! (.effect (.spec definition)) (Destructive))
    (set! (.idempotent (.spec definition)) false)
    (set! (.timeout-ms (.spec definition)) 10000)
    (set! (.implementation definition) implementation)
    (load definition)))

(defn filesystem-path-definition [(allocator (dyn Allocator))
                                  (root (slice u8))
                                  (name (slice u8))
                                  (description (slice u8))
                                  (effect ToolEffect)
                                  (implementation (dyn ToolImplementation))] (-> ToolDefinition)
  (let [definition (primitive/alloc-stack ToolDefinition)]
    (set! (.name (.spec definition)) name)
    (set! (.description (.spec definition)) description)
    (set! (.input-schema (.spec definition)) (file-tool-schema allocator false))
    (set! (.strict (.spec definition)) true)
    (set! (.effect (.spec definition)) effect)
    (set! (.idempotent (.spec definition)) false)
    (set! (.timeout-ms (.spec definition)) 10000)
    (set! (.implementation definition) implementation)
    (load definition)))

(defn create-directory-definition [(allocator (dyn Allocator))
                                   (root (slice u8))] (-> ToolDefinition)
  (let [implementation (box! allocator CreateDirectoryTool (zeroed CreateDirectoryTool))]
    (set! (.root implementation) root)
    (filesystem-path-definition allocator
                                root
                                "create_directory"
                                "Create one workspace-relative directory. Its parent must exist."
                                (Reversible)
                                implementation)))

(defn delete-file-definition [(allocator (dyn Allocator))
                              (root (slice u8))] (-> ToolDefinition)
  (let [implementation (box! allocator DeleteFileTool (zeroed DeleteFileTool))]
    (set! (.root implementation) root)
    (filesystem-path-definition allocator
                                root
                                "delete_file"
                                "Delete one workspace-relative file."
                                (Destructive)
                                implementation)))

(defn remove-directory-definition [(allocator (dyn Allocator))
                                   (root (slice u8))] (-> ToolDefinition)
  (let [implementation (box! allocator RemoveDirectoryTool (zeroed RemoveDirectoryTool))]
    (set! (.root implementation) root)
    (filesystem-path-definition allocator
                                root
                                "remove_directory"
                                "Remove one empty workspace-relative directory."
                                (Destructive)
                                implementation)))

(defn register-filesystem-tools! [(registry (mut ToolRegistry))
                                  (allocator (dyn Allocator))
                                  (root (slice u8))] (-> bool)
  (let [read-added
          (tool-register! (mut registry)
                          (read-text-file-definition allocator root))
        write-added
          (tool-register! (mut registry)
                          (write-text-file-definition allocator root))
        edit-added
          (tool-register! (mut registry)
                          (edit-text-file-definition allocator root))
        directory-added
          (tool-register! (mut registry)
                          (create-directory-definition allocator root))
        delete-added
          (tool-register! (mut registry)
                          (delete-file-definition allocator root))
        remove-added
          (tool-register! (mut registry)
                          (remove-directory-definition allocator root))]
    (and read-added
         (and write-added
              (and edit-added
                   (and directory-added (and delete-added remove-added)))))))
