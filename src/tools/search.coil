(module harness-search-tool)
(import "coil.primitive" :as primitive)

(import "coil.primitive" :as primitive)

(import "coil.alloc" :as alloc :use *)
(import "coil.cancellation" :as native-cancellation)
(import "coil.match" :use *)
(import "coil.slice" :use *)
(import "coil.subprocess" :as subprocess)
(import "coil.time" :as time)
(import "harness-filesystem-tools" :use *)
(import "harness-json" :use *)
(import "harness-system" :use *)
(import "harness-tool" :use *)
(import "provider-common" :use *)

(const SEARCH_CAPTURE_LIMIT 8192)
(const SEARCH_TIMEOUT_MS 30000)

(defstruct SearchTextTool [(root (slice u8))])

(defn search-error [(call (ptr ToolCall)) (message (slice u8))] (-> ToolResult)
  (let [(mut result) (tool-result-empty (.id call) (ToolErrored))]
    (set! (.error result) message)
    (load result)))

(defn execute-search-text [(self (ptr SearchTextTool))
                           (call (ptr ToolCall))
                           (context (ptr ToolExecutionContext))
                           (allocator (dyn Allocator))] (-> ToolResult)
  (let [arguments (.arguments call)
        query (match (json-string-at arguments "query")
                (Some [value] value)
                (None [] ""))
        relative (match (json-string-at arguments "path")
                   (Some [value] value)
                   (None [] "."))]
    (cond (= (slice-len [u8] query) 0) (search-error call "query must not be empty")
          (not (file-tool-path-safe? relative))
            (search-error call "path must be workspace-relative without parent traversal")
          (cancellation-requested? (load (field context cancellation)))
            (search-error call "search cancelled")
          :else
            (let [args (primitive/alloc-stack (array (slice u8) 9))
                  run-result (primitive/alloc-stack subprocess/RunResult)]
              (store! (index args 0) "rg")
              (store! (index args 1) "--line-number")
              (store! (index args 2) "--no-heading")
              (store! (index args 3) "--color")
              (store! (index args 4) "never")
              (store! (index args 5) "--max-count")
              (store! (index args 6) "50")
              (store! (index args 7) query)
              (store! (index args 8) (file-tool-path allocator
                                                     (load (field self root))
                                                     relative))
              (let [deadline
                      (match (time/duration-millis SEARCH_TIMEOUT_MS)
                        (Err [failure] (None [time/Instant]))
                        (Ok [duration]
                          (match (time/deadline-after duration)
                            (Err [failure] (None [time/Instant]))
                            (Ok [value] (Some value)))))
                    options
                      (subprocess/run-options "/usr/bin/env"
                                              (slice-new [(slice u8)] (index args 0) 9)
                                              (load (field self root))
                                              SEARCH_CAPTURE_LIMIT
                                              SEARCH_CAPTURE_LIMIT
                                              deadline
                                              (cast (ptr native-cancellation/Cancellation) 0)
                                              (zeroed time/Duration))]
                (match (subprocess/run allocator run-result options)
                  (Err [failure] (search-error call "could not execute text search"))
                  (Ok [completed]
                    (let [(mut output) (json-object allocator)
                          (mut result) (tool-result-empty (load (field call id))
                                                         (ToolSucceeded))
                          truncated (load (field completed stdout-truncated))]
                      ;; RunResult owns its capture buffers. Tool results outlive this
                      ;; function, so copy stdout before freeing the subprocess result.
                      (json-object-put! (mut output)
                                        "matches"
                                        (JsonString
                                          (json-copy-string
                                            allocator
                                            (load (field completed stdout)))))
                      (json-put-bool! (mut output) "truncated" truncated)
                      (json-object-put! (mut output) "exit_code"
                                        (json-integer allocator
                                          (match (load (field completed status))
                                            (subprocess/Exited [code] code)
                                            (subprocess/Signaled [signal] (+ 128 signal)))))
                      (when truncated
                        (json-put-string! (mut output) "hint"
                                          "Search output exceeded the bounded result size. Narrow query or path; use ranged read_text_file for the relevant locations.")
                        0)
                      (store! (field result output) (load output))
                      (subprocess/run-result-free allocator completed)
                      (load result)))))))))

(impl ToolImplementation SearchTextTool
  (execute-tool [(self (ptr SearchTextTool))
                 (call (ptr ToolCall))
                 (context (ptr ToolExecutionContext))
                 (allocator (dyn Allocator))] (-> ToolResult)
    (execute-search-text self call context allocator)))

(defn search-text-schema [(allocator (dyn Allocator))] (-> Json)
  (let [(mut query) (json-object allocator)
        (mut path) (json-object allocator)
        (mut properties) (json-object allocator)
        (mut required) (json-array allocator)
        (mut schema) (json-object allocator)]
    (json-put-string! (mut query) "type" "string")
    (json-put-string! (mut path) "type" "string")
    (json-object-put! (mut properties) "query" (load query))
    (json-object-put! (mut properties) "path" (load path))
    (json-array-push! (mut required) (JsonString "query"))
    (json-array-push! (mut required) (JsonString "path"))
    (json-put-string! (mut schema) "type" "object")
    (json-object-put! (mut schema) "properties" (load properties))
    (json-object-put! (mut schema) "required" (load required))
    (json-put-bool! (mut schema) "additionalProperties" false)
    (load schema)))

(defn register-search-text-tool! [(registry (mut ToolRegistry))
                                  (allocator (dyn Allocator))
                                  (root (slice u8))] (-> bool)
  (let [definition (primitive/alloc-stack ToolDefinition)
        implementation (box! allocator SearchTextTool (zeroed SearchTextTool))]
    (set! (.root implementation) root)
    (set! (.name (.spec definition)) "search_text")
    (set! (.description (.spec definition))
          "Search workspace text with bounded line-numbered results. Narrow query or path when truncated, then use ranged read_text_file.")
    (set! (.input-schema (.spec definition)) (search-text-schema allocator))
    (set! (.strict (.spec definition)) true)
    (set! (.effect (.spec definition)) (ReadOnly))
    (set! (.idempotent (.spec definition)) true)
    (set! (.timeout-ms (.spec definition)) SEARCH_TIMEOUT_MS)
    (set! (.implementation definition) implementation)
    (tool-register! (mut registry) (load definition))))
