(module harness-factory-definition)

(import "coil.alloc" :as alloc :use *)
(import "coil.arraylist" :use *)
(import "coil.fs" :as fs)
(import "coil.match" :use *)
(import "coil.result" :use *)
(import "coil.slice" :use *)
(import "harness-directory" :use *)
(import "harness-json" :use *)

;; A factory is deliberately data on disk: one small metadata file plus Markdown
;; worker/context files. Nothing here knows about any particular product.
(defstruct FactoryWorker
  [(file (slice u8))
   (instructions (slice u8))
   ;; Empty values inherit the run-level selection.
   (provider (slice u8))
   (model (slice u8))
   (reasoning (slice u8))
   (before-commands (ArrayList (slice u8)))
   (after-commands (ArrayList (slice u8)))])

(defstruct FactoryDefinition
  [(directory (slice u8))
   (name (slice u8))
   (goal (slice u8))
   (common-context (ArrayList (slice u8)))
   (tool-groups (ArrayList (slice u8)))
   (before-commands (ArrayList (slice u8)))
   (after-commands (ArrayList (slice u8)))
   (before-each-commands (ArrayList (slice u8)))
   (after-each-commands (ArrayList (slice u8)))
   (workers (ArrayList FactoryWorker))])

(defn factory-load-strings! [(values Json)
                             (output (mut (ArrayList (slice u8))))] (-> bool)
  (match (json-array-items values)
    (None [] false)
    (Some [items]
          (let [(mut i) 0
                n (al-len [Json] (load items))
                (mut ok) true]
            (loop (if (or (>= (load i) n) (not (load ok)))
                      (break)
                      (match (al-get [Json] (load items) (load i))
                        (JsonString [value]
                                    (if (= (slice-len [u8] value) 0)
                                        (store! ok false)
                                        (do
                                          (al-push! [(slice u8)] (mut output) value)
                                          (store! i (+ (load i) 1)))))
                        (_ (store! ok false)))))
            (load ok)))))

(defn factory-load-optional-strings! [(values Json)
                                      (output (mut (ArrayList (slice u8))))] (-> bool)
  (match-else values
              (JsonNull [] true)
              (_ (factory-load-strings! values (mut output)))))

(defsum FactoryDefinitionResult
  (FactoryLoaded [(definition FactoryDefinition)])
  (FactoryInvalid [(message (slice u8))]))

(defn factory-read-file [(allocator (ptr Allocator))
                         (directory (slice u8))
                         (relative (slice u8))] (-> (slice u8))
  (match (fs/read-file allocator (path-join allocator directory relative))
    (Ok [owned] owned)
    (Err [failure] "")))

(defn factory-load-string-files! [(allocator (ptr Allocator))
                                  (directory (slice u8))
                                  (paths Json)
                                  (output (mut (ArrayList (slice u8))))] (-> bool)
  (match (json-array-items paths)
    (None [] false)
    (Some [items]
          (let [(mut i) 0
                n (al-len [Json] (load items))
                (mut ok) true]
            (loop (if (or (>= (load i) n) (not (load ok)))
                      (break)
                      (match (al-get [Json] (load items) (load i))
                        (JsonString [relative]
                                    (let [contents (factory-read-file allocator directory relative)]
                                      (if (= (slice-len [u8] contents) 0)
                                          (store! ok false)
                                          (do
                                            (al-push! [(slice u8)] (mut output) contents)
                                            (store! i (+ (load i) 1))))))
                        (_ (store! ok false)))))
            (load ok)))))

(defn factory-add-worker! [(allocator (ptr Allocator))
                           (directory (slice u8))
                           (file (slice u8))
                           (provider (slice u8))
                           (model (slice u8))
                           (reasoning (slice u8))
                           (before Json)
                           (after Json)
                           (workers (mut (ArrayList FactoryWorker)))] (-> bool)
  (let [instructions (factory-read-file allocator directory file)
        worker (alloc/stack FactoryWorker)]
    (store! (field worker file) file)
    (store! (field worker instructions) instructions)
    (store! (field worker provider) provider)
    (store! (field worker model) model)
    (store! (field worker reasoning) reasoning)
    (store! (field worker before-commands) (al-new [(slice u8)] allocator))
    (store! (field worker after-commands) (al-new [(slice u8)] allocator))
    (if (or (= (slice-len [u8] file) 0)
            (= (slice-len [u8] instructions) 0))
        false
        (if (not (and (factory-load-optional-strings! before
                                                      (mut (field worker before-commands)))
                      (factory-load-optional-strings! after
                                                      (mut (field worker after-commands)))))
            false
            (do (al-push! [FactoryWorker] (mut workers) (load worker)) true)))))

(defn factory-load-workers! [(allocator (ptr Allocator))
                             (directory (slice u8))
                             (entries Json)
                             (workers (mut (ArrayList FactoryWorker)))] (-> bool)
  (match (json-array-items entries)
    (None [] false)
    (Some [items]
          (let [(mut i) 0
                n (al-len [Json] (load items))
                (mut ok) true]
            (loop (if (or (>= (load i) n) (not (load ok)))
                      (break)
                      (let [entry (al-get [Json] (load items) (load i))]
                        (store! ok
                                (match entry
                                  (JsonString [file]
                                              (factory-add-worker! allocator
                                                                   directory
                                                                   file
                                                                   ""
                                                                   ""
                                                                   ""
                                                                   (JsonNull)
                                                                   (JsonNull)
                                                                   (mut workers)))
                                  (JsonObject [keys values]
                                              (factory-add-worker! allocator
                                                                   directory
                                                                   (match (json-string-at entry "file")
                                                                     (Some [file] file)
                                                                     (None [] ""))
                                                                   (match (json-string-at entry "provider")
                                                                     (Some [value] value)
                                                                     (None [] ""))
                                                                   (match (json-string-at entry "model")
                                                                     (Some [value] value)
                                                                     (None [] ""))
                                                                   (match (json-string-at entry "reasoning")
                                                                     (Some [value] value)
                                                                     (None [] ""))
                                                                   (json-get entry "before")
                                                                   (json-get entry "after")
                                                                   (mut workers)))
                                  (_ false)))
                        (store! i (+ (load i) 1)))))
            (load ok)))))

(defn load-factory-definition [(allocator (ptr Allocator))
                               (directory (slice u8))] (-> FactoryDefinitionResult)
  (let [manifest-text (factory-read-file allocator directory "factory.json")]
    (if (= (slice-len [u8] manifest-text) 0)
        (FactoryInvalid "factory folder must contain a readable factory.json")
        (let [parsed (json-parse allocator manifest-text)]
          (if (not (load (field parsed ok)))
              (FactoryInvalid "factory.json is not valid JSON")
              (let [manifest (load (field parsed value))
                    name
                      (match (json-string-at manifest "name")
                        (Some [value] value)
                        (None [] ""))
                    goal
                      (match (json-string-at manifest "goal")
                        (Some [value] value)
                        (None [] ""))
                    commands (json-get manifest "commands")
                    (mut definition) (zeroed FactoryDefinition)]
                (store! (field definition directory) directory)
                (store! (field definition name) name)
                (store! (field definition goal) goal)
                (store! (field definition common-context) (al-new [(slice u8)] allocator))
                (store! (field definition tool-groups) (al-new [(slice u8)] allocator))
                (store! (field definition before-commands) (al-new [(slice u8)] allocator))
                (store! (field definition after-commands) (al-new [(slice u8)] allocator))
                (store! (field definition before-each-commands) (al-new [(slice u8)] allocator))
                (store! (field definition after-each-commands) (al-new [(slice u8)] allocator))
                (store! (field definition workers) (al-new [FactoryWorker] allocator))
                (cond (or (= (slice-len [u8] name) 0) (= (slice-len [u8] goal) 0))
                        (FactoryInvalid "factory.json requires non-empty name and goal")
                      (not (factory-load-strings! (json-get (json-get manifest "tools") "groups")
                                                  (mut (field definition tool-groups))))
                        (FactoryInvalid "factory.json requires a tools.groups array")
                      (not (factory-load-string-files! allocator
                                                       directory
                                                       (json-get manifest "context")
                                                       (mut (field definition common-context))))
                        (FactoryInvalid "factory context must name readable Markdown files")
                      (not (and (factory-load-optional-strings! (json-get commands "before")
                                                                (mut (field definition before-commands)))
                                (and (factory-load-optional-strings! (json-get commands "after")
                                                                     (mut (field definition after-commands)))
                                     (and (factory-load-optional-strings! (json-get commands "before_each")
                                                                          (mut (field definition before-each-commands)))
                                          (factory-load-optional-strings! (json-get commands "after_each")
                                                                          (mut (field definition after-each-commands)))))))
                        (FactoryInvalid "factory commands must be arrays of non-empty strings")
                      (not (factory-load-workers! allocator
                                                  directory
                                                  (json-get manifest "workers")
                                                  (mut (field definition workers))))
                        (FactoryInvalid "workers must be readable Markdown files with optional before/after command arrays")
                      :else (FactoryLoaded (load definition)))))))))
