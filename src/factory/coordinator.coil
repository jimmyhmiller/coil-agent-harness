(module harness-factory-coordinator)

(import "coil.primitive" :as primitive)

(import "coil.alloc" :as alloc :use *)
(import "coil.arraylist" :use *)
(import "coil.match" :use *)
(import "coil.slice" :use *)
(import "coil.str" :use *)
(import "harness-agent-runner" :use *)
(import "harness-allocation-domain" :use *)
(import "harness-bash-tool" :use *)
(import "harness-event" :use *)
(import "harness-factory-definition" :use *)
(import "harness-factory-status" :use *)
(import "harness-factory-workflow" :use *)
(import "harness-factory-workspace" :use *)
(import "harness-filesystem-tools" :use *)
(import "harness-json" :use *)
(import "harness-model" :use *)
(import "harness-run-inbox" :use *)
(import "coil.os" :as os :use *)
(import "harness-runtime-controller" :use *)
(import "harness-search-tool" :use *)
(import "harness-system" :use *)
(import "harness-tool" :use *)
(import "provider-common" :use *)

(defn factory-stage-payload [(allocator (dyn Allocator))
                             (worker (ref FactoryWorker))
                             (provider (slice u8))
                             (model (slice u8))
                             (reasoning (slice u8))
                             (reported bool)
                             (ready bool)] (-> Json)
  (let [(mut payload) (json-object allocator)]
    (json-put-string! (mut payload) "worker" (.file worker))
    (json-put-string! (mut payload) "provider" provider)
    (json-put-string! (mut payload) "model" model)
    (json-put-string! (mut payload) "reasoning" reasoning)
    (json-put-bool! (mut payload) "reported" reported)
    (json-put-bool! (mut payload) "ready" ready)
    (load payload)))

(defn factory-worker-setting [(worker-value (slice u8))
                              (run-value (slice u8))] (-> (slice u8))
  (if (> (slice-len [u8] worker-value) 0) worker-value run-value))

(defn factory-run-id [(allocator (dyn Allocator))
                      (name (slice u8))] (-> (slice u8))
  (let [(mut value) (sb-new allocator)]
    (sb-push-str! (mut value) "factory-")
    (sb-push-str! (mut value) name)
    (sb-push-str! (mut value) "-")
    (sb-push-str! (mut value)
                  (json-stringify allocator (json-integer allocator (now-ms))))
    (sb-finish! (mut value))))

(defn factory-command-id [(allocator (dyn Allocator))
                          (phase (slice u8))
                          (invocation i64)
                          (index i64)] (-> (slice u8))
  (let [(mut value) (sb-new allocator)]
    (sb-push-str! (mut value) "factory-command-")
    (sb-push-str! (mut value) phase)
    (sb-push-str! (mut value) "-")
    (sb-push-str! (mut value) (json-stringify allocator (json-integer allocator invocation)))
    (sb-push-str! (mut value) "-")
    (sb-push-str! (mut value) (json-stringify allocator (json-integer allocator index)))
    (sb-finish! (mut value))))

(defn factory-command-payload [(allocator (dyn Allocator))
                               (phase (slice u8))
                               (command (slice u8))
                               (index i64)
                               (output Json)] (-> Json)
  (let [(mut payload) (json-object allocator)]
    (json-put-string! (mut payload) "phase" phase)
    (json-put-string! (mut payload) "command" command)
    (json-object-put! (mut payload) "index" (json-integer allocator index))
    (when (not (match output (JsonNull [] true) (_ false)))
      (json-object-put! (mut payload) "result" output)
      0)
    (load payload)))

(defn run-factory-commands [(allocator (dyn Allocator))
                            (commands (ArrayList (slice u8)))
                            (phase (slice u8))
                            (invocation i64)
                            (factory-id (slice u8))
                            (worker (slice u8))
                            (workspace (slice u8))
                            (provider-name (slice u8))
                            (model (slice u8))
                            (emitter (ptr EventEmitter))] (-> i64)
  (let [tool (primitive/alloc-stack BashTool)
        context (primitive/alloc-stack ToolExecutionContext)
        (mut i) 0
        n (al-len [(slice u8)] commands)
        (mut result) 0]
    (set! (.cwd tool) workspace)
    (set! (.run-id context) factory-id)
    (set! (.cancellation context) (cast (ptr CancellationToken) 0))
    (set! (.run-deadline-monotonic-ms context) 0)
    (set! (.tool-deadline-monotonic-ms context) 0)
    (loop (if (or (>= (load i) n) (!= (load result) 0))
              (break)
              (let [command (al-get [(slice u8)] commands (load i))
                    call-id (factory-command-id allocator phase invocation (load i))
                    call (primitive/alloc-stack ToolCall)
                    (mut arguments) (json-object allocator)]
                (json-put-string! (mut arguments) "command" command)
                (set! (.id call) call-id)
                (set! (.name call) "bash")
                (set! (.arguments call) (load arguments))
                (set! (.raw-arguments call) "")
                (emit-event emitter
                            (now-ms)
                            (FactoryCommandStarted)
                            factory-id
                            worker
                            call-id
                            provider-name
                            model
                            (factory-command-payload allocator phase command (load i) (JsonNull)))
                (let [outcome (execute-bash tool call context allocator)
                      output (.output outcome)
                      success
                        (and (match (.status outcome) (ToolSucceeded [] true) (_ false))
                             (= (json-number-i64 (json-get output "exit_code")) 0))]
                  (emit-event emitter
                              (now-ms)
                              (if success (FactoryCommandCompleted) (FactoryCommandFailed))
                              factory-id
                              worker
                              call-id
                              provider-name
                              model
                              (factory-command-payload allocator phase command (load i) output))
                  (if success
                      (set! i (+ (load i) 1))
                      (set! result 1))))))
    (load result)))

(defn factory-append-sections! [(buffer (mut StrBuf))
                                (sections (ArrayList (slice u8)))] (-> i64)
  (let [(mut i) 0
        n (al-len [(slice u8)] sections)]
    (loop (if (>= (load i) n)
              (break)
              (do
                (sb-push-str! (mut buffer) "\n\n")
                (sb-push-str! (mut buffer) (al-get [(slice u8)] sections (load i)))
                (set! i (+ (load i) 1))))))
  0)

;;; How many times a worker that says "not ready" is sent back in before the run
;;; gives up. A worker reporting what is left is describing work, not failing:
;;; the answer to "not ready" is "carry on", not "stop everything". The bound
;;; exists so a worker that cannot make progress cannot spend forever proving it.
(const FACTORY_STAGE_ATTEMPTS 5)

;;; What to say to a worker that reported it was not done. Its own sentence is the
;;; instruction: it has just written the most accurate description of the
;;; remaining work that anybody has.
(defn factory-continue-prompt [(allocator (dyn Allocator))
                               (prompt (slice u8))
                               (summary (slice u8))
                               (attempt i64)] (-> (slice u8))
  (let [(mut out) (sb-new allocator)]
    (sb-push-str! (mut out) prompt)
    (sb-push-str! (mut out)
                  "\n\nYou already worked on this assignment in this same workspace and reported that it was not ready. This is what you said was left:\n\n")
    (sb-push-str! (mut out) (if (= (slice-len [u8] summary) 0) "(no summary given)" summary))
    (sb-push-str! (mut out)
                  "\n\nCarry on from there. The work you already did is on disk -- inspect it rather than starting over. Do the remaining work now; do not hand it back describing it again. Report ready=true when it is genuinely done, and ready=false only if you are blocked on something you cannot do here, saying exactly what blocks you.")
    (sb-finish! (mut out))))

(defn factory-continue-payload [(allocator (dyn Allocator))
                                (worker (ref FactoryWorker))
                                (attempt i64)
                                (reported bool)
                                (summary (slice u8))] (-> Json)
  (let [(mut payload) (json-object allocator)]
    (json-put-string! (mut payload) "worker" (.file worker))
    (json-object-put! (mut payload) "attempt" (json-integer allocator attempt))
    (json-object-put! (mut payload) "attempts" (json-integer allocator FACTORY_STAGE_ATTEMPTS))
    ;; A worker that finished without reporting at all is treated the same way:
    ;; it did not say it was done, so it is not done.
    (json-put-bool! (mut payload) "reported" reported)
    (json-put-string! (mut payload) "remaining" summary)
    (load payload)))

(defn factory-stage-prompt [(allocator (dyn Allocator))
                            (definition (ref FactoryDefinition))
                            (worker (ref FactoryWorker))
                            (workspace (slice u8))] (-> (slice u8))
  (let [(mut prompt) (sb-new allocator)]
    (factory-append-sections! (mut prompt) (.common-context definition))
    (sb-push-str! (mut prompt) "\n\n# Product goal\n\n")
    (sb-push-str! (mut prompt) (.goal definition))
    (sb-push-str! (mut prompt) "\n\n# Current worker assignment\n\n")
    (sb-push-str! (mut prompt) (.instructions worker))
    (sb-push-str! (mut prompt) "\n\n# Execution context\n\nFactory: ")
    (sb-push-str! (mut prompt) (.name definition))
    (sb-push-str! (mut prompt) "\nWorkspace: ")
    (sb-push-str! (mut prompt) workspace)
    (sb-push-str! (mut prompt) "\nMutable factory definition: ")
    (sb-push-str! (mut prompt) (.directory definition))
    (when (starts-with (load (field definition directory)) workspace)
      (let [workspace-length (slice-len [u8] workspace)
            definition-length (slice-len [u8] (load (field definition directory)))]
        (when (> definition-length workspace-length)
          (sb-push-str! (mut prompt) "\nWorkspace-relative factory definition: ")
          (sb-push-str! (mut prompt)
                        (substr (load (field definition directory))
                                (+ workspace-length 1)
                                definition-length))
          0))
      0)
    (sb-push-str! (mut prompt)
                  "\nA person may be watching this run and can send you a message while it is going. If one arrives it is marked as coming from them; treat it as a change of orders that outranks this assignment, act on it immediately, and say what you changed.\n\nExecute the Markdown assignment in this workspace using the available tools and supplied context. The factory definition above is this run's private copy; you may update its context, goal, tool groups, worker list, or later worker Markdown when that helps subsequent phases. The coordinator reloads it before the next phase. Use inspect_workflow when you need the live ordered topology, current position, or completed history. The workflow continues in order by default; use set_workflow_state to complete early or route to a named worker. Decide what validation the assignment requires and perform it. Before finishing, call report_worker_status with ready=true only if you believe the assignment is complete and validated; otherwise report ready=false and explain what remains.")
    (sb-finish! (mut prompt))))

(defn factory-request [(allocator (dyn Allocator))
                       (registry (ptr ToolRegistry))
                       (run-id (slice u8))
                       (model (slice u8))
                       (reasoning (slice u8))
                       (prompt (slice u8))
                       ;; Every worker of a factory reads the same inbox, the
                       ;; factory's own: a person watching a run says something
                       ;; to "this run", not to whichever step happens to hold
                       ;; the floor when they hit return.
                       (inbox (slice u8))] (-> ModelRequest)
  (let [request (primitive/alloc-stack ModelRequest)
        messages (box! allocator (ArrayList Message) (al-new [Message] allocator))
        message (primitive/alloc-stack Message)]
    (set! (.role message) (UserRole))
    (set! (.content message) prompt)
    (al-push! [Message] messages (load message))
    (set! (.run-id request) run-id)
    (set! (.operation-id request) "model-1")
    (set! (.model request) model)
    (set! (.instructions request)
          "Complete the assigned work with the available tools and report your worker status before finishing. A person may be watching this run and can send a message into it while it is going. Such a message arrives marked as coming from them; it outranks the assignment and whatever you had planned, and must be acted on in the very next thing you do. Say what you are changing, then do it.")
    (set! (.cache-key request) "")
    (set! (.prompt-cache-key request) run-id)
    (set! (.messages request) messages)
    (set! (.tools request) registry)
    (set! (.tool-choice request) (ToolsAuto))
    (set! (.parallel-tool-calls request) true)
    (set! (.reasoning request) reasoning)
    (set! (.max-output-tokens request) 0)
    (set! (.timeout-ms request) 120000)
    (set! (.deadline-monotonic-ms request) 0)
    (set! (.cancellation request) (cast (ptr CancellationToken) 0))
    (set! (.run-lifecycle request) (cast (ptr i64) 0))
    (set! (.inbox request) inbox)
    (set! (.present (.continuation request)) false)
    (set! (.previous-response-id (.continuation request)) "")
    (set! (.provider-session-id (.continuation request)) "")
    (set! (.previous-output (.continuation request)) (JsonNull))
    (set! (.tool-results (.continuation request)) (cast (ptr (ArrayList ToolResult)) 0))
    ;; A stack slot is not zeroed. Every pointer in the continuation has to be
    ;; nulled by hand or the runtime reads whatever the last frame left there --
    ;; which is a transcript pointer into nothing, and a segfault on the turn
    ;; that first appends to it.
    (set! (.turns (.continuation request)) (cast (ptr (ArrayList ContinuationTurn)) 0))
    (load request)))

(defn factory-tool-group-enabled? [(definition (ref FactoryDefinition))
                                   (name (slice u8))] (-> bool)
  (let [(mut i) 0
        groups (.tool-groups definition)
        n (al-len [(slice u8)] groups)
        (mut enabled) false]
    (loop (if (or (>= (load i) n) (load enabled))
              (break)
              (do
                (when (= (al-get [(slice u8)] groups (load i)) name)
                  (store! enabled true)
                  0)
                (set! i (+ (load i) 1)))))
    (load enabled)))

(defn factory-register-configured-tools! [(registry (mut ToolRegistry))
                                          (allocator (dyn Allocator))
                                          (workspace (slice u8))
                                          (definition (ref FactoryDefinition))] (-> i64)
  (when (factory-tool-group-enabled? definition "filesystem")
    (register-filesystem-tools! (mut registry) allocator workspace)
    (register-search-text-tool! (mut registry) allocator workspace)
    0)
  (when (factory-tool-group-enabled? definition "bash")
    (register-bash-tool! (mut registry) allocator workspace)
    0)
  0)

(defn factory-stage-run-id [(allocator (dyn Allocator))
                            (name (slice u8))
                            (stage i64)] (-> (slice u8))
  (let [(mut value) (sb-new allocator)]
    (sb-push-str! (mut value) name)
    (sb-push-str! (mut value) "-worker-")
    (sb-push-str! (mut value)
                  (json-stringify allocator (json-integer allocator (+ stage 1))))
    (sb-finish! (mut value))))

(defn run-factory-stage [(allocator (dyn Allocator))
                         (provider (dyn ModelProvider))
                         (definition (ref FactoryDefinition))
                         (worker (ref FactoryWorker))
                         (worker-status (ptr FactoryWorkerStatus))
                         (workflow-state (ptr FactoryWorkflowState))
                         (stage i64)
                         (invocation i64)
                         (factory-id (slice u8))
                         (workspace (slice u8))
                         (provider-name (slice u8))
                         (model (slice u8))
                         (reasoning (slice u8))
                         (emitter (ptr EventEmitter))] (-> i64)
  (let [run-id (factory-stage-run-id allocator (.name definition) invocation)
        domain (allocation-domain-open allocator)
        (mut result) 0]
    (factory-worker-status-reset! worker-status)
    (factory-workflow-prepare-stage! workflow-state (.file worker) stage)
    (emit-event emitter
                (now-ms)
                (FactoryStageStarted)
                factory-id
                (.file worker)
                run-id
                provider-name
                model
                (factory-stage-payload allocator worker provider-name model reasoning false false))
    (if (not (allocation-domain-valid? domain))
        (set! result 70)
        (let [run-allocator (allocation-domain-allocator domain)
              registry (box! run-allocator ToolRegistry (tool-registry-new run-allocator))
              prompt (factory-stage-prompt run-allocator definition worker workspace)
              request (primitive/alloc-stack ModelRequest)
              policy (primitive/alloc-stack AgentRunPolicy)]
          (factory-register-configured-tools! registry run-allocator workspace definition)
          (register-factory-status-tool! registry run-allocator worker-status)
          (register-factory-workflow-tools! registry run-allocator workflow-state)
          (set! request
                (factory-request run-allocator
                                 registry
                                 run-id
                                 model
                                 reasoning
                                 prompt
                                 (inbox-path run-allocator factory-id)))
          (set! (.max-model-turns policy) 0)
          (set! (.max-parallel-tools policy) 8)
          ;; A worker that reports "not ready" has described the work that is
          ;; left, not failed. Send it back in with its own words until it is
          ;; done or the attempts run out.
          (let [(mut attempt) 1
                (mut settled) false]
            (loop (if (load settled)
                      (break)
                      (match (run-agent run-allocator provider request emitter (load policy))
                        (ModelErr [failure] (do (set! result 70) (set! settled true)))
                        (ModelOk [response]
                                 (let [reported (factory-worker-status-reported? worker-status)
                                       ready (factory-worker-status-ready? worker-status)
                                       summary (factory-worker-status-summary worker-status)]
                                   (cond
                                     (and reported ready)
                                       (do
                                         (factory-workflow-record-completed! workflow-state)
                                         ;; A finished worker's work exists the
                                         ;; moment it says it is done. Commit it
                                         ;; in the run's own worktree: the next
                                         ;; worker's tools cannot quietly undo
                                         ;; what is already a commit, and what
                                         ;; each one changed can be read back.
                                         (commit-workspace! run-allocator
                                                            workspace
                                                            (factory-commit-message run-allocator
                                                                                    definition
                                                                                    worker))
                                         (emit-event emitter
                                                     (now-ms)
                                                     (FactoryStageAccepted)
                                                     factory-id
                                                     (.file worker)
                                                     run-id
                                                     provider-name
                                                     model
                                                     (factory-stage-payload allocator
                                                                            worker
                                                                            provider-name
                                                                            model
                                                                            reasoning
                                                                            reported
                                                                            ready))
                                         (set! settled true))
                                     ;; Not ready, and there is another attempt:
                                     ;; carry on rather than ending the run.
                                     (< (load attempt) FACTORY_STAGE_ATTEMPTS)
                                       (do
                                         (emit-event emitter
                                                     (now-ms)
                                                     (FactoryStageContinued)
                                                     factory-id
                                                     (.file worker)
                                                     run-id
                                                     provider-name
                                                     model
                                                     (factory-continue-payload allocator
                                                                               worker
                                                                               (load attempt)
                                                                               reported
                                                                               summary))
                                         (set! attempt (+ (load attempt) 1))
                                         (factory-worker-status-reset! worker-status)
                                         (set! request
                                               (factory-request run-allocator
                                                                registry
                                                                run-id
                                                                model
                                                                reasoning
                                                                (factory-continue-prompt run-allocator
                                                                                         prompt
                                                                                         summary
                                                                                         (load attempt))
                                                                (inbox-path run-allocator factory-id)))
                                         0)
                                     :else (do (set! result 1) (set! settled true)))))))))
          (allocation-domain-close! allocator domain)))
    (load result)))

(defn factory-apply-workflow-decision! [(allocator (dyn Allocator))
                                        (definition-directory (slice u8))
                                        (workflow-state (ptr FactoryWorkflowState))
                                        (stage (ptr i64))
                                        (finished (ptr bool))
                                        (result (ptr i64))] (-> i64)
  (cond (= (load (field workflow-state decision)) 1) (store! finished true)
        (= (load (field workflow-state decision)) 2)
          (let [target-index
                  (factory-workflow-worker-index allocator
                                                 definition-directory
                                                 (load (field workflow-state target)))]
            (if (< target-index 0)
                (store! result 65)
                (store! stage target-index)))
        :else (store! stage (+ (load stage) 1)))
  0)

(defn run-factory-stage-with-commands [(allocator (dyn Allocator))
                                       (provider (dyn ModelProvider))
                                       (definition (ref FactoryDefinition))
                                       (worker (ref FactoryWorker))
                                       (worker-status (ptr FactoryWorkerStatus))
                                       (workflow-state (ptr FactoryWorkflowState))
                                       (stage i64)
                                       (invocation i64)
                                       (factory-id (slice u8))
                                       (workspace (slice u8))
                                       (provider-name (slice u8))
                                       (model (slice u8))
                                       (reasoning (slice u8))
                                       (emitter (ptr EventEmitter))] (-> i64)
  (let [(mut result) 0
        worker-file (.file worker)]
    (set! result
          (run-factory-commands allocator
                                (.before-each-commands definition)
                                "before-each"
                                invocation
                                factory-id
                                worker-file
                                workspace
                                provider-name
                                model
                                emitter))
    (when (= (load result) 0)
      (store! result
              (run-factory-commands allocator
                                    (load (field worker before-commands))
                                    "before-state"
                                    invocation
                                    factory-id
                                    worker-file
                                    workspace
                                    provider-name
                                    model
                                    emitter))
      0)
    (when (= (load result) 0)
      (store! result
              (run-factory-stage allocator
                                 provider
                                 definition
                                 worker
                                 worker-status
                                 workflow-state
                                 stage
                                 invocation
                                 factory-id
                                 workspace
                                 provider-name
                                 model
                                 reasoning
                                 emitter))
      0)
    (when (= (load result) 0)
      (store! result
              (run-factory-commands allocator
                                    (load (field worker after-commands))
                                    "after-state"
                                    invocation
                                    factory-id
                                    worker-file
                                    workspace
                                    provider-name
                                    model
                                    emitter))
      0)
    (when (= (load result) 0)
      (store! result
              (run-factory-commands allocator
                                    (load (field definition after-each-commands))
                                    "after-each"
                                    invocation
                                    factory-id
                                    worker-file
                                    workspace
                                    provider-name
                                    model
                                    emitter))
      0)
    (load result)))

;;; What one worker's commit says: the factory, then the worker whose turn it was.
(defn factory-commit-message [(allocator (dyn Allocator))
                              (definition (ref FactoryDefinition))
                              (worker (ref FactoryWorker))] (-> (slice u8))
  (let [(mut text) (sb-new allocator)]
    (sb-push-str! (mut text) (.name definition))
    (sb-push-str! (mut text) ": ")
    (sb-push-str! (mut text) (.file worker))
    (sb-finish! (mut text))))

(defn run-factory-definition [(allocator (dyn Allocator))
                              (definition (ref FactoryDefinition))
                              (runtime-contexts (ArrayList (slice u8)))
                              (workspace (slice u8))
                              (provider-name (slice u8))
                              (model (slice u8))
                              (emitter (ptr EventEmitter))] (-> i64)
  (let [worker-status (box! allocator FactoryWorkerStatus (zeroed FactoryWorkerStatus))
        status-allocator (store! (field worker-status allocator) allocator)
        status-has-allocator (store! (field worker-status has-allocator) true)
        provider-factory
          (box! allocator
               DefaultRuntimeProviderFactory
               (zeroed DefaultRuntimeProviderFactory))
        factory-id (factory-run-id allocator (.name definition))
        workflow-state
          (box! allocator
               FactoryWorkflowState
               (factory-workflow-state-new allocator (load (field definition directory))))
        (mut result) 0
        (mut stage) 0
        (mut invocation) 0
        (mut finished) false]
    (let [(mut created) (json-object allocator)]
      (json-put-string! (mut created) "factory" (.name definition))
      (json-put-string! (mut created) "workspace" workspace)
      (json-put-string! (mut created) "definition" (.directory definition))
      ;; The process this run is. A run that dies without writing a terminal
      ;; record -- killed, crashed, or a laptop closed -- is indistinguishable
      ;; from a slow one unless somebody can ask whether it is still there.
      (json-object-put! (mut created)
                        "pid"
                        (json-integer allocator (cast i64 (os/getpid))))
      (emit-event emitter
                  (now-ms)
                  (FactoryRunCreated)
                  factory-id
                  "factory"
                  ""
                  provider-name
                  model
                  (load created)))
    (set! result
          (run-factory-commands allocator
                                (.before-commands definition)
                                "before-flow"
                                0
                                factory-id
                                "factory"
                                workspace
                                provider-name
                                model
                                emitter))
    (default-runtime-provider-factory-init! provider-factory allocator)
    (loop (if (or (load finished) (!= (load result) 0))
              (break)
              (match (load-factory-definition allocator
                                              (.directory definition))
                (FactoryInvalid [message] (set! result 65))
                (FactoryLoaded [refreshed-value]
                               (let [(mut refreshed) refreshed-value
                                     (mut context-index) 0
                                     context-count (al-len [(slice u8)] runtime-contexts)]
                                 (loop (if (>= (load context-index) context-count)
                                           (break)
                                           (do
                                             (al-push! [(slice u8)]
                                                       (mut (.common-context refreshed))
                                                       (al-get [(slice u8)]
                                                               runtime-contexts
                                                               (load context-index)))
                                             (set! context-index (+ (load context-index) 1)))))
                                 (if (>= (load stage)
                                         (al-len [FactoryWorker] (.workers refreshed)))
                                     (set! finished true)
                                     (let [worker
                                             (al-get [FactoryWorker]
                                                     (.workers refreshed)
                                                     (load stage))
                                           stage-provider
                                             (factory-worker-setting
                                               (.provider worker)
                                               provider-name)
                                           stage-model
                                             (factory-worker-setting
                                               (.model worker)
                                               model)
                                           stage-reasoning
                                             (factory-worker-setting
                                               (.reasoning worker)
                                               "medium")]
                                       (if (< (default-runtime-provider-factory-prepare!
                                                provider-factory
                                                stage-provider
                                                allocator)
                                              0)
                                           (set! result 70)
                                           (match (resolve-runtime-provider provider-factory
                                                                            allocator
                                                                            stage-provider)
                                             (None [] (set! result 64))
                                             (Some [provider]
                                                   (set! result
                                                         (run-factory-stage-with-commands
                                                           allocator
                                                           provider
                                                           refreshed
                                                           worker
                                                           worker-status
                                                           workflow-state
                                                           (load stage)
                                                           (load invocation)
                                                           factory-id
                                                           workspace
                                                           stage-provider
                                                           stage-model
                                                           stage-reasoning
                                                           emitter)))))
                                       (when (= (load result) 0)
                                         (store! invocation (+ (load invocation) 1))
                                         (factory-apply-workflow-decision! allocator
                                                                           (load (field definition directory))
                                                                           workflow-state
                                                                           (mut stage)
                                                                           (mut finished)
                                                                           (mut result))))))))))
    (when (= (load result) 0)
      (match (load-factory-definition allocator (load (field definition directory)))
        (FactoryInvalid [message] (store! result 65))
        (FactoryLoaded [final-definition-value]
                       (let [final-definition final-definition-value]
                         (store! result
                                 (run-factory-commands allocator
                                                       (load (field final-definition after-commands))
                                                       "after-flow"
                                                       (load invocation)
                                                       factory-id
                                                       "factory"
                                                       workspace
                                                       provider-name
                                                       model
                                                       emitter)))))
      0)
    ;; Anything a run leaves behind uncommitted -- a worker that stopped without
    ;; reporting, a command that wrote after the last acceptance -- is committed
    ;; here. A worktree with a dirty tree and no commit is work nobody can find.
    (let [(mut tail) (sb-new allocator)]
      (sb-push-str! (mut tail) (.name definition))
      (sb-push-str! (mut tail) ": ")
      (sb-push-str! (mut tail) factory-id)
      (commit-workspace! allocator workspace (sb-finish! (mut tail))))
    (emit-event emitter
                (now-ms)
                (if (= (load result) 0) (FactoryRunCompleted) (FactoryRunFailed))
                factory-id
                "factory"
                ""
                provider-name
                model
                (json-integer allocator (load result)))
    (default-runtime-provider-factory-close! provider-factory)
    (load result)))
